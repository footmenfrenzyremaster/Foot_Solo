    set udg_temp_AoE=500.00
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_ITEM_Scroll_of_Invisibility_Func006002003))
