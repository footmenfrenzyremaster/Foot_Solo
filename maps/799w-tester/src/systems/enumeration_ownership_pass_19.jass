function Trig_Upgrades_level_Func002A takes nothing returns nothing
    local group affectedUnits=null
    if Trig_Upgrades_level_Func002Func002C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_playernumber=GetConvertedPlayerId(GetEnumPlayer())
        call UnitAddAbilityBJ('A082', udg_base[udg_temp_playernumber])
    endif
    if Trig_Upgrades_level_Func002Func004C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set affectedUnits=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func004Func002002002))
        set udg_temp_ability='A05L'
        call ForGroup(affectedUnits, function Trig_Upgrades_level_Func002Func004Func005A)
        call DestroyGroup(affectedUnits)
        set affectedUnits=null
    endif
    if Trig_Upgrades_level_Func002Func005C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set affectedUnits=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func005Func002002002))
        set udg_temp_ability='A05P'
        call ForGroup(affectedUnits, function Trig_Upgrades_level_Func002Func005Func005A)
        call DestroyGroup(affectedUnits)
        set affectedUnits=null
    endif
    if Trig_Upgrades_level_Func002Func006C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set affectedUnits=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func006Func002002002))
        call ForGroup(affectedUnits, function Trig_Upgrades_level_Func002Func006Func004A)
        call DestroyGroup(affectedUnits)
        set affectedUnits=null
    endif
    if Trig_Upgrades_level_Func002Func007C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set affectedUnits=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func007Func002002002))
        set udg_temp_ability='A05M'
        call ForGroup(affectedUnits, function Trig_Upgrades_level_Func002Func007Func005A)
        call DestroyGroup(affectedUnits)
        set affectedUnits=null
    endif
    if Trig_Upgrades_level_Func002Func009C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_frostbolt_upgrade_level[udg_teamnumber[GetConvertedPlayerId(GetTriggerPlayer())]]=udg_temp_int
        set affectedUnits=GetUnitsOfPlayerAndTypeId(GetEnumPlayer(), 'hgtw')
        set udg_temp_ability='Awfb'
        call ForGroup(affectedUnits, function Trig_Upgrades_level_Func002Func009Func006A)
        call DestroyGroup(affectedUnits)
        set affectedUnits=null
    endif
    if Trig_Upgrades_level_Func002Func011C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
    endif
    if Trig_Upgrades_level_Func002Func013C() then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
    endif
    set udg_temp_int=GetPlayerTechCountSimple(GetResearched(), GetTriggerPlayer())
    set affectedUnits=null
endfunction

function Trig_Upgrades_level_Actions takes nothing returns nothing
    local force alliedPlayers=GetPlayersAllies(GetTriggerPlayer())
    local location researchPoint=null
    set udg_temp_int=GetPlayerTechCountSimple(GetResearched(), GetTriggerPlayer())
    call ForForce(alliedPlayers, function Trig_Upgrades_level_Func002A)
    set researchPoint=GetUnitLoc(GetTriggerUnit())
    call PingMinimapLocForForceEx(alliedPlayers, researchPoint, 1.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
    call DisplayTextToForce(alliedPlayers, "Research completed for Team " + I2S(udg_teamnumber[GetConvertedPlayerId(GetTriggerPlayer())]))
    call RemoveLocation(researchPoint)
    call DestroyForce(alliedPlayers)
    set researchPoint=null
    set alliedPlayers=null
endfunction

function Trig_player_destroyed_Func003Func001C takes nothing returns boolean
    local group townHalls=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_player_destroyed_Func003Func001Func002001001002))
    local boolean hasTownHall=FirstOfGroup(townHalls) != null
    call DestroyGroup(townHalls)
    set townHalls=null
    return hasTownHall
endfunction
