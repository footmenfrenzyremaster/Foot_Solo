//===========================================================================
// Trigger: player destroyed
//===========================================================================
function Trig_player_destroyed_Conditions takes nothing returns boolean
    local integer playerNumber=GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1
    if not PlayerLifecycle_IsPlayerNumber(playerNumber) then
        return false
    endif
    if PlayerLifecycle_BaseDeathHandled[playerNumber] then
        return false
    endif
    return IsUnitType(GetTriggerUnit(), UNIT_TYPE_TOWNHALL) and GetTriggerUnit() == udg_base[playerNumber]
endfunction

function Trig_player_destroyed_Actions takes nothing returns nothing
    local unit deadBase=GetTriggerUnit()
    local unit killingUnit=GetKillingUnit()
    local integer playerNumber=GetPlayerId(GetOwningPlayer(deadBase)) + 1
    local integer teamNumber=udg_teamnumber[playerNumber]
    set PlayerLifecycle_BaseDeathHandled[playerNumber]=true
    set udg_player_active[playerNumber]=false
    set udg_unit_production[playerNumber]=false
    call ForceRemovePlayerSimple(ConvertedPlayer(playerNumber), udg_Active_PlayGroup)
    call PlayerLifecycle_RemoveControlsForPlayer(playerNumber)
    if killingUnit != null then
        call DisplayTimedTextToForce(udg_all_players, 3.00, GetPlayerName(ConvertedPlayer(playerNumber)) + " has been destroyed by " + GetPlayerName(GetOwningPlayer(killingUnit)))
    else
        call DisplayTimedTextToForce(udg_all_players, 3.00, GetPlayerName(ConvertedPlayer(playerNumber)) + " has been destroyed.")
    endif
    call PlayerLifecycle_KillPlayerUnits(playerNumber)
    call PlayerLifecycle_DistributeGold(playerNumber)
    if not PlayerLifecycle_TeamHasLivingBase(teamNumber) then
        call PlayerLifecycle_RemovePubDefender(teamNumber)
    endif
    set PlayerLifecycle_RemoveBaseControls=false
    call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
    call PlayerLifecycle_EvaluateAllTeams(true)
    set deadBase=null
    set killingUnit=null
endfunction

//===========================================================================
function InitTrig_player_destroyed takes nothing returns nothing
    set gg_trg_player_destroyed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_player_destroyed, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_player_destroyed, Condition(function Trig_player_destroyed_Conditions))
    call TriggerAddAction(gg_trg_player_destroyed, function Trig_player_destroyed_Actions)
endfunction

//===========================================================================
// Trigger: Visibility
//===========================================================================
function Trig_Visibility_Actions takes nothing returns nothing
    local integer teamNumber=1
    loop
        exitwhen teamNumber > 4
        if udg_force_defeat[teamNumber] then
            call PlayerLifecycle_RevealDefeatedTeam(teamNumber)
        endif
        set teamNumber=teamNumber + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Visibility takes nothing returns nothing
    set gg_trg_Visibility=CreateTrigger()
    call TriggerAddAction(gg_trg_Visibility, function Trig_Visibility_Actions)
endfunction

//===========================================================================
// Trigger: END
//===========================================================================
function Trig_END_Actions takes nothing returns nothing
    local integer winnerTeam=0
    local unit killingUnit=GetKillingUnit()
    if not PlayerLifecycle_GameStarted or PlayerLifecycle_GameEnded then
        set killingUnit=null
        return
    endif
    set winnerTeam=PlayerLifecycle_GetWinnerTeam()
    if winnerTeam > 0 then
        call PlayerLifecycle_EndGame(winnerTeam, killingUnit)
    endif
    set killingUnit=null
endfunction

//===========================================================================
function InitTrig_END takes nothing returns nothing
    set gg_trg_END=CreateTrigger()
    call TriggerAddAction(gg_trg_END, function Trig_END_Actions)
endfunction
