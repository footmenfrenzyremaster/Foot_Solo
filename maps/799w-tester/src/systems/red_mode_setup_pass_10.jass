    set gg_trg_Vote_AR_button=CreateTrigger()
    call DisableTrigger(gg_trg_Vote_AR_button)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Vote_AR_button, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Vote_AR_button, Condition(function Trig_Vote_AR_button_Conditions))
    call TriggerAddAction(gg_trg_Vote_AR_button, function Trig_Vote_AR_button_Actions)
