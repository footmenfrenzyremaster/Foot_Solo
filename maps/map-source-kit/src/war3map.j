    call TriggerAddAction(gg_trg_limit_amount_of_creeps, function Trig_limit_amount_of_creeps_Actions)
endfunction

//===========================================================================
// Trigger: phoenix block
//
// CHECK #2 - OK
//===========================================================================
function Trig_phoenix_block_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'hphx' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h00Q' ) ) then
