//===========================================================================
// Trigger: Forked Fury
//===========================================================================
function Trig_Forked_Fury_Func008C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02U') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I03C') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'ratf') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Forked_Fury_Conditions takes nothing returns boolean
    if ( not Trig_Forked_Fury_Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_Forked_Fury_Actions takes nothing returns nothing
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'ratf'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I02U'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I03C'))
    call UnitAddItemByIdSwapped('rat6', GetTriggerUnit())
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
    call DisplayTextToForce(udg_temp_playergroup, ( "You successfully created: " + GetItemName(GetLastCreatedItem()) ))
    call DestroyForce(udg_temp_playergroup)
endfunction

//===========================================================================
function InitTrig_Forked_Fury takes nothing returns nothing
    set gg_trg_Forked_Fury=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Forked_Fury, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_Forked_Fury, Condition(function Trig_Forked_Fury_Conditions))
    call TriggerAddAction(gg_trg_Forked_Fury, function Trig_Forked_Fury_Actions)
endfunction

//===========================================================================
// Trigger: Spawn Unit Is Recycled
//===========================================================================
function Trig_Spawn_Unit_Is_Recycled_Actions takes nothing returns nothing
    // This Event runs whenever the Unit Indexer recycles a unit's custom value!
    // Since Custom Values are recycled we need to make sure that this Boolean gets reset.
    set udg_Is_A_Spawn[udg_UDex]=false
endfunction

//===========================================================================
function InitTrig_Spawn_Unit_Is_Recycled takes nothing returns nothing
    set gg_trg_Spawn_Unit_Is_Recycled=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_Spawn_Unit_Is_Recycled, "udg_UnitIndexEvent", EQUAL, 2.00)
    call TriggerAddAction(gg_trg_Spawn_Unit_Is_Recycled, function Trig_Spawn_Unit_Is_Recycled_Actions)
endfunction

