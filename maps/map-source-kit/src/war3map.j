//===========================================================================
// Trigger: Warlock Vengeance Expire
//===========================================================================
function Trig_Warlock_Vengeance_Expire_Func022C takes nothing returns boolean
    if ( not ( udg_Vengeance_Counter[GetUnitUserData(udg_GST_Unit1)] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Warlock_Vengeance_Expire_Actions takes nothing returns nothing
    set udg_abilitylevel=GetUnitAbilityLevelSwapped('A080', udg_GST_Unit1)
    set udg_vengaence_point[99]=GetUnitLoc(udg_GST_Unit1)
    //                                                                              
    set udg_vengaence_point[100]=GetRandomLocInRect(RectFromCenterSizeBJ(udg_vengaence_point[99], 500.00, 500.00))
    call TerrainDeformationRippleBJ(1.25, false, udg_vengaence_point[100], 200.00, 300.00, 64, 0.50, 50.00)
    //                                                                              
    call AddSpecialEffectLocBJ(udg_vengaence_point[100], "Doodads\\Cinematic\\Lightningbolt\\Lightningbolt.mdl")
    set udg_DDE_Duration=0.75
    call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
    //                                                                              
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_GST_Unit1), udg_vengaence_point[100], bj_UNIT_FACING)
    set udg_DummyNew=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_DummyNew)
    call UnitAddAbilityBJ('A08F', udg_DummyNew)
    call SetUnitAbilityLevelSwapped('A08F', udg_DummyNew, udg_abilitylevel)
    call IssueImmediateOrderBJ(udg_DummyNew, "stomp")
    //                                                                              
    call RemoveLocation(udg_vengaence_point[99])
    call RemoveLocation(udg_vengaence_point[100])
    //                                                                              
    set udg_Vengeance_Counter[GetUnitUserData(udg_GST_Unit1)]=( udg_Vengeance_Counter[GetUnitUserData(udg_GST_Unit1)] + 1 )
    if ( Trig_Warlock_Vengeance_Expire_Func022C() ) then
        call GST_DestroyTimer()
    else
    endif
endfunction

//===========================================================================
function InitTrig_Warlock_Vengeance_Expire takes nothing returns nothing
    set gg_trg_Warlock_Vengeance_Expire=CreateTrigger()
    call TriggerAddAction(gg_trg_Warlock_Vengeance_Expire, function Trig_Warlock_Vengeance_Expire_Actions)
endfunction

//===========================================================================
// Trigger: HERO Wheelchair Warlock Duplicate
//
// CHECK #2 - OK - remove unit!
//===========================================================================
function Trig_HERO_Wheelchair_Warlock_Duplicate_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummonedUnit()) == 'o00V' ) ) then
        return false
    endif
    if ( not ( udg_b1ik[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Wheelchair_Warlock_Duplicate_Actions takes nothing returns nothing
    set udg_temp_unit=GetSummoningUnit()
    set udg_Wheelchair_Duplicate=GetSummonedUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped('A0AM', udg_temp_unit)
    // ability levels
    call SetUnitAbilityLevelSwapped('A0AO', udg_Wheelchair_Duplicate, udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('A0AP', udg_Wheelchair_Duplicate, udg_abilitylevel)
    // unit stats
    call BlzSetUnitMaxHP(udg_Wheelchair_Duplicate, R2I(( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_temp_unit) * 0.75 )))
    call BlzSetUnitMaxMana(udg_Wheelchair_Duplicate, BlzGetUnitMaxMana(udg_temp_unit))
    call SetUnitLifePercentBJ(udg_Wheelchair_Duplicate, 100)
    call SetUnitManaPercentBJ(udg_Wheelchair_Duplicate, 100)
    call BlzSetUnitArmor(udg_Wheelchair_Duplicate, BlzGetUnitArmor(udg_temp_unit))
    call BlzSetUnitBaseDamage(udg_Wheelchair_Duplicate, BlzGetUnitWeaponIntegerField(udg_temp_unit, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0), 0)
    call BlzSetUnitDiceNumber(udg_Wheelchair_Duplicate, 6, 0)
    call BlzSetUnitDiceSides(udg_Wheelchair_Duplicate, 2, 0)
    call BlzSetUnitAttackCooldown(udg_Wheelchair_Duplicate, BlzGetUnitWeaponRealField(udg_temp_unit, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 1), 1)
endfunction

//===========================================================================
function InitTrig_HERO_Wheelchair_Warlock_Duplicate takes nothing returns nothing
    set gg_trg_HERO_Wheelchair_Warlock_Duplicate=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Wheelchair_Warlock_Duplicate, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddCondition(gg_trg_HERO_Wheelchair_Warlock_Duplicate, Condition(function Trig_HERO_Wheelchair_Warlock_Duplicate_Conditions))
    call TriggerAddAction(gg_trg_HERO_Wheelchair_Warlock_Duplicate, function Trig_HERO_Wheelchair_Warlock_Duplicate_Actions)
endfunction

//===========================================================================
// Trigger: HERO Shock Wooj
//===========================================================================
function Trig_HERO_Shock_Wooj_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0QF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shock_Wooj_Func010C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_temp_target, udg_temp_player) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shock_Wooj_Actions takes nothing returns nothing
    // SET BASE VARIABLES
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_target=GetSpellTargetUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    // ACTION TIME
    if ( Trig_HERO_Shock_Wooj_Func010C() ) then
        // TARGET = ENEMY
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0JX', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0JX', udg_dummy, udg_abilitylevel)
        call IssueTargetOrderBJ(udg_dummy, "purge", udg_temp_target)
        call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_dummy)
    else
        // TARGET = FRIEND
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0QE', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0QE', udg_dummy, udg_abilitylevel)
        call IssueTargetOrderBJ(udg_dummy, "purge", udg_temp_target)
        call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_dummy)
    endif
    // CLEANUP TIME
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_HERO_Shock_Wooj takes nothing returns nothing
    set gg_trg_HERO_Shock_Wooj=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Shock_Wooj, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Shock_Wooj, Condition(function Trig_HERO_Shock_Wooj_Conditions))
    call TriggerAddAction(gg_trg_HERO_Shock_Wooj, function Trig_HERO_Shock_Wooj_Actions)
endfunction

