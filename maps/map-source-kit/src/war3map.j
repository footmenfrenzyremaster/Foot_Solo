    set udg_MadWizard=GetTriggerUnit()
    set udg_MadWizard_Player=GetOwningPlayer(udg_MadWizard)
    set udg_MadWizard_Group=GetUnitsOfPlayerMatching(udg_MadWizard_Player, Condition(function Trig_HERO_Mad_Wizard_Bomb_detonate_Func004002002))
    call ForGroupBJ(udg_MadWizard_Group, function Trig_HERO_Mad_Wizard_Bomb_detonate_Func005A)
    call DestroyGroup(udg_MadWizard_Group)
endfunction

//===========================================================================
function InitTrig_HERO_Mad_Wizard_Bomb_detonate takes nothing returns nothing
