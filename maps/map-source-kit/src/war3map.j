//===========================================================================
// Trigger: ITEM packhorse pickup
//===========================================================================
function Trig_ITEM_packhorse_pickup_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'hrdh' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_packhorse_pickup_Func007Func003C takes nothing returns boolean
    if ( not ( R2I(DistanceBetweenPoints(udg_temp_point, udg_temp_point_caster)) <= 200 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_packhorse_pickup_Func007Func004C takes nothing returns boolean
    if ( ( GetItemType(udg_temp_item) == ITEM_TYPE_POWERUP ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_temp_item) == 'tkno' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_temp_item) == 'texp' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_temp_item) == 'tgxp' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_temp_item) == 'rhe2' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_temp_item) == 'tret' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_temp_item) == 'stel' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ITEM_packhorse_pickup_Func007C takes nothing returns boolean
    if ( not Trig_ITEM_packhorse_pickup_Func007Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_packhorse_pickup_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_item=GetOrderTargetItem()
    set udg_temp_point=GetItemLoc(udg_temp_item)
    if ( Trig_ITEM_packhorse_pickup_Func007C() ) then
        call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_temp_unit)), "TRIGSTR_1844")
        call IssuePointOrderLocBJ(udg_temp_unit, "move", udg_temp_point_caster)
        if ( Trig_ITEM_packhorse_pickup_Func007Func003C() ) then
            call RemoveItem(udg_temp_item)
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_ITEM_packhorse_pickup takes nothing returns nothing
    set gg_trg_ITEM_packhorse_pickup=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_packhorse_pickup, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_ITEM_packhorse_pickup, Condition(function Trig_ITEM_packhorse_pickup_Conditions))
    call TriggerAddAction(gg_trg_ITEM_packhorse_pickup, function Trig_ITEM_packhorse_pickup_Actions)
endfunction

