function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Avalanche_SF_Caster_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func003C takes nothing returns boolean
    if ( not ( ModuloInteger(udg_Avalanche_SF_Duration[udg_Avalanche_CV], 10) == 0 ) ) then
