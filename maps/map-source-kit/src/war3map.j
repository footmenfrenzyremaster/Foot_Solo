    return ( IsUnitEnemy(GetFilterUnit(), udg_temp_player) == true )
endfunction

function Trig_HERO_Mad_Wizard_MassHex_Func012A takes nothing returns nothing
    call IssueTargetOrderBJ(udg_DummyNew, "hex", GetEnumUnit())
