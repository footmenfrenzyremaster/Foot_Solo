function InitTrig_UNIT_Tower_of_Terror_Nuke takes nothing returns nothing
    set gg_trg_UNIT_Tower_of_Terror_Nuke=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_UNIT_Tower_of_Terror_Nuke, EVENT_PLAYER_UNIT_SPELL_EFFECT)
