        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func004Func002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h01S' )
endfunction

function Trig_Upgrades_level_Func002Func004Func005A takes nothing returns nothing
    call UnitRemoveAbilityBJ('A05L', GetEnumUnit())
    call UnitAddAbilityBJ('A05L', GetEnumUnit())
    call SetUnitAbilityLevelSwapped(udg_temp_ability, GetEnumUnit(), udg_temp_int)
endfunction

function Trig_Upgrades_level_Func002Func004C takes nothing returns boolean
    if ( not ( GetResearched() == 'R008' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func005Func002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h01S' )
endfunction

function Trig_Upgrades_level_Func002Func005Func005A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped(udg_temp_ability, GetEnumUnit(), udg_temp_int)
endfunction

function Trig_Upgrades_level_Func002Func005C takes nothing returns boolean
    if ( not ( GetResearched() == 'R000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func006Func002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h01S' )
endfunction

function Trig_Upgrades_level_Func002Func006Func004A takes nothing returns nothing
    // one is the actual reg, the other only a picture...
    set udg_temp_ability='ACnr'
    call SetUnitAbilityLevelSwapped(udg_temp_ability, GetEnumUnit(), udg_temp_int)
    set udg_temp_ability='A05K'
    call SetUnitAbilityLevelSwapped(udg_temp_ability, GetEnumUnit(), udg_temp_int)
endfunction

function Trig_Upgrades_level_Func002Func006C takes nothing returns boolean
    if ( not ( GetResearched() == 'R006' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func007Func002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h01S' )
endfunction

function Trig_Upgrades_level_Func002Func007Func005A takes nothing returns nothing
    call UnitRemoveAbilityBJ('A05M', GetEnumUnit())
    call UnitAddAbilityBJ('A05M', GetEnumUnit())
    call SetUnitAbilityLevelSwapped(udg_temp_ability, GetEnumUnit(), udg_temp_int)
endfunction

function Trig_Upgrades_level_Func002Func007C takes nothing returns boolean
    if ( not ( GetResearched() == 'R007' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func009Func004A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_temp_unitgroup)
endfunction

function Trig_Upgrades_level_Func002Func009Func006A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_MAXIMUM_NUMBER_OF_TARGETS, 0, 2)
endfunction

function Trig_Upgrades_level_Func002Func009C takes nothing returns boolean
    if ( not ( GetResearched() == 'R00A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func011C takes nothing returns boolean
    if ( not ( GetResearched() == 'Rhac' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002Func013Func001C takes nothing returns boolean
    if ( ( GetResearched() == 'R002' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R001' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R003' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R005' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Upgrades_level_Func002Func013C takes nothing returns boolean
    if ( not Trig_Upgrades_level_Func002Func013Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrades_level_Func002A takes nothing returns nothing
    // OVERDRIVE
    if ( Trig_Upgrades_level_Func002Func002C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_playernumber=GetConvertedPlayerId(GetEnumPlayer())
        call UnitAddAbilityBJ('A082', udg_base[udg_temp_playernumber])
    else
        call DoNothing()
    endif
    // BASE AURA
    if ( Trig_Upgrades_level_Func002Func004C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func004Func002002002))
        set udg_temp_ability='A05L'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func004Func005A)
    else
        call DoNothing()
    endif
    if ( Trig_Upgrades_level_Func002Func005C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func005Func002002002))
        set udg_temp_ability='A05P'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func005Func005A)
    else
        call DoNothing()
    endif
    if ( Trig_Upgrades_level_Func002Func006C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func006Func002002002))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func006Func004A)
    else
        call DoNothing()
    endif
    if ( Trig_Upgrades_level_Func002Func007C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func007Func002002002))
        set udg_temp_ability='A05M'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func007Func005A)
    else
        call DoNothing()
    endif
    // TOWER UPGRADE
    if ( Trig_Upgrades_level_Func002Func009C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_frostbolt_upgrade_level[udg_teamnumber[GetConvertedPlayerId(GetTriggerPlayer())]]=udg_temp_int
        call ForGroupBJ(GetUnitsOfPlayerAndTypeId(GetEnumPlayer(), 'hgtw'), function Trig_Upgrades_level_Func002Func009Func004A)
        set udg_temp_ability='Awfb'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func009Func006A)
    else
        call DoNothing()
    endif
    // BUILDING UPGRADE
    if ( Trig_Upgrades_level_Func002Func011C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
    else
        call DoNothing()
    endif
    // CREEP UPGRADES
    if ( Trig_Upgrades_level_Func002Func013C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
    else
        call DoNothing()
    endif
    set udg_temp_int=GetPlayerTechCountSimple(GetResearched(), GetTriggerPlayer())
endfunction

function Trig_Upgrades_level_Actions takes nothing returns nothing
    set udg_temp_int=GetPlayerTechCountSimple(GetResearched(), GetTriggerPlayer())
    call ForForce(GetPlayersAllies(GetTriggerPlayer()), function Trig_Upgrades_level_Func002A)
    // MESSAGE TO OTHER PLAYERS
    set udg_temp_point=GetUnitLoc(GetTriggerUnit())
    call PingMinimapLocForForceEx(GetForceOfPlayer(GetEnumPlayer()), udg_temp_point, 1.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
    call RemoveLocation(udg_temp_point)
    set udg_temp_playergroup=GetPlayersAllies(GetTriggerPlayer())
    call DisplayTextToForce(udg_temp_playergroup, ( "Research completed for Team " + I2S(udg_teamnumber[GetConvertedPlayerId(GetTriggerPlayer())]) ))
    call DestroyForce(udg_temp_playergroup)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

//===========================================================================
function InitTrig_Upgrades_level takes nothing returns nothing
    set gg_trg_Upgrades_level=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Upgrades_level, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
