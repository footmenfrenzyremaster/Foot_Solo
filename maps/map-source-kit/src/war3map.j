endfunction

function Trig_Avatar_Loop_Func001A takes nothing returns nothing
    if ( Trig_Avatar_Loop_Func001Func001C() ) then
        call DestroyEffectBJ(udg_Avatar_Sfx_1[GetUnitUserData(GetEnumUnit())])
        //                                                                                                                    
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Avatar_Sfx_Group)
        if ( Trig_Avatar_Loop_Func001Func001Func004C() ) then
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    else
    endif
endfunction

function Trig_Avatar_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Avatar_Sfx_Group, function Trig_Avatar_Loop_Func001A)
endfunction

