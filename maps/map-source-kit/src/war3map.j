//===========================================================================
// Trigger: Mirror Image Cast
//===========================================================================
function Trig_Mirror_Image_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AMIR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mirror_Image_Cast_Func011A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_Mirror_Image_Cast_Actions takes nothing returns nothing
    set udg_MIC_Caster=GetTriggerUnit()
    set udg_MIC_CV=GetUnitUserData(udg_MIC_Caster)
    //                                                                                                                                   
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_MIC_Caster)
    call SetUnitInvulnerable(udg_MIC_Caster, true)
    call SetUnitScalePercent(udg_MIC_Caster, 0.01, 0.01, 0.01)
    set udg_MIC_Illusion_Count[udg_MIC_CV]=0
    call BlzPauseUnitEx(udg_MIC_Caster, true)
    //                                                                                                                                   
    if udg_MIC_Illusions[udg_MIC_CV] != null then
    call ForGroupBJ(udg_MIC_Illusions[udg_MIC_CV], function Trig_Mirror_Image_Cast_Func011A)
    call DestroyGroup(udg_MIC_Illusions[udg_MIC_CV])
    endif
    //                                                                                                                                   
    // Create a new Unit Group:
    set udg_MIC_Illusions[udg_MIC_CV]=CreateGroup()
    //                                                                                                                                   
    set udg_MIC_Point[0]=GetUnitLoc(udg_MIC_Caster)
    call AddSpecialEffectLocBJ(udg_MIC_Point[0], "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
    call BlzSetSpecialEffectYaw(GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(udg_MIC_Caster)))
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_MIC_Point[0])
    //                                                                                                                                   
    set udg_GST_Trigger=gg_trg_Mirror_Image_Create_Illusions
    call GST_Unit(udg_MIC_Caster , false , 0.49)
endfunction

//===========================================================================
function InitTrig_Mirror_Image_Cast takes nothing returns nothing
    set gg_trg_Mirror_Image_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Mirror_Image_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Mirror_Image_Cast, Condition(function Trig_Mirror_Image_Cast_Conditions))
    call TriggerAddAction(gg_trg_Mirror_Image_Cast, function Trig_Mirror_Image_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Mirror Image Create Illusions
//===========================================================================
function Trig_Mirror_Image_Create_Illusions_Actions takes nothing returns nothing
    set udg_MIC_Caster=udg_GST_Unit1
    set udg_MIC_CV=GetUnitUserData(udg_MIC_Caster)
    set udg_MIC_Level=GetUnitAbilityLevelSwapped('AMIR', udg_MIC_Caster)
    //                                                                                                                                   
    set udg_MIC_Point[0]=GetUnitLoc(udg_MIC_Caster)
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_MIC_Caster), udg_MIC_Point[0], bj_UNIT_FACING)
    set udg_MIC_Dummy=GetLastCreatedUnit()
    call RemoveLocation(udg_MIC_Point[0])
    call UnitAddAbilityBJ('AMRD', udg_MIC_Dummy)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_MIC_Dummy)
    set udg_MIC_Caster_Link[GetUnitUserData(udg_MIC_Dummy)]=udg_MIC_Caster
    //                                                                                                                                   
    // Create X illusions:
    set udg_MIC_Loop=1
    loop
        exitwhen udg_MIC_Loop > udg_MIC_Level
        call IssueTargetOrderById(udg_MIC_Dummy, 852274, udg_MIC_Caster)
        set udg_MIC_Loop=udg_MIC_Loop + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Mirror_Image_Create_Illusions takes nothing returns nothing
    set gg_trg_Mirror_Image_Create_Illusions=CreateTrigger()
    call TriggerAddAction(gg_trg_Mirror_Image_Create_Illusions, function Trig_Mirror_Image_Create_Illusions_Actions)
endfunction

//===========================================================================
// Trigger: Mirror Image Finish
//===========================================================================
function Trig_Mirror_Image_Finish_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummoningUnit()) == 'umir' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mirror_Image_Finish_Func011Func015A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Mirror_Image_Finish_Func011C takes nothing returns boolean
    if ( not ( udg_MIC_Illusion_Count[udg_MIC_CV] == udg_MIC_Level ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mirror_Image_Finish_Actions takes nothing returns nothing
    set udg_MIC_Caster=udg_MIC_Caster_Link[GetUnitUserData(GetSummoningUnit())]
    set udg_MIC_CV=GetUnitUserData(udg_MIC_Caster)
    set udg_MIC_Level=GetUnitAbilityLevelSwapped('AMIR', udg_MIC_Caster)
    //                                                                                                                                   
    call GroupAddUnitSimple(GetSummonedUnit(), udg_MIC_Illusions[udg_MIC_CV])
    call ShowUnitHide(GetSummonedUnit())
    //                                                                                                                                   
    set udg_MIC_Illusion_Count[udg_MIC_CV]=( udg_MIC_Illusion_Count[udg_MIC_CV] + 1 )
    if ( Trig_Mirror_Image_Finish_Func011C() ) then
        call SetUnitInvulnerable(udg_MIC_Caster, false)
        call SetUnitScalePercent(udg_MIC_Caster, 100.00, 100.00, 100.00)
        call BlzPauseUnitEx(udg_MIC_Caster, false)
        //                                                                                                                                   
        set udg_MIC_Point[0]=GetUnitLoc(udg_MIC_Caster)
        //                                                                                                                                   
        set udg_MIC_Angle=GetRandomDirectionDeg()
        set udg_MIC_Loop=1
        loop
            exitwhen udg_MIC_Loop > ( udg_MIC_Level + 1 )
            set udg_MIC_Point[udg_MIC_Loop]=PolarProjectionBJ(udg_MIC_Point[0], 150.00, ( GetUnitFacing(udg_MIC_Caster) + udg_MIC_Angle ))
            set udg_MIC_Angle=( udg_MIC_Angle + 90.00 )
            set udg_MIC_Loop=udg_MIC_Loop + 1
        endloop
        //                                                                                                                                   
        set udg_MIC_Illusions[0]=CreateGroup()
        call GroupAddGroup(udg_MIC_Illusions[udg_MIC_CV], udg_MIC_Illusions[0])
        call GroupAddUnitSimple(udg_MIC_Caster, udg_MIC_Illusions[0])
        set udg_MIC_Loop=1
        loop
            exitwhen udg_MIC_Loop > ( udg_MIC_Level + 1 )
            set udg_MIC_Caster=GroupPickRandomUnit(udg_MIC_Illusions[0])
            call GroupRemoveUnitSimple(udg_MIC_Caster, udg_MIC_Illusions[0])
            call SetUnitPositionLoc(udg_MIC_Caster, udg_MIC_Point[udg_MIC_Loop])
            //                                                                                                     
            // Missile Properties:
            set udg_MissileSource=udg_MIC_Caster
            set udg_MissileStart=OffsetLocation(udg_MIC_Point[0], 0, 0)
            set udg_MissileFinish=udg_MIC_Point[udg_MIC_Loop]
            set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
            set udg_MissileModel="Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageMissile.mdl"
            set udg_MissileScale=1.00
            set udg_MissileSpeed=1200.00
            // Launch Missile:
            call TriggerExecute(gg_trg_MissileCreate)
            //                                                                                                     
            call RemoveLocation(udg_MIC_Point[udg_MIC_Loop])
            set udg_MIC_Loop=udg_MIC_Loop + 1
        endloop
        //                                                                                                                                   
        call ForGroupBJ(udg_MIC_Illusions[udg_MIC_CV], function Trig_Mirror_Image_Finish_Func011Func015A)
        //                                                                                                                                   
        call RemoveLocation(udg_MIC_Point[0])
        call DestroyGroup(udg_MIC_Illusions[0])
    else
    endif
endfunction

