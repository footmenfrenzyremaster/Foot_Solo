    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[4])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[5])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[6])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[7])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[8])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[9])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Guardian_Purification_Nova_Explode, udg_timer_purificationNova[10])
