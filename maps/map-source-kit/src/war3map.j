    return true
endfunction

function Trig_Upgrade_after_Actions takes nothing returns nothing
    set udg_temp_int=GetConvertedPlayerId(GetTriggerPlayer())
    call BlzSetUnitWeaponIntegerFieldBJ(GetTriggerUnit(), UNIT_WEAPON_IF_ATTACK_MAXIMUM_NUMBER_OF_TARGETS, 0, 2)
    if ( Trig_Upgrade_after_Func004C() ) then
        call DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), ( "TRIGGER, UNIT: " + GetUnitName(GetTriggerUnit()) ))
        call DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), ( "LEVEL: " + I2S(udg_frostbolt_upgrade_level[udg_teamnumber[udg_temp_int]]) ))
