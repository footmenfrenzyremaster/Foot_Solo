function Trig_Start_SD_Func025Func001Func001Func001C takes nothing returns boolean
    if ( not ( udg_hero_category[udg_X] == udg_temp_int ) ) then
        return false
    endif
    return true
endfunction

function Trig_Start_SD_Func025Func001A takes nothing returns nothing
    set udg_temp_int=1
    loop
        exitwhen udg_temp_int > udg_numberofSDcategories
        if ( Trig_Start_SD_Func025Func001Func001Func001C() ) then
            call GroupAddUnitSimple(GetEnumUnit(), udg_hero_category_group[udg_temp_int])
        else
            call DoNothing()
        endif
        set udg_temp_int=udg_temp_int + 1
    endloop
endfunction

function Trig_Start_SD_Func038Func006Func002Func002C takes nothing returns boolean
    if ( not ( udg_X_category == 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Start_SD_Func038Func006Func002Func003C takes nothing returns boolean
    if ( not ( udg_X_category == 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Start_SD_Func038Func006Func002Func004C takes nothing returns boolean
    if ( not ( udg_X_category == 11 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Start_SD_Func038Func006Func002A takes nothing returns nothing
    call AddUnitToStockBJ(GetUnitTypeId(GetEnumUnit()), udg_real_shop[udg_deal_shop], 1, 1)
    if ( Trig_Start_SD_Func038Func006Func002Func002C() ) then
        set udg_carryhero[udg_deal_shop]=GetUnitTypeId(GetEnumUnit())
    else
        call DoNothing()
    endif
    if ( Trig_Start_SD_Func038Func006Func002Func003C() ) then
        set udg_carryhero2[udg_deal_shop]=GetUnitTypeId(GetEnumUnit())
    else
        call DoNothing()
    endif
    if ( Trig_Start_SD_Func038Func006Func002Func004C() ) then
        set udg_carryhero3[udg_deal_shop]=GetUnitTypeId(GetEnumUnit())
    else
        call DoNothing()
    endif
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_hero_category_group[udg_X_category])
endfunction

function Trig_Start_SD_Func040A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Start_SD_Actions takes nothing returns nothing
    set udg_Host_Picked_A_Game_Mode=true
    //                                                                                                                                     
    call EnableTrigger(gg_trg_swap_command)
    call EnableTrigger(gg_trg_swap_execute)
    set udg_selected_mode=3
    set udg_game_mode_display[3]=" SD"
    call DisplayTextToForce(udg_all_players, "TRIGSTR_6009")
    call DisplayTextToForce(udg_all_players, "TRIGSTR_6693")
    call EnableSelect(true, true)
    call TimerDialogDisplayBJ(false, udg_timer_window_voting)
    call StartTimerBJ(udg_timer_repick, false, 220.00)
    call CreateTimerDialogBJ(udg_timer_repick, "TRIGSTR_13432")
    set udg_timer_window_repick=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_timer_window_repick)
    // VISIBILITY
    set udg_X=1
    loop
        exitwhen udg_X > 12
        call FogModifierStop(udg_Tavern_Visibility[udg_X])
        set udg_X=udg_X + 1
    endloop
    call ForForce(udg_team[1], function Trig_Start_SD_Func017A)
    call ForForce(udg_team[2], function Trig_Start_SD_Func018A)
    call ForForce(udg_team[3], function Trig_Start_SD_Func019A)
    call ForForce(udg_team[4], function Trig_Start_SD_Func020A)
    // ADD HEROS INTO TAVERNS
    set udg_RNG_Burn=ModuloInteger(R2I(( 1000.00 * TimerGetElapsed(udg_EntropyTimer) )), 200)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_RNG_Burn
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_RNG_junk=GetRandomInt(1, 1000)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set udg_X_category=1
    loop
        exitwhen udg_X_category > udg_numberofSDcategories
        set udg_hero_category_group[udg_X_category]=CreateGroup()
        set udg_X_category=udg_X_category + 1
    endloop
    set udg_X=1
    loop
        exitwhen udg_X > udg_total_hero_count
        call ForGroupBJ(GetUnitsOfTypeIdAll(udg_hero_type[udg_X]), function Trig_Start_SD_Func025Func001A)
        set udg_X=udg_X + 1
    endloop
    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, I2S(udg_total_hero_count))
    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, I2S(udg_numberofSDcategories))
    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, I2S(CountUnitsInGroup(udg_hero_category_group[1])))
    // Real Shops
    call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[1], 130.00)
    set udg_real_shop[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[2], 130.00)
    set udg_real_shop[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[3], 310.00)
    set udg_real_shop[3]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[4], 310.00)
    set udg_real_shop[4]=GetLastCreatedUnit()
    set udg_X_category=1
    loop
        exitwhen udg_X_category > udg_numberofSDcategories
        set udg_shop_order[1]=1
        set udg_shop_order[2]=2
        set udg_shop_order[3]=3
        set udg_shop_order[4]=4
        set udg_shuffle_i=1
        loop
            exitwhen udg_shuffle_i > 4
            set udg_shuffle_roll=GetRandomInt(udg_shuffle_i, 4)
            set udg_shuffle_swap=udg_shop_order[udg_shuffle_i]
            set udg_shop_order[udg_shuffle_i]=udg_shop_order[udg_shuffle_roll]
            set udg_shop_order[udg_shuffle_roll]=udg_shuffle_swap
            set udg_shuffle_i=udg_shuffle_i + 1
        endloop
        set udg_deal_index=1
        loop
            exitwhen udg_deal_index > 4
            set udg_deal_shop=udg_shop_order[udg_deal_index]
            call ForGroupBJ(GetRandomSubGroup(1, udg_hero_category_group[udg_X_category]), function Trig_Start_SD_Func038Func006Func002A)
            set udg_deal_index=udg_deal_index + 1
        endloop
        set udg_X_category=udg_X_category + 1
    endloop
    set udg_temp_unitgroup=GetUnitsInRectOfPlayer(gg_rct_ALL_HERO, Player(PLAYER_NEUTRAL_PASSIVE))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_SD_Func040A)
    call DestroyGroup(udg_temp_unitgroup)
    set udg_X=1
    loop
        exitwhen udg_X > udg_numberofSDcategories
        call DestroyGroup(udg_hero_category_group[udg_X])
        set udg_X=udg_X + 1
    endloop
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyGroup(udg_temp_unitgroup2)
    call DestroyGroup(udg_temp_unitgroup3)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

