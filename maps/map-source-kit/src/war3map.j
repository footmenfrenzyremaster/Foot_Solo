function InitTrig_Mirror_Image_Finish takes nothing returns nothing
    set gg_trg_Mirror_Image_Finish=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Mirror_Image_Finish, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddCondition(gg_trg_Mirror_Image_Finish, Condition(function Trig_Mirror_Image_Finish_Conditions))
    call TriggerAddAction(gg_trg_Mirror_Image_Finish, function Trig_Mirror_Image_Finish_Actions)
endfunction

