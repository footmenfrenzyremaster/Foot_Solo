    if ( not ( GetSpellAbilityId() == 'A0W3' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func010C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0W5' ) ) then
        return false
    endif
    return true
endfunction

