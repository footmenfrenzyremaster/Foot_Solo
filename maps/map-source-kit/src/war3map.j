    endif
    return true
endfunction

function Trig_TP_hero_Func005Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitSelected(GetEnumUnit(), ConvertedPlayer(udg_temp_playernumber)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TP_hero_Func005Func004A takes nothing returns nothing
    if ( Trig_TP_hero_Func005Func004Func001C() ) then
        set udg_mh_cnt[udg_temp_playernumber]=( udg_mh_cnt[udg_temp_playernumber] + 1 )
    else
        set udg_mh_cnt[udg_temp_playernumber]=( udg_mh_cnt[udg_temp_playernumber] + 0 )
    endif
endfunction

function Trig_TP_hero_Func005Func012C takes nothing returns boolean
    if ( not ( udg_mode_inhouse == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TP_hero_Func005Func018Func001Func003C takes nothing returns boolean
    if ( not ( udg_hero_category[udg_X] >= 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TP_hero_Func005Func018Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_temp_unit) == udg_hero_type[udg_X] ) ) then
        return false
    endif
    return true
endfunction

function Trig_TP_hero_Func005C takes nothing returns boolean
    if ( not ( udg_tp_kill[udg_temp_playernumber] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TP_hero_Func010001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_herO[udg_X]) == 'H00U' )
endfunction

function Trig_TP_hero_Func011001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_herO[udg_X]) == 'H00T' )
endfunction

function Trig_TP_hero_Func012001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_herO[udg_X]) == 'E00V' )
endfunction

function Trig_TP_hero_Func013001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_herO[udg_X]) == 'N00O' )
endfunction

function Trig_TP_hero_Func014001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_herO[udg_X]) == 'E00O' )
endfunction

function Trig_TP_hero_Func015001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_herO[udg_X]) == 'N00N' )
endfunction

function Trig_TP_hero_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point=GetPlayerStartLocationLoc(GetOwningPlayer(udg_temp_unit))
    // TP HERO
    if ( Trig_TP_hero_Func005C() ) then
        set udg_tp_kill[udg_temp_playernumber]=true
        set udg_herO[udg_temp_playernumber]=udg_temp_unit
        call ForGroupBJ(udg_realshops, function Trig_TP_hero_Func005Func004A)
        call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
        // Starting Items
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
        call UnitAddItemByIdSwapped('pinv', udg_temp_unit)
        call UnitAddItemByIdSwapped('hslv', udg_temp_unit)
        if ( Trig_TP_hero_Func005Func012C() ) then
            call UnitAddItemByIdSwapped('I01C', udg_temp_unit)
        else
            call DoNothing()
        endif
        call PanCameraToTimedLocForPlayer(ConvertedPlayer(udg_temp_playernumber), udg_temp_point, 1.00)
        call zoom_RestoreFromCacheForPlayer(Player(udg_temp_playernumber - 1))
        call SetPlayerName(ConvertedPlayer(udg_temp_playernumber), ( ( "(" + ( GetUnitName(udg_temp_unit) + ") " ) ) + udg_orig_player_name[udg_temp_playernumber] ))
        set udg_coloured_playername[udg_temp_playernumber]=( udg_colour[udg_temp_playernumber] + ( GetPlayerName(ConvertedPlayer(udg_temp_playernumber)) + "|r" ) )
        // Assign Hero #
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            if ( Trig_TP_hero_Func005Func018Func001C() ) then
                set udg_picked_hero[udg_temp_playernumber]=udg_X
                // SD only 1x carry
                if ( Trig_TP_hero_Func005Func018Func001Func003C() ) then
                    call AddUnitToStockBJ(udg_carryhero[udg_teamnumber[udg_temp_playernumber]], udg_real_shop[udg_teamnumber[udg_temp_playernumber]], 0, 0)
                    call AddUnitToStockBJ(udg_carryhero2[udg_teamnumber[udg_temp_playernumber]], udg_real_shop[udg_teamnumber[udg_temp_playernumber]], 0, 0)
                    call AddUnitToStockBJ(udg_carryhero3[udg_teamnumber[udg_temp_playernumber]], udg_real_shop[udg_teamnumber[udg_temp_playernumber]], 0, 0)
                else
                    call DoNothing()
                endif
                // set hero stats
                call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_STRENGTH, R2I(udg_hero_STR_base[udg_X]))
                call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_AGILITY, R2I(udg_hero_AGI_base[udg_X]))
                call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_INTELLIGENCE, R2I(udg_hero_INT_base[udg_X]))
                call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[udg_X])
                call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[udg_X])
                call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[udg_X])
                call SetUnitMoveSpeed(udg_temp_unit, udg_hero_move_base[udg_X])
                call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_TURN_RATE, udg_hero_turnrate[udg_X])
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        if ( Trig_TP_hero_Func005Func001C() ) then
            call RemoveUnit(udg_temp_unit)
        else
            call DoNothing()
        endif
    endif
    call ConditionalTriggerExecute(gg_trg_admin_level)
    set udg_X=udg_temp_playernumber
    set udg_temp_level=1
    set udg_hero_bounty_multiplier=1.00
    if ( (GetUnitTypeId(udg_herO[udg_X]) == 'H00U') ) then // INLINED!!
        set udg_hero_bounty_multiplier=0.50
    else
        call DoNothing()
    endif
    if ( (GetUnitTypeId(udg_herO[udg_X]) == 'H00T') ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.50
    else
        call DoNothing()
    endif
    if ( (GetUnitTypeId(udg_herO[udg_X]) == 'E00V') ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.10
    else
        call DoNothing()
    endif
    if ( (GetUnitTypeId(udg_herO[udg_X]) == 'N00O') ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.10
    else
        call DoNothing()
    endif
    if ( (GetUnitTypeId(udg_herO[udg_X]) == 'E00O') ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.25
    else
        call DoNothing()
    endif
    if ( (GetUnitTypeId(udg_herO[udg_X]) == 'N00N') ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.00
    else
        call DoNothing()
    endif
    set udg_temp_real=( I2R(udg_hero_bounty_base[udg_temp_level]) * udg_hero_bounty_multiplier )
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_temp_real))
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, 0)
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, 0)
    call RemoveLocation(udg_temp_point)
endfunction

