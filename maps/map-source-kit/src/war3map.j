    set gg_trg_MH_hide_fake_shop_rat=CreateTrigger()
    call DisableTrigger(gg_trg_MH_hide_fake_shop_rat)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MH_hide_fake_shop_rat, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MH_hide_fake_shop_rat, Condition(function Trig_MH_hide_fake_shop_rat_Conditions))
    call TriggerAddAction(gg_trg_MH_hide_fake_shop_rat, function Trig_MH_hide_fake_shop_rat_Actions)
endfunction

