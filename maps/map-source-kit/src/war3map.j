// Trigger: HERO Mass Roots
//
// CHECK #2 - OK - remove unit!
//===========================================================================
function Trig_HERO_Mass_Roots_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A06O' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0B1' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A09K' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A03W' ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Mass_Roots_Conditions takes nothing returns boolean
    if ( not ( udg_b1ik[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    if ( not Trig_HERO_Mass_Roots_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Mass_Roots_Func008002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), udg_temp_player) == true )
endfunction

function Trig_HERO_Mass_Roots_Func011C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Mass_Roots_Func013A takes nothing returns nothing
    call IssueTargetOrderBJ(udg_DummyNew, "entanglingroots", GetEnumUnit())
endfunction

function Trig_HERO_Mass_Roots_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE=BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_temp_unit, GetSpellAbilityId()), ABILITY_RLF_FINAL_AREA_OEQ4, ( udg_abilitylevel - 1 ))
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_Mass_Roots_Func008002003))
    call CreateNUnitsAtLoc(1, 'dmmy', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_DummyNew=GetLastCreatedUnit()
    if ( Trig_HERO_Mass_Roots_Func011C() ) then
        call UnitAddAbilityBJ('A04E', udg_DummyNew)
        call SetUnitAbilityLevelSwapped('A04E', udg_DummyNew, udg_abilitylevel)
    else
        call UnitAddAbilityBJ('A06P', udg_DummyNew)
        call SetUnitAbilityLevelSwapped('A06P', udg_DummyNew, udg_abilitylevel)
    endif
    call UnitApplyTimedLifeBJ(15.00, 'BTLF', udg_DummyNew)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Mass_Roots_Func013A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

//===========================================================================
function InitTrig_HERO_Mass_Roots takes nothing returns nothing
    set gg_trg_HERO_Mass_Roots=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Mass_Roots, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Mass_Roots, Condition(function Trig_HERO_Mass_Roots_Conditions))
    call TriggerAddAction(gg_trg_HERO_Mass_Roots, function Trig_HERO_Mass_Roots_Actions)
endfunction

