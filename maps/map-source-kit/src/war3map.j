        return false
    endif
    return true
endfunction

function Trig_HERO_Zeus_Shock_Damage_Actions takes nothing returns nothing
    set udg_Zeus_Shock_Damage[1]=100.00
    set udg_Zeus_Shock_Damage[2]=200.00
    set udg_Zeus_Shock_Damage[3]=260.00
    set udg_Zeus_Shock_Damage[4]=330.00
    set udg_Zeus_Shock_Damage[5]=420.00
    set udg_Zeus_Shock_Damage[6]=500.00
    call UnitDamageTargetBJ(GetTriggerUnit(), GetSpellTargetUnit(), udg_Zeus_Shock_Damage[GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
