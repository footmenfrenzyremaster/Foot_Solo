function Trig_GM_execute_Func003C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_btn_guided_1[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function Trig_GM_execute_Func004C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_btn_guided_2[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function Trig_GM_execute_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_playergroup=GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber))
    if ( Trig_GM_execute_Func003C() ) then
        set udg_guided[udg_temp_playernumber]=true
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1114")
    else
        call DoNothing()
    endif
    if ( Trig_GM_execute_Func004C() ) then
        set udg_guided[udg_temp_playernumber]=false
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1115")
    else
        call DoNothing()
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

