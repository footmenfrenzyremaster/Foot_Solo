    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I01S') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'rst1') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'clfm') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Cloak_Conditions takes nothing returns boolean
    if ( not Trig_Chaos_Cloak_Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Cloak_Actions takes nothing returns nothing
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I01S'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'rst1'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'clfm'))
    call UnitAddItemByIdSwapped('I01R', GetTriggerUnit())
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
    call DisplayTextToForce(udg_temp_playergroup, ( "You successfully created: " + GetItemName(GetLastCreatedItem()) ))
    call DestroyForce(udg_temp_playergroup)
endfunction

//===========================================================================
function InitTrig_Chaos_Cloak takes nothing returns nothing
    set gg_trg_Chaos_Cloak=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Chaos_Cloak, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_Chaos_Cloak, Condition(function Trig_Chaos_Cloak_Conditions))
    call TriggerAddAction(gg_trg_Chaos_Cloak, function Trig_Chaos_Cloak_Actions)
endfunction

