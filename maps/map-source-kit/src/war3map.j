        return false
    endif
    return true
endfunction

function Trig_swap_command_Func001Func006002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_swap_command_Func001Func007002002 takes nothing returns boolean
