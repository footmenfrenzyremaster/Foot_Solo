    return ( IsUnitAlly(GetFilterUnit(), udg_temp_player) == true )
endfunction

function Trig_ITEM_Scroll_of_Frenzy_Func008Func001Func001C takes nothing returns boolean
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_ITEM_Scroll_of_Frenzy_Func008Func001C takes nothing returns boolean
    if ( not Trig_ITEM_Scroll_of_Frenzy_Func008Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Scroll_of_Frenzy_Func008A takes nothing returns nothing
    if ( Trig_ITEM_Scroll_of_Frenzy_Func008Func001C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_temp_unitgroup)
    else
    endif
endfunction

function Trig_ITEM_Scroll_of_Frenzy_Func011C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Scroll_of_Frenzy_Func013A takes nothing returns nothing
    call UnitAddAbilityBJ('A0LS', GetEnumUnit())
    call SetUnitAbilityLevelSwapped('A0LS', GetEnumUnit(), 1)
    call IssueImmediateOrderBJ(GetEnumUnit(), "berserk")
    call UnitRemoveAbilityBJ('A0LS', GetEnumUnit())
endfunction

function Trig_ITEM_Scroll_of_Frenzy_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE=1000.00
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_ITEM_Scroll_of_Frenzy_Func006002003))
    call BlzStartUnitAbilityCooldown(udg_temp_unit, 'A07C', 25.00)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_ITEM_Scroll_of_Frenzy_Func008A)
    call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    if ( Trig_ITEM_Scroll_of_Frenzy_Func011C() ) then
        call UnitAddItemByIdSwapped('I01U', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01U'))
    else
        call DoNothing()
    endif
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_ITEM_Scroll_of_Frenzy_Func013A)
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I02P'))
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

