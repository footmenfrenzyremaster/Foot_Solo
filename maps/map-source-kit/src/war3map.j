function Trig_TheNook_Hellseek_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AHES' ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Cast_Actions takes nothing returns nothing
    set udg_TheNook=GetTriggerUnit()
    set udg_TheNook_CV=GetUnitUserData(udg_TheNook)
    //                                                                                                                    
    set udg_TheNook_HK_Duration[udg_TheNook_CV]=0
    set udg_TheNook_HK_Point[udg_TheNook_CV]=GetUnitLoc(GetSpellTargetUnit())
    set udg_TheNook_HK_Target[udg_TheNook_CV]=GetSpellTargetUnit()
    //                                                                                                                    
    call GroupAddUnitSimple(udg_TheNook, udg_TheNook_HK_Group)
    call EnableTrigger(gg_trg_TheNook_Hellseek_Loop)
endfunction

