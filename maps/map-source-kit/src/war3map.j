        if ( Trig_autopool_command_Func004Func006C() ) then
            call DialogAddButtonBJ(udg_dlg_pool[udg_temp_playernumber], GetPlayerName(udg_ally2[udg_temp_playernumber]))
            set udg_dlg_btn_pool_2[udg_temp_playernumber]=GetLastCreatedButtonBJ()
