function Trig_HERO_Blooddancer_Bloodrush_periodic_Func001Func001Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_herO[udg_X], 'B00O') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Blooddancer_Bloodrush_periodic_Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_herO[udg_X]) == 'O00G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Blooddancer_Bloodrush_periodic_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Blooddancer_Bloodrush_periodic_Func001Func001C() ) then
            if ( Trig_HERO_Blooddancer_Bloodrush_periodic_Func001Func001Func002C() ) then
                set udg_abilitylevel=GetUnitAbilityLevelSwapped('A07X', udg_herO[udg_X])
                call UnitAddAbilityBJ('A068', udg_herO[udg_X])
                call SetUnitAbilityLevelSwapped('A068', udg_herO[udg_X], udg_abilitylevel)
            else
                call UnitRemoveAbilityBJ('A068', udg_herO[udg_X])
                call EnableTrigger(GetTriggeringTrigger())
            endif
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

