    if ( GetBooleanAnd((IsUnitType(udg_SW_HitUnit, UNIT_TYPE_FLYING) == udg_SW_AffectAir[udg_SW_Loop]), (udg_SW_AffectAir[udg_SW_Loop] == true)) ) then // INLINED!!
