function Trig_KOTH_Second_Hill_Actions takes nothing returns nothing
    // THIS TIMER IS STARTED IN: Game mode/King Of The Hill/KOTH Setup
    //                                                                                                     
    // Update the second hill gold:
    set udg_KOTH_Level=3
    set udg_KOTH_HP=900
    set udg_KOTH_Gold_Starting_Total=99999
    set udg_KOTH_Gold_Remaining=udg_KOTH_Gold_Starting_Total
    set udg_KOTH_Gold_Half_Remaining=( udg_KOTH_Gold_Starting_Total / 2 )
    set udg_KOTH_Gold_Division_Bonus=1
    set udg_KOTH_Gold_Bounty=28
    set udg_KOTH_Gold_Rewarded=9
    if ( Trig_KOTH_Second_Hill_Func012C() ) then
        set udg_KOTH_Gold_Rewarded=18
    else
    endif
    //                                                                                                     
    call DisplayTimedTextToForce(GetPlayersAll(), 4.00, "TRIGSTR_6706")
    //                                                                                                     
    // Reset the hill (creates a new second hill using the new gold values):
    set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
    call TriggerExecute(gg_trg_KOTH_Reset_Hill)
endfunction

