        call DialogAddButtonBJ(udg_dlg_pool[udg_temp_playernumber], "TRIGSTR_1683")
        set udg_dlg_btn_pool_3[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogAddButtonBJ(udg_dlg_pool[udg_temp_playernumber], "TRIGSTR_1684")
        set udg_dlg_btn_pool_cancel[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogDisplayBJ(true, udg_dlg_pool[udg_temp_playernumber], GetTriggerPlayer())
    else
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1681")
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

