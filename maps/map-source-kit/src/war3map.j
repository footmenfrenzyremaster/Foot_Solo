function Trig_eight_mass_bonus_Func007Func003C takes nothing returns boolean
    if ( not ( udg_unit_production[udg_X_playernumber] == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_base[udg_X_playernumber]) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_base[udg_X_playernumber]) == udg_base_type[udg_X_base] ) ) then
        return false
    endif
    if ( not ( CountLivingPlayerUnitsOfTypeId(udg_spawn_unit[udg_X_base], ConvertedPlayer(udg_X_playernumber)) <= udg_maxunitnumber ) ) then
        return false
    endif
    return true
endfunction

