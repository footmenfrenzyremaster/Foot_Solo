    set udg_temp_playernumber=S2I(SubStringBJ(GetEventPlayerChatString(), 6, 8))
    set udg_temp_int=S2I(SubStringBJ(GetEventPlayerChatString(), 9, 11))
    if ( Trig_summon_hero_for_player_Func005C() ) then
        call CreateNUnitsAtLoc(1, udg_hero_type[udg_temp_int], ConvertedPlayer(udg_temp_playernumber), udg_loc_tavern, bj_UNIT_FACING)
    else
        call DoNothing()
