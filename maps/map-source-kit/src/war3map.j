function Trig_set_hero_bounty_update_Actions takes nothing returns nothing
    // Just in case these values aren't applied let's apply them later on
    set udg_X=1
    loop
        exitwhen udg_X > 12
        set udg_BountyHero=udg_herO[udg_X]
        set udg_temp_level=GetHeroLevel(udg_BountyHero)
        set udg_hero_bounty_multiplier=1.00
        if ( (GetUnitTypeId(udg_BountyHero) == 'H00U') ) then // INLINED!!
            set udg_hero_bounty_multiplier=0.50
        else
            call DoNothing()
        endif
        if ( (GetUnitTypeId(udg_BountyHero) == 'N00O') ) then // INLINED!!
            set udg_hero_bounty_multiplier=1.25
        else
            call DoNothing()
        endif
        if ( (GetUnitTypeId(udg_BountyHero) == 'H00T') ) then // INLINED!!
            set udg_hero_bounty_multiplier=1.50
        else
            call DoNothing()
        endif
        if ( (GetUnitTypeId(udg_BountyHero) == 'E00V') ) then // INLINED!!
            set udg_hero_bounty_multiplier=1.10
        else
            call DoNothing()
        endif
        set udg_temp_real=( I2R(udg_hero_bounty_base[udg_temp_level]) * udg_hero_bounty_multiplier )
        call BlzSetUnitIntegerFieldBJ(udg_BountyHero, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_temp_real))
        call BlzSetUnitIntegerFieldBJ(udg_BountyHero, UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, 0)
        call BlzSetUnitIntegerFieldBJ(udg_BountyHero, UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, 0)
        set udg_X=udg_X + 1
    endloop
endfunction

