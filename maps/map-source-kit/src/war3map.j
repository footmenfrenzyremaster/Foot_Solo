function InitTrig_Kill_units_of_inactive_player takes nothing returns nothing
    set gg_trg_Kill_units_of_inactive_player=CreateTrigger()
    call DisableTrigger(gg_trg_Kill_units_of_inactive_player)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Kill_units_of_inactive_player, 1.00)
    call TriggerAddAction(gg_trg_Kill_units_of_inactive_player, function Trig_Kill_units_of_inactive_player_Actions)
endfunction

