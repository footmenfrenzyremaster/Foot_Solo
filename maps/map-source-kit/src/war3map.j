            call TriggerSleepAction(17.25)
            call s__File_close(s__File_write(s__File_open("wc3mt.txt"),"wc3mt-GameEnd"))
            call ForForce(udg_team[1], function Trig_END_Func001Func009Func039A)
            call ForForce(udg_team[2], function Trig_END_Func001Func009Func040A)
            call ForForce(udg_team[3], function Trig_END_Func001Func009Func041A)
            call ForForce(udg_team[4], function Trig_END_Func001Func009Func042A)
            call ForForce(udg_team[5], function Trig_END_Func001Func009Func043A)
