function Trig_Start_AP_Actions takes nothing returns nothing
    set udg_Host_Picked_A_Game_Mode=true
    //                                                                                                                                     
    set udg_temp_unitgroup2=GetUnitsInRectOfPlayer(gg_rct_EXILE_OLD, Player(PLAYER_NEUTRAL_PASSIVE))
    set udg_temp_unitgroup3=GetUnitsInRectOfPlayer(gg_rct_EXILE_NEW, Player(PLAYER_NEUTRAL_PASSIVE))
    // MOVE HEROS
    if ( Trig_Start_AP_Func006C() ) then
        call ForGroupBJ(udg_temp_unitgroup2, function Trig_Start_AP_Func006Func003A)
        call ForGroupBJ(udg_temp_unitgroup3, function Trig_Start_AP_Func006Func004A)
    else
        call ForGroupBJ(udg_temp_unitgroup2, function Trig_Start_AP_Func006Func001A)
        call ForGroupBJ(udg_temp_unitgroup3, function Trig_Start_AP_Func006Func002A)
    endif
    call RemoveLocation(udg_temp_point)
    set udg_selected_mode=2
    set udg_game_mode_display[3]=" AP"
    call TimerDialogDisplayBJ(false, udg_timer_window_voting)
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_11525")
    // START REPICK TIMER
    call StartTimerBJ(udg_timer_repick, false, 150.00)
    call CreateTimerDialogBJ(udg_timer_repick, "TRIGSTR_11528")
    set udg_timer_window_repick=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_timer_window_repick)
    call EnableTrigger(gg_trg_repick_command)
    // ########### WONKY MODES
    if ( Trig_Start_AP_Func019C() ) then
        call DisplayTextToForce(udg_all_players, "TRIGSTR_11543")
        call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + " has selected to play the Madness Mode!|r" ))
    else
        call DoNothing()
    endif
    if ( Trig_Start_AP_Func020C() ) then
        set udg_ap_number_of_heros=2
    else
        call DoNothing()
    endif
    // Real Shops
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[1], 130.00)
    set udg_real_shop[13]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[2], 130.00)
    set udg_real_shop[14]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[3], 130.00)
    set udg_real_shop[15]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[4], 130.00)
    set udg_real_shop[16]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[5], 130.00)
    set udg_real_shop[17]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[6], 130.00)
    set udg_real_shop[18]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[7], 130.00)
    set udg_real_shop[19]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[8], 130.00)
    set udg_real_shop[20]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'n01A', Player(PLAYER_NEUTRAL_PASSIVE), udg_tavern[9], 130.00)
    set udg_real_shop[21]=GetLastCreatedUnit()
    set udg_X=1
    loop
        exitwhen udg_X > 8
        call CreateTextTagUnitBJ(( "#" + I2S(udg_X) ), udg_real_shop[( 12 + udg_X )], 0, 10, 100, 100, 100, 0)
        set udg_X=udg_X + 1
    endloop
    set udg_X=13
    loop
        exitwhen udg_X > 21
        call GroupAddUnitSimple(udg_real_shop[udg_X], udg_realshops)
        set udg_X=udg_X + 1
    endloop
    set udg_X=1
    loop
        exitwhen udg_X > 11
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[13], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=12
    loop
        exitwhen udg_X > 22
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[14], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=23
    loop
        exitwhen udg_X > 33
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[15], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=34
    loop
        exitwhen udg_X > 44
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[16], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=45
    loop
        exitwhen udg_X > 55
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[17], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=56
    loop
        exitwhen udg_X > 66
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[18], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=67
    loop
        exitwhen udg_X > 77
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[19], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=78
    loop
        exitwhen udg_X > 88
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[20], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    set udg_X=89
    loop
        exitwhen udg_X > 93
        call AddUnitToStockBJ(udg_hero_type[udg_X], udg_real_shop[21], 3, udg_ap_number_of_heros)
        set udg_X=udg_X + 1
    endloop
    call EnableSelect(true, true)
    // delete heros
    set udg_temp_unitgroup=GetUnitsInRectOfPlayer(gg_rct_ALL_HERO, Player(PLAYER_NEUTRAL_PASSIVE))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_AP_Func054A)
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

