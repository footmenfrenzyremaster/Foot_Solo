//===========================================================================
// Trigger: BASE production ONOFF
//
// CHECK #2 - OK
//===========================================================================
function Trig_BASE_production_ONOFF_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0FS' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FR' ) ) then
        return true
    endif
    return false
endfunction

function Trig_BASE_production_ONOFF_Conditions takes nothing returns boolean
    if ( not Trig_BASE_production_ONOFF_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_production_ONOFF_Func006C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_production_ONOFF_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(udg_temp_unit))
    if ( Trig_BASE_production_ONOFF_Func006C() ) then
        set udg_unit_production[udg_temp_playernumber]=true
        call UnitRemoveAbilityBJ('A0FS', udg_base[udg_temp_playernumber])
        call UnitAddAbilityBJ('A0FR', udg_base[udg_temp_playernumber])
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_7745")
    else
        set udg_unit_production[udg_temp_playernumber]=false
        call UnitRemoveAbilityBJ('A0FR', udg_base[udg_temp_playernumber])
        call UnitAddAbilityBJ('A0FS', udg_base[udg_temp_playernumber])
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_6715")
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

//===========================================================================
function InitTrig_BASE_production_ONOFF takes nothing returns nothing
    set gg_trg_BASE_production_ONOFF=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BASE_production_ONOFF, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_BASE_production_ONOFF, Condition(function Trig_BASE_production_ONOFF_Conditions))
