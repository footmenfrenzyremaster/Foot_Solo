function Trig_HERO_Mad_Wizard_MassHex_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE=( 150.00 + ( 25.00 * I2R(udg_abilitylevel) ) )
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_Mad_Wizard_MassHex_Func006002003))
    call CreateNUnitsAtLoc(1, 'dmmy', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_DummyNew=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.50, 'BTLF', udg_DummyNew)
    call UnitAddAbilityBJ('A04H', udg_DummyNew)
    call SetUnitAbilityLevelSwapped('A04H', udg_DummyNew, udg_abilitylevel)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Mad_Wizard_MassHex_Func012A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

