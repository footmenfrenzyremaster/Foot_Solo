endfunction

//===========================================================================
// Trigger: BASE AutoSend ONOFF
//
// CHECK #2 - OK
//===========================================================================
function Trig_BASE_AutoSend_ONOFF_Func006C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A06X' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A06Y' ) ) then
        return true
    endif
    return false
endfunction

function Trig_BASE_AutoSend_ONOFF_Conditions takes nothing returns boolean
    if ( not Trig_BASE_AutoSend_ONOFF_Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_AutoSend_ONOFF_Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_AutoSend_ONOFF_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(udg_temp_unit))
    if ( Trig_BASE_AutoSend_ONOFF_Func004C() ) then
        set udg_autosend[udg_temp_playernumber]=true
        call UnitRemoveAbilityBJ('A06X', udg_temp_unit)
        call UnitAddAbilityBJ('A06Y', udg_temp_unit)
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1136")
    else
        set udg_autosend[udg_temp_playernumber]=false
        call UnitRemoveAbilityBJ('A06Y', udg_temp_unit)
        call UnitAddAbilityBJ('A06X', udg_temp_unit)
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1133")
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

//===========================================================================
function InitTrig_BASE_AutoSend_ONOFF takes nothing returns nothing
    set gg_trg_BASE_AutoSend_ONOFF=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BASE_AutoSend_ONOFF, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_BASE_AutoSend_ONOFF, Condition(function Trig_BASE_AutoSend_ONOFF_Conditions))
