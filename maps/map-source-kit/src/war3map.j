    if ( not ( GetSpellAbilityId() == 'A0GC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Absinthe_Func008002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == false )
endfunction

function Trig_HERO_Absinthe_Func009A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h01K', GetTriggerPlayer(), udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0FI', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0FI', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "antimagicshell", GetEnumUnit())
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
endfunction

function Trig_HERO_Absinthe_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE_array[1]=350.00
    set udg_temp_AoE_array[2]=400.00
    set udg_temp_AoE_array[3]=500.00
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE_array[udg_abilitylevel], udg_temp_point, Condition(function Trig_HERO_Absinthe_Func008002003))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Absinthe_Func009A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

