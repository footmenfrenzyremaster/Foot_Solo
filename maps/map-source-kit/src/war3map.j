    set udg_WooJ_Shock_Damage[3]=300.00
    set udg_WooJ_Shock_Damage[4]=350.00
    set udg_WooJ_Shock_Damage[5]=450.00
    set udg_WooJ_Shock_Damage[6]=550.00
