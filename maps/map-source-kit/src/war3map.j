    set gg_trg_ITEM_Forked_Fury_NEW=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_Forked_Fury_NEW, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_ITEM_Forked_Fury_NEW, Condition(function Trig_ITEM_Forked_Fury_NEW_Conditions))
