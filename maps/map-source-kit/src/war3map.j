function Trig_HERO_Shattering_Strike_Trigger_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Trigger_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_wrath_point[udg_temp_playernumber]=GetSpellTargetLoc()
    set udg_wrath_active[udg_temp_playernumber]=true
    //                                                                              
    set udg_Wrath_Effect[udg_temp_playernumber]=true
    call AddSpecialEffectLocBJ(udg_wrath_point[udg_temp_playernumber], "war3mapImported\\VengeanceNoSpin.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 5.00)
    call StartTimerBJ(udg_timer_wrath[udg_temp_playernumber], false, 1.30)
    call StartTimerBJ(udg_timer_wrath_effect[udg_temp_playernumber], false, 0.50)
endfunction

