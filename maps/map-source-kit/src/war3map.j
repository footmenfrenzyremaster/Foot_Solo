    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[5])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[6])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[7])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[8])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[9])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[10])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[11])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[12])
