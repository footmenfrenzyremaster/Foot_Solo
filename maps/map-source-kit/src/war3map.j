                    endif
                    // footmen level before 8 minutes
                    if ( Trig_eight_Func001Func002Func001Func020Func025C() ) then
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, 1)
                    else
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, 2)
                    endif
                    if ( Trig_eight_Func001Func002Func001Func020Func026C() ) then
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, 1)
                    else
                        call DoNothing()
                    endif
                    set udg_temp_int=udg_temp_int + 1
                endloop
            else
            endif
            set udg_X_base=udg_X_base + 1
        endloop
        set udg_X_playernumber=udg_X_playernumber + 1
    endloop
    call StartTimerBJ(udg_spawnTimer, true, 8.00)
endfunction

//===========================================================================
function InitTrig_eight takes nothing returns nothing
    set gg_trg_eight=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_eight, udg_spawnTimer)
    call TriggerAddCondition(gg_trg_eight, Condition(function Trig_eight_Conditions))
    call TriggerAddAction(gg_trg_eight, function Trig_eight_Actions)
endfunction

//===========================================================================
// Trigger: eight mass bonus
//===========================================================================
function Trig_eight_mass_bonus_Conditions takes nothing returns boolean
    if ( not ( udg_balanced == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_mass_bonus_Func005C takes nothing returns boolean
    if ( not ( udg_Mass_Bonus_Spawns[udg_Mass_Cycle] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_mass_bonus_Func007Func003Func010Func001Func003C takes nothing returns boolean
    if ( ( udg_X_base == 1 ) ) then
        return true
    endif
    if ( ( udg_X_base == 2 ) ) then
        return true
    endif
    if ( ( udg_X_base == 14 ) ) then
