        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func014Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Avalanche_SF_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_Avalanche_SF_Target, GetOwningPlayer(udg_Avalanche)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_SF_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Avalanche_SF_Target) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_Avalanche_SF_Target) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_SF_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func014A takes nothing returns nothing
    set udg_Avalanche_SF_Target=GetEnumUnit()
    if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func014Func002C() ) then
        call UnitDamageTargetBJ(udg_Avalanche, udg_Avalanche_SF_Target, udg_Avalanche_SF_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
        call IssueTargetOrderBJ(udg_Avalanche_SF_Dummy, "drunkenhaze", udg_Avalanche_SF_Target)
    else
    endif
endfunction

