        return false
    endif
    return true
endfunction

function Trig_HERO_Prison_Func087C takes nothing returns boolean
    if ( not ( false == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Prison_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_HERO_Prison_Wall_countdown)
    call EnableTrigger(gg_trg_ITEM_Wall_taunt)
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE=500.00
    set udg_temp_real=280.00
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_Prison_Func011002003))
    set udg_prison_wall_point_1[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 45.00)
    set udg_prison_wall_point_2[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 135.00)
    set udg_prison_wall_point_3[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 225.00)
    set udg_prison_wall_point_4[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 315.00)
    set udg_prison_block_point_1[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 0.00)
    set udg_prison_block_point_2[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 90.00)
    set udg_prison_block_point_3[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 180.00)
    set udg_prison_block_point_4[udg_temp_playernumber]=PolarProjectionBJ(udg_temp_point, udg_temp_real, 270.00)
    set udg_prison_wall_duration[1]=6.00
    set udg_prison_wall_duration[2]=6.50
    set udg_prison_wall_duration[3]=7.00
    set udg_summon_hp[1]=400
    set udg_summon_hp[2]=500
    set udg_summon_hp[3]=700
    call StartTimerBJ(udg_timer_spell_cd[udg_temp_playernumber], false, 300.00)
    call BlzStartUnitAbilityCooldown(udg_temp_unit, 'A0GL', TimerGetRemaining(udg_timer_spell_cd[udg_temp_playernumber]))
    // move units in wall
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Prison_Func029A)
    call StartTimerBJ(udg_prison_timer[udg_temp_playernumber], false, udg_prison_wall_duration[udg_abilitylevel])
    // WALL 1
    call CreateNUnitsAtLoc(1, 'h02T', udg_temp_player, udg_prison_wall_point_1[udg_temp_playernumber], bj_UNIT_FACING)
    set udg_prison_wall_1[udg_temp_playernumber]=GetLastCreatedUnit()
    call BlzSetUnitMaxHP(udg_prison_wall_1[udg_temp_playernumber], udg_summon_hp[udg_abilitylevel])
    call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(), UNIT_RF_HP, I2R(BlzGetUnitMaxHP(GetLastCreatedUnit())))
    call UnitApplyTimedLifeBJ(udg_prison_wall_duration[udg_abilitylevel], 'BTLF', udg_prison_wall_1[udg_temp_playernumber])
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), udg_prison_wall_point_1[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
    set udg_prison_wall_text_1[udg_temp_playernumber]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_prison_wall_text_1[udg_temp_playernumber], udg_prison_wall_duration[udg_abilitylevel])
    call CreateDestructableLoc('YTpb', udg_prison_block_point_1[udg_temp_playernumber], 0.00, 1, 0)
    set udg_prison_block_1[udg_temp_playernumber]=GetLastCreatedDestructable()
    // WALL 2
    call CreateNUnitsAtLoc(1, 'h02S', udg_temp_player, udg_prison_wall_point_2[udg_temp_playernumber], bj_UNIT_FACING)
    set udg_prison_wall_2[udg_temp_playernumber]=GetLastCreatedUnit()
    call BlzSetUnitMaxHP(udg_prison_wall_2[udg_temp_playernumber], udg_summon_hp[udg_abilitylevel])
    call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(), UNIT_RF_HP, I2R(BlzGetUnitMaxHP(GetLastCreatedUnit())))
    call UnitApplyTimedLifeBJ(udg_prison_wall_duration[udg_abilitylevel], 'BTLF', udg_prison_wall_2[udg_temp_playernumber])
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), udg_prison_wall_point_2[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
    set udg_prison_wall_text_2[udg_temp_playernumber]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_prison_wall_text_2[udg_temp_playernumber], udg_prison_wall_duration[udg_abilitylevel])
    call CreateDestructableLoc('YTpb', udg_prison_block_point_2[udg_temp_playernumber], 0.00, 1, 0)
    set udg_prison_block_2[udg_temp_playernumber]=GetLastCreatedDestructable()
    // WALL 3
    call CreateNUnitsAtLoc(1, 'h02T', udg_temp_player, udg_prison_wall_point_3[udg_temp_playernumber], bj_UNIT_FACING)
    set udg_prison_wall_3[udg_temp_playernumber]=GetLastCreatedUnit()
    call BlzSetUnitMaxHP(udg_prison_wall_3[udg_temp_playernumber], udg_summon_hp[udg_abilitylevel])
    call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(), UNIT_RF_HP, I2R(BlzGetUnitMaxHP(GetLastCreatedUnit())))
    call UnitApplyTimedLifeBJ(udg_prison_wall_duration[udg_abilitylevel], 'BTLF', udg_prison_wall_3[udg_temp_playernumber])
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), udg_prison_wall_point_3[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
    set udg_prison_wall_text_3[udg_temp_playernumber]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_prison_wall_text_3[udg_temp_playernumber], udg_prison_wall_duration[udg_abilitylevel])
    call CreateDestructableLoc('YTpb', udg_prison_block_point_3[udg_temp_playernumber], 0.00, 1, 0)
    set udg_prison_block_3[udg_temp_playernumber]=GetLastCreatedDestructable()
    // WALL 4
    call CreateNUnitsAtLoc(1, 'h02S', udg_temp_player, udg_prison_wall_point_4[udg_temp_playernumber], bj_UNIT_FACING)
    set udg_prison_wall_4[udg_temp_playernumber]=GetLastCreatedUnit()
    call BlzSetUnitMaxHP(udg_prison_wall_4[udg_temp_playernumber], udg_summon_hp[udg_abilitylevel])
    call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(), UNIT_RF_HP, I2R(BlzGetUnitMaxHP(GetLastCreatedUnit())))
    call UnitApplyTimedLifeBJ(udg_prison_wall_duration[udg_abilitylevel], 'BTLF', udg_prison_wall_4[udg_temp_playernumber])
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), udg_prison_wall_point_4[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
    set udg_prison_wall_text_4[udg_temp_playernumber]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_prison_wall_text_4[udg_temp_playernumber], udg_prison_wall_duration[udg_abilitylevel])
    call CreateDestructableLoc('YTpb', udg_prison_block_point_4[udg_temp_playernumber], 0.00, 1, 0)
    set udg_prison_block_4[udg_temp_playernumber]=GetLastCreatedDestructable()
    // move units in wall
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Prison_Func076A)
    // cast d&d
    call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0GW', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0GW', udg_dummy, udg_abilitylevel)
    call IssuePointOrderLocBJ(udg_dummy, "deathanddecay", udg_temp_point)
    call UnitApplyTimedLifeBJ(26.10, 'BTLF', udg_dummy)
    // cast silence
    if ( Trig_HERO_Prison_Func085C() ) then
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('ANsi', udg_dummy)
        call SetUnitAbilityLevelSwapped('ANsi', udg_dummy, 1)
        call IssuePointOrderLocBJ(udg_dummy, "silence", udg_temp_point)
        call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    else
        call DoNothing()
    endif
    // debug output
    if ( Trig_HERO_Prison_Func087C() ) then
        call CreateTextTagLocBJ("TRIGSTR_10954", udg_prison_block_point_1[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
        call CreateTextTagLocBJ("TRIGSTR_10955", udg_prison_block_point_2[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
        call CreateTextTagLocBJ("TRIGSTR_10956", udg_prison_block_point_3[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
        call CreateTextTagLocBJ("TRIGSTR_10957", udg_prison_block_point_4[udg_temp_playernumber], 0, 9.00, 100, 100, 100, 25.00)
    else
    endif
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

//===========================================================================
function InitTrig_HERO_Prison takes nothing returns nothing
    set gg_trg_HERO_Prison=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Prison, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Prison, Condition(function Trig_HERO_Prison_Conditions))
    call TriggerAddAction(gg_trg_HERO_Prison, function Trig_HERO_Prison_Actions)
endfunction

//===========================================================================
// Trigger: HERO Prison Wall countdown
//
// CHECK #2 - OK
//===========================================================================
function Trig_HERO_Prison_Wall_countdown_Func001Func001C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]) < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Prison_Wall_countdown_Actions takes nothing returns nothing
    set udg_temp_playernumber=1
    loop
        exitwhen udg_temp_playernumber > 12
        if ( Trig_HERO_Prison_Wall_countdown_Func001Func001C() ) then
            call DestroyTextTagBJ(udg_prison_wall_text_1[udg_temp_playernumber])
            call DestroyTextTagBJ(udg_prison_wall_text_2[udg_temp_playernumber])
            call DestroyTextTagBJ(udg_prison_wall_text_3[udg_temp_playernumber])
            call DestroyTextTagBJ(udg_prison_wall_text_4[udg_temp_playernumber])
            call RemoveLocation(udg_prison_wall_point_1[udg_temp_playernumber])
            call RemoveLocation(udg_prison_wall_point_2[udg_temp_playernumber])
            call RemoveLocation(udg_prison_wall_point_3[udg_temp_playernumber])
            call RemoveLocation(udg_prison_wall_point_4[udg_temp_playernumber])
            call RemoveDestructable(udg_prison_block_1[udg_temp_playernumber])
            call RemoveDestructable(udg_prison_block_2[udg_temp_playernumber])
            call RemoveDestructable(udg_prison_block_3[udg_temp_playernumber])
            call RemoveDestructable(udg_prison_block_4[udg_temp_playernumber])
        else
            call SetTextTagTextBJ(udg_prison_wall_text_1[udg_temp_playernumber], R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), 9.00)
            call SetTextTagTextBJ(udg_prison_wall_text_2[udg_temp_playernumber], R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), 9.00)
            call SetTextTagTextBJ(udg_prison_wall_text_3[udg_temp_playernumber], R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), 9.00)
            call SetTextTagTextBJ(udg_prison_wall_text_4[udg_temp_playernumber], R2SW(TimerGetRemaining(udg_prison_timer[udg_temp_playernumber]), 2, 0), 9.00)
        endif
        set udg_temp_playernumber=udg_temp_playernumber + 1
    endloop
endfunction

//===========================================================================
function InitTrig_HERO_Prison_Wall_countdown takes nothing returns nothing
    set gg_trg_HERO_Prison_Wall_countdown=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_HERO_Prison_Wall_countdown, 1.00)
    call TriggerAddAction(gg_trg_HERO_Prison_Wall_countdown, function Trig_HERO_Prison_Wall_countdown_Actions)
endfunction

//===========================================================================
// Trigger: HERO Hook Throw
//
// -hero 01 55
//===========================================================================
function Trig_HERO_Hook_Throw_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Throw_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_hook_degree[udg_temp_playernumber]=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    call CreateNUnitsAtLoc(1, 'h04D', udg_temp_player, udg_temp_point_caster, udg_hook_degree[udg_X])
    set udg_dummy_hook[udg_temp_playernumber]=GetLastCreatedUnit()
    set udg_hook_level[GetUnitUserData(GetLastCreatedUnit())]=udg_abilitylevel
    set udg_hook_start_location[udg_temp_playernumber]=udg_temp_point_caster
    set udg_hook_location[udg_temp_playernumber]=udg_temp_point_caster
    set udg_hook_send_active[udg_temp_playernumber]=true
    set udg_hook_return_active[udg_temp_playernumber]=false
    set udg_hook_target_aquired[udg_temp_playernumber]=false
    set udg_hook_first[udg_temp_playernumber]=true
    set udg_hook_range[udg_abilitylevel]=BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_temp_unit, 'A0GU'), ABILITY_RLF_CAST_RANGE, ( udg_abilitylevel - 1 ))
    call EnableTrigger(gg_trg_HERO_Hook_Loop)
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_HERO_Hook_Throw takes nothing returns nothing
    set gg_trg_HERO_Hook_Throw=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Hook_Throw, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Hook_Throw, Condition(function Trig_HERO_Hook_Throw_Conditions))
    call TriggerAddAction(gg_trg_HERO_Hook_Throw, function Trig_HERO_Hook_Throw_Actions)
endfunction

//===========================================================================
// Trigger: HERO Hook Loop
//
// -hero 01 55
//===========================================================================
function Trig_HERO_Hook_Loop_Func001Func001Func003Func002C takes nothing returns boolean
    if ( not ( udg_hook_first[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func003002003001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), ConvertedPlayer(udg_X)) == true )
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func003002003002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func003002003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitEnemy(GetFilterUnit(), ConvertedPlayer(udg_X)) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func004Func001Func001C takes nothing returns boolean
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_ANCIENT) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == true ) ) then
        return true
    endif
    if ( ( BlzIsUnitInvulnerable(GetEnumUnit()) == true ) ) then
        return true
    endif
    if ( ( IsUnitInvisible(GetEnumUnit(), ConvertedPlayer(udg_X)) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_SLEEPING) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return true
    endif
    if ( ( GetUnitDefaultMoveSpeed(GetEnumUnit()) < 1.00 ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func004Func001C takes nothing returns boolean
    if ( not Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func004Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func004A takes nothing returns nothing
    if ( Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func004Func001C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_hook_target_group[udg_X])
    else
        call DoNothing()
    endif
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func005Func005A takes nothing returns nothing
    set udg_hook_target[udg_X]=GetEnumUnit()
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_hook_target_group[udg_X]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003Func005C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_hook_start_location[udg_X], udg_hook_location[udg_X]) >= udg_hook_range[udg_abilitylevel] ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func003C takes nothing returns boolean
    if ( not ( udg_hook_send_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func004Func007Func001C takes nothing returns boolean
    if ( ( BlzIsUnitInvulnerable(udg_hook_target[udg_X]) == true ) ) then
        return true
    endif
    if ( ( DistanceBetweenPoints(udg_hook_start_location[udg_X], udg_hook_location[udg_X]) <= 100.00 ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func004Func007Func004C takes nothing returns boolean
    if ( not ( udg_hook_target_aquired[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func004Func007C takes nothing returns boolean
    if ( not Trig_HERO_Hook_Loop_Func001Func001Func004Func007Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func004Func008C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_hook_start_location[udg_X], udg_hook_location[udg_X]) <= 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func004Func009C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == GetUnitTypeId(udg_hook_target[udg_X]) ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == GetUnitTypeId(udg_hook_target[udg_X]) ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001Func004C takes nothing returns boolean
    if ( not ( udg_hook_return_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_herO[udg_X]) == 'E010' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Hook_Loop_Func001Func001C() ) then
            set udg_abilitylevel=udg_hook_level[GetUnitUserData(udg_dummy_hook[udg_X])]
            set udg_hook_start_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
            if ( Trig_HERO_Hook_Loop_Func001Func001Func003C() ) then
                // SEND HOOK
                if ( Trig_HERO_Hook_Loop_Func001Func001Func003Func002C() ) then
                    set udg_hook_first[udg_X]=false
                    set udg_hook_location[udg_X]=PolarProjectionBJ(udg_hook_start_location[udg_X], 65.00, udg_hook_degree[udg_X])
                    call AddLightningLoc("LEAS", udg_hook_start_location[udg_X], udg_hook_location[udg_X])
                    set udg_hook_lightning[udg_X]=GetLastCreatedLightningBJ()
                else
                    set udg_hook_location[udg_X]=PolarProjectionBJ(udg_hook_location[udg_X], 65.00, udg_hook_degree[udg_X])
                endif
                call SetUnitPositionLocFacingBJ(udg_dummy_hook[udg_X], udg_hook_location[udg_X], udg_hook_degree[udg_X])
                call MoveLightningLoc(udg_hook_lightning[udg_X], udg_hook_start_location[udg_X], udg_hook_location[udg_X])
                if ( Trig_HERO_Hook_Loop_Func001Func001Func003Func005C() ) then
                    // NO TARGET, ACTIVATE RETURN
                    set udg_hook_send_active[udg_X]=false
                    set udg_hook_return_active[udg_X]=true
                    set udg_hook_target_aquired[udg_X]=false
                else
                    // TARGET FOUND , ACTIVATE RETURN
                    set udg_hook_target_group[udg_X]=GetUnitsInRangeOfLocMatching(120.00, udg_hook_location[udg_X], Condition(function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func003002003))
                    call ForGroupBJ(udg_hook_target_group[udg_X], function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func004A)
                    if ( Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func005C() ) then
                        set udg_hook_send_active[udg_X]=false
                        set udg_hook_return_active[udg_X]=true
                        set udg_hook_target_aquired[udg_X]=true
                        call ForGroupBJ(GetRandomSubGroup(1, udg_hook_target_group[udg_X]), function Trig_HERO_Hook_Loop_Func001Func001Func003Func005Func005Func005A)
                    else
                        call DoNothing()
                    endif
                    call DestroyGroup(udg_hook_target_group[udg_X])
                endif
            else
                call DoNothing()
            endif
            if ( Trig_HERO_Hook_Loop_Func001Func001Func004C() ) then
                // RETURN HOOK
                set udg_hook_degree[udg_X]=AngleBetweenPoints(udg_hook_start_location[udg_X], udg_hook_location[udg_X])
                set udg_hook_location[udg_X]=PolarProjectionBJ(udg_hook_location[udg_X], - 40.00, udg_hook_degree[udg_X])
                call SetUnitPositionLocFacingBJ(udg_dummy_hook[udg_X], udg_hook_location[udg_X], udg_hook_degree[udg_X])
                call SetUnitPositionLocFacingBJ(udg_hook_target[udg_X], udg_hook_location[udg_X], udg_hook_degree[udg_X])
                call MoveLightningLoc(udg_hook_lightning[udg_X], udg_hook_start_location[udg_X], udg_hook_location[udg_X])
                if ( Trig_HERO_Hook_Loop_Func001Func001Func004Func007C() ) then
                    // HOOK RETURNED
                    if ( Trig_HERO_Hook_Loop_Func001Func001Func004Func007Func004C() ) then
                        call UnitAddAbilityBJ('A0GX', udg_dummy_hook[udg_X])
                        call SetUnitAbilityLevelSwapped('A0GX', udg_dummy_hook[udg_X], udg_abilitylevel)
                        call IssueTargetOrderBJ(udg_dummy_hook[udg_X], "firebolt", udg_hook_target[udg_X])
                    else
                        call DoNothing()
                    endif
                    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_hook[udg_X])
                    set udg_hook_return_active[udg_X]=false
                    set udg_hook_target[udg_X]=null
                    call DestroyLightningBJ(udg_hook_lightning[udg_X])
                    call RemoveLocation(udg_hook_location[udg_X])
                    call RemoveLocation(udg_hook_start_location[udg_X])
                    call DisableTrigger(GetTriggeringTrigger())
                else
                    call DoNothing()
                endif
                if ( Trig_HERO_Hook_Loop_Func001Func001Func004Func008C() ) then
                    // HOOK RETURNED
                    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_hook[udg_X])
                    set udg_hook_return_active[udg_X]=false
                    set udg_hook_target[udg_X]=null
                    call DestroyLightningBJ(udg_hook_lightning[udg_X])
                    call RemoveLocation(udg_hook_location[udg_X])
                    call RemoveLocation(udg_hook_start_location[udg_X])
                    call DisableTrigger(GetTriggeringTrigger())
                else
                    call DoNothing()
                endif
                if ( Trig_HERO_Hook_Loop_Func001Func001Func004Func009C() ) then
                    call UnitAddAbilityBJ('A0GX', udg_dummy_hook[udg_X])
                    call SetUnitAbilityLevelSwapped('A0GX', udg_dummy_hook[udg_X], udg_abilitylevel)
                    call IssueTargetOrderBJ(udg_dummy_hook[udg_X], "firebolt", udg_hook_target[udg_X])
                else
                    call DoNothing()
                endif
            else
                call DoNothing()
            endif
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

