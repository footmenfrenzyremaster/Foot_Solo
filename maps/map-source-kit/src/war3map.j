    set gg_trg_MODE_set_inhouse=CreateTrigger()
    call TriggerAddAction(gg_trg_MODE_set_inhouse, function Trig_MODE_set_inhouse_Actions)
endfunction

//===========================================================================
// Trigger: MODE colossal GUI execute
//
// ok
//===========================================================================
function Trig_MODE_colossal_GUI_execute_Func002C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_colossal_yes ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_colossal_GUI_execute_Func003C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_colossal_no ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_colossal_GUI_execute_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    if ( Trig_MODE_colossal_GUI_execute_Func002C() ) then
        set udg_colossal_wave_steps[0]=99
        set udg_colossal_wave_steps[1]=1
        set udg_colossal_wave_steps[2]=2
        set udg_colossal_wave_steps[3]=3
        set udg_colossal_wave_steps[4]=4
        set udg_colossal_wave_steps[5]=5
        set udg_colossal_wave_steps[6]=10
        set udg_colossal_on=true
        set udg_wmd[2]=( "|cff00ffffColossals:|r |cff00ff00On|r" )
        // # of waves GUI
        call DialogClearBJ(udg_dlg_colossal_amount)
        call DialogSetMessageBJ(udg_dlg_colossal_amount, "TRIGSTR_11624")
        // buttons
        call DialogAddButtonBJ(udg_dlg_colossal_amount, "TRIGSTR_11625")
        set udg_dlg_btn_colossal_amount[0]=GetLastCreatedButtonBJ()
        set udg_X=1
        loop
            exitwhen udg_X > 6
            call DialogAddButtonBJ(udg_dlg_colossal_amount, I2S(udg_colossal_wave_steps[udg_X]))
            set udg_dlg_btn_colossal_amount[udg_X]=GetLastCreatedButtonBJ()
            set udg_X=udg_X + 1
        endloop
        // show
        call DialogDisplayBJ(true, udg_dlg_colossal_amount, ConvertedPlayer(udg_temp_playernumber))
    else
        call DoNothing()
    endif
    if ( Trig_MODE_colossal_GUI_execute_Func003C() ) then
        set udg_colossal_on=false
        set udg_wmd[2]=( "|cff00ffffColossals:|r |cffff0000Off|r" )
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_MODE_colossal_GUI_execute takes nothing returns nothing
    set gg_trg_MODE_colossal_GUI_execute=CreateTrigger()
    call TriggerRegisterDialogEventBJ(gg_trg_MODE_colossal_GUI_execute, udg_dlg_colossal)
    call TriggerAddAction(gg_trg_MODE_colossal_GUI_execute, function Trig_MODE_colossal_GUI_execute_Actions)
endfunction

