function InitTrig_HERO_Pirate_Send_Ship takes nothing returns nothing
    set gg_trg_HERO_Pirate_Send_Ship=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Pirate_Send_Ship, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Pirate_Send_Ship, Condition(function Trig_HERO_Pirate_Send_Ship_Conditions))
    call TriggerAddAction(gg_trg_HERO_Pirate_Send_Ship, function Trig_HERO_Pirate_Send_Ship_Actions)
