//===========================================================================
// Trigger: Votekick Vote Yes or No
//===========================================================================
function Trig_Votekick_Vote_Yes_or_No_Conditions takes nothing returns boolean
    if ( not ( udg_Votekick_Is_Active == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Vote_Yes_or_No_Func002Func005Func003C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(udg_Votekick_Target_Player) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Vote_Yes_or_No_Func002Func005C takes nothing returns boolean
    if ( not ( udg_Votekick_Allied_Votes >= udg_Votekick_Allied_Votes_Needed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Vote_Yes_or_No_Func002C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_Votekick_Button_Yes ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Vote_Yes_or_No_Actions takes nothing returns nothing
    if ( Trig_Votekick_Vote_Yes_or_No_Func002C() ) then
        set udg_Votekick_Allied_Votes=( udg_Votekick_Allied_Votes + 1 )
        //                                                                                                     
        if ( Trig_Votekick_Vote_Yes_or_No_Func002Func005C() ) then
            call DisplayTextToForce(GetPlayersAll(), ( ( GetPlayerName(GetTriggerPlayer()) + "'s team have decided to kick " ) + ( GetPlayerName(udg_Votekick_Target_Player) + " - RIP." ) ))
            //                                                                                                     
            if ( Trig_Votekick_Vote_Yes_or_No_Func002Func005Func003C() ) then
                call CustomDefeatBJ(udg_Votekick_Target_Player, "TRIGSTR_7869")
                set udg_Votekick_Defeat_Kicked_Player=true
                call TriggerExecute(gg_trg_player_leaves)
            else
            endif
            //                                                                                                     
            call TriggerExecute(gg_trg_Votekick_RESET)
        else
        endif
    else
        // Nothing really needs to happen when they press No.
        call TriggerExecute(gg_trg_Votekick_RESET)
    endif
endfunction

//===========================================================================
function InitTrig_Votekick_Vote_Yes_or_No takes nothing returns nothing
    set gg_trg_Votekick_Vote_Yes_or_No=CreateTrigger()
    call TriggerRegisterDialogEventBJ(gg_trg_Votekick_Vote_Yes_or_No, udg_Votekick_Dialog_YesNo)
    call TriggerAddCondition(gg_trg_Votekick_Vote_Yes_or_No, Condition(function Trig_Votekick_Vote_Yes_or_No_Conditions))
    call TriggerAddAction(gg_trg_Votekick_Vote_Yes_or_No, function Trig_Votekick_Vote_Yes_or_No_Actions)
endfunction

