    if ( not ( GetClickedButtonBJ() == udg_dlg_btn_downgrade_no[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tower_downgrade_execute_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_player=GetOwningPlayer(udg_upgrading_tower[udg_temp_playernumber])
    if ( Trig_Tower_downgrade_execute_Func015C() ) then
        call ReplaceUnitBJ(udg_upgrading_tower[udg_temp_playernumber], 'hwtw', bj_UNIT_STATE_METHOD_RELATIVE)
        call UnitSetUpgradeProgress(udg_upgrading_tower[udg_temp_playernumber], 100)
    else
        call DoNothing()
    endif
    if ( Trig_Tower_downgrade_execute_Func016C() ) then
        call IssueImmediateOrderById(udg_upgrading_tower[udg_temp_playernumber], 851976)
    else
        call DoNothing()
    endif
endfunction

