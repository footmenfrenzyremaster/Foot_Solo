            endif
            if ( Trig_GM_send_messages_Func003Func001Func008C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func009C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
