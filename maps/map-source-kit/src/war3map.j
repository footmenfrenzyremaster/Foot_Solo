//===========================================================================
// Trigger: Votekick Initiate
//===========================================================================
function Trig_Votekick_Initiate_Func035C takes nothing returns boolean
    if ( ( udg_player_active[GetConvertedPlayerId(udg_ally1[GetConvertedPlayerId(GetTriggerPlayer())])] == true ) ) then
        return true
    endif
    if ( ( udg_player_active[GetConvertedPlayerId(udg_ally2[GetConvertedPlayerId(GetTriggerPlayer())])] == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Votekick_Initiate_Conditions takes nothing returns boolean
    if ( not ( udg_Votekick_Is_Active == false ) ) then
        return false
    endif
    if ( not ( udg_Votekick_Player_Disabled[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    if ( not Trig_Votekick_Initiate_Func035C() ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Initiate_Func003A takes nothing returns nothing
    set udg_Votekick_Player_Disabled[GetConvertedPlayerId(GetEnumPlayer())]=false
endfunction

function Trig_Votekick_Initiate_Func017C takes nothing returns boolean
    if ( not ( udg_player_active[GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Initiate_Func018C takes nothing returns boolean
    if ( not ( udg_player_active[GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Initiate_Actions takes nothing returns nothing
    set udg_Votekick_Is_Active=true
    //                                                                                                     
    call ForForce(GetPlayersAll(), function Trig_Votekick_Initiate_Func003A)
    //                                                                                                     
    set udg_Votekick_Allied_Votes=1
    set udg_Votekick_Allied_Votes_Needed=2
    //                                                                                                     
    // Currently set to always be 1!
    //                                                                                                     
    set udg_Votekick_Start_Player=GetTriggerPlayer()
    set udg_temp_playernumber=GetConvertedPlayerId(udg_Votekick_Start_Player)
    set udg_Votekick_Player_Disabled[udg_temp_playernumber]=true
    //                                                                                                     
    // Choose Ally To Kick Dialog:
    call DialogClearBJ(udg_Votekick_Dialog_Initiate)
    call DialogSetMessageBJ(udg_Votekick_Dialog_Initiate, "TRIGSTR_11785")
    if ( Trig_Votekick_Initiate_Func017C() ) then
        call DialogAddButtonBJ(udg_Votekick_Dialog_Initiate, GetPlayerName(udg_ally1[udg_temp_playernumber]))
        set udg_Votekick_Button_Ally1=GetLastCreatedButtonBJ()
    else
    endif
    if ( Trig_Votekick_Initiate_Func018C() ) then
        call DialogAddButtonBJ(udg_Votekick_Dialog_Initiate, GetPlayerName(udg_ally2[udg_temp_playernumber]))
        set udg_Votekick_Button_Ally2=GetLastCreatedButtonBJ()
    else
    endif
    call DialogAddButtonBJ(udg_Votekick_Dialog_Initiate, "TRIGSTR_12628")
    set udg_Votekick_Button_Cancel=GetLastCreatedButtonBJ()
    call DialogDisplayBJ(true, udg_Votekick_Dialog_Initiate, udg_Votekick_Start_Player)
    //                                                                                                     
    // Yes / No Dialog:
    call DialogClearBJ(udg_Votekick_Dialog_YesNo)
    call DialogSetMessageBJ(udg_Votekick_Dialog_YesNo, "TRIGSTR_12629")
    call DialogAddButtonBJ(udg_Votekick_Dialog_YesNo, "TRIGSTR_12630")
    set udg_Votekick_Button_Yes=GetLastCreatedButtonBJ()
    call DialogAddButtonBJ(udg_Votekick_Dialog_YesNo, "TRIGSTR_12631")
    set udg_Votekick_Button_No=GetLastCreatedButtonBJ()
    //                                                                                                     
    // The votekick shouldn't last forever:
    call StartTimerBJ(udg_Votekick_Timer, false, 30.00)
endfunction

//===========================================================================
function InitTrig_Votekick_Initiate takes nothing returns nothing
    set gg_trg_Votekick_Initiate=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(0), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(1), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(2), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(3), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(4), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(5), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(6), "-votekick", false)
