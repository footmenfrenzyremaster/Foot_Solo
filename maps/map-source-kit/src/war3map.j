function Trig_BASE_destroy_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_destroy_Func004002 takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_BASE_destroy_Func012C takes nothing returns boolean
    if ( not ( udg_player_active[udg_temp_playernumber_ally_1] == true ) ) then
        return false
    endif
    if ( not ( udg_player_active[udg_temp_playernumber_ally_2] == true ) ) then
        return false
    endif
    if ( not ( udg_leaving_gold[udg_temp_playernumber] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_destroy_Func013C takes nothing returns boolean
    if ( not ( udg_player_active[udg_temp_playernumber_ally_1] == true ) ) then
        return false
    endif
    if ( not ( udg_player_active[udg_temp_playernumber_ally_2] == false ) ) then
        return false
    endif
    if ( not ( udg_leaving_gold[udg_temp_playernumber] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_destroy_Func014C takes nothing returns boolean
    if ( not ( udg_player_active[udg_temp_playernumber_ally_1] == false ) ) then
        return false
    endif
    if ( not ( udg_player_active[udg_temp_playernumber_ally_2] == true ) ) then
        return false
    endif
    if ( not ( udg_leaving_gold[udg_temp_playernumber] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_destroy_Actions takes nothing returns nothing
    set udg_X=udg_Destroyer_Player_Number[GetUnitUserData(GetTriggerUnit())]
    set udg_temp_player=ConvertedPlayer(udg_X)
    set udg_unitgroup_kill=GetUnitsOfPlayerAll(ConvertedPlayer(udg_X))
    call ForGroupBJ(udg_unitgroup_kill, function Trig_BASE_destroy_Func004002)
    call DestroyGroup(udg_unitgroup_kill)
    call RemoveLocation(udg_temp_point)
    set udg_temp_playernumber=udg_X
    set udg_temp_playernumber_ally_1=GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])
    set udg_temp_playernumber_ally_2=GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])
    set udg_leaving_gold[udg_temp_playernumber]=GetPlayerState(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD)
    call SetPlayerStateBJ(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD, 0)
    if ( Trig_BASE_destroy_Func012C() ) then
        call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_1)), ( "You receive " + ( I2S(( udg_leaving_gold[udg_temp_playernumber] / 2 )) + " Gold." ) ))
        call AdjustPlayerStateBJ(( udg_leaving_gold[udg_temp_playernumber] / 2 ), ConvertedPlayer(udg_temp_playernumber_ally_1), PLAYER_STATE_RESOURCE_GOLD)
        call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_2)), ( "You receive " + ( I2S(( udg_leaving_gold[udg_temp_playernumber] / 2 )) + " Gold." ) ))
        call AdjustPlayerStateBJ(( udg_leaving_gold[udg_temp_playernumber] / 2 ), ConvertedPlayer(udg_temp_playernumber_ally_2), PLAYER_STATE_RESOURCE_GOLD)
    else
        call DoNothing()
    endif
    if ( Trig_BASE_destroy_Func013C() ) then
        call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_1)), ( "You receive " + ( I2S(udg_leaving_gold[udg_temp_playernumber]) + " Gold." ) ))
        call AdjustPlayerStateBJ(udg_leaving_gold[udg_temp_playernumber], ConvertedPlayer(udg_temp_playernumber_ally_1), PLAYER_STATE_RESOURCE_GOLD)
    else
        call DoNothing()
    endif
    if ( Trig_BASE_destroy_Func014C() ) then
        call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_2)), ( "You receive " + ( I2S(udg_leaving_gold[udg_temp_playernumber]) + " Gold." ) ))
        call AdjustPlayerStateBJ(udg_leaving_gold[udg_temp_playernumber], ConvertedPlayer(udg_temp_playernumber_ally_2), PLAYER_STATE_RESOURCE_GOLD)
    else
        call DoNothing()
    endif
    call RemoveUnit(GetTriggerUnit())
endfunction

