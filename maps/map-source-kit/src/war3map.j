    if ( not ( udg_player_active[GetConvertedPlayerId(udg_ally2[udg_X])] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_execute_Func011Func001Func009C takes nothing returns boolean
    if ( not ( udg_X <= 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_execute_Func011Func001C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_New_Kick_Dialog_Buttons[udg_X] ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_execute_Actions takes nothing returns nothing
    // CANCEL
    if ( Trig_KICK_execute_Func002C() ) then
        set udg_New_Kick_Is_Active=false
        call DialogDisplayBJ(false, udg_New_Kick_Dialog, udg_New_Kick_Decider)
        //                                                                                                                                         
        set udg_temp_playergroup=GetForceOfPlayer(udg_New_Kick_Decider)
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_5168")
        call DestroyForce(udg_temp_playergroup)
        return
    else
    endif
    //                                                                                                                                         
    // NEXT PAGE
    if ( Trig_KICK_execute_Func005C() ) then
        if ( Trig_KICK_execute_Func005Func001C() ) then
            set udg_New_Kick_Current_Page=( udg_New_Kick_Current_Page + 1 )
        else
            set udg_New_Kick_Current_Page=1
        endif
        call TriggerExecute(gg_trg_KICK_rebuild_dialog)
        return
    else
    endif
    //                                                                                                                                         
    // PREVIOUS PAGE
    if ( Trig_KICK_execute_Func008C() ) then
        if ( Trig_KICK_execute_Func008Func001C() ) then
            set udg_New_Kick_Current_Page=( udg_New_Kick_Current_Page - 1 )
        else
            set udg_New_Kick_Current_Page=udg_New_Kick_Total_Pages
        endif
        call TriggerExecute(gg_trg_KICK_rebuild_dialog)
        return
    else
    endif
    //                                                                                                                                         
    // KICK A PLAYER:
    set udg_X=1
    loop
        exitwhen udg_X > 24
        if ( Trig_KICK_execute_Func011Func001C() ) then
            set udg_New_Kick_Is_Active=false
            call DialogDisplayBJ(false, udg_New_Kick_Dialog, udg_New_Kick_Decider)
            //                                                                                                                                         
            call DisplayTextToForce(GetPlayersAll(), ( ( GetPlayerName(udg_New_Kick_Decider) + " has removed " ) + ( GetPlayerName(ConvertedPlayer(udg_X)) + " from the game." ) ))
            call CustomDefeatBJ(ConvertedPlayer(udg_X), "TRIGSTR_16610")
            set udg_leave_or_votekick[udg_X]=true
            //                                                                                                                                         
            // NON-OBSERVERS RUN EXTRA LOGIC WHEN THEY'RE KICKED:
            if ( Trig_KICK_execute_Func011Func001Func009C() ) then
                call EnableTrigger(gg_trg_BASE_destroy)
                call EnableTrigger(gg_trg_BASE_collect_gold)
                //                                                                                                                                         
                if ( Trig_KICK_execute_Func011Func001Func009Func004C() ) then
                    call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_X), udg_ally1[udg_X], bj_ALLIANCE_ALLIED_ADVUNITS)
                    set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_X))
                    call CreateNUnitsAtLoc(1, 'h02Q', udg_ally1[udg_X], udg_temp_point, bj_UNIT_FACING)
                    set udg_Destroyer_Player_Number[GetUnitUserData(GetLastCreatedUnit())]=udg_X
                    call RemoveLocation(udg_temp_point)
                else
                endif
                //                                                                                                                                         
                if ( Trig_KICK_execute_Func011Func001Func009Func006C() ) then
                    call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_X), udg_ally2[udg_X], bj_ALLIANCE_ALLIED_ADVUNITS)
                    set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_X))
                    call CreateNUnitsAtLoc(1, 'h02Q', udg_ally2[udg_X], udg_temp_point, bj_UNIT_FACING)
                    set udg_Destroyer_Player_Number[GetUnitUserData(GetLastCreatedUnit())]=udg_X
                    call RemoveLocation(udg_temp_point)
                else
                endif
            else
            endif
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

//===========================================================================
function InitTrig_KICK_execute takes nothing returns nothing
    set gg_trg_KICK_execute=CreateTrigger()
    call TriggerRegisterDialogEventBJ(gg_trg_KICK_execute, udg_New_Kick_Dialog)
    call TriggerAddAction(gg_trg_KICK_execute, function Trig_KICK_execute_Actions)
endfunction

