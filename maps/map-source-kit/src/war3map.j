//
// ok
//===========================================================================
function Trig_status_Conditions takes nothing returns boolean
    if ( not ( udg_admin_level[GetConvertedPlayerId(GetTriggerPlayer())] >= 90 ) ) then
        return false
    endif
    return true
endfunction

function Trig_status_Func003Func001001 takes nothing returns boolean
    return ( udg_player_active[udg_X] == true )
endfunction

function Trig_status_Func003Func002001 takes nothing returns boolean
    return ( udg_leave_or_votekick[udg_X] == true )
endfunction

function Trig_status_Actions takes nothing returns nothing
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( (udg_player_active[udg_X] == true) ) then // INLINED!!
            set udg_playerstatus[udg_X]="ACTIVE: |cff00ff00YES|r "
        else
            set udg_playerstatus[udg_X]="ACTIVE: |cffff0000NO|r "
        endif
        if ( (udg_leave_or_votekick[udg_X] == true) ) then // INLINED!!
            set udg_playerstatus[udg_X]=( udg_playerstatus[udg_X] + "| LEAVE / KICK: |cff00ff00YES|r" )
        else
            set udg_playerstatus[udg_X]=( udg_playerstatus[udg_X] + "| LEAVE / KICK: |cffff0000NO|r" )
        endif
        call DisplayTextToForce(udg_temp_playergroup, ( GetPlayerName(ConvertedPlayer(udg_X)) + udg_playerstatus[udg_X] ))
        set udg_X=udg_X + 1
    endloop
    call DestroyForce(udg_temp_playergroup)
endfunction

