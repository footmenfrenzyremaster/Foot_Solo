// Trigger: KICK execute
//===========================================================================
function Trig_KICK_execute_Func002C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_New_Kick_Dialog_Cancel_Button ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_execute_Func005Func001C takes nothing returns boolean
    if ( not ( udg_New_Kick_Current_Page < udg_New_Kick_Total_Pages ) ) then
        return false
    endif
    return true
endfunction

