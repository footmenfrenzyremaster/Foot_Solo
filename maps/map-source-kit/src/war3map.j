//===========================================================================
// Trigger: HERO Corruptor Defile Action
//===========================================================================
function Trig_HERO_Corruptor_Defile_Action_Func025002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Defile_Caster)) == true )
endfunction

function Trig_HERO_Corruptor_Defile_Action_Func026Func001Func002C takes nothing returns boolean
    if ( ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == true ) ) then
        return true
    endif
    if ( ( BlzIsUnitInvulnerable(GetEnumUnit()) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Corruptor_Defile_Action_Func026Func001C takes nothing returns boolean
    if ( not Trig_HERO_Corruptor_Defile_Action_Func026Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Corruptor_Defile_Action_Func026A takes nothing returns nothing
    if ( Trig_HERO_Corruptor_Defile_Action_Func026Func001C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Defile_Group)
    else
    endif
endfunction

function Trig_HERO_Corruptor_Defile_Action_Func041C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Defile_Group) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Corruptor_Defile_Action_Func043A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Defile_Caster, GetEnumUnit(), udg_Defile_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
endfunction

function Trig_HERO_Corruptor_Defile_Action_Actions takes nothing returns nothing
    local integer i= 0
    loop
    exitwhen i > 24
    set i=i + 1
    if GetExpiredTimer() == udg_timer_defile[i] then
    set udg_X=i
    set i=100
    endif
    endloop
    //                                                                                            
    // ==================================================
    // DEFINE THE DAMAGE PER LVL:
    set udg_Defile_Damage[1]=45.00
    set udg_Defile_Damage[2]=85.00
    set udg_Defile_Damage[3]=160.00
    set udg_Defile_Damage[4]=225.00
    set udg_Defile_Damage[5]=275.00
    set udg_Defile_Damage[6]=350.00
    // ==================================================
    //                                                                                            
    set udg_Defile_Caster=udg_herO[udg_X]
    set udg_Defile_Level=GetUnitAbilityLevelSwapped('A0G8', udg_Defile_Caster)
    // 145 base AoE + 32 to account for the average collision size
    set udg_temp_AoE=165.00
    set udg_Defile_Group=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_defile_point[udg_X], Condition(function Trig_HERO_Corruptor_Defile_Action_Func025002003))
    call ForGroupBJ(udg_Defile_Group, function Trig_HERO_Corruptor_Defile_Action_Func026A)
    //                                                                                            
    call AddSpecialEffectLocBJ(udg_defile_point[udg_X], "Void Disc.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.50)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                            
    // SLOW ALL UNITS
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Defile_Caster), udg_defile_point[udg_X], bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0FZ', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0FZ', udg_dummy, udg_Defile_Level)
    call IssueImmediateOrderBJ(udg_dummy, "thunderclap")
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_dummy)
    //                                                                                            
    // Double damage on single target:
    if ( Trig_HERO_Corruptor_Defile_Action_Func041C() ) then
        set udg_Defile_Damage[0]=( udg_Defile_Damage[udg_Defile_Level] * 2.00 )
    else
        set udg_Defile_Damage[0]=( udg_Defile_Damage[udg_Defile_Level] + 0.00 )
    endif
    //                                                                                            
    call ForGroupBJ(udg_Defile_Group, function Trig_HERO_Corruptor_Defile_Action_Func043A)
    //                                                                                            
    call RemoveLocation(udg_defile_point[udg_X])
    call DestroyGroup(udg_Defile_Group)
endfunction

//===========================================================================
function InitTrig_HERO_Corruptor_Defile_Action takes nothing returns nothing
    set gg_trg_HERO_Corruptor_Defile_Action=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[1])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[2])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[3])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[4])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[5])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[6])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[7])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[8])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[9])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[10])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[11])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Corruptor_Defile_Action, udg_timer_defile[12])
    call TriggerAddAction(gg_trg_HERO_Corruptor_Defile_Action, function Trig_HERO_Corruptor_Defile_Action_Actions)
endfunction

