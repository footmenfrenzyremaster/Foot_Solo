//===========================================================================
// Trigger: DDE Destroy Effect
//===========================================================================
function Trig_DDE_Destroy_Effect_Func001Func001C takes nothing returns boolean
    if ( not ( udg_DDE_Hide_Death_Animation == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DDE_Destroy_Effect_Func001Func002C takes nothing returns boolean
    if ( not ( udg_DDE_Hide_Death_Animation == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DDE_Destroy_Effect_Func001C takes nothing returns boolean
    if ( not ( udg_DDE_Duration > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DDE_Destroy_Effect_Actions takes nothing returns nothing
    if ( Trig_DDE_Destroy_Effect_Func001C() ) then
        if ( Trig_DDE_Destroy_Effect_Func001Func002C() ) then
            set udg_GST_Trigger=gg_trg_DDE_Expire
        else
            set udg_DDE_Hide_Death_Animation=false
            set udg_GST_Trigger=gg_trg_DDE_Expire_Hide
        endif
        call GST_Effect(udg_DDE_Effect , false , udg_DDE_Duration)
    else
        if ( Trig_DDE_Destroy_Effect_Func001Func001C() ) then
            set udg_GST_Trigger=gg_trg_DDE_Expire
            call GST_Effect(udg_DDE_Effect , false , udg_DDE_Duration)
        else
            call BlzSetSpecialEffectX(udg_DDE_Effect, 0.00)
            call BlzSetSpecialEffectY(udg_DDE_Effect, 4000.00)
            call BlzSetSpecialEffectHeight(udg_DDE_Effect, 5000.00)
            call DestroyEffectBJ(udg_DDE_Effect)
        endif
    endif
endfunction

//===========================================================================
function InitTrig_DDE_Destroy_Effect takes nothing returns nothing
    set gg_trg_DDE_Destroy_Effect=CreateTrigger()
    call TriggerAddAction(gg_trg_DDE_Destroy_Effect, function Trig_DDE_Destroy_Effect_Actions)
endfunction

//===========================================================================
// Trigger: DDE Destroy Last Created Effect
//===========================================================================
function Trig_DDE_Destroy_Last_Created_Effect_Func002Func001C takes nothing returns boolean
    if ( not ( udg_DDE_Hide_Death_Animation == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DDE_Destroy_Last_Created_Effect_Func002Func002C takes nothing returns boolean
    if ( not ( udg_DDE_Hide_Death_Animation == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DDE_Destroy_Last_Created_Effect_Func002C takes nothing returns boolean
    if ( not ( udg_DDE_Duration > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DDE_Destroy_Last_Created_Effect_Actions takes nothing returns nothing
    local effect sfx= bj_lastCreatedEffect
    if ( Trig_DDE_Destroy_Last_Created_Effect_Func002C() ) then
        if ( Trig_DDE_Destroy_Last_Created_Effect_Func002Func002C() ) then
            set udg_GST_Trigger=gg_trg_DDE_Expire
        else
            set udg_DDE_Hide_Death_Animation=false
            set udg_GST_Trigger=gg_trg_DDE_Expire_Hide
        endif
        call GST_Effect(sfx , false , udg_DDE_Duration)
    else
        if ( Trig_DDE_Destroy_Last_Created_Effect_Func002Func001C() ) then
            set udg_GST_Trigger=gg_trg_DDE_Expire
            call GST_Effect(sfx , false , udg_DDE_Duration)
        else
            call BlzSetSpecialEffectX(udg_DDE_Effect, 0.00)
            call BlzSetSpecialEffectY(udg_DDE_Effect, 4000.00)
            call BlzSetSpecialEffectHeight(udg_DDE_Effect, 5000.00)
            call DestroyEffectBJ(udg_DDE_Effect)
        endif
    endif
    set sfx=null
endfunction

//===========================================================================
function InitTrig_DDE_Destroy_Last_Created_Effect takes nothing returns nothing
    set gg_trg_DDE_Destroy_Last_Created_Effect=CreateTrigger()
    call TriggerAddAction(gg_trg_DDE_Destroy_Last_Created_Effect, function Trig_DDE_Destroy_Last_Created_Effect_Actions)
endfunction

