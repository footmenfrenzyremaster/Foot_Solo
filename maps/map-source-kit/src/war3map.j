    return true
endfunction

function Trig_ITEM_Illusion_Func004Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(UnitItemInSlotBJ(udg_temp_unit, udg_X)) == 'rat6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Illusion_Func005Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Illusion_Func005Func004A takes nothing returns nothing
    if ( Trig_ITEM_Illusion_Func005Func004Func001C() ) then
        call KillUnit(GetEnumUnit())
    else
        call DoNothing()
    endif
endfunction

function Trig_ITEM_Illusion_Func005C takes nothing returns boolean
    if ( not ( udg_temp_int >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Illusion_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_int=0
    set udg_X=1
    loop
        exitwhen udg_X > 6
        if ( Trig_ITEM_Illusion_Func004Func001C() ) then
            set udg_temp_int=( udg_temp_int + 1 )
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
    if ( Trig_ITEM_Illusion_Func005C() ) then
        call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), "TRIGSTR_1701")
        set udg_temp_unitgroup=GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_temp_unit), GetUnitTypeId(udg_temp_unit))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_ITEM_Illusion_Func005Func004A)
        call DestroyGroup(udg_temp_unitgroup)
    else
        call DoNothing()
    endif
endfunction

