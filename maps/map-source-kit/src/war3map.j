function Trig_ITEM_combo_limits_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_item=GetManipulatedItem()
    set udg_temp_int=0
    // Slippers
    set udg_temp_item_type='rag1'
    if ( Trig_ITEM_combo_limits_Func007C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_combo_limits_Func007Func003Func001C() ) then
                call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
                call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), "TRIGSTR_8259")
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        call DoNothing()
    endif
    // Soldiers Mask
    set udg_temp_item_type='hval'
    if ( Trig_ITEM_combo_limits_Func010C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_combo_limits_Func010Func003Func001C() ) then
                call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
                call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), "TRIGSTR_10260")
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        call DoNothing()
    endif
    // Talisman of Evasion
    set udg_temp_item_type='evtl'
    if ( Trig_ITEM_combo_limits_Func013C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_combo_limits_Func013Func003Func001C() ) then
                call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
                call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), "TRIGSTR_10343")
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        call DoNothing()
    endif
