    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_autorevive_Func002002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_autorevive_Func004A takes nothing returns nothing
    call IssueTargetOrderBJ(GetEnumUnit(), "revive", GetTriggerUnit())
    call DisplayTextToForce(udg_temp_playergroup, ( "Your Hero " + ( GetUnitName(GetTriggerUnit()) + " will be automatically revived." ) ))
endfunction

function Trig_autorevive_Actions takes nothing returns nothing
    call TriggerSleepAction(10.00)
    set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetOwningPlayer(GetTriggerUnit()), Condition(function Trig_autorevive_Func002002002))
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_autorevive_Func004A)
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyForce(udg_temp_playergroup)
endfunction

