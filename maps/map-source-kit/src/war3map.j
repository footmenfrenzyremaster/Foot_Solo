    if ( not ( udg_spawnprotection == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_new_Func002Func002Func001C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId(udg_spawn_unit[udg_X], GetOwningPlayer(GetEnumUnit())) <= udg_maxunitnumber ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_new_Func002Func002A takes nothing returns nothing
    if ( Trig_eight_new_Func002Func002Func001C() ) then
        set udg_temp_point=GetUnitLoc(GetEnumUnit())
        call CreateNUnitsAtLoc(1, udg_spawn_unit[udg_X], GetOwningPlayer(GetEnumUnit()), udg_temp_point, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        if ( Trig_eight_new_Func002Func002Func001Func006C() ) then
            call UnitAddAbilityBJ('Avul', udg_temp_unit)
        else
            if ( Trig_eight_new_Func002Func002Func001Func006Func002C() ) then
                set bj_forLoopAIndex=1
                set bj_forLoopAIndexEnd=12
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    if ( Trig_eight_new_Func002Func002Func001Func006Func002Func001Func001C() ) then
                        call IssuePointOrderLocBJ(udg_temp_unit, "attack", GetRectCenter(GetPlayableMapRect()))
                    else
                        call IssueImmediateOrderBJ(udg_temp_unit, "stop")
                    endif
                    set bj_forLoopAIndex=bj_forLoopAIndex + 1
                endloop
            else
                call DoNothing()
            endif
        endif
    else
    endif
    call DestroyGroup(udg_main[udg_X])
endfunction

function Trig_eight_new_Actions takes nothing returns nothing
    set udg_X=0
    loop
        exitwhen udg_X > 3
        set udg_main[udg_X]=GetUnitsOfTypeIdAll(udg_new_base[udg_X])
        call ForGroupBJ(udg_main[udg_X], function Trig_eight_new_Func002Func002A)
        set udg_X=udg_X + 1
    endloop
    call RemoveLocation(udg_temp_point)
endfunction

