//===========================================================================
function Trig_MODE_new_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSellingUnit()) == 'h03Y' ) ) then
        return false
    endif
    if ( not ( udg_version_W3C == false ) ) then
        return false
    endif
    if ( not ( udg_autohost == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == udg_Host ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func011C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_temp_unit) == 'h054' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func012C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_temp_unit) == 'h04P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func014Func005Func001C takes nothing returns boolean
    if ( not ( udg_hero_category[udg_X] == 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func014C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_temp_unit) == 'h03V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func016Func001C takes nothing returns boolean
    if ( not ( true == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func016C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_temp_unit) == 'h03Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Func017C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_temp_unit) == 'h04B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_new_Actions takes nothing returns nothing
    set udg_temp_unit=GetSoldUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    call RemoveUnit(udg_temp_unit)
    // CHECK WHICH MODE(S) HAVE BEEN SELECTED
    // KOTH OFF
    if ( Trig_MODE_new_Func011C() ) then
        call DisplayTextToForce(udg_all_players, "TRIGSTR_11571")
        call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + " has selected to disable King of the Hill mode!|r" ))
        set udg_mode_koth=false
        call PlaySoundBJ(gg_snd_QuestNew)
    else
    endif
    if ( Trig_MODE_new_Func012C() ) then
        call DisplayTextToForce(udg_all_players, "TRIGSTR_11573")
        call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + " has selected to play King of the Hill mode!|r" ))
        set udg_mode_koth=true
        call PlaySoundBJ(gg_snd_QuestNew)
    else
    endif
    // No Mute
    if ( Trig_MODE_new_Func014C() ) then
        set udg_wmd[3]=( "|cff00ffffNo Transmute:|r |cff00ff00On|r" )
        call DisplayTextToForce(udg_all_players, "TRIGSTR_11586")
        call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + " has selected to play with no Transmute mode.|r" ))
        call PlaySoundBJ(gg_snd_KnightGoldMineCollapsed1)
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            if ( Trig_MODE_new_Func014Func005Func001C() ) then
                set udg_hero_category[udg_X]=0
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        call DoNothing()
    endif
    // 777
    if ( Trig_MODE_new_Func016C() ) then
        if ( Trig_MODE_new_Func016Func001C() ) then
            set udg_wmd[7]=( "|cff00ffff777 Club:|r |cff00ff00On|r" )
            call DisplayTextToForce(udg_all_players, "TRIGSTR_11620")
            call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + " has selected to play the 777 Club Mode!|r |cffffff00$$$ |r" ))
            set udg_mode_777club=true
        else
            call DisplayTextToForce(bj_FORCE_PLAYER[0], "TRIGSTR_11621")
        endif
    else
        call DoNothing()
    endif
    if ( Trig_MODE_new_Func017C() ) then
        set udg_wmd[10]=( "|cff00ffffNo TP:|r |cff00ff00On|r" )
        call DisplayTextToForce(udg_all_players, "TRIGSTR_13547")
        call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + " has selected to play without Pooling.|r" ))
        set udg_mode_promode=true
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_MODE_new takes nothing returns nothing
    set gg_trg_MODE_new=CreateTrigger()
    call DisableTrigger(gg_trg_MODE_new)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MODE_new, EVENT_PLAYER_UNIT_SELL)
    call TriggerAddCondition(gg_trg_MODE_new, Condition(function Trig_MODE_new_Conditions))
    call TriggerAddAction(gg_trg_MODE_new, function Trig_MODE_new_Actions)
endfunction

