endfunction

function Trig_Start_Vote_Actions takes nothing returns nothing
    call EnableSelect(false, true)
    set udg_X=1
    loop
        exitwhen udg_X > 12
        call SelectUnitForPlayerSingle(udg_mode_selector[udg_X], ConvertedPlayer(udg_X))
        set udg_X=udg_X + 1
    endloop
    call ForForce(udg_all_players, function Trig_Start_Vote_Func004A)
    call ClearTextMessagesBJ(udg_all_players)
    call DisplayTextToForce(udg_all_players, "TRIGSTR_1065")
    set udg_voting=true
    set udg_voting_mode=1
    set udg_t_voting=10.00
    call StartTimerBJ(udg_timer_voting, false, udg_t_voting)
    set udg_timer_window_voting=GetLastCreatedTimerDialogBJ()
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

