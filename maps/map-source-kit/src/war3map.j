function Trig_check_if_team_active_Actions takes nothing returns nothing
    if ( Trig_check_if_team_active_Func002C() ) then
        set udg_force_defeat[1]=true
        set udg_X=1
        loop
            exitwhen udg_X > 3
            set udg_player_active[udg_X]=false
            set udg_X=udg_X + 1
        endloop
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call DisplayTextToForce(udg_all_players, "TRIGSTR_2021")
    else
        call DoNothing()
    endif
    if ( Trig_check_if_team_active_Func003C() ) then
        set udg_force_defeat[2]=true
        set udg_X=4
        loop
            exitwhen udg_X > 6
            set udg_player_active[udg_X]=false
            set udg_X=udg_X + 1
        endloop
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call DisplayTextToForce(udg_all_players, "TRIGSTR_2022")
    else
        call DoNothing()
    endif
    if ( Trig_check_if_team_active_Func004C() ) then
        set udg_force_defeat[3]=true
        set udg_X=7
        loop
            exitwhen udg_X > 9
            set udg_player_active[udg_X]=false
            set udg_X=udg_X + 1
        endloop
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call DisplayTextToForce(udg_all_players, "TRIGSTR_2023")
    else
        call DoNothing()
    endif
    if ( Trig_check_if_team_active_Func005C() ) then
        set udg_force_defeat[4]=true
        set udg_X=10
        loop
            exitwhen udg_X > 12
            set udg_player_active[udg_X]=false
            set udg_X=udg_X + 1
        endloop
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call DisplayTextToForce(udg_all_players, "TRIGSTR_2024")
    else
        call DoNothing()
    endif
endfunction

