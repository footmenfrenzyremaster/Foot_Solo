//
// CHECK #2 - OK
//===========================================================================
function Trig_HERO_Jaina_Ulti_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A048' ) ) then
        return false
    endif
    if ( not ( udg_b1ik[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Jaina_Ulti_Func030003001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_orb[3])) == true )
endfunction

function Trig_HERO_Jaina_Ulti_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point_caster=GetSpellTargetLoc()
    set udg_tripple_level=GetUnitAbilityLevelSwapped('A048', udg_temp_unit)
    // create ORBs
    set udg_temp_point=PolarProjectionBJ(udg_temp_point_caster, 80.00, 0)
    call CreateNUnitsAtLoc(1, 'h01L', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_orb[1]=GetLastCreatedUnit()
    set udg_temp_point=PolarProjectionBJ(udg_temp_point_caster, 80.00, 120.00)
    call CreateNUnitsAtLoc(1, 'h01M', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_orb[2]=GetLastCreatedUnit()
    set udg_temp_point=PolarProjectionBJ(udg_temp_point_caster, 80.00, 240.00)
    call CreateNUnitsAtLoc(1, 'h01N', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_orb[3]=GetLastCreatedUnit()
    // add abilities
    call UnitAddAbilityBJ('A063', udg_orb[1])
    call UnitAddAbilityBJ('A064', udg_orb[2])
    call UnitAddAbilityBJ('A065', udg_orb[3])
    // set levels
    call SetUnitAbilityLevelSwapped('A063', udg_orb[1], udg_tripple_level)
    call SetUnitAbilityLevelSwapped('A064', udg_orb[2], udg_tripple_level)
    call SetUnitAbilityLevelSwapped('A065', udg_orb[3], udg_tripple_level)
    // Frost ORB
    call IssueImmediateOrderBJ(udg_orb[1], "stomp")
    call TriggerSleepAction(1.00)
    // Fire ORB
    call IssuePointOrderLocBJ(udg_orb[2], "rainoffire", GetUnitLoc(udg_orb[2]))
    call TriggerSleepAction(1.00)
    // Lightning ORB
    call IssueTargetOrderBJ(udg_orb[3], "chainlightning", GroupPickRandomUnit(GetUnitsInRangeOfLocMatching(512, GetUnitLoc(udg_orb[3]), Condition(function Trig_HERO_Jaina_Ulti_Func030003001003))))
    call TriggerSleepAction(2.00)
    // remove ORBs
    set udg_X=1
    loop
        exitwhen udg_X > 3
        call RemoveUnit(udg_orb[udg_X])
        set udg_X=udg_X + 1
    endloop
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_HERO_Jaina_Ulti takes nothing returns nothing
    set gg_trg_HERO_Jaina_Ulti=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Jaina_Ulti, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Jaina_Ulti, Condition(function Trig_HERO_Jaina_Ulti_Conditions))
    call TriggerAddAction(gg_trg_HERO_Jaina_Ulti, function Trig_HERO_Jaina_Ulti_Actions)
endfunction

//===========================================================================
// Trigger: HERO Not Guilty
//
// CHECK #2 - OK
//===========================================================================
function Trig_HERO_Not_Guilty_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Not_Guilty_Func008C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Not_Guilty_Func009C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Not_Guilty_Func010C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Not_Guilty_Func012002003 takes nothing returns boolean
    return ( IsUnitAlly(GetFilterUnit(), udg_temp_player) == true )
endfunction

function Trig_HERO_Not_Guilty_Func014A takes nothing returns nothing
    set udg_temp_int=( udg_temp_int + 1 )
    call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A090', udg_dummy)
    call SetUnitAbilityLevelSwapped('A090', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "innerfire", GetEnumUnit())
    call UnitAddAbilityBJ('A0FC', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0FC', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "frostarmor", GetEnumUnit())
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
endfunction

function Trig_HERO_Not_Guilty_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    if ( Trig_HERO_Not_Guilty_Func008C() ) then
        set udg_temp_AoE=350.00
        call UnitAddItemByIdSwapped('I01M', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01M'))
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Not_Guilty_Func009C() ) then
        set udg_temp_AoE=450.00
        call UnitAddItemByIdSwapped('I01L', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01L'))
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Not_Guilty_Func010C() ) then
        set udg_temp_AoE=500.00
        call UnitAddItemByIdSwapped('I01N', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01N'))
    else
        call DoNothing()
    endif
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_Not_Guilty_Func012002003))
    set udg_temp_int=0
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Not_Guilty_Func014A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

//===========================================================================
function InitTrig_HERO_Not_Guilty takes nothing returns nothing
    set gg_trg_HERO_Not_Guilty=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Not_Guilty, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Not_Guilty, Condition(function Trig_HERO_Not_Guilty_Conditions))
    call TriggerAddAction(gg_trg_HERO_Not_Guilty, function Trig_HERO_Not_Guilty_Actions)
endfunction

//===========================================================================
// Trigger: Objection
//===========================================================================
function Trig_Objection_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0M1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Objection_Func010C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_temp_target, udg_temp_player) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Objection_Actions takes nothing returns nothing
    // SET BASE VARIABLES
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_target=GetSpellTargetUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    // ACTION TIME
    if ( Trig_Objection_Func010C() ) then
        // TARGET = ENEMY
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('ANso', udg_dummy)
        call SetUnitAbilityLevelSwapped('ANso', udg_dummy, udg_abilitylevel)
        call IssueTargetOrderBJ(udg_dummy, "soulburn", udg_temp_target)
        call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    else
        // TARGET = FRIEND
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0EK', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0EK', udg_dummy, udg_abilitylevel)
        call IssueTargetOrderBJ(udg_dummy, "rejuvination", udg_temp_target)
        call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
        call PlaySoundAtPointBJ(gg_snd_MassTeleportTarget, 100, udg_temp_point, 0)
        call AddSpecialEffectLocBJ(udg_temp_point, "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call SetUnitPositionLoc(udg_temp_target, udg_player_start[udg_temp_playernumber])
    endif
    // CLEANUP TIME
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_Objection takes nothing returns nothing
    set gg_trg_Objection=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Objection, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Objection, Condition(function Trig_Objection_Conditions))
    call TriggerAddAction(gg_trg_Objection, function Trig_Objection_Actions)
endfunction

