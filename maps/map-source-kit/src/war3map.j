function InitTrig_Axe_OnHit takes nothing returns nothing
    set gg_trg_Axe_OnHit=CreateTrigger()
    call TriggerAddCondition(gg_trg_Axe_OnHit, Condition(function Trig_Axe_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Axe_OnHit, function Trig_Axe_OnHit_Actions)
endfunction

//===========================================================================
// Trigger: Hammer Cast
//===========================================================================
function Trig_Hammer_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ANSP' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Cast_Func002C takes nothing returns boolean
    if ( not ( udg_NS_Damage[1] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Cast_Func020Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_HU_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Cast_Func020C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('AHUL', udg_MissileSource) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Cast_Actions takes nothing returns nothing
    // DEFINE HAMMER DAMAGE PER LEVEL:
    if ( Trig_Hammer_Cast_Func002C() ) then
        set udg_NS_Damage[1]=100.00
        set udg_NS_Damage[2]=175.00
        set udg_NS_Damage[3]=225.00
        set udg_NS_Damage[4]=275.00
        set udg_NS_Damage[5]=400.00
        set udg_NS_Damage[6]=550.00
    else
    endif
    //                                                                                                     
    set udg_NS_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_NS_Point[1]=GetSpellTargetLoc()
    set udg_NS_Angle=AngleBetweenPoints(udg_NS_Point[0], udg_NS_Point[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=GetUnitLoc(udg_MissileSource)
    set udg_MissileFinish=PolarProjectionBJ(udg_NS_Point[0], 1150.00, udg_NS_Angle)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="Storm Bolt.mdx"
    set udg_MissileScale=1.25
    set udg_MissileCollision=70.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=1200.00
    set udg_MissileVision=300.00
    if ( Trig_Hammer_Cast_Func020C() ) then
        // A unique number to let us know that it's been empowered by the ulti:
        set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
        set udg_MissileData=( udg_MissileData + ( 100 * GetUnitAbilityLevelSwapped('AHAM', udg_MissileSource) ) )
        call GroupRemoveUnitSimple(udg_MissileSource, udg_HU_Group)
        call UnitRemoveAbilityBJ('AHUL', udg_MissileSource)
        call UnitRemoveBuffBJ('B01J', udg_MissileSource)
        if ( Trig_Hammer_Cast_Func020Func008C() ) then
            call DisableTrigger(gg_trg_Hammer_Ulti_Loop)
        else
        endif
    else
        set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    endif
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Hammer_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_NS_Point[0])
    call RemoveLocation(udg_NS_Point[1])
endfunction

//===========================================================================
function InitTrig_Hammer_Cast takes nothing returns nothing
    set gg_trg_Hammer_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Hammer_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Hammer_Cast, Condition(function Trig_Hammer_Cast_Conditions))
    call TriggerAddAction(gg_trg_Hammer_Cast, function Trig_Hammer_Cast_Actions)
endfunction

