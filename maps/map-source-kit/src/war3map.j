function InitTrig_HERO_Footgirl_Interchange takes nothing returns nothing
    set gg_trg_HERO_Footgirl_Interchange=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Footgirl_Interchange, EVENT_PLAYER_UNIT_SPELL_EFFECT)
