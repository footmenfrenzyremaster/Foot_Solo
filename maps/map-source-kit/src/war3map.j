//===========================================================================
// Trigger: MASS timer
//
// CHECK #2 - OK 300s trade
//===========================================================================
function Trig_MASS_timer_Func004C takes nothing returns boolean
    if ( not ( udg_mode_inhouse == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MASS_timer_Actions takes nothing returns nothing
    // MASS TIMER: 1 min 30
    set udg_t_premass=90.00
    if ( Trig_MASS_timer_Func004C() ) then
        set udg_t_premass=90.00
    else
        call DoNothing()
    endif
    //                     
    // Bonus footies 5 seconds before Mass:
    call StartTimerBJ(udg_timer_premass_bonus, false, ( udg_t_premass - 5.00 ))
    //                     
    call StartTimerBJ(udg_timer_premass, false, udg_t_premass)
    call CreateTimerDialogBJ(udg_timer_premass, "TRIGSTR_1138")
    set udg_timer_window_premass=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_timer_window_premass)
    //                     
endfunction

//===========================================================================
function InitTrig_MASS_timer takes nothing returns nothing
    set gg_trg_MASS_timer=CreateTrigger()
    call DisableTrigger(gg_trg_MASS_timer)
    call TriggerRegisterTimerEventSingle(gg_trg_MASS_timer, 0.10)
    call TriggerAddAction(gg_trg_MASS_timer, function Trig_MASS_timer_Actions)
endfunction

//===========================================================================
// Trigger: keep footy in base
//
// CHECK #2 - OK
//===========================================================================
function Trig_keep_footy_in_base_Conditions takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_timer_premass) > 0.00 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'hfoo' ) ) then
        return false
    endif
    return true
endfunction

function Trig_keep_footy_in_base_Func009C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_timer) <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_keep_footy_in_base_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(udg_temp_unit))
    set udg_temp_real=AngleBetweenPoints(udg_centermap, GetUnitLoc(udg_temp_unit))
    set udg_temp_point=PolarProjectionBJ(GetUnitLoc(udg_temp_unit), 100.00, udg_temp_real)
    call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
    call IssueImmediateOrderBJ(udg_temp_unit, "stop")
    call RemoveLocation(udg_temp_point)
    if ( Trig_keep_footy_in_base_Func009C() ) then
        call StartTimerBJ(udg_timer, false, 1.00)
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1137")
    else
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

//===========================================================================
function InitTrig_keep_footy_in_base takes nothing returns nothing
    set gg_trg_keep_footy_in_base=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_keep_footy_in_base, gg_rct_CENTER)
    call TriggerAddCondition(gg_trg_keep_footy_in_base, Condition(function Trig_keep_footy_in_base_Conditions))
    call TriggerAddAction(gg_trg_keep_footy_in_base, function Trig_keep_footy_in_base_Actions)
endfunction

//===========================================================================
// Trigger: MASS PRE START BONUS
//===========================================================================
function Trig_MASS_PRE_START_BONUS_Actions takes nothing returns nothing
    // Define the number of footmen that spawn every 20 seconds (first spawn happens NOW):
    set udg_Mass_Bonus_Spawns[1]=3
    set udg_Mass_Bonus_Spawns[2]=4
    set udg_Mass_Bonus_Spawns[3]=5
    set udg_Mass_Bonus_Spawns[4]=4
    set udg_Mass_Bonus_Spawns[5]=4
    set udg_Mass_Bonus_Spawns[6]=0
    set udg_Mass_Bonus_Spawns[7]=0
    set udg_Mass_Bonus_Spawns[8]=0
    //                     
    // Create bonus footies and begin the bonus timer for extra footies throughout mass:
    call StartTimerBJ(udg_spawnMassTimer, true, 20.00)
    call ConditionalTriggerExecute(gg_trg_eight_mass_bonus)
endfunction

//===========================================================================
function InitTrig_MASS_PRE_START_BONUS takes nothing returns nothing
    set gg_trg_MASS_PRE_START_BONUS=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_MASS_PRE_START_BONUS, udg_timer_premass_bonus)
    call TriggerAddAction(gg_trg_MASS_PRE_START_BONUS, function Trig_MASS_PRE_START_BONUS_Actions)
endfunction

//===========================================================================
// Trigger: Mass START
//
// CHECK #2 - OK
// 204
//===========================================================================
function Trig_Mass_START_Func002Func009C takes nothing returns boolean
    if ( not ( udg_mode_inhouse == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func014Func001C takes nothing returns boolean
    if ( not ( udg_AI_player[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func014Func004Func002Func003C takes nothing returns boolean
    if ( not ( udg_autosend[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func014Func004Func002C takes nothing returns boolean
    if ( not Trig_Mass_START_Func002Func014Func004Func002Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func014Func004A takes nothing returns nothing
    call UnitRemoveAbilityBJ('Avul', GetEnumUnit())
    if ( Trig_Mass_START_Func002Func014Func004Func002C() ) then
        call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetRectCenter(GetPlayableMapRect()))
    else
        call DoNothing()
    endif
endfunction

function Trig_Mass_START_Func002Func016Func001C takes nothing returns boolean
    if ( not ( udg_mode_pub == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func030Func003Func002Func003C takes nothing returns boolean
    if ( not ( udg_autosend[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func030Func003Func002C takes nothing returns boolean
    if ( not Trig_Mass_START_Func002Func030Func003Func002Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Func002Func030Func003A takes nothing returns nothing
    call UnitRemoveAbilityBJ('Avul', GetEnumUnit())
    if ( Trig_Mass_START_Func002Func030Func003Func002C() ) then
        call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetRectCenter(GetPlayableMapRect()))
    else
        call DoNothing()
    endif
endfunction

function Trig_Mass_START_Func002C takes nothing returns boolean
    if ( not ( udg_mode_no_mass == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_START_Actions takes nothing returns nothing
    call TimerDialogDisplayBJ(false, udg_timer_window_premass)
    if ( Trig_Mass_START_Func002C() ) then
        call DestroyTextTagBJ(udg_game_mode_floating_text)
        call DestroyTextTagBJ(udg_wonky_mode_floating_text)
        set udg_t_mass=1.00
        call TimerDialogDisplayBJ(false, udg_timer_window_premass)
        call StartTimerBJ(udg_timer_mass, false, udg_t_mass)
        set udg_timer_window_mass=GetLastCreatedTimerDialogBJ()
        set udg_spawnprotection=false
        set udg_mass_active=true
        call DisableTrigger(gg_trg_keep_footy_in_base)
        set udg_X=1
        loop
            exitwhen udg_X > 12
            call SetPlayerHandicapReviveTimeBJ(ConvertedPlayer(udg_X), 100.00)
            set udg_number_of_spawned_units[udg_X]=1
            call ForGroupBJ(GetUnitsOfPlayerAndTypeId(ConvertedPlayer(udg_X), 'hfoo'), function Trig_Mass_START_Func002Func030Func003A)
            set udg_X=udg_X + 1
        endloop
        call DestroyGroup(udg_temp_unitgroup)
        call ConditionalTriggerExecute(gg_trg_Destroy_Triggers_2)
        call DestroyTrigger(GetTriggeringTrigger())
    else
        call PlaySoundBJ(gg_snd_TheHornOfCenarius)
        call DestroyTextTagBJ(udg_game_mode_floating_text)
        call DestroyTextTagBJ(udg_wonky_mode_floating_text)
        set udg_t_mass=( ( 9.00 * 8.25 ) * 2.00 )
        call StartTimerBJ(udg_timer_mass, false, udg_t_mass)
        call CreateTimerDialogBJ(udg_timer_mass, "TRIGSTR_10294")
        set udg_timer_window_mass=GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ(true, udg_timer_window_mass)
        if ( Trig_Mass_START_Func002Func009C() ) then
            call TimerDialogDisplayBJ(false, udg_timer_window_mass)
        else
            call DoNothing()
        endif
        set udg_spawnprotection=false
        set udg_mass_active=true
        call DisableTrigger(gg_trg_keep_footy_in_base)
        // AUTOSEND
        set udg_X=1
        loop
            exitwhen udg_X > 12
            if ( Trig_Mass_START_Func002Func014Func001C() ) then
                call IssuePointOrderLocBJ(udg_herO[udg_X], "attack", udg_centermap)
            else
                call DoNothing()
            endif
            call SetPlayerHandicapReviveTimeBJ(ConvertedPlayer(udg_X), 100.00)
            set udg_number_of_spawned_units[udg_X]=1
            call ForGroupBJ(GetUnitsOfPlayerAndTypeId(ConvertedPlayer(udg_X), 'hfoo'), function Trig_Mass_START_Func002Func014Func004A)
            set udg_X=udg_X + 1
        endloop
        // AUTO BEASTSCROLL
        set udg_X_playernumber=1
        loop
            exitwhen udg_X_playernumber > 12
            if ( Trig_Mass_START_Func002Func016Func001C() ) then
                set udg_temp_point=udg_player_start[udg_X_playernumber]
                call CreateNUnitsAtLoc(1, 'h01K', ConvertedPlayer(udg_X_playernumber), udg_temp_point, bj_UNIT_FACING)
                set udg_dummy=GetLastCreatedUnit()
                call UnitAddAbilityBJ('A0H5', udg_dummy)
                call IssueImmediateOrderBJ(udg_dummy, "roar")
                call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
            else
                call DoNothing()
            endif
            set udg_X_playernumber=udg_X_playernumber + 1
        endloop
        call DestroyGroup(udg_temp_unitgroup)
        call ConditionalTriggerExecute(gg_trg_Destroy_Triggers_2)
        call DestroyTrigger(GetTriggeringTrigger())
    endif
endfunction

