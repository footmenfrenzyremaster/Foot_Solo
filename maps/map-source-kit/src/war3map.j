    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(6), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(7), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(8), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(9), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(10), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(11), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(12), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(13), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(14), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(15), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(16), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(17), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(18), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(19), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(20), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(21), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(22), "-kick", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_KICK_command, Player(23), "-kick", true)
    call TriggerAddCondition(gg_trg_KICK_command, Condition(function Trig_KICK_command_Conditions))
