            call DisplayTextToForce(udg_temp_playergroup, ( ( ( "(Tip #|cffffff00 " + I2S(udg_guided_tip_number) ) + ( "|r of|cffffff00 " + ( I2S(udg_total_tips) + "|r) - |cff00ff00 " ) ) ) + udg_guided_tip[udg_guided_tip_number] ))
            if ( Trig_GM_send_messages_Func003Func001Func003C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
