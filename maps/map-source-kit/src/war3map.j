function Trig_Multiboard_Update_Func005C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_temp_killing_unit, ConvertedPlayer(udg_pn_die)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_temp_killing_unit) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_temp_killing_unit) != 0 ) ) then
        return false
    endif
    if ( not ( udg_pn_killer >= 1 ) ) then
        return false
    endif
    if ( not ( udg_pn_killer <= 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Update_Actions takes nothing returns nothing
    set udg_temp_killing_unit=GetKillingUnitBJ()
    set udg_temp_dying_unit=GetDyingUnit()
    set udg_pn_killer=GetConvertedPlayerId(GetOwningPlayer(udg_temp_killing_unit))
    set udg_pn_die=GetConvertedPlayerId(GetOwningPlayer(udg_temp_dying_unit))
    if ( Trig_Multiboard_Update_Func005C() ) then
        // Hero Kills / Deaths
        if ( Trig_Multiboard_Update_Func005Func007C() ) then
            // BONUS GOLD BASED ON WINNING FACTOR:
            if ( Trig_Multiboard_Update_Func005Func007Func002C() ) then
                set udg_TeamNumber=GetPlayerTeam(ConvertedPlayer(udg_pn_die))
                if ( Trig_Multiboard_Update_Func005Func007Func002Func003C() ) then
                    call AdjustPlayerStateBJ(R2I(( I2R(BlzGetUnitIntegerField(udg_temp_dying_unit, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)) * udg_Team1stPlaceBountyMultiplier )), ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_GOLD)
                else
                    if ( Trig_Multiboard_Update_Func005Func007Func002Func003Func002C() ) then
                        call AdjustPlayerStateBJ(R2I(( I2R(BlzGetUnitIntegerField(udg_temp_dying_unit, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)) * udg_Team2ndPlaceBountyMultiplier )), ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_GOLD)
                    else
                    endif
                endif
            else
            endif
            //                                                                                                     
            call AdjustPlayerStateBJ(1, ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_LUMBER)
            set udg_hero_kills[udg_pn_killer]=( udg_hero_kills[udg_pn_killer] + 1 )
            set udg_hero_deaths[udg_pn_die]=( udg_hero_deaths[udg_pn_die] + 1 )
            // HERO - KILL FIRSTBLOOD
            if ( Trig_Multiboard_Update_Func005Func007Func009C() ) then
                set udg_firstblood=true
                call PlaySoundBJ(gg_snd_ArrangedTeamInvitation)
                call DisplayTimedTextToForce(GetPlayersAll(), 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + ( " has just gotten " + ( "|cffff0000FIRST BLOOD|r " + ( " by killing " + GetPlayerName(ConvertedPlayer(udg_pn_die)) ) ) ) ))
            else
                call DisplayTimedTextToForce(GetPlayersAll(), 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + ( " has " + ( "|cffff0000slain|r " + ( " " + GetPlayerName(ConvertedPlayer(udg_pn_die)) ) ) ) ))
            endif
            // HERO - KILL STREAK
            set udg_hero_killstreak[udg_pn_die]=0
            set udg_hero_killstreak[udg_pn_killer]=( udg_hero_killstreak[udg_pn_killer] + 1 )
            set udg_temp_playergroup=GetForceOfPlayer(ConvertedPlayer(udg_pn_killer))
            call DisplayTextToForce(udg_temp_playergroup, ( "You're on a |cff00ff00" + ( I2S(udg_hero_killstreak[udg_pn_killer]) + "|r Hero kill streak!" ) ))
            call DestroyForce(udg_temp_playergroup)
            if ( Trig_Multiboard_Update_Func005Func007Func016C() ) then
                call DisplayTimedTextToForce(udg_all_players, 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + " - |cffffff00K|r|cffffea00i|r|cffffd500l|r|cffffc000l|r|cffffaa00i|r|cffff9500n|r|cffff8000g|r|cffff6b00 |r|cffff5500S|r|cffff4000p|r|cffff2b00r|r|cffff1600e|r|cffff0000e|r" ))
            else
                if ( Trig_Multiboard_Update_Func005Func007Func016Func001C() ) then
                    call DisplayTimedTextToForce(udg_all_players, 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + " - |cffffff00R|r|cffffd500a|r|cffffaa00m|r|cffff8000p|r|cffff5500a|r|cffff2b00g|r|cffff0000e|r" ))
                else
                    if ( Trig_Multiboard_Update_Func005Func007Func016Func001Func001C() ) then
                        call DisplayTimedTextToForce(udg_all_players, 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + " - |cffffff00D|r|cffffe300o|r|cffffc700m|r|cffffaa00i|r|cffff8e00n|r|cffff7200a|r|cffff5500t|r|cffff3900i|r|cffff1d00n|r|cffff0000g|r" ))
                    else
                        if ( Trig_Multiboard_Update_Func005Func007Func016Func001Func001Func001C() ) then
                            call DisplayTimedTextToForce(udg_all_players, 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + " - |cffffff00U|r|cffffe600n|r|cffffcc00s|r|cffffb300t|r|cffff9900o|r|cffff8000p|r|cffff6600p|r|cffff4d00a|r|cffff3300b|r|cffff1a00l|r|cffff0000e|r" ))
                        else
                            if ( Trig_Multiboard_Update_Func005Func007Func016Func001Func001Func001Func001C() ) then
                                call DisplayTimedTextToForce(udg_all_players, 2.00, ( GetPlayerName(ConvertedPlayer(udg_pn_killer)) + " - |cffffff00G|r|cffffd500o|r|cffffaa00d|r|cffff8000l|r|cffff5500i|r|cffff2b00k|r|cffff0000e|r" ))
                            else
                            endif
                        endif
                    endif
                endif
            endif
            // [TEAM] Hero Kills
            if ( Trig_Multiboard_Update_Func005Func007Func018C() ) then
                set udg_team_hero_kills[udg_teamnumber[udg_pn_killer]]=( udg_team_hero_kills[udg_teamnumber[udg_pn_killer]] + 1 )
                call MultiboardSetItemValueBJ(udg_multiboard_kills, 3, ( udg_teamnumber[udg_pn_killer] + 1 ), I2S(udg_team_hero_kills[udg_teamnumber[udg_pn_killer]]))
            else
            endif
        else
            call DoNothing()
        endif
        // Unit Kills
        if ( Trig_Multiboard_Update_Func005Func009C() ) then
            // BONUS GOLD BASED ON WINNING FACTOR:
            if ( Trig_Multiboard_Update_Func005Func009Func002C() ) then
                set udg_TeamNumber=GetPlayerTeam(ConvertedPlayer(udg_pn_die))
                if ( Trig_Multiboard_Update_Func005Func009Func002Func003C() ) then
                    call AdjustPlayerStateBJ(R2I(( I2R(BlzGetUnitIntegerField(udg_temp_dying_unit, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)) * udg_Team1stPlaceBountyMultiplier )), ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_GOLD)
                else
                    if ( Trig_Multiboard_Update_Func005Func009Func002Func003Func002C() ) then
                        call AdjustPlayerStateBJ(R2I(( I2R(BlzGetUnitIntegerField(udg_temp_dying_unit, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)) * udg_Team2ndPlaceBountyMultiplier )), ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_GOLD)
                    else
                    endif
                endif
            else
            endif
            //                                                                                                     
            set udg_creep_gold_cost=0
            set udg_creep_gold_cost=BlzGetUnitIntegerField(udg_temp_dying_unit, UNIT_IF_LUMBER_BOUNTY_AWARDED_BASE)
            call SetPlayerStateBJ(ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(ConvertedPlayer(udg_pn_killer), PLAYER_STATE_RESOURCE_LUMBER) - udg_creep_gold_cost ))
            set udg_unit_kills[udg_pn_killer]=( udg_unit_kills[udg_pn_killer] + 1 )
            set udg_unit_deaths[udg_pn_die]=( udg_unit_deaths[udg_pn_die] + 1 )
            // Uncle; WHAT IS HAPPENING HERE?
            // [TEAM] Unit Kills
            if ( Trig_Multiboard_Update_Func005Func009Func012C() ) then
                set udg_team_unit_kills[udg_teamnumber[udg_pn_killer]]=( udg_team_unit_kills[udg_teamnumber[udg_pn_killer]] + 1 )
                call MultiboardSetItemValueBJ(udg_multiboard_kills, 2, ( udg_teamnumber[udg_pn_killer] + 1 ), I2S(udg_team_unit_kills[udg_teamnumber[udg_pn_killer]]))
            else
            endif
            if ( Trig_Multiboard_Update_Func005Func009Func013C() ) then
                set udg_team_unit_kills[udg_teamnumber[udg_pn_killer]]=( udg_team_unit_kills[udg_teamnumber[udg_pn_killer]] + 1 )
                call MultiboardSetItemValueBJ(udg_multiboard_kills, 2, ( udg_teamnumber[udg_pn_killer] + 1 ), I2S(udg_team_unit_kills[udg_teamnumber[udg_pn_killer]]))
            else
                call DoNothing()
            endif
        else
            call DoNothing()
        endif
        // Base Kills
        if ( Trig_Multiboard_Update_Func005Func011C() ) then
            set udg_base_kills[udg_pn_killer]=( udg_base_kills[udg_pn_killer] + 1 )
        else
            call DoNothing()
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Multiboard_Update takes nothing returns nothing
    set gg_trg_Multiboard_Update=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Multiboard_Update, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Multiboard_Update, Condition(function Trig_Multiboard_Update_Conditions))
    call TriggerAddAction(gg_trg_Multiboard_Update, function Trig_Multiboard_Update_Actions)
endfunction

//===========================================================================
// Trigger: Update Game Time
//===========================================================================
function Trig_Update_Game_Time_Func002C takes nothing returns boolean
    if ( not ( udg_Timer_Seconds == 60 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Update_Game_Time_Func003C takes nothing returns boolean
    if ( not ( udg_Timer_Seconds < 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Update_Game_Time_Actions takes nothing returns nothing
    set udg_Timer_Seconds=( udg_Timer_Seconds + 1 )
    if ( Trig_Update_Game_Time_Func002C() ) then
        set udg_Timer_Seconds=0
        set udg_Timer_Minutes=( udg_Timer_Minutes + 1 )
    else
    endif
    if ( Trig_Update_Game_Time_Func003C() ) then
        set udg_Temp_Time_String=( I2S(udg_Timer_Minutes) + ( ":0" + I2S(udg_Timer_Seconds) ) )
    else
        set udg_Temp_Time_String=( I2S(udg_Timer_Minutes) + ( ":" + I2S(udg_Timer_Seconds) ) )
    endif
    call MultiboardSetTitleText(udg_multiboard_kills, ( "Leaderboard - |cffffcc00" + ( udg_Temp_Time_String + "|r" ) ))
endfunction

//===========================================================================
function InitTrig_Update_Game_Time takes nothing returns nothing
    set gg_trg_Update_Game_Time=CreateTrigger()
    call DisableTrigger(gg_trg_Update_Game_Time)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Update_Game_Time, 1.00)
    call TriggerAddAction(gg_trg_Update_Game_Time, function Trig_Update_Game_Time_Actions)
endfunction

