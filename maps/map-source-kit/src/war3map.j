//===========================================================================
// Trigger: Searing Bullet
//===========================================================================
function Trig_Searing_Bullet_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0OE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_Func002C takes nothing returns boolean
    if ( not ( udg_QS_Damage[1] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_Actions takes nothing returns nothing
    // DEFINE SEARING BULLET DAMAGE PER LEVEL:
    if ( Trig_Searing_Bullet_Func002C() ) then
        set udg_QS_Damage[1]=150.00
        set udg_QS_Damage[2]=250.00
        set udg_QS_Damage[3]=325.00
        set udg_QS_Damage[4]=400.00
        set udg_QS_Damage[5]=500.00
        set udg_QS_Damage[6]=700.00
    else
    endif
    //                                                                                                     
    set udg_QS_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_QS_Point[1]=GetSpellTargetLoc()
    set udg_QS_Angle=AngleBetweenPoints(udg_QS_Point[0], udg_QS_Point[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=GetUnitLoc(udg_MissileSource)
    set udg_MissileFinish=PolarProjectionBJ(udg_QS_Point[0], 1350.00, udg_QS_Angle)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="war3mapImported\\Deadly Plumage HD Gold.mdx"
    set udg_MissileScale=0.60
    set udg_MissileCollision=60.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=1800.00
    set udg_MissileVision=300.00
    set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Searing_Bullet_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_QS_Point[0])
    call RemoveLocation(udg_QS_Point[1])
endfunction

//===========================================================================
function InitTrig_Searing_Bullet takes nothing returns nothing
    set gg_trg_Searing_Bullet=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Searing_Bullet, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Searing_Bullet, Condition(function Trig_Searing_Bullet_Conditions))
    call TriggerAddAction(gg_trg_Searing_Bullet, function Trig_Searing_Bullet_Actions)
endfunction

//===========================================================================
// Trigger: Searing Bullet OnHit
//===========================================================================
function Trig_Searing_Bullet_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitVisible(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_MissileHitUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_OnHit_Func011Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_QS_Target, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_QS_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target, UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_QS_Target) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_OnHit_Func011A takes nothing returns nothing
    set udg_QS_Target=GetEnumUnit()
    if ( Trig_Searing_Bullet_OnHit_Func011Func002C() ) then
        call UnitDamageTargetBJ(udg_MissileSource, udg_QS_Target, udg_QS_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_QS_Dummy, "thunderbolt", udg_QS_Target)
    else
    endif
endfunction

function Trig_Searing_Bullet_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    //                                                                                                     
    call CreateNUnitsAtLoc(1, 'dmmy', udg_MissileOwner, udg_MissilePosition, bj_UNIT_FACING)
    set udg_QS_Dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0OF', udg_QS_Dummy)
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_QS_Dummy)
    call SetUnitAbilityLevelSwapped('A0OF', udg_QS_Dummy, GetUnitAbilityLevelSwapped('A0OE', udg_MissileSource))
    set udg_QS_Damage[0]=udg_QS_Damage[udg_MissileData]
    //                                                                                                     
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(110.00, udg_MissilePosition), function Trig_Searing_Bullet_OnHit_Func011A)
endfunction

//===========================================================================
function InitTrig_Searing_Bullet_OnHit takes nothing returns nothing
    set gg_trg_Searing_Bullet_OnHit=CreateTrigger()
    call TriggerAddCondition(gg_trg_Searing_Bullet_OnHit, Condition(function Trig_Searing_Bullet_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Searing_Bullet_OnHit, function Trig_Searing_Bullet_OnHit_Actions)
endfunction

//===========================================================================
// Trigger: SovietSniper Reposition Cast
//===========================================================================
function Trig_SovietSniper_Reposition_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AREW' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Cast_Func007C takes nothing returns boolean
    if ( not ( IsUnitInGroup(udg_SovietSniper, udg_SovietSniper_RP_Caster_Group) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Cast_Actions takes nothing returns nothing
    set udg_SovietSniper=GetTriggerUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    set udg_SovietSniper_RP_Atk_On[udg_SovietSniper_CV]=false
    //                                                                                                          
    if ( Trig_SovietSniper_Reposition_Cast_Func007C() ) then
        // Add Attack Range:
        // (Blizzard broke this function but this setup works)
        call SetUnitAcquireRangeBJ(udg_SovietSniper, 850.00)
        call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 700.00)
        call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 1, 700.00)
        call SetUnitAcquireRangeBJ(udg_SovietSniper, 850.00)
    else
    endif
    //                                                                                                          
    // Invis Dummy:
    set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper)
    //                                                                                                          
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_SovietSniper), udg_SovietSniper_Point[0], bj_UNIT_FACING)
    set udg_SovietSniper_Unit[0]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_SovietSniper_Unit[0])
    call IssueTargetOrderBJ(udg_SovietSniper_Unit[0], "invisibility", udg_SovietSniper)
    //                                                                                                          
    call RemoveLocation(udg_SovietSniper_Point[0])
    //                                                                                                          
    call GroupAddUnitSimple(udg_SovietSniper, udg_SovietSniper_RP_Caster_Group)
    call EnableTrigger(gg_trg_SovietSniper_Reposition_Loop)
endfunction

//===========================================================================
function InitTrig_SovietSniper_Reposition_Cast takes nothing returns nothing
    set gg_trg_SovietSniper_Reposition_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SovietSniper_Reposition_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SovietSniper_Reposition_Cast, Condition(function Trig_SovietSniper_Reposition_Cast_Conditions))
    call TriggerAddAction(gg_trg_SovietSniper_Reposition_Cast, function Trig_SovietSniper_Reposition_Cast_Actions)
endfunction

//===========================================================================
// Trigger: SovietSniper Reposition Loop
//===========================================================================
function Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func011Func001Func012C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_SovietSniper_RP_Caster_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func011Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_SovietSniper, 'BRES') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func011C takes nothing returns boolean
    if ( not ( udg_SovietSniper_RP_Atk_On[udg_SovietSniper_CV] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func013C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_SovietSniper_RP_Caster_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Loop_Func002Func004Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SovietSniper) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Loop_Func002Func004C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_SovietSniper, 'BREI') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Reposition_Loop_Func002A takes nothing returns nothing
    set udg_SovietSniper=GetEnumUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    if ( Trig_SovietSniper_Reposition_Loop_Func002Func004C() ) then
        if ( Trig_SovietSniper_Reposition_Loop_Func002Func004Func002C() ) then
            // Add bonus attack speed and attack range for 3 seconds:
            //                                                                                                          
            if ( Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func011C() ) then
                set udg_SovietSniper_RP_Atk_On[udg_SovietSniper_CV]=true
                //                                                                                                          
                set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper)
                //                                                                                                          
                // Remove the Movement Speed bonus that was paired with Invisibility:
                //                                                                                                          
                // Attack Speed Dummy:
                call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_SovietSniper), udg_SovietSniper_Point[0], bj_UNIT_FACING)
                set udg_SovietSniper_Unit[0]=GetLastCreatedUnit()
                call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_SovietSniper_Unit[0])
                call UnitAddAbilityBJ('ARPA', udg_SovietSniper_Unit[0])
                call SetUnitAbilityLevelSwapped('ARPA', udg_SovietSniper_Unit[0], GetUnitAbilityLevelSwapped('AREP', udg_SovietSniper))
                call IssueTargetOrderBJ(udg_SovietSniper_Unit[0], "bloodlust", udg_SovietSniper)
                //                                                                                                          
                call RemoveLocation(udg_SovietSniper_Point[0])
                //                                                                                                          
                // Check if there was a ration waiting to be thrown:
            else
                if ( Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func011Func001C() ) then
                    //                                                                                                          
                    // Remove Attack Range:
                    // (Blizzard broke this function but this setup works)
                    call SetUnitAcquireRangeBJ(udg_SovietSniper, 650.00)
                    call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 300.00)
                    call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 1, 300.00)
                    call SetUnitAcquireRangeBJ(udg_SovietSniper, 650.00)
                    //                                                                                                          
                    // Finished:
                    call GroupRemoveUnitSimple(udg_SovietSniper, udg_SovietSniper_RP_Caster_Group)
                    if ( Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func011Func001Func012C() ) then
                        call DisableTrigger(GetTriggeringTrigger())
                    else
                    endif
                else
                endif
            endif
        else
            // Remove Attack Range:
            // (Blizzard broke this function but this setup works)
            call SetUnitAcquireRangeBJ(udg_SovietSniper, 650.00)
            call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 350.00)
            call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 1, 350.00)
            call SetUnitAcquireRangeBJ(udg_SovietSniper, 650.00)
            //                                                                                                          
            // Dead - End early:
            call GroupRemoveUnitSimple(udg_SovietSniper, udg_SovietSniper_RP_Caster_Group)
            if ( Trig_SovietSniper_Reposition_Loop_Func002Func004Func002Func013C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        endif
    else
    endif
endfunction

function Trig_SovietSniper_Reposition_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_SovietSniper_RP_Caster_Group, function Trig_SovietSniper_Reposition_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_SovietSniper_Reposition_Loop takes nothing returns nothing
    set gg_trg_SovietSniper_Reposition_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_SovietSniper_Reposition_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_SovietSniper_Reposition_Loop, 0.02)
    call TriggerAddAction(gg_trg_SovietSniper_Reposition_Loop, function Trig_SovietSniper_Reposition_Loop_Actions)
endfunction

//===========================================================================
// Trigger: SovietSniper Decoy Bomb Cast
//===========================================================================
function Trig_SovietSniper_Decoy_Bomb_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ADEC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Cast_Func006C takes nothing returns boolean
    if ( not ( udg_SovietSniper_DB_Damage_Per_Lvl[1] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Cast_Actions takes nothing returns nothing
    set udg_SovietSniper=GetTriggerUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    // Define damage scaling per level (once):
    if ( Trig_SovietSniper_Decoy_Bomb_Cast_Func006C() ) then
        set udg_SovietSniper_DB_Damage_Per_Lvl[1]=75.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[2]=125.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[3]=175.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[4]=200.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[5]=275.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[6]=400.00
    else
    endif
    //                                                                                                          
    // Missile Properties:
    set udg_MissileData=udg_SovietSniper_CV
    set udg_MissileSource=udg_SovietSniper
    set udg_MissileStart=GetUnitLoc(udg_SovietSniper)
    set udg_MissileFinish=GetSpellTargetLoc()
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl"
    set udg_MissileScale=1.20
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=25.00
    set udg_MissileSpeed=700.00
    //                                                                                                     
    // Arc should be between 0.00 and 80.00:
    set udg_MissileArc=40.00
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onFinish=gg_trg_SovietSniper_Decoy_Bomb_Create_Bomb
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
endfunction

//===========================================================================
function InitTrig_SovietSniper_Decoy_Bomb_Cast takes nothing returns nothing
    set gg_trg_SovietSniper_Decoy_Bomb_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SovietSniper_Decoy_Bomb_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SovietSniper_Decoy_Bomb_Cast, Condition(function Trig_SovietSniper_Decoy_Bomb_Cast_Conditions))
    call TriggerAddAction(gg_trg_SovietSniper_Decoy_Bomb_Cast, function Trig_SovietSniper_Decoy_Bomb_Cast_Actions)
endfunction

//===========================================================================
// Trigger: SovietSniper Decoy Bomb Create Bomb
//===========================================================================
function Trig_SovietSniper_Decoy_Bomb_Create_Bomb_Func021C takes nothing returns boolean
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Create_Bomb_Func024C takes nothing returns boolean
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Create_Bomb_Actions takes nothing returns nothing
    set udg_SovietSniper=udg_UDexUnits[udg_MissileData]
    //                                                                                                          
    call CreateNUnitsAtLoc(1, 'o013', GetOwningPlayer(udg_SovietSniper), udg_MissileFinish, bj_UNIT_FACING)
    set udg_SovietSniper_Unit[0]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_SovietSniper_Unit[0], "stand victory")
    //                                                                                                          
    set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper_Unit[0])
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper_Unit[0])
    set udg_SovietSniper_DB_Duration[udg_SovietSniper_CV]=0
    set udg_SovietSniper_DB_Hero[udg_SovietSniper_CV]=udg_SovietSniper
    set udg_SovietSniper_DB_Damage[udg_SovietSniper_CV]=udg_SovietSniper_DB_Damage_Per_Lvl[GetUnitAbilityLevelSwapped('ADEC', udg_SovietSniper)]
    //                                                                                                          
    // Warning effect (flamestrike):
    call AddSpecialEffectLocBJ(udg_MissileFinish, "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.50)
    call BlzSetSpecialEffectTimeScale(GetLastCreatedEffectBJ(), 3.00)
    set udg_DDE_Duration=2.00
    call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
    //                                                                                                          
    // Explosive barrels:
    if ( (true) ) then // INLINED!!
        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], GetRandomReal(35.00, 45.00), GetRandomReal(340.00, 355.00))
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "Units\\Other\\TNTBarrel\\TNTBarrel.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), GetRandomReal(1.00, 1.20))
        call RemoveLocation(udg_SovietSniper_Point[1])
        call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
        //                                                                                                          
        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], GetRandomReal(35.00, 45.00), GetRandomReal(80.00, 100.00))
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "Units\\Other\\TNTBarrel\\TNTBarrel.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), GetRandomReal(1.00, 1.20))
        call RemoveLocation(udg_SovietSniper_Point[1])
        call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
        //                                                                                                          
        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], GetRandomReal(35.00, 45.00), GetRandomReal(170.00, 190.00))
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "Units\\Other\\TNTBarrel\\TNTBarrel.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), GetRandomReal(1.00, 1.20))
        call RemoveLocation(udg_SovietSniper_Point[1])
        call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
        //                                                                                                          
    else
    endif
    //                                                                                                          
    // Goblin land mines:
    if ( (true) ) then // INLINED!!
        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], GetRandomReal(100.00, 120.00), GetRandomReal(20.00, 80.00))
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "units\\creeps\\GoblinLandMine\\GoblinLandMine.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.85)
        call RemoveLocation(udg_SovietSniper_Point[1])
        call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
        //                                                                                                          
        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], GetRandomReal(100.00, 120.00), GetRandomReal(140.00, 200.00))
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "units\\creeps\\GoblinLandMine\\GoblinLandMine.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.85)
        call RemoveLocation(udg_SovietSniper_Point[1])
        call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
        //                                                                                                          
        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], GetRandomReal(100.00, 120.00), GetRandomReal(260.00, 320.00))
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "units\\creeps\\GoblinLandMine\\GoblinLandMine.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.85)
        call RemoveLocation(udg_SovietSniper_Point[1])
        call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
    else
    endif
    //                                                                                                          
    call RemoveLocation(udg_SovietSniper_Point[0])
    //                                                                                                          
    call GroupAddUnitSimple(udg_SovietSniper_Unit[0], udg_SovietSniper_DB_Bomb_Group)
    call EnableTrigger(gg_trg_SovietSniper_Decoy_Bomb_Loop)
endfunction

