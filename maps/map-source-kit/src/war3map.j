//===========================================================================
// Trigger: VERSION CHECK
//===========================================================================
function Trig_VERSION_CHECK_Func009Func001Func001Func002C takes nothing returns boolean
    if ( ( udg_orig_player_name[udg_temp_playernumber] == "RJE#2927" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_temp_playernumber] == "RJE#11113" ) ) then
        return true
    endif
    return false
endfunction

function Trig_VERSION_CHECK_Func009Func001Func001C takes nothing returns boolean
    if ( not Trig_VERSION_CHECK_Func009Func001Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_VERSION_CHECK_Func009Func002C takes nothing returns boolean
    if ( not ( udg_admin[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VERSION_CHECK_Func009C takes nothing returns boolean
    if ( not ( udg_version_test == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VERSION_CHECK_Actions takes nothing returns nothing
    // VERSIONS
    set udg_version_test=false
    set udg_version_public=true
    set udg_version_tournament=false
    set udg_version_W3C=false
    // AUTOHOST
    // TEST
    if ( Trig_VERSION_CHECK_Func009C() ) then
        set udg_temp_playernumber=1
        loop
            exitwhen udg_temp_playernumber > 24
            if ( Trig_VERSION_CHECK_Func009Func001Func001C() ) then
                set udg_admin[1]=true
            else
                call DoNothing()
            endif
            set udg_temp_playernumber=udg_temp_playernumber + 1
        endloop
        if ( Trig_VERSION_CHECK_Func009Func002C() ) then
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2037")
        else
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2038")
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2039")
            call TriggerSleepAction(1.00)
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2040")
            call TriggerSleepAction(1.00)
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2041")
            call TriggerSleepAction(1.00)
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2042")
            call TriggerSleepAction(1.00)
            call DisplayTextToForce(udg_all_players, "TRIGSTR_2043")
            call TriggerSleepAction(1.00)
            set udg_X=1
            loop
                exitwhen udg_X > 12
                call CustomDefeatBJ(ConvertedPlayer(udg_X), "TRIGSTR_2044")
                set udg_X=udg_X + 1
            endloop
        endif
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_VERSION_CHECK takes nothing returns nothing
    set gg_trg_VERSION_CHECK=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_VERSION_CHECK, 0.01)
    call TriggerAddAction(gg_trg_VERSION_CHECK, function Trig_VERSION_CHECK_Actions)
endfunction

