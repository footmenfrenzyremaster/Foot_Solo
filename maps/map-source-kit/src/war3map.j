        return true
    endif
    if ( ( GetUnitTypeId(udg_ExpDeadUnit_Copy) == 'earc' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(udg_ExpDeadUnit_Copy) == 'uban' ) ) then
        return true
    endif
    return false
