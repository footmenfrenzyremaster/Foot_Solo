    if ( not ( udg_repicked[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_repick_command_Actions takes nothing returns nothing
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    if ( Trig_repick_command_Func002C() ) then
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetTriggerPlayer(), Condition(function Trig_repick_command_Func002Func003002002))
        set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
        set udg_temp_player=ConvertedPlayer(udg_temp_playernumber)
        if ( Trig_repick_command_Func002Func006C() ) then
            call ForGroupBJ(udg_temp_unitgroup, function Trig_repick_command_Func002Func006Func003A)
        else
            call ForGroupBJ(udg_temp_unitgroup, function Trig_repick_command_Func002Func006Func002A)
        endif
        call DestroyGroup(udg_temp_unitgroup)
        call DestroyForce(udg_temp_playergroup)
    else
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1691")
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

