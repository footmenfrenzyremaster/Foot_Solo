    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Adjust flying height of the unit:
    set udg_HCr_Height[0]=( ( udg_HCr_Height_Rate[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) - ( udg_HCr_Height_Factor[udg_HCr_CV] * ( udg_HCr_Height_Rate[udg_HCr_CV] * ( udg_HCr_Elapsed_Time[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) ) ) )
    call SetUnitFlyHeightBJ(udg_HCr_Caster, ( GetUnitDefaultFlyHeight(udg_HCr_Caster) + udg_HCr_Height[0] ), 0.00)
    //                                                                                                                    
    // Check if the duration is finished or if the caster died:
    if ( Trig_Pounce_Loop_Func002Func025C() ) then
        call GroupRemoveUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
        set udg_HCr_Caster_Count=( udg_HCr_Caster_Count - 1 )
        if ( Trig_Pounce_Loop_Func002Func025Func004C() ) then
            call DisableTrigger(gg_trg_Pounce_Loop)
        else
        endif
        //                                                                                                                    
        // For some reason Collision no longer turns off/on (1.35/1.36 bug):
        call SetUnitPathing(udg_HCr_Caster, true)
        //                                                                                                                    
        // This removes a triggered Stun from the unit (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, false)
        //                                                                                                                    
        call SetUnitFlyHeightBJ(udg_HCr_Caster, GetUnitDefaultFlyHeight(udg_HCr_Caster), 0.00)
        //                                                                                                                    
        // Damage and slow if the caster unit is still alive:
        if ( Trig_Pounce_Loop_Func002Func025Func015C() ) then
            set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
            call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[0])
            call SetUnitInvulnerable(udg_HCr_Caster, false)
            //                                                                                                                    
            //                                                                                                                    
            // Damage nearby enemy units and heal nearby allied units:
            set udg_HCr_Nearby_Group=GetUnitsInRangeOfLocAll(225.00, udg_HCr_Point[0])
            call ForGroupBJ(udg_HCr_Nearby_Group, function Trig_Pounce_Loop_Func002Func025Func015Func008A)
            //                                                                                                                    
            call RemoveLocation(udg_HCr_Point[0])
            call DestroyGroup(udg_HCr_Nearby_Group)
        else
        endif
    else
    endif
    //                                                                                                                    
endfunction

function Trig_Pounce_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_HCr_Caster_Group, function Trig_Pounce_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_Pounce_Loop takes nothing returns nothing
    set gg_trg_Pounce_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Pounce_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Pounce_Loop, 0.02)
    call TriggerAddAction(gg_trg_Pounce_Loop, function Trig_Pounce_Loop_Actions)
endfunction

//===========================================================================
// Trigger: Staff of the River
//===========================================================================
function Trig_Staff_of_the_River_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0R7' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Staff_of_the_River_Actions takes nothing returns nothing
    set udg_MonkeyKing=GetTriggerUnit()
    // DEFINE HEALING PER LEVEL:
    set udg_Jungle_Heal[1]=85.00
    set udg_Jungle_Heal[2]=125.00
    set udg_Jungle_Heal[3]=180.00
    set udg_Jungle_Heal[4]=225.00
    set udg_Jungle_Heal[5]=275.00
    set udg_Jungle_Heal[6]=375.00
    //                                                                                                     
    set udg_Jungle_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_Jungle_Point[1]=GetSpellTargetLoc()
    set udg_Jungle_Angle=AngleBetweenPoints(udg_Jungle_Point[0], udg_Jungle_Point[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 150.00, udg_Jungle_Angle)
    set udg_MissileFinish=PolarProjectionBJ(udg_Jungle_Point[0], 1000.00, udg_Jungle_Angle)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="war3mapImported\\Scepter of the Tides.mdx"
    set udg_MissileScale=3.00
    set udg_MissileCollision=90.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=1300.00
    set udg_MissileVision=300.00
    set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Staff_of_the_River_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_Jungle_Point[0])
    call RemoveLocation(udg_Jungle_Point[1])
endfunction

//===========================================================================
function InitTrig_Staff_of_the_River takes nothing returns nothing
    set gg_trg_Staff_of_the_River=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Staff_of_the_River, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Staff_of_the_River, Condition(function Trig_Staff_of_the_River_Conditions))
    call TriggerAddAction(gg_trg_Staff_of_the_River, function Trig_Staff_of_the_River_Actions)
endfunction

//===========================================================================
// Trigger: Staff of the River OnHit
//===========================================================================
function Trig_Staff_of_the_River_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Staff_of_the_River_OnHit_Func009Func002C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Jungle_Target, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Jungle_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Jungle_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Jungle_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Staff_of_the_River_OnHit_Func009A takes nothing returns nothing
    set udg_Jungle_Target=GetEnumUnit()
    if ( Trig_Staff_of_the_River_OnHit_Func009Func002C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call SetUnitLifeBJ(GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_Jungle_Heal[0] ))
    else
        call DoNothing()
    endif
endfunction

function Trig_Staff_of_the_River_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    set udg_Jungle_Heal[0]=udg_Jungle_Heal[udg_MissileData]
    call SetUnitPositionLocFacingBJ(udg_MonkeyKing, udg_MissilePosition, udg_Jungle_Angle)
    call AddSpecialEffectLocBJ(udg_MissilePosition, "war3mapImported\\Culling Slash.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.50)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(425.00, GetUnitLoc(udg_MissileSource)), function Trig_Staff_of_the_River_OnHit_Func009A)
endfunction

//===========================================================================
function InitTrig_Staff_of_the_River_OnHit takes nothing returns nothing
    set gg_trg_Staff_of_the_River_OnHit=CreateTrigger()
    call TriggerAddCondition(gg_trg_Staff_of_the_River_OnHit, Condition(function Trig_Staff_of_the_River_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Staff_of_the_River_OnHit, function Trig_Staff_of_the_River_OnHit_Actions)
endfunction

//===========================================================================
// Trigger: Akama Shadow Clone Cast
//===========================================================================
function Trig_Akama_Shadow_Clone_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func032C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[3] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func033C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[3] == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func034C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[3] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func043Func002C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[0] > udg_Akama_Integer[4] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func043C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[0] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func045Func002C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[1] > udg_Akama_Integer[4] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func045C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[1] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func047Func002C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[2] > udg_Akama_Integer[4] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Func047C takes nothing returns boolean
    if ( not ( udg_Akama_Integer[2] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Cast_Actions takes nothing returns nothing
    set udg_Akama=GetTriggerUnit()
    set udg_Akama_CV=GetUnitUserData(udg_Akama)
    //                                                                                                          
    // Get rid of the old Shadow Clone (if one somehow exists):
    call ConditionalTriggerExecute(gg_trg_Akama_Shadow_Clone_Destroy_Clone)
    //                                                                                                          
    set udg_Akama_SC_Update[udg_Akama_CV]=0
    //                                                                                                          
    set udg_Akama_Point[0]=GetUnitLoc(udg_Akama)
    set udg_Akama_Point[1]=PolarProjectionBJ(udg_Akama_Point[0], 120.00, GetUnitFacing(udg_Akama))
    //                                                                                                          
    call CreateNUnitsAtLoc(1, 'hSHC', GetOwningPlayer(udg_Akama), udg_Akama_Point[1], bj_UNIT_FACING)
    set udg_Akama_SC_Clone[udg_Akama_CV]=GetLastCreatedUnit()
    set udg_Akama_SC_Hero[GetUnitUserData(GetLastCreatedUnit())]=udg_Akama
    //                                                                                                          
    set udg_Akama_Point[2]=GetUnitLoc(udg_Akama_SC_Clone[udg_Akama_CV])
    call AddSpecialEffectLocBJ(udg_Akama_Point[2], "warpimpact.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.00)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                          
    // This is part of the Life Drain shared healing effect:
    call SetUnitLifeBJ(udg_Akama_SC_Clone[udg_Akama_CV], 1.00)
    //                                                                                                          
    call SetUnitVertexColorBJ(udg_Akama_SC_Clone[udg_Akama_CV], 100, 100, 100, 40.00)
    //                                                                                                          
    set udg_Akama_Integer[0]=GetUnitAbilityLevelSwapped('ASHS', udg_Akama)
    set udg_Akama_Integer[1]=GetUnitAbilityLevelSwapped('A0LH', udg_Akama)
    set udg_Akama_Integer[2]=GetUnitAbilityLevelSwapped('ALDR', udg_Akama)
    set udg_Akama_Integer[3]=GetUnitAbilityLevelSwapped('A00Q', udg_Akama)
    //                                                                                                          
    // Set Level Caps:
    if ( Trig_Akama_Shadow_Clone_Cast_Func032C() ) then
        // Max level = 2
        set udg_Akama_Integer[4]=3
    else
    endif
    if ( Trig_Akama_Shadow_Clone_Cast_Func033C() ) then
        // Max level = 3
        set udg_Akama_Integer[4]=4
    else
    endif
    if ( Trig_Akama_Shadow_Clone_Cast_Func034C() ) then
        // Max level = 6
        set udg_Akama_Integer[4]=6
    else
    endif
    //                                                                                                          
    // DEFINE THE SHADOW CLONE'S DURATION:
    set udg_Akama_SC_Duration[udg_Akama_CV]=( 40.00 + ( 5.00 * I2R(udg_Akama_Integer[3]) ) )
    //                                                                                                          
    // Change the passive damage per second (phoenix fire):
    call SetUnitAbilityLevelSwapped('ASHP', udg_Akama_SC_Clone[udg_Akama_CV], udg_Akama_Integer[3])
    //                                                                                                          
    // Add and level up hero abilities:
    if ( Trig_Akama_Shadow_Clone_Cast_Func043C() ) then
        call UnitAddAbilityBJ('ASHS', udg_Akama_SC_Clone[udg_Akama_CV])
        if ( Trig_Akama_Shadow_Clone_Cast_Func043Func002C() ) then
            set udg_Akama_Integer[0]=udg_Akama_Integer[4]
        else
        endif
        call SetUnitAbilityLevelSwapped('ASHS', udg_Akama_SC_Clone[udg_Akama_CV], udg_Akama_Integer[0])
    else
    endif
    //                                                                                                          
    if ( Trig_Akama_Shadow_Clone_Cast_Func045C() ) then
        call UnitAddAbilityBJ('A0LH', udg_Akama_SC_Clone[udg_Akama_CV])
        if ( Trig_Akama_Shadow_Clone_Cast_Func045Func002C() ) then
            set udg_Akama_Integer[1]=udg_Akama_Integer[4]
        else
        endif
        call SetUnitAbilityLevelSwapped('A0LH', udg_Akama_SC_Clone[udg_Akama_CV], udg_Akama_Integer[1])
    else
    endif
    //                                                                                                          
    if ( Trig_Akama_Shadow_Clone_Cast_Func047C() ) then
        call UnitAddAbilityBJ('ALDR', udg_Akama_SC_Clone[udg_Akama_CV])
        if ( Trig_Akama_Shadow_Clone_Cast_Func047Func002C() ) then
            set udg_Akama_Integer[2]=udg_Akama_Integer[4]
        else
        endif
        call SetUnitAbilityLevelSwapped('ALDR', udg_Akama_SC_Clone[udg_Akama_CV], udg_Akama_Integer[2])
    else
    endif
    //                                                                                                          
    call RemoveLocation(udg_Akama_Point[0])
    call RemoveLocation(udg_Akama_Point[1])
    call RemoveLocation(udg_Akama_Point[2])
    //                                                                                                          
    call GroupAddUnitSimple(udg_Akama, udg_Akama_SC_Hero_Group)
    call EnableTrigger(gg_trg_Akama_Shadow_Clone_Loop)
    call EnableTrigger(gg_trg_Akama_Shadow_Clone_Akama_Dies)
    call EnableTrigger(gg_trg_Akama_Shadow_Clone_Mimic_Start)
    call EnableTrigger(gg_trg_Akama_Shadow_Clone_Mimic_Stop)
endfunction

//===========================================================================
function InitTrig_Akama_Shadow_Clone_Cast takes nothing returns nothing
    set gg_trg_Akama_Shadow_Clone_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Shadow_Clone_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Akama_Shadow_Clone_Cast, Condition(function Trig_Akama_Shadow_Clone_Cast_Conditions))
    call TriggerAddAction(gg_trg_Akama_Shadow_Clone_Cast, function Trig_Akama_Shadow_Clone_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Akama Shadow Clone Loop
//===========================================================================
function Trig_Akama_Shadow_Clone_Loop_Func001Func003Func004C takes nothing returns boolean
    if ( not ( udg_Akama_SC_Duration[udg_Akama_CV] <= 0.01 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001Func003Func007C takes nothing returns boolean
    if ( not ( udg_Akama_SC_Update[udg_Akama_CV] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001Func003Func010Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Akama_Point[0], udg_Akama_Point[1]) >= 400.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001Func003Func010C takes nothing returns boolean
    if ( not ( udg_Akama_SC_Update[udg_Akama_CV] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001Func003Func013Func002C takes nothing returns boolean
    if ( not ( udg_Akama_Real[0] > 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001Func003Func013C takes nothing returns boolean
    if ( not ( GetUnitCurrentOrder(udg_Akama_SC_Clone[udg_Akama_CV]) == String2OrderIdBJ("drain") ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Akama) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Loop_Func001A takes nothing returns nothing
    set udg_Akama=GetEnumUnit()
    //                                                                                                          
    if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003C() ) then
        set udg_Akama_CV=GetUnitUserData(udg_Akama)
        //                                                                                                          
        set udg_Akama_SC_Duration[udg_Akama_CV]=( udg_Akama_SC_Duration[udg_Akama_CV] - 0.51 )
        if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003Func004C() ) then
            // Get rid of the old Shadow Clone:
            call ConditionalTriggerExecute(gg_trg_Akama_Shadow_Clone_Destroy_Clone)
            return
        else
        endif
        //                                                                                                          
        // Update it when necessary:
        if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003Func007C() ) then
            set udg_Akama_SC_Update[udg_Akama_CV]=( udg_Akama_SC_Update[udg_Akama_CV] - 1 )
        else
        endif
        //                                                                                                          
        // Follow the main hero:
        if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003Func010C() ) then
            set udg_Akama_Point[0]=GetUnitLoc(udg_Akama)
            set udg_Akama_Point[1]=GetUnitLoc(udg_Akama_SC_Clone[udg_Akama_CV])
            if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003Func010Func003C() ) then
                set udg_Akama_Point[2]=PolarProjectionBJ(udg_Akama_Point[0], 120.00, GetRandomDirectionDeg())
                call SetUnitPositionLoc(udg_Akama_SC_Clone[udg_Akama_CV], udg_Akama_Point[2])
                call RemoveLocation(udg_Akama_Point[2])
            else
            endif
            call RemoveLocation(udg_Akama_Point[0])
            call RemoveLocation(udg_Akama_Point[1])
            //                                                                                                          
            call IssueTargetOrderBJ(udg_Akama_SC_Clone[udg_Akama_CV], "move", udg_Akama)
            set udg_Akama_SC_Update[udg_Akama_CV]=2
        else
        endif
        //                                                                                                          
        // Share life from Life Drain:
        if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003Func013C() ) then
            set udg_Akama_Real[0]=GetUnitStateSwap(UNIT_STATE_LIFE, udg_Akama_SC_Clone[udg_Akama_CV])
            if ( Trig_Akama_Shadow_Clone_Loop_Func001Func003Func013Func002C() ) then
                set udg_Akama_Real[0]=( udg_Akama_Real[0] - 1 )
                call SetUnitLifeBJ(udg_Akama, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Akama) + udg_Akama_Real[0] ))
                call SetUnitLifeBJ(udg_Akama_SC_Clone[udg_Akama_CV], 1.00)
            else
            endif
        else
        endif
    else
    endif
endfunction

function Trig_Akama_Shadow_Clone_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Akama_SC_Hero_Group, function Trig_Akama_Shadow_Clone_Loop_Func001A)
endfunction

//===========================================================================
function InitTrig_Akama_Shadow_Clone_Loop takes nothing returns nothing
    set gg_trg_Akama_Shadow_Clone_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Akama_Shadow_Clone_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Akama_Shadow_Clone_Loop, 0.20)
    call TriggerAddAction(gg_trg_Akama_Shadow_Clone_Loop, function Trig_Akama_Shadow_Clone_Loop_Actions)
endfunction

//===========================================================================
// Trigger: Akama Shadow Clone Mimic Start
//===========================================================================
function Trig_Akama_Shadow_Clone_Mimic_Start_Func014C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'ASHS' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0LH' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'ALDR' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Akama_Shadow_Clone_Mimic_Start_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E00Z' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_Akama_SC_Clone[udg_Akama_CV]) != 0 ) ) then
        return false
    endif
    if ( not Trig_Akama_Shadow_Clone_Mimic_Start_Func014C() ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Mimic_Start_Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ASHS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Mimic_Start_Func008C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0LH' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Mimic_Start_Func011C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ALDR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Mimic_Start_Actions takes nothing returns nothing
    set udg_Akama=GetTriggerUnit()
    set udg_Akama_CV=GetUnitUserData(udg_Akama)
    //                                                                                                          
    // Blink:
    if ( Trig_Akama_Shadow_Clone_Mimic_Start_Func005C() ) then
        set udg_Akama_SC_Update[udg_Akama_CV]=4
        set udg_Akama_Point[0]=GetSpellTargetLoc()
        set udg_Akama_Point[1]=PolarProjectionBJ(udg_Akama_Point[0], 120.00, GetRandomDirectionDeg())
        call IssuePointOrderLocBJ(udg_Akama_SC_Clone[udg_Akama_CV], "blink", udg_Akama_Point[1])
        call RemoveLocation(udg_Akama_Point[0])
        call RemoveLocation(udg_Akama_Point[1])
    else
    endif
    //                                                                                                          
    // Shadow Strike:
    if ( Trig_Akama_Shadow_Clone_Mimic_Start_Func008C() ) then
        set udg_Akama_SC_Update[udg_Akama_CV]=10
        call IssueTargetOrderBJ(udg_Akama_SC_Clone[udg_Akama_CV], "shadowstrike", GetSpellTargetUnit())
    else
    endif
    //                                                                                                          
    // Life Drain:
    if ( Trig_Akama_Shadow_Clone_Mimic_Start_Func011C() ) then
        set udg_Akama_SC_Update[udg_Akama_CV]=18
        call IssueTargetOrderBJ(udg_Akama_SC_Clone[udg_Akama_CV], "drain", GetSpellTargetUnit())
    else
    endif
endfunction

//===========================================================================
function InitTrig_Akama_Shadow_Clone_Mimic_Start takes nothing returns nothing
    set gg_trg_Akama_Shadow_Clone_Mimic_Start=CreateTrigger()
    call DisableTrigger(gg_trg_Akama_Shadow_Clone_Mimic_Start)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Shadow_Clone_Mimic_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Akama_Shadow_Clone_Mimic_Start, Condition(function Trig_Akama_Shadow_Clone_Mimic_Start_Conditions))
    call TriggerAddAction(gg_trg_Akama_Shadow_Clone_Mimic_Start, function Trig_Akama_Shadow_Clone_Mimic_Start_Actions)
endfunction

