    if ( not ( GetClickedButtonBJ() == udg_New_Kick_Dialog_Prev_Button ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_execute_Func011Func001Func009Func004C takes nothing returns boolean
    if ( not ( udg_player_active[GetConvertedPlayerId(udg_ally1[udg_X])] == true ) ) then
        return false
    endif
    return true
endfunction

