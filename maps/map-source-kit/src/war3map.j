//===========================================================================
// Trigger: GM set messages
//
// CHECK #2 - OK
//===========================================================================
function Trig_GM_set_messages_Actions takes nothing returns nothing

set udg_total_tips=32

set udg_guided_tip[1]="To disable or enable tips, type |cffffff00-help|r. All of these tips are also available in the F9 menu."
set udg_guided_tip[2]="The speed and beast scroll are the two most important items in the early-mid game. These items ensure you have a good mass by greatly increasing the efficiency of your footmen. Use them as soon as mass starts!"
set udg_guided_tip[3]="Remember to share control. Sharing control helps if players go AFK, get blocked by friendly units, etc."
set udg_guided_tip[4]="Consider consolidating your scrolls. It could be helpful to have one player manage the beast and speed scrolls. This ensures that two of the same scrolls are not used at the same time. Remember scrolls do not stack."
set udg_guided_tip[5]="Consider having only one player on your team tech upgrade. This means that the other two players can focus on farming and supporting."
set udg_guided_tip[6]="Consider pooling gold to one player for more powerful tech upgrades."
set udg_guided_tip[7]="Rebuy your beast scroll. Investing 500 gold in more beast scrolls will change the tides of mid-game and late-game fights."
set udg_guided_tip[8]="There is a free invisible potion at one of your base shops that respawns regularly."
set udg_guided_tip[9]="Remember to reinforce your mass. Keeping sending footmen from your base to reinforce, this will prevent you from being surrounded and continue getting valuable experience."
set udg_guided_tip[10]="Auras don't stack. If you have two heroes on your team with the same aura, ensure that only one of those heroes is maxing the aura skill."
set udg_guided_tip[11]="Buy creeps! Creeps are some of the most useful units in the game. For example, a Jamie creep can dispell low-level summons and even a tank."
set udg_guided_tip[12]="Don't feed. Killing off your footmen using a cannon will avoid enemy heroes from farming gold and gaining valuable experience. Remember every killed unit means a gold bounty."
set udg_guided_tip[13]="Buy frost towers. Frost towers are the most important defensive upgrade in the game. They prevent farming and can result in important hero kills."
set udg_guided_tip[14]="Deny kills. Kill your own low-health units to avoid the enemy getting valuable gold and experience."
set udg_guided_tip[15]="Behind on levels? Use a time of power or experience."
set udg_guided_tip[16]="Wondering why other players are such overleveled? It may be because they worked with their team--teamwork helps you farm, buy leveling items, and get critical upgrades."
set udg_guided_tip[17]="Keep getting killed by other heroes? Use a invisible potion of a priest of protection creep’s invisibility spell to sneak past hero killers."
set udg_guided_tip[18]="Use healing wards. They keep your army alive and avoid feeding."
set udg_guided_tip[19]="Most summons (including Dark Ranger's minions) are dispellable. Use a wand of negation, Jamie, or Blank War Golem."
set udg_guided_tip[20]="Keep getting hexed or slept? Use a Blank War Golem's consume magic spell to instantly remove the spell effect."
set udg_guided_tip[21]="Use Control + Number on numberpad to create control groups. You can put units, buildings, and even creeps in separate control groups."
set udg_guided_tip[22]="Type |cffffff00-players|r to see what heroes other players have picked. This will inform your strategy."
set udg_guided_tip[23]="Want to learn more about footmen frenzy? Join the discord, and be sure to introduce yourself -> discord.gg/WES9tY"
set udg_guided_tip[24]="Beware of tanks. The tank is the best tool to end players early. If you see a player with the tank token, invest in a wand of negation or another creep/item that can dispell. Tanks are dispellable!"
set udg_guided_tip[25]="Carry a teleport scroll, always."
set udg_guided_tip[26]="Positioning is everything. Try to maximize your army's damage output by using attack move and not allowing units get surrounded. If you see a 'U-shape' of enemy units form around yours, retreat and reposition."
set udg_guided_tip[27]="Position your hero to get as much experience from unit kills as possible during mass."
set udg_guided_tip[28]="If you have a hero with an aura or AOE spell, pick that spell first for mass. It is helpful for gaining the most possible experience or outright winning mass. If you both, ask a teammate what you should pick."
set udg_guided_tip[29]="Use the shockwave item! This item is available at one of your base shops after a certain period of time and can kill footmen in one hit."
set udg_guided_tip[30]="Use dusts of appearance frequently. Dusts reveal those sneaky farmers and even a potential basekill attempt."
set udg_guided_tip[31]="Use AOE spells on weak units."
set udg_guided_tip[32]="Use speed scrolls to save units in less desirable fights."

call DestroyTrigger(GetTriggeringTrigger())

endfunction

//===========================================================================
function InitTrig_GM_set_messages takes nothing returns nothing
    set gg_trg_GM_set_messages=CreateTrigger()
    call TriggerAddAction(gg_trg_GM_set_messages, function Trig_GM_set_messages_Actions)
endfunction


