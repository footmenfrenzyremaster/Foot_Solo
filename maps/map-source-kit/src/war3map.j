//===========================================================================
// Trigger: ITEM Wall
//
// CHECK #2 - OK
//===========================================================================
function Trig_ITEM_Wall_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetConstructedStructure()) == 'h02S' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetConstructedStructure()) == 'h02T' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ITEM_Wall_Conditions takes nothing returns boolean
    if ( not Trig_ITEM_Wall_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Wall_Func006001 takes nothing returns boolean
    return ( udg_wall_ID == 20 )
endfunction

function Trig_ITEM_Wall_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_ITEM_Wall_countdown)
    set udg_temp_unit=GetConstructedStructure()
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
    if ( (udg_wall_ID == 20) ) then // INLINED!!
        set udg_wall_ID=0
    else
        call DoNothing()
    endif
    set udg_wall_ID=( udg_wall_ID + 1 )
    call SetUnitUserData(udg_temp_unit, udg_wall_ID)
    call UnitApplyTimedLifeBJ(40.00, 'BTLF', udg_temp_unit)
    call StartTimerBJ(udg_wall_timer[udg_wall_ID], false, 40.00)
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_wall_timer[udg_wall_ID]), 2, 0), udg_temp_point, 0, 9.00, 100, 100, 100, 25.00)
    set udg_wall_timer_text[udg_wall_ID]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_wall_timer_text[udg_wall_ID], 40.00)
endfunction

//===========================================================================
function InitTrig_ITEM_Wall takes nothing returns nothing
    set gg_trg_ITEM_Wall=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_Wall, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_ITEM_Wall, Condition(function Trig_ITEM_Wall_Conditions))
    call TriggerAddAction(gg_trg_ITEM_Wall, function Trig_ITEM_Wall_Actions)
endfunction

//===========================================================================
// Trigger: ITEM Wall countdown
//
// CHECK #2 - OK
//===========================================================================
function Trig_ITEM_Wall_countdown_Func001Func002001 takes nothing returns boolean
    return ( TimerGetRemaining(udg_wall_timer[GetForLoopIndexA()]) < 1.00 )
endfunction

function Trig_ITEM_Wall_countdown_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetTextTagTextBJ(udg_wall_timer_text[GetForLoopIndexA()], R2SW(TimerGetRemaining(udg_wall_timer[GetForLoopIndexA()]), 2, 0), 9.00)
        if ( (TimerGetRemaining(udg_wall_timer[GetForLoopIndexA()]) < 1.00) ) then // INLINED!!
            call DestroyTextTagBJ(udg_wall_timer_text[GetForLoopIndexA()])
        else
            call DoNothing()
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_ITEM_Wall_countdown takes nothing returns nothing
    set gg_trg_ITEM_Wall_countdown=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_ITEM_Wall_countdown, 1.00)
    call TriggerAddAction(gg_trg_ITEM_Wall_countdown, function Trig_ITEM_Wall_countdown_Actions)
endfunction

