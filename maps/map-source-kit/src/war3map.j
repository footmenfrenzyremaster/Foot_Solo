    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(9), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(10), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(11), "-vk", false)
    call TriggerAddCondition(gg_trg_Votekick_Initiate, Condition(function Trig_Votekick_Initiate_Conditions))
    call TriggerAddAction(gg_trg_Votekick_Initiate, function Trig_Votekick_Initiate_Actions)
endfunction

