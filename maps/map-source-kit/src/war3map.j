    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_player_destroyed_Func003Func001Func002001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_player_destroyed_Func003Func001C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_player_destroyed_Func003Func001Func002001001002))) > 0 ) ) then
        return false
