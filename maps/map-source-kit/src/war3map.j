//===========================================================================
// Trigger: Vote Timer Expires
//===========================================================================
function Trig_Vote_Timer_Expires_Func002Func008Func001Func002C takes nothing returns boolean
    if ( not ( udg_SD_votes > udg_AR_votes ) ) then
        return false
    endif
    if ( not ( udg_SD_votes > udg_AP_votes ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vote_Timer_Expires_Func002Func008Func001C takes nothing returns boolean
    if ( not ( udg_AR_votes > udg_AP_votes ) ) then
        return false
    endif
    if ( not ( udg_AR_votes > udg_SD_votes ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vote_Timer_Expires_Func002Func008C takes nothing returns boolean
    if ( not ( udg_AP_votes > udg_AR_votes ) ) then
        return false
    endif
    if ( not ( udg_AP_votes > udg_SD_votes ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vote_Timer_Expires_Func002C takes nothing returns boolean
    if ( not ( udg_voting_mode == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vote_Timer_Expires_Actions takes nothing returns nothing
    // Normal Vote Timer Expired (first time):
    if ( Trig_Vote_Timer_Expires_Func002C() ) then
        // Unsure if I'm supposed to hide this here:
        call TimerDialogDisplayBJ(false, udg_timer_window_voting)
        set udg_voting=false
        set udg_X=1
        loop
            exitwhen udg_X > 12
            set udg_AP_votes=( udg_AP_votes + udg_AP[udg_X] )
            set udg_AR_votes=( udg_AR_votes + udg_AR[udg_X] )
            set udg_SD_votes=( udg_SD_votes + udg_SD[udg_X] )
            set udg_X=udg_X + 1
        endloop
        call DisplayTextToForce(udg_all_players, ( I2S(udg_AR_votes) + " Votes for AR mode" ))
        call DisplayTextToForce(udg_all_players, ( I2S(udg_AP_votes) + " Votes for AP mode" ))
        call DisplayTextToForce(udg_all_players, ( I2S(udg_SD_votes) + " Votes for SD mode" ))
        if ( Trig_Vote_Timer_Expires_Func002Func008C() ) then
            call EnableTrigger(gg_trg_Start_AP)
            call ConditionalTriggerExecute(gg_trg_Start_AP)
            call ConditionalTriggerExecute(gg_trg_Start_game)
        else
            if ( Trig_Vote_Timer_Expires_Func002Func008Func001C() ) then
                call EnableTrigger(gg_trg_Start_AR)
                call ConditionalTriggerExecute(gg_trg_Start_AR)
                call ConditionalTriggerExecute(gg_trg_Start_game)
            else
                if ( Trig_Vote_Timer_Expires_Func002Func008Func001Func002C() ) then
                    call ConditionalTriggerExecute(gg_trg_Start_game)
                else
                endif
            endif
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Vote_Timer_Expires takes nothing returns nothing
    set gg_trg_Vote_Timer_Expires=CreateTrigger()
    call DisableTrigger(gg_trg_Vote_Timer_Expires)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Vote_Timer_Expires, udg_timer_voting)
    call TriggerAddAction(gg_trg_Vote_Timer_Expires, function Trig_Vote_Timer_Expires_Actions)
endfunction

//===========================================================================
// Trigger: KOTH Setup
//===========================================================================
function Trig_KOTH_Setup_Func012C takes nothing returns boolean
    if ( not ( udg_mode_overdrive == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Setup_Actions takes nothing returns nothing
    // THIS TIMER IS STARTED IN: Game mode/Game/MODE King Of The Hill
    //                                                                                                     
    // Define your King of the Hill variables:
    //                                                                                                     
    // The starting gold of the hill:
    set udg_KOTH_Gold_Starting_Total=99999
    set udg_KOTH_Gold_Remaining=udg_KOTH_Gold_Starting_Total
    //                                                                                                     
    // The default amount of gold rewarded whenever the income timer expires:
    set udg_KOTH_Gold_Rewarded=6
    set udg_KOTH_Gold_Division_Bonus=1
    if ( Trig_KOTH_Setup_Func012C() ) then
        set udg_KOTH_Gold_Rewarded=6
    else
        call DoNothing()
    endif
    //                                                                                                     
    // How much gold remaining is needed for the income reward to increase:
    set udg_KOTH_Gold_Half_Remaining=89000
    //                                                                                                     
    // How much gold a team can earn before the Hill resets:
    set udg_KOTH_Gold_Reset_Amount=300
    set udg_KOTH_Gold_Bounty=20
    //                                                                                                     
    // Create the starting hill:
    set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
    call CreateNUnitsAtLoc(1, 'koth', udg_KOTH_Player, udg_centermap, bj_UNIT_FACING)
    set udg_KOTH_Hill=GetLastCreatedUnit()
    call SetUnitVertexColorBJ(udg_KOTH_Hill, 100, 100, 100, 100.00)
    //                                                                                                     
    // Create the starting text:
    set udg_KOTH_Level=2
    call TriggerExecute(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    // Create the hero glow special effect:
    call TriggerExecute(gg_trg_KOTH_Create_Hill_Glow)
    //                                                                                                     
    //                                                                                                     
    // Starts timers for each level of the hill
    call StartTimerBJ(udg_KOTH_Second_Hill_Timer, false, 900.00)
    call StartTimerBJ(udg_KOTH_Third_Hill_Timer, false, 1800.00)
endfunction

//===========================================================================
function InitTrig_KOTH_Setup takes nothing returns nothing
    set gg_trg_KOTH_Setup=CreateTrigger()
    call DisableTrigger(gg_trg_KOTH_Setup)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_KOTH_Setup, udg_KOTH_Setup_Timer)
    call TriggerAddAction(gg_trg_KOTH_Setup, function Trig_KOTH_Setup_Actions)
endfunction

//===========================================================================
// Trigger: KOTH Income
//===========================================================================
function Trig_KOTH_Income_Func006Func001C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(GetEnumPlayer()) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func006A takes nothing returns nothing
    if ( Trig_KOTH_Income_Func006Func001C() ) then
        set udg_KOTH_Team_Size=( udg_KOTH_Team_Size + 1 )
    else
    endif
endfunction

function Trig_KOTH_Income_Func010C takes nothing returns boolean
    if ( not ( udg_KOTH_Team_Size == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func014A takes nothing returns nothing
    call AdjustPlayerStateBJ(( udg_KOTH_Gold_To_Add + udg_KOTH_Gold_Division_To_Add ), GetEnumPlayer(), PLAYER_STATE_RESOURCE_GOLD)
    set udg_KOTH_Gold_Division_To_Add=0
endfunction

function Trig_KOTH_Income_Func024Func002C takes nothing returns boolean
    if ( not ( udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number] >= udg_KOTH_Gold_Reset_Amount ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func024Func005C takes nothing returns boolean
    if ( not ( udg_KOTH_Gold_Remaining <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func024C takes nothing returns boolean
    if ( not ( udg_KOTH_Gold_Remaining <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Actions takes nothing returns nothing
    // Adjust the hill gold remaining:
    set udg_KOTH_Gold_Remaining=( udg_KOTH_Gold_Remaining - udg_KOTH_Gold_Rewarded )
    //                                                                                                     
    // Count how many active players are in the killing team:
    set udg_KOTH_Team_Size=0
    call ForForce(udg_KOTH_Team, function Trig_KOTH_Income_Func006A)
    //                                                                                                     
    // Calculate how much gold each player should earn:
    set udg_KOTH_Gold_Division_To_Add=0
    if ( Trig_KOTH_Income_Func010C() ) then
        set udg_KOTH_Gold_Division_To_Add=udg_KOTH_Gold_Division_Bonus
    else
    endif
    set udg_KOTH_Gold_To_Add=( udg_KOTH_Gold_Rewarded / udg_KOTH_Team_Size )
    //                                                                                                     
    // Add the gold to each player:
    call ForForce(udg_KOTH_Team, function Trig_KOTH_Income_Func014A)
    //                                                                                                     
    // Calculate the total amount of gold that team has earned:
    set udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number]=( udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number] + udg_KOTH_Gold_Rewarded )
    set udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number]=( udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number] + udg_KOTH_Gold_Rewarded )
    //                                                                                                     
    call TriggerExecute(gg_trg_KOTH_Update_Board_Gold)
    call TriggerExecute(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    // Check for many different scenarios regarding the hill and it's remaining gold:
    if ( Trig_KOTH_Income_Func024C() ) then
        // The Hill is completely out of gold:
        call PauseTimerBJ(true, udg_KOTH_Income_Timer)
        call RemoveUnit(udg_KOTH_Hill)
        set udg_KOTH_Gold_Remaining=0
    else
        // The Hill is now down to half of it's total remaining gold:
        if ( Trig_KOTH_Income_Func024Func002C() ) then
            set udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number]=0
            set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
            call PauseTimerBJ(true, udg_KOTH_Income_Timer)
            call TriggerExecute(gg_trg_KOTH_Reset_Hill)
        else
        endif
        //                                                                                                     
        if ( Trig_KOTH_Income_Func024Func005C() ) then
            call TriggerExecute(gg_trg_KOTH_Gold_Depleted)
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_KOTH_Income takes nothing returns nothing
    set gg_trg_KOTH_Income=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_KOTH_Income, udg_KOTH_Income_Timer)
    call TriggerAddAction(gg_trg_KOTH_Income, function Trig_KOTH_Income_Actions)
endfunction

//===========================================================================
// Trigger: KOTH Hill Dies
//===========================================================================
function Trig_KOTH_Hill_Dies_Conditions takes nothing returns boolean
    if ( not ( udg_KOTH_Hill == GetTriggerUnit() ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Hill_Dies_Func002Func011C takes nothing returns boolean
    if ( ( GetKillingUnitBJ() == null ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(bj_PLAYER_NEUTRAL_VICTIM) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(bj_PLAYER_NEUTRAL_EXTRA) ) ) then
        return true
    endif
    return false
endfunction

function Trig_KOTH_Hill_Dies_Func002C takes nothing returns boolean
    if ( not Trig_KOTH_Hill_Dies_Func002Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Hill_Dies_Actions takes nothing returns nothing
    // Let's make sure that the hill goes back to Neutral if we can't find the Player that killed it:
    if ( Trig_KOTH_Hill_Dies_Func002C() ) then
        call TriggerExecute(gg_trg_KOTH_Set_Neutral_Hill)
    else
        // An actual Player killed the Hill - Let's give them control:
        set udg_KOTH_Player=GetOwningPlayer(GetKillingUnitBJ())
        set udg_KOTH_Team_Number=udg_teamnumber[GetConvertedPlayerId(udg_KOTH_Player)]
        set udg_KOTH_Team=udg_team[udg_KOTH_Team_Number]
        set udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number]=( udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number] + udg_KOTH_Gold_Bounty )
        call TriggerExecute(gg_trg_KOTH_Update_Board_Gold)
        set udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number]=0
        call StartTimerBJ(udg_KOTH_Income_Timer, true, 3.00)
        call PingMinimapLocForForceEx(GetPlayersAll(), udg_centermap, 1, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 0.00, 0.00)
    endif
    //                                                                                                     
    // Some fancy special effects to show the Hill has been claimed:
    call AddSpecialEffectLocBJ(udg_centermap, "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    // Stop regenerating the hill's hp (this is just in case the regen still active):
    if udg_KOTH_Regen_SFX != null then
    call DestroyEffectBJ(udg_KOTH_Regen_SFX)
    endif
    //                                                                                                     
    // Recreate the hill:
    call TriggerExecute(gg_trg_KOTH_Reset_Hill)
endfunction

//===========================================================================
function InitTrig_KOTH_Hill_Dies takes nothing returns nothing
    set gg_trg_KOTH_Hill_Dies=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_KOTH_Hill_Dies, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_KOTH_Hill_Dies, Condition(function Trig_KOTH_Hill_Dies_Conditions))
    call TriggerAddAction(gg_trg_KOTH_Hill_Dies, function Trig_KOTH_Hill_Dies_Actions)
endfunction

//===========================================================================
// Trigger: KOTH Gold Depleted
//===========================================================================
function Trig_KOTH_Gold_Depleted_Actions takes nothing returns nothing
    call DisableTrigger(gg_trg_KOTH_Income)
    call DisableTrigger(gg_trg_KOTH_Hill_Dies)
    call DisableTrigger(gg_trg_KOTH_Gold_Depleted)
    call DisableTrigger(gg_trg_KOTH_Set_Neutral_Hill)
    call DisableTrigger(gg_trg_KOTH_Reset_Hill)
    call DisableTrigger(gg_trg_KOTH_Create_Hill_Glow)
    call DisableTrigger(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    call PauseTimerBJ(true, udg_KOTH_Income_Timer)
    //                                                                                                     
    call AddSpecialEffectLocBJ(udg_centermap, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    call DestroyEffectBJ(udg_KOTH_Hill_Glow_SFX)
    call DestroyEffectBJ(udg_KOTH_Regen_SFX)
    call DestroyTextTagBJ(udg_KOTH_Floating_Text)
    //                                                                                                     
    call RemoveUnit(udg_KOTH_Hill)
endfunction

//===========================================================================
function InitTrig_KOTH_Gold_Depleted takes nothing returns nothing
    set gg_trg_KOTH_Gold_Depleted=CreateTrigger()
    call TriggerAddAction(gg_trg_KOTH_Gold_Depleted, function Trig_KOTH_Gold_Depleted_Actions)
endfunction

//===========================================================================
// Trigger: KOTH Set Neutral Hill
//===========================================================================
function Trig_KOTH_Set_Neutral_Hill_Actions takes nothing returns nothing
    set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
    call PauseTimerBJ(true, udg_KOTH_Income_Timer)
    call SetUnitAbilityLevelSwapped('AKOH', udg_KOTH_Hill, 1)
    //                                                                                                     
    // You still need to Run KOTH Reset Hill after this (I should be doing this already in my other triggers).
endfunction

//===========================================================================
function InitTrig_KOTH_Set_Neutral_Hill takes nothing returns nothing
    set gg_trg_KOTH_Set_Neutral_Hill=CreateTrigger()
    call TriggerAddAction(gg_trg_KOTH_Set_Neutral_Hill, function Trig_KOTH_Set_Neutral_Hill_Actions)
endfunction

//===========================================================================
// Trigger: KOTH Reset Hill
//===========================================================================
function Trig_KOTH_Reset_Hill_Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_KOTH_Hill) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Reset_Hill_Func017C takes nothing returns boolean
    if ( not ( udg_KOTH_Player != Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Reset_Hill_Actions takes nothing returns nothing
    // If the hill is still alive then remove it:
    if ( Trig_KOTH_Reset_Hill_Func002C() ) then
        call RemoveUnit(udg_KOTH_Hill)
    else
    endif
    //                                                                                                     
    // Recreate the hill:
    call CreateNUnitsAtLoc(1, 'koth', udg_KOTH_Player, udg_centermap, bj_UNIT_FACING)
    set udg_KOTH_Hill=GetLastCreatedUnit()
    call BlzSetUnitMaxHP(udg_KOTH_Hill, udg_KOTH_HP)
    call SetUnitLifePercentBJ(udg_KOTH_Hill, 100)
    call BlzSetUnitIntegerFieldBJ(udg_KOTH_Hill, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, udg_KOTH_Gold_Bounty)
    call SetUnitVertexColorBJ(udg_KOTH_Hill, 100, 100, 100, 100.00)
    call DestroyEffectBJ(udg_KOTH_Invul)
    //                                                                                                     
    // Create or update the hill glow special effect:
    call TriggerExecute(gg_trg_KOTH_Create_Hill_Glow)
    //                                                                                                     
    // Only reduce it's life / regen if it's now under a Players control:
    if ( Trig_KOTH_Reset_Hill_Func017C() ) then
        call SetUnitAbilityLevelSwapped('AKOH', udg_KOTH_Hill, udg_KOTH_Level)
        call SetUnitInvulnerable(udg_KOTH_Hill, true)
        call AddSpecialEffectLocBJ(udg_centermap, "Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.00)
        set udg_KOTH_Invul=GetLastCreatedEffectBJ()
        call StartTimerBJ(udg_timer_KOTH_Invul, false, 3.00)
    else
        call SetUnitAbilityLevelSwapped('AKOH', udg_KOTH_Hill, 1)
    endif
    //                                                                                                     
    call TriggerExecute(gg_trg_KOTH_Update_Text)
endfunction

//===========================================================================
function InitTrig_KOTH_Reset_Hill takes nothing returns nothing
    set gg_trg_KOTH_Reset_Hill=CreateTrigger()
    call TriggerAddAction(gg_trg_KOTH_Reset_Hill, function Trig_KOTH_Reset_Hill_Actions)
endfunction

//===========================================================================
