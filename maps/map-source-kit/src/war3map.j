    return true
endfunction

function Trig_Pub_Defender_Setup_Func009A takes nothing returns nothing
    set udg_Pub_Team_Number=( GetPlayerTeam(GetEnumPlayer()) + 1 )
    if ( Trig_Pub_Defender_Setup_Func009Func002C() ) then
        call CreateNUnitsAtLoc(1, 'h04R', GetEnumPlayer(), udg_Pub_Center_Points[udg_Pub_Team_Number], bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(540.00, 'BTLF', GetLastCreatedUnit())
        set udg_Pub_Defenders[udg_Pub_Team_Number]=GetLastCreatedUnit()
    else
    endif
endfunction

function Trig_Pub_Defender_Setup_Actions takes nothing returns nothing
    // This trigger runs from the MODE set pub game trigger (or at least it did).
    // Modify the Expiration Timer on the Pub_Defender to change how long it lasts!
    //                                                                                                     
    set udg_Pub_Center_Points[1]=GetRectCenter(gg_rct_T1_COMPLETE)
    set udg_Pub_Center_Points[2]=GetRectCenter(gg_rct_T2_COMPLETE)
    set udg_Pub_Center_Points[3]=GetRectCenter(gg_rct_T3_COMPLETE)
    set udg_Pub_Center_Points[4]=GetRectCenter(gg_rct_T4_COMPLETE)
    //                                                                                                     
    call ForForce(GetPlayersAll(), function Trig_Pub_Defender_Setup_Func009A)
    //                                                                                                     
    call RemoveLocation(udg_Pub_Center_Points[1])
    call RemoveLocation(udg_Pub_Center_Points[2])
    call RemoveLocation(udg_Pub_Center_Points[3])
    call RemoveLocation(udg_Pub_Center_Points[4])
endfunction

