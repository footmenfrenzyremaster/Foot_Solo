function Trig_HERO_Blooddancer_Illusions_summon_Func007A takes nothing returns nothing
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetSpellAbilityUnit())
    call SetUnitAbilityLevelSwapped('A07A', GetEnumUnit(), udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('A07B', GetEnumUnit(), udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('A07C', GetEnumUnit(), udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('AOcr', GetEnumUnit(), udg_abilitylevel)
    if ( Trig_HERO_Blooddancer_Illusions_summon_Func007Func006C() ) then
        call UnitRemoveAbilityBJ('AOcr', GetEnumUnit())
        // Unit Stats
        call BlzSetUnitMaxHP(GetEnumUnit(), 2500)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_HP, 2250.00)
        call BlzSetUnitMaxMana(GetEnumUnit(), 500)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_MANA, 500.00)
        call BlzSetUnitArmor(GetEnumUnit(), 20.00)
        call BlzSetUnitBaseDamage(GetEnumUnit(), 50, 0)
        call BlzSetUnitDiceNumber(GetEnumUnit(), 2, 0)
        call BlzSetUnitDiceSides(GetEnumUnit(), 9, 0)
        call UnitAddAbilityBJ('A0AR', GetEnumUnit())
        call SetUnitAbilityLevelSwapped('A0AR', GetEnumUnit(), 1)
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Blooddancer_Illusions_summon_Func007Func007C() ) then
        // Unit Stats
        call BlzSetUnitMaxHP(GetEnumUnit(), 3500)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_HP, 3000.00)
        call BlzSetUnitMaxMana(GetEnumUnit(), 600)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_MANA, 600.00)
        call BlzSetUnitArmor(GetEnumUnit(), 25.00)
        call BlzSetUnitBaseDamage(GetEnumUnit(), 65, 0)
        call BlzSetUnitDiceNumber(GetEnumUnit(), 3, 0)
        call BlzSetUnitDiceSides(GetEnumUnit(), 10, 0)
        call UnitAddAbilityBJ('A0AR', GetEnumUnit())
        call SetUnitAbilityLevelSwapped('A0AR', GetEnumUnit(), 2)
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Blooddancer_Illusions_summon_Func007Func008C() ) then
        // Unit Stats
        call BlzSetUnitMaxHP(GetEnumUnit(), 4000)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_HP, 4000.00)
        call BlzSetUnitMaxMana(GetEnumUnit(), 750)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_MANA, 750.00)
        call BlzSetUnitArmor(GetEnumUnit(), 30.00)
        call BlzSetUnitBaseDamage(GetEnumUnit(), 99, 0)
        call BlzSetUnitDiceNumber(GetEnumUnit(), 3, 0)
        call BlzSetUnitDiceSides(GetEnumUnit(), 14, 0)
        call UnitAddAbilityBJ('A0AR', GetEnumUnit())
        call SetUnitAbilityLevelSwapped('A0AR', GetEnumUnit(), 3)
    else
        call DoNothing()
    endif
endfunction

function Trig_HERO_Blooddancer_Illusions_summon_Actions takes nothing returns nothing
    call TriggerSleepAction(0.50)
    set udg_temp_unit=GetSpellAbilityUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_unit=GetSpellAbilityUnit()
    call SetUnitLifePercentBJ(GetSpellAbilityUnit(), 10.00)
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_temp_player, 'n02T'), function Trig_HERO_Blooddancer_Illusions_summon_Func007A)
endfunction

