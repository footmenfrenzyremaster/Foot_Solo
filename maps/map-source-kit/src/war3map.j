endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func001A takes nothing returns nothing
    set udg_temp_int=GetUnitAbilityLevelSwapped('A05Y', GetEnumUnit())
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func004002003 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func005001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func006001003 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) == true )
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func007A takes nothing returns nothing
    set udg_temp_degree=AngleBetweenPoints(GetUnitLoc(GetEnumUnit()), udg_waterfall_mid[udg_X])
    call SetUnitPositionLoc(GetEnumUnit(), PolarProjectionBJ(GetUnitLoc(GetEnumUnit()), 1.00, udg_temp_degree))
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func001001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h02A' )
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func001A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped('A05Z', GetEnumUnit(), udg_temp_int)
    call IssueImmediateOrderBJ(GetEnumUnit(), "stomp")
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func005001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

