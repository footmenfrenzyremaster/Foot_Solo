//===========================================================================
// Trigger: Avalanche Seismic Fury Start Cast
//===========================================================================
function Trig_Avalanche_Seismic_Fury_Start_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ASEF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Start_Cast_Actions takes nothing returns nothing
    set udg_Avalanche=GetTriggerUnit()
    set udg_Avalanche_CV=GetUnitUserData(udg_Avalanche)
    //                                                                                                          
    set udg_Avalanche_SF_Duration[udg_Avalanche_CV]=0
    set udg_Avalanche_SF_Is_Casting[udg_Avalanche_CV]=false
    set udg_Avalanche_SF_Point[udg_Avalanche_CV]=GetSpellTargetLoc()
    //                                                                                                          
    call SetUnitVertexColorBJ(udg_Avalanche, 100, 100.00, 100.00, 0)
    //                                                                                                          
    call SetUnitTimeScalePercent(udg_Avalanche, 100.00)
    //                                                                                                          
    call GroupAddUnitSimple(udg_Avalanche, udg_Avalanche_SF_Caster_Group)
    call EnableTrigger(gg_trg_Avalanche_Seismic_Fury_Loop)
    //                                                                                                          
    call BlzPauseUnitEx(udg_Avalanche, true)
    //                                                                                                          
    // Cool special effect for eye candy:
    call AddSpecialEffectTargetUnitBJ("origin", udg_Avalanche, "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                          
    // Disable the ability again:
    call UnitRemoveAbilityBJ('ASEA', udg_Avalanche)
    call BlzUnitDisableAbility(udg_Avalanche, 'ASEF', true, false)
    set udg_Avalanche_SF_Stacks[udg_Avalanche_CV]=0
    //                                                                                                          
    // Force it's cooldown since disabling it breaks the cooldown:
    call BlzStartUnitAbilityCooldown(udg_Avalanche, 'ASEF', BlzGetUnitAbilityCooldown(udg_Avalanche, 'ASEF', ( GetUnitAbilityLevelSwapped('ASEF', udg_Avalanche) - 1 )))
endfunction

//===========================================================================
function InitTrig_Avalanche_Seismic_Fury_Start_Cast takes nothing returns nothing
    set gg_trg_Avalanche_Seismic_Fury_Start_Cast=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Start_Cast)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Avalanche_Seismic_Fury_Start_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Avalanche_Seismic_Fury_Start_Cast, Condition(function Trig_Avalanche_Seismic_Fury_Start_Cast_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Seismic_Fury_Start_Cast, function Trig_Avalanche_Seismic_Fury_Start_Cast_Actions)
endfunction

