//===========================================================================
function Trig_Holy_Crash_Cast_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'AHCR' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Holy_Crash_Cast_Conditions takes nothing returns boolean
    if ( not Trig_Holy_Crash_Cast_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Func010Func002C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] <= 125.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Func010C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] < udg_HCr_Setup_Min_Distance ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Func043C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Actions takes nothing returns nothing
    set udg_HCr_Caster=GetTriggerUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    set udg_HCr_Point[1]=GetSpellTargetLoc()
    set udg_HCr_Distance[udg_HCr_CV]=DistanceBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Level[udg_HCr_CV]=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_HCr_Caster)
    //                                                                                                                    
    // Enforce a minimum distance:
    if ( Trig_Holy_Crash_Cast_Func010C() ) then
        // This is a fix for if you target yourself with the ability:
        if ( Trig_Holy_Crash_Cast_Func010Func002C() ) then
            call RemoveLocation(udg_HCr_Point[1])
            set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Setup_Min_Distance, GetUnitFacing(udg_HCr_Caster))
        else
        endif
        set udg_HCr_Distance[udg_HCr_CV]=udg_HCr_Setup_Min_Distance
    else
    endif
    //                                                                                                                    
    //                                                                                                                    
    // ==============================================================
    // DEFINE the duration and max height (if it's confusing just change the very first number in each):
    set udg_HCr_Duration[udg_HCr_CV]=( 0.40 + ( udg_HCr_Distance[udg_HCr_CV] / 1200.00 ) )
    set udg_HCr_Height[udg_HCr_CV]=( 850.00 + ( udg_HCr_Distance[udg_HCr_CV] / 8.00 ) )
    // ==============================================================
    //                                                                                                                    
    //                                                                                                                    
    // Calculate angle, speed and height adjustment math:
    set udg_HCr_Angle[udg_HCr_CV]=AngleBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Speed[0]=( udg_HCr_Distance[udg_HCr_CV] / udg_HCr_Duration[udg_HCr_CV] )
    set udg_HCr_Speed[udg_HCr_CV]=( udg_HCr_Speed[0] * 0.02 )
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.00
    set udg_HCr_Height_Rate[udg_HCr_CV]=( 2.00 * udg_HCr_Height[udg_HCr_CV] )
    set udg_HCr_Height_Factor[udg_HCr_CV]=( 1.00 / udg_HCr_Duration[udg_HCr_CV] )
    //                                                                                                                    
    // For some reason Collision no longer turns off/on (1.35/1.36 bug):
    call SetUnitPathing(udg_HCr_Caster, false)
    //                                                                                                                    
    // This allows a non-Flying unit to have it's Flying Height adjusted:
    call UnitAddAbilityBJ('Arav', udg_HCr_Caster)
    call UnitRemoveAbilityBJ('Arav', udg_HCr_Caster)
    //                                                                                                                    
    call GroupAddUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
    set udg_HCr_Caster_Count=( udg_HCr_Caster_Count + 1 )
    call SetUnitInvulnerable(udg_HCr_Caster, true)
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Turn on the Loop trigger which moves the caster:
    if ( Trig_Holy_Crash_Cast_Func043C() ) then
        call EnableTrigger(gg_trg_Holy_Crash_Loop)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Holy_Crash_Cast takes nothing returns nothing
    set gg_trg_Holy_Crash_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Holy_Crash_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Holy_Crash_Cast, Condition(function Trig_Holy_Crash_Cast_Conditions))
    call TriggerAddAction(gg_trg_Holy_Crash_Cast, function Trig_Holy_Crash_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Holy Crash Loop
//===========================================================================
function Trig_Holy_Crash_Loop_Func002Func004C takes nothing returns boolean
    if ( not ( udg_HCr_Elapsed_Time[udg_HCr_CV] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func001C takes nothing returns boolean
    if ( ( udg_HCr_Elapsed_Time[udg_HCr_CV] >= udg_HCr_Duration[udg_HCr_CV] ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_HCr_Caster) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func005C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_HCr_Target[0], GetOwningPlayer(udg_HCr_Caster)) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_HCr_Target[0]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HCr_Target[0], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HCr_Target[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HCr_Target[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016Func008A takes nothing returns nothing
    set udg_HCr_Target[0]=GetEnumUnit()
    if ( Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002C() ) then
        // DAMAGE
        if ( Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002Func002C() ) then
            call UnitDamageTargetBJ(udg_HCr_Caster, udg_HCr_Target[0], udg_HCr_Setup_Damage[udg_HCr_Level[udg_HCr_CV]], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
            call AddSpecialEffectTargetUnitBJ("origin", udg_HCr_Target[0], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissile.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            // APPLY KNOCK-UP EFFECT - (Note: Height is not perfect so use a higher value than normal):
            set udg_KnockUp_Target=udg_HCr_Target[0]
            set udg_KnockUp_Height=400.00
            set udg_KnockUp_Duration=1.00
            call TriggerExecute(gg_trg_KnockUp_Apply)
        else
            // HEAL
        endif
    else
    endif
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HCr_Caster) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026C takes nothing returns boolean
    if ( not Trig_Holy_Crash_Loop_Func002Func026Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002A takes nothing returns nothing
    set udg_HCr_Caster=GetEnumUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    //                                                                                                                    
    if ( Trig_Holy_Crash_Loop_Func002Func004C() ) then
        // This is a triggered Stun (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, true)
        set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.01
        //                                                                                                                    
        // Optional animation to be played while in the air:
        call SetUnitAnimation(udg_HCr_Caster, "attack")
        call QueueUnitAnimationBJ(udg_HCr_Caster, "stand")
        call AddSpecialEffectTargetUnitBJ("weapon", udg_HCr_Caster, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    //                                                                                                                    
    // Time_Elapsed should increase by the Periodic Interval amount (0.02 by default):
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=( udg_HCr_Elapsed_Time[udg_HCr_CV] + 0.02 )
    //                                                                                                                    
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    //                                                                                                                    
    // Get the destination:
    set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Speed[udg_HCr_CV], udg_HCr_Angle[udg_HCr_CV])
    //                                                                                                                    
    call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[1])
    call SetUnitX(udg_HCr_Caster, GetLocationX(udg_HCr_Point[1]))
    call SetUnitY(udg_HCr_Caster, GetLocationY(udg_HCr_Point[1]))
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Adjust flying height of the unit:
    set udg_HCr_Height[0]=( ( udg_HCr_Height_Rate[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) - ( udg_HCr_Height_Factor[udg_HCr_CV] * ( udg_HCr_Height_Rate[udg_HCr_CV] * ( udg_HCr_Elapsed_Time[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) ) ) )
    call SetUnitFlyHeightBJ(udg_HCr_Caster, ( GetUnitDefaultFlyHeight(udg_HCr_Caster) + udg_HCr_Height[0] ), 0.00)
    //                                                                                                                    
    // Check if the duration is finished or if the caster died:
    if ( Trig_Holy_Crash_Loop_Func002Func026C() ) then
        call GroupRemoveUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
        call SetUnitInvulnerable(udg_HCr_Caster, false)
        set udg_HCr_Caster_Count=( udg_HCr_Caster_Count - 1 )
        if ( Trig_Holy_Crash_Loop_Func002Func026Func005C() ) then
            call DisableTrigger(gg_trg_Holy_Crash_Loop)
        else
        endif
        //                                                                                                                    
        // For some reason Collision no longer turns off/on (1.35/1.36 bug):
        call SetUnitPathing(udg_HCr_Caster, true)
        //                                                                                                                    
        // This removes a triggered Stun from the unit (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, false)
        //                                                                                                                    
        call SetUnitFlyHeightBJ(udg_HCr_Caster, GetUnitDefaultFlyHeight(udg_HCr_Caster), 0.00)
        //                                                                                                                    
        // Damage and slow if the caster unit is still alive:
        if ( Trig_Holy_Crash_Loop_Func002Func026Func016C() ) then
            set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
            call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[0])
            call SetUnitInvulnerable(udg_HCr_Caster, false)
            //                                                                                                                    
            //                                                                                                                    
            // Damage nearby enemy units and heal nearby allied units:
            set udg_HCr_Nearby_Group=GetUnitsInRangeOfLocAll(BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_HCr_Caster, 'AHCR'), ABILITY_RLF_AREA_OF_EFFECT, ( udg_HCr_Level[udg_HCr_CV] - 1 )), udg_HCr_Point[0])
            call ForGroupBJ(udg_HCr_Nearby_Group, function Trig_Holy_Crash_Loop_Func002Func026Func016Func008A)
            //                                                                                                                    
            call RemoveLocation(udg_HCr_Point[0])
            call DestroyGroup(udg_HCr_Nearby_Group)
        else
        endif
    else
    endif
    //                                                                                                                    
endfunction

function Trig_Holy_Crash_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_HCr_Caster_Group, function Trig_Holy_Crash_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_Holy_Crash_Loop takes nothing returns nothing
    set gg_trg_Holy_Crash_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Holy_Crash_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Holy_Crash_Loop, 0.02)
    call TriggerAddAction(gg_trg_Holy_Crash_Loop, function Trig_Holy_Crash_Loop_Actions)
endfunction

