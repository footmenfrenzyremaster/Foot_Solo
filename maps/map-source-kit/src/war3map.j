//===========================================================================
// Trigger: HERO Shattering Strike Action
//===========================================================================
function Trig_HERO_Shattering_Strike_Action_Func015002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Wrath_Caster)) == true )
endfunction

function Trig_HERO_Shattering_Strike_Action_Func016Func001Func002C takes nothing returns boolean
    if ( ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return true
    endif
    if ( ( BlzIsUnitInvulnerable(GetEnumUnit()) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Shattering_Strike_Action_Func016Func001C takes nothing returns boolean
    if ( not Trig_HERO_Shattering_Strike_Action_Func016Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Action_Func016A takes nothing returns nothing
    if ( Trig_HERO_Shattering_Strike_Action_Func016Func001C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Wrath_Group)
    else
    endif
endfunction

function Trig_HERO_Shattering_Strike_Action_Func030C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Wrath_Group) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Action_Func032A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Wrath_Caster, GetEnumUnit(), udg_Wrath_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_HERO_Shattering_Strike_Action_Actions takes nothing returns nothing
    local integer i= 0
    loop
    exitwhen i > 24
    set i=i + 1
    if GetExpiredTimer() == udg_timer_wrath[i] then
    set udg_X=i
    set i=100
    endif
    endloop
    //                                                                                            
    set udg_Wrath_Caster=udg_herO[udg_X]
    set udg_Wrath_Level=GetUnitAbilityLevelSwapped('A0NB', udg_Wrath_Caster)
    // 145 base AoE + 32 to account for the average collision size
    set udg_temp_AoE=300.00
    set udg_Wrath_Group=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_wrath_point[udg_X], Condition(function Trig_HERO_Shattering_Strike_Action_Func015002003))
    call ForGroupBJ(udg_Wrath_Group, function Trig_HERO_Shattering_Strike_Action_Func016A)
    //                                                                                            
    // SLOW ALL UNITS
    set udg_Wrath_Damage[1]=250.00
    set udg_Wrath_Damage[2]=350.00
    set udg_Wrath_Damage[3]=500.00
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Wrath_Caster), udg_wrath_point[udg_X], bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0LT', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0LT', udg_dummy, udg_Wrath_Level)
    call IssueImmediateOrderBJ(udg_dummy, "stomp")
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_dummy)
    //                                                                                            
    // Double damage on single target:
    if ( Trig_HERO_Shattering_Strike_Action_Func030C() ) then
        set udg_Wrath_Damage[0]=( udg_Wrath_Damage[udg_Wrath_Level] * 2.00 )
    else
        set udg_Wrath_Damage[0]=( udg_Wrath_Damage[udg_Wrath_Level] + 0.00 )
    endif
    //                                                                                            
    call ForGroupBJ(udg_Wrath_Group, function Trig_HERO_Shattering_Strike_Action_Func032A)
    //                                                                                            
    call RemoveLocation(udg_wrath_point[udg_X])
    call DestroyGroup(udg_Wrath_Group)
endfunction

//===========================================================================
function InitTrig_HERO_Shattering_Strike_Action takes nothing returns nothing
    set gg_trg_HERO_Shattering_Strike_Action=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[1])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[2])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[3])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[4])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[5])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[6])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[7])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[8])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[9])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[10])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[11])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[12])
    call TriggerAddAction(gg_trg_HERO_Shattering_Strike_Action, function Trig_HERO_Shattering_Strike_Action_Actions)
endfunction

//===========================================================================
// Trigger: Cripple Wave
//===========================================================================
function Trig_Cripple_Wave_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0Q4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cripple_Wave_Func002C takes nothing returns boolean
    if ( not ( udg_QS_Damage_Copy[1] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cripple_Wave_Actions takes nothing returns nothing
    // DEFINE SEARING BULLET DAMAGE PER LEVEL:
    if ( Trig_Cripple_Wave_Func002C() ) then
        set udg_QS_Damage_Copy[1]=80.00
        set udg_QS_Damage_Copy[2]=175.00
        set udg_QS_Damage_Copy[3]=275.00
        set udg_QS_Damage_Copy[4]=325.00
        set udg_QS_Damage_Copy[5]=425.00
        set udg_QS_Damage_Copy[6]=525.00
    else
    endif
    //                                                                                                     
    set udg_QS_Point_Copy[0]=GetUnitLoc(GetTriggerUnit())
    set udg_QS_Point_Copy[1]=GetSpellTargetLoc()
    set udg_QS_Angle_Copy=AngleBetweenPoints(udg_QS_Point_Copy[0], udg_QS_Point_Copy[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=GetUnitLoc(udg_MissileSource)
    set udg_MissileFinish=PolarProjectionBJ(udg_QS_Point_Copy[0], 1300.00, udg_QS_Angle_Copy)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="war3mapImported\\ArcaneMissileComplete.mdx"
    set udg_MissileScale=1.00
    set udg_MissileCollision=100.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=2200.00
    set udg_MissileVision=300.00
    set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Cripple_Wave_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_QS_Point[0])
    call RemoveLocation(udg_QS_Point[1])
endfunction

//===========================================================================
function InitTrig_Cripple_Wave takes nothing returns nothing
    set gg_trg_Cripple_Wave=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Cripple_Wave, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Cripple_Wave, Condition(function Trig_Cripple_Wave_Conditions))
    call TriggerAddAction(gg_trg_Cripple_Wave, function Trig_Cripple_Wave_Actions)
endfunction

//===========================================================================
// Trigger: Cripple Wave OnHit
//===========================================================================
function Trig_Cripple_Wave_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitVisible(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_MissileHitUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cripple_Wave_OnHit_Func010Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_QS_Target_Copy, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_QS_Target_Copy) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target_Copy, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target_Copy, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_QS_Target_Copy) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cripple_Wave_OnHit_Func010A takes nothing returns nothing
    set udg_QS_Target_Copy=GetEnumUnit()
    if ( Trig_Cripple_Wave_OnHit_Func010Func002C() ) then
        call UnitDamageTargetBJ(udg_MissileSource, udg_QS_Target_Copy, udg_QS_Damage_Copy[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_QS_Dummy_Copy, "cripple", udg_QS_Target_Copy)
    else
    endif
endfunction

function Trig_Cripple_Wave_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    //                                                                                                     
    call CreateNUnitsAtLoc(1, 'dmmy', udg_MissileOwner, udg_MissilePosition, bj_UNIT_FACING)
    set udg_QS_Dummy_Copy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('S007', udg_QS_Dummy_Copy)
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_QS_Dummy_Copy)
    call SetUnitAbilityLevelSwapped('S007', udg_QS_Dummy_Copy, GetUnitAbilityLevelSwapped('A0Q4', udg_MissileSource))
    set udg_QS_Damage_Copy[0]=udg_QS_Damage_Copy[udg_MissileData]
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(175.00, udg_MissilePosition), function Trig_Cripple_Wave_OnHit_Func010A)
endfunction

//===========================================================================
function InitTrig_Cripple_Wave_OnHit takes nothing returns nothing
    set gg_trg_Cripple_Wave_OnHit=CreateTrigger()
    call TriggerAddCondition(gg_trg_Cripple_Wave_OnHit, Condition(function Trig_Cripple_Wave_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Cripple_Wave_OnHit, function Trig_Cripple_Wave_OnHit_Actions)
endfunction

//===========================================================================
// Trigger: HERO Monkey Staff of the Jungle Throw
//
// -hero 01 55
//===========================================================================
function Trig_HERO_Monkey_Staff_of_the_Jungle_Throw_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0LO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Throw_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_StaffJungle_degree[udg_temp_playernumber]=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    call CreateNUnitsAtLoc(1, 'h05M', udg_temp_player, udg_temp_point_caster, udg_StaffJungle_degree[udg_temp_playernumber])
    set udg_dummy_Jungle[udg_temp_playernumber]=GetLastCreatedUnit()
    set udg_StaffJungle_level[GetUnitUserData(GetLastCreatedUnit())]=udg_abilitylevel
    set udg_StaffJungle_location[udg_temp_playernumber]=udg_temp_point_caster
    set udg_StaffJungle_active[udg_temp_playernumber]=true
    call EnableTrigger(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop)
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_HERO_Monkey_Staff_of_the_Jungle_Throw takes nothing returns nothing
    set gg_trg_HERO_Monkey_Staff_of_the_Jungle_Throw=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Throw, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Throw, Condition(function Trig_HERO_Monkey_Staff_of_the_Jungle_Throw_Conditions))
    call TriggerAddAction(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Throw, function Trig_HERO_Monkey_Staff_of_the_Jungle_Throw_Actions)
endfunction

//===========================================================================
// Trigger: HERO Monkey Staff of the Jungle Loop
//
// -hero 01 55
//===========================================================================
function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'O01B' ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func003C takes nothing returns boolean
    if ( not ( udg_StaffJungle_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), ConvertedPlayer(udg_X)) == true )
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003002002 takes nothing returns boolean
    return ( IsUnitVisible(GetFilterUnit(), ConvertedPlayer(udg_X)) == true )
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitVisible(GetFilterUnit(), ConvertedPlayer(udg_X)) == true)) // INLINED!!
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitEnemy(GetFilterUnit(), ConvertedPlayer(udg_X)) == true), (GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitVisible(GetFilterUnit(), ConvertedPlayer(udg_X)) == true)))) // INLINED!!
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_StaffJungle_target[udg_X]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func007C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_StaffJungle_start_location[udg_X], udg_StaffJungle_location[udg_X]) >= 950.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001C takes nothing returns boolean
    if ( not Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001C() ) then
            set udg_StaffJungle_start_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func003C() ) then
                set udg_StaffJungle_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
                set udg_StaffJungle_active[udg_X]=false
            else
                set udg_StaffJungle_location[udg_X]=PolarProjectionBJ(udg_StaffJungle_location[udg_X], 20.00, udg_StaffJungle_degree[udg_X])
            endif
            call SetUnitPositionLocFacingBJ(udg_dummy_Jungle[udg_X], udg_StaffJungle_location[udg_X], udg_StaffJungle_degree[udg_X])
            set udg_StaffJungle_target[udg_X]=GetUnitsInRangeOfLocMatching(110.00, udg_StaffJungle_location[udg_X], Condition(function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003))
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func006C() ) then
                call SetUnitPositionLocFacingBJ(udg_herO[udg_X], udg_StaffJungle_location[udg_X], udg_StaffJungle_degree[udg_X])
                call AddSpecialEffectLocBJ(udg_StaffJungle_location[udg_X], "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                call UnitAddAbilityBJ('A0RF', udg_dummy_Jungle[udg_X])
                call SetUnitAbilityLevelSwapped('A0RF', udg_dummy_Jungle[udg_X], udg_StaffJungle_level[GetUnitUserData(udg_dummy_Jungle[udg_X])])
                call IssueImmediateOrderBJ(udg_dummy_Jungle[udg_X], "stomp")
                call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_Jungle[udg_X])
                call RemoveLocation(udg_StaffJungle_location[udg_X])
                call RemoveLocation(udg_StaffJungle_start_location[udg_X])
                set udg_StaffJungle_active[udg_X]=false
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func007C() ) then
                call RemoveUnit(udg_dummy_Jungle[udg_X])
                call RemoveLocation(udg_StaffJungle_location[udg_X])
                set udg_StaffJungle_active[udg_X]=false
                call RemoveLocation(udg_StaffJungle_start_location[udg_X])
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            call DestroyGroup(udg_StaffJungle_target[udg_X])
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

//===========================================================================
function InitTrig_HERO_Monkey_Staff_of_the_Jungle_Loop takes nothing returns nothing
    set gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop, 0.02)
    call TriggerAddAction(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop, function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Actions)
endfunction

