    call DialogAddButtonBJ(udg_dlg_draw[udg_temp_playernumber], "TRIGSTR_10475")
    set udg_dlg_btn_draw_no[udg_temp_playernumber]=GetLastCreatedButtonBJ()
    call DialogAddButtonBJ(udg_dlg_draw[udg_temp_playernumber], "TRIGSTR_10476")
    set udg_dlg_btn_draw_yes[udg_temp_playernumber]=GetLastCreatedButtonBJ()
    call DialogDisplayBJ(true, udg_dlg_draw[udg_temp_playernumber], GetTriggerPlayer())
endfunction

