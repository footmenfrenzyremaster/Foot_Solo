    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(11), "-votekick", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(0), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(1), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(2), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(3), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(4), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(5), "-vk", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_Votekick_Initiate, Player(6), "-vk", false)
