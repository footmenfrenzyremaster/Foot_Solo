//===========================================================================
// Trigger: Remove Obs PauseSave
//===========================================================================
function Trig_Remove_Obs_PauseSave_Func008Func001C takes nothing returns boolean
    if ( not ( GetConvertedPlayerId(GetEnumPlayer()) >= 13 ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetEnumPlayer()) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(GetEnumPlayer()) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remove_Obs_PauseSave_Func008A takes nothing returns nothing
    if ( Trig_Remove_Obs_PauseSave_Func008Func001C() ) then
        if GetLocalPlayer() == GetEnumPlayer() then
        call BlzFrameSetVisible(BlzGetFrameByName("PauseButton", 0), false)
        call BlzFrameSetVisible(BlzGetFrameByName("SaveButton", 0), false)
        endif
    else
    endif
endfunction

function Trig_Remove_Obs_PauseSave_Actions takes nothing returns nothing
    // Sometimes accessing a frame for the very first time LOCALLY will cause a desync.
    // So let's access the frames in a GLOBAL fashion, do nothing to them, then proceed with the LOCAL logic:
    //  
    call BlzFrameSetVisible(BlzGetFrameByName("PauseButton", 0), true)
    call BlzFrameSetVisible(BlzGetFrameByName("SaveButton", 0), true)
    //  
    // Proceed:
    call ForForce(GetPlayersAll(), function Trig_Remove_Obs_PauseSave_Func008A)
endfunction

//===========================================================================
function InitTrig_Remove_Obs_PauseSave takes nothing returns nothing
    set gg_trg_Remove_Obs_PauseSave=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_Remove_Obs_PauseSave, 0.50)
    call TriggerAddAction(gg_trg_Remove_Obs_PauseSave, function Trig_Remove_Obs_PauseSave_Actions)
endfunction

