        set udg_pool_threshold[udg_temp_playernumber]=0
    else
        call DoNothing()
    endif
    if ( Trig_autopool_th_execute_Func003C() ) then
        set udg_pool_threshold[udg_temp_playernumber]=50
    else
        call DoNothing()
    endif
    if ( Trig_autopool_th_execute_Func004C() ) then
        set udg_pool_threshold[udg_temp_playernumber]=150
    else
        call DoNothing()
    endif
    if ( Trig_autopool_th_execute_Func005C() ) then
        set udg_pool_threshold[udg_temp_playernumber]=250
    else
        call DoNothing()
    endif
    if ( Trig_autopool_th_execute_Func006C() ) then
        set udg_pool_threshold[udg_temp_playernumber]=500
    else
        call DoNothing()
    endif
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( I2S(udg_pool_threshold[udg_temp_playernumber]) + "|cffffff00 Gold|r will be held back for your personal use." ))
