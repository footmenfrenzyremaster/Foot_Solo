function InitTrig_CPP_Create_Pathing_Checker takes nothing returns nothing
    set gg_trg_CPP_Create_Pathing_Checker=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_CPP_Create_Pathing_Checker, 0.00)
    call TriggerAddAction(gg_trg_CPP_Create_Pathing_Checker, function Trig_CPP_Create_Pathing_Checker_Actions)
endfunction

//===========================================================================
// Trigger: KnockUp Apply
//===========================================================================
function Trig_KnockUp_Apply_Func009C takes nothing returns boolean
    if ( not ( udg_KnockUp__Elapsed_Time[udg_KnockUp__CV] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockUp_Apply_Func012C takes nothing returns boolean
    if ( not ( udg_KnockUp_Duration < 0.10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockUp_Apply_Actions takes nothing returns nothing
    // How to use:
    // Set KnockUp_Target, KnockUp_Height, and KnockUp_Duration then Run this trigger (ignoring conditions).
    //                                                                                                                    
    // Note: Height applied to the unit is actually less than you'd expect, set it to a higher value for better results!
    //                                                                                                                    
    set udg_KnockUp__CV=GetUnitUserData(udg_KnockUp_Target)
    //                                                                                                                    
    // Add target to knock up group and prepare it for lift off:
    if ( Trig_KnockUp_Apply_Func009C() ) then
        call GroupAddUnitSimple(udg_KnockUp_Target, udg_KnockUp__Group)
        set udg_KnockUp__Group_Count=( udg_KnockUp__Group_Count + 1 )
        call EnableTrigger(gg_trg_KnockUp_Loop)
        //                                                                                                                    
        // Stun it:
        call BlzPauseUnitEx(udg_KnockUp_Target, true)
        //                                                                                                                    
        // Use storm crow trick to allow ground units to change flying height:
        call UnitAddAbilityBJ('Arav', udg_KnockUp_Target)
        call UnitRemoveAbilityBJ('Arav', udg_KnockUp_Target)
    else
    endif
    //                                                                                                                    
    // Enforce a minimum duration to prevent crashes:
    if ( Trig_KnockUp_Apply_Func012C() ) then
        set udg_KnockUp_Duration=0.10
    else
    endif
    //                                                                                                                    
    // Calculate math for knock up effect:
    set udg_KnockUp__Elapsed_Time[udg_KnockUp__CV]=0.00
    set udg_KnockUp__Duration[udg_KnockUp__CV]=( udg_KnockUp_Duration - 0.01 )
    set udg_KnockUp__Height[udg_KnockUp__CV]=udg_KnockUp_Height
    set udg_KnockUp__Rate[udg_KnockUp__CV]=( 2.00 * udg_KnockUp_Height )
    set udg_KnockUp__Factor[udg_KnockUp__CV]=( 1.00 / udg_KnockUp_Duration )
endfunction

//===========================================================================
function InitTrig_KnockUp_Apply takes nothing returns nothing
    set gg_trg_KnockUp_Apply=CreateTrigger()
    call TriggerAddAction(gg_trg_KnockUp_Apply, function Trig_KnockUp_Apply_Actions)
endfunction

//===========================================================================
// Trigger: KnockUp Loop
//===========================================================================
function Trig_KnockUp_Loop_Func002Func004Func010C takes nothing returns boolean
    if ( not ( udg_KnockUp__Group_Count <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockUp_Loop_Func002Func004C takes nothing returns boolean
    if ( not ( udg_KnockUp__Elapsed_Time[udg_KnockUp__CV] < udg_KnockUp__Duration[udg_KnockUp__CV] ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_KnockUp_Target) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockUp_Loop_Func002A takes nothing returns nothing
    set udg_KnockUp_Target=GetEnumUnit()
    set udg_KnockUp__CV=GetUnitUserData(udg_KnockUp_Target)
    //                                                                                                                    
    if ( Trig_KnockUp_Loop_Func002Func004C() ) then
        set udg_KnockUp__Elapsed_Time[udg_KnockUp__CV]=( udg_KnockUp__Elapsed_Time[udg_KnockUp__CV] + 0.02 )
        //                                                                                                                    
        // Adjust flying height of the unit:
        set udg_KnockUp_Height=( ( udg_KnockUp__Rate[udg_KnockUp__CV] * udg_KnockUp__Elapsed_Time[udg_KnockUp__CV] ) - ( udg_KnockUp__Factor[udg_KnockUp__CV] * ( udg_KnockUp__Rate[udg_KnockUp__CV] * ( udg_KnockUp__Elapsed_Time[udg_KnockUp__CV] * udg_KnockUp__Elapsed_Time[udg_KnockUp__CV] ) ) ) )
        call SetUnitFlyHeightBJ(udg_KnockUp_Target, ( GetUnitDefaultFlyHeight(udg_KnockUp_Target) + udg_KnockUp_Height ), 0.00)
    else
        // Unstun it:
        call BlzPauseUnitEx(udg_KnockUp_Target, false)
        //                                                                                                                    
        // Air time is finished or the unit died - End!
        set udg_KnockUp__Elapsed_Time[udg_KnockUp__CV]=0.00
        call SetUnitFlyHeightBJ(udg_KnockUp_Target, GetUnitDefaultFlyHeight(udg_KnockUp_Target), 0.00)
        //                                                                                                                    
        call GroupRemoveUnitSimple(udg_KnockUp_Target, udg_KnockUp__Group)
        set udg_KnockUp__Group_Count=( udg_KnockUp__Group_Count - 1 )
        if ( Trig_KnockUp_Loop_Func002Func004Func010C() ) then
            set udg_KnockUp__Group_Count=0
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    endif
endfunction

function Trig_KnockUp_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_KnockUp__Group, function Trig_KnockUp_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_KnockUp_Loop takes nothing returns nothing
    set gg_trg_KnockUp_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_KnockUp_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_KnockUp_Loop, 0.02)
    call TriggerAddAction(gg_trg_KnockUp_Loop, function Trig_KnockUp_Loop_Actions)
endfunction

//===========================================================================
// Trigger: W3MMD Library
//===========================================================================
//TESH.scrollpos=0
//TESH.alwaysfold=0
///////////////////////////////////////////////////////////////
/// The Map Meta Data Library
/// Version: v1.00       
/// Last Modified: April 24, 2009
/// Author Chain: Strilanc, [insert next ...]
///////////////////////////////////////////////////////////////
/// This library is used to emit standardized meta data which parsers and bot hosts can use to record relevant
/// game statistics like "hero kills" which would otherwise be impossible to record automatically.
///
/// In particular, the flag function can be used to indicate if a leaver should be awarded a win or not. Replays
/// don't contain enough information to easily tell winners who leave from losers who leave. (for example: people
/// who leave while end-game stats are being shown)
///////////////////////////////////////////////////////////////
/// Interface:
///   void FlagPlayer(player, flag_constant)
///   void DefineValue(name, type_constant, goal_constant, suggest_constant)
///   void UpdateValueInt(name, player, operation_constant, value)
///   void UpdateValueReal(name, player, operation_constant, value)
///   void UpdateValueString(name, player, value)
///   void DefineEvent0(name, format) /////////////////////////
//===========================================================================
// Trigger: init
//
// CHECK #2 - OK
//===========================================================================
function Trig_init_Func002C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_EMPTY ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(3)) == PLAYER_SLOT_STATE_EMPTY ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(4)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(5)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(6)) == PLAYER_SLOT_STATE_EMPTY ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(7)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(8)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(9)) == PLAYER_SLOT_STATE_EMPTY ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(10)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(Player(11)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

