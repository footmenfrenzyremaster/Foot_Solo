//
// ok
//===========================================================================
function Trig_bounty_Conditions takes nothing returns boolean
    if ( not ( udg_admin_level[GetConvertedPlayerId(GetTriggerPlayer())] >= 99 ) ) then
        return false
    endif
    return true
endfunction

function Trig_bounty_Func003Func001C takes nothing returns boolean
    if ( not ( udg_player_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_bounty_Actions takes nothing returns nothing
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_bounty_Func003Func001C() ) then
            set udg_temp_int=BlzGetUnitIntegerField(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)
            call DisplayTextToForce(udg_temp_playergroup, ( ( "Bounty of Player #" + I2S(udg_X) ) + ( "'s Hero: " + I2S(udg_temp_int) ) ))
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
    call DestroyForce(udg_temp_playergroup)
endfunction

