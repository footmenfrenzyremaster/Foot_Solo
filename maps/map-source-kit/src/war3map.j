function Trig_ITEM_Null_Rod_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0I8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Null_Rod_Func008Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(udg_u) == 'n01P' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(udg_u) == 'n00U' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ITEM_Null_Rod_Func008C takes nothing returns boolean
    if ( not Trig_ITEM_Null_Rod_Func008Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Null_Rod_Actions takes nothing returns nothing
    set udg_u=GetSpellTargetUnit()
    set udg_TempLoc_NullRod=GetUnitLoc(udg_u)
    call UnitRemoveAbilityBJ('ACmi', udg_u)
    call CreateNUnitsAtLoc(1, 'dmmy', GetTriggerPlayer(), udg_TempLoc_NullRod, bj_UNIT_FACING)
    call UnitAddAbilityBJ('A0GE', GetLastCreatedUnit())
    call IssueTargetOrderBJ(GetLastCreatedUnit(), "sleep", udg_u)
    call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
    if ( Trig_ITEM_Null_Rod_Func008C() ) then
        call UnitAddAbilityBJ('ACmi', udg_u)
    else
        call DoNothing()
    endif
    call RemoveLocation(udg_TempLoc_NullRod)
endfunction

