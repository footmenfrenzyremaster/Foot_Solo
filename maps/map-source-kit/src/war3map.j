//===========================================================================
// Trigger: Camera Zoom
//===========================================================================
// scope zoom begins

//===========================================================================

// only call Zoom from local context!
function zoom___Zoom takes integer cameraDistance,boolean withMessaging returns integer
    local boolean wasValid= false
    local integer previousCameraDistance= R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE))
    if ( previousCameraDistance == cameraDistance ) then
        if ( withMessaging ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Already at target zoom level")
        endif
    else

	if ( GetPlayerId(GetTriggerPlayer()) > 11 ) then
            set zoom___gMaxDistance=4500
	else
            set zoom___gMaxDistance=4500
        endif


        if ( cameraDistance > zoom___gMaxDistance ) then
            set cameraDistance=zoom___gMaxDistance
        elseif ( cameraDistance < zoom___gMinDistance ) then
            set cameraDistance=zoom___gMinDistance
        else
            set wasValid=true
        endif

        if ( withMessaging and not ( wasValid ) ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Valid zoom range: " + I2S(zoom___gMinDistance) + " up to " + I2S(zoom___gMaxDistance))
        endif
    
        if ( withMessaging ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "New zoom level: " + I2S(cameraDistance))
        endif
        call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, cameraDistance, 0.00)
    endif
    return cameraDistance
endfunction

//===========================================================================

// only call RestoreFromFile from local context!
function zoom___RestoreFromFile takes nothing returns nothing
    local integer file= s__File_open(zoom___gFileName)
    local string input= (s__File_readEx((file),false)) // INLINED!!
    local integer cameraDistance= S2I(SubString(input, 0, 4))
    call s__File_close(file)
    call zoom___Zoom(cameraDistance , false)
endfunction

//===========================================================================

function zoom___Save takes integer cameraDistance returns nothing
    local integer file= s__File_open(zoom___gFileName)
    call s__File_write(file,I2S(cameraDistance))
    call s__File_close(file)
endfunction

//===========================================================================

function zoom___handleChatCommand takes nothing returns nothing
    local string cameraDistanceStr= SubString(GetEventPlayerChatString(), 6, StringLength(GetEventPlayerChatString()))
    local integer cameraDistance= 0
    if ( GetLocalPlayer() == GetTriggerPlayer() ) then
        if ( cameraDistanceStr != " " ) then
            set cameraDistance=S2I(cameraDistanceStr)
        endif
        if ( cameraDistance == 0 ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Invalid zoom command usage. Example usage: \"-zoom 2500\"")
        else
            set cameraDistance=zoom___Zoom(cameraDistance , true)
            call zoom___Save(cameraDistance)
        endif
    endif
endfunction

function zoom___handleInfoChatCommand takes nothing returns nothing
    if ( GetLocalPlayer() == GetTriggerPlayer() ) then
        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Current zoom level: " + I2S(R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE))))
    endif
endfunction

function zoom_RestoreFromCacheForPlayer takes player p returns nothing
    if ( GetLocalPlayer() == p ) then
        call zoom___RestoreFromFile()
    endif
endfunction

function zoom_RestoreForAllPlayersFromCache takes nothing returns nothing
    local integer i= 0
    loop
    exitwhen i >= 24
        if ( GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING ) then
            if ( GetLocalPlayer() == Player(i) ) then
                call zoom___RestoreFromFile()
            endif
        endif
        set i=i + 1
    endloop
endfunction

function zoom_Init takes nothing returns nothing
    local integer i= 0
    local trigger setTrigger= CreateTrigger()
    local trigger infoTrigger= CreateTrigger()
    loop
    exitwhen i >= 24
        call TriggerRegisterPlayerChatEvent(setTrigger, Player(i), "-zoom ", false)
        call TriggerRegisterPlayerChatEvent(infoTrigger, Player(i), "-zoom", true)
        set i=i + 1
    endloop
    call TriggerAddAction(setTrigger, function zoom___handleChatCommand)
    call TriggerAddAction(infoTrigger, function zoom___handleInfoChatCommand)
    call zoom_RestoreForAllPlayersFromCache()
endfunction

// scope zoom ends

//===========================================================================
function InitTrig_Camera_Zoom takes nothing returns nothing
    call zoom_Init()
endfunction
