function Trig_MODE_colossal_amount_GUI_execute_Func003Func001C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_btn_colossal_amount[udg_X] ) ) then
        return false
    endif
    return true
endfunction

function Trig_MODE_colossal_amount_GUI_execute_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    if ( Trig_MODE_colossal_amount_GUI_execute_Func002C() ) then
        set udg_colossal_max_wave=udg_colossal_wave_steps[0]
        call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + "|r has selected to play with unlimited colossal waves." ))
    else
        call DoNothing()
    endif
    set udg_X=1
    loop
        exitwhen udg_X > 6
        if ( Trig_MODE_colossal_amount_GUI_execute_Func003Func001C() ) then
            set udg_colossal_max_wave=udg_colossal_wave_steps[udg_X]
            call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(GetTriggerPlayer()) ) + ( "|r has selected to play with " + ( I2S(udg_colossal_wave_steps[udg_X]) + " colossal waves." ) ) ))
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

