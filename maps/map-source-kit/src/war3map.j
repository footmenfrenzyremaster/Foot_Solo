    set gg_trg_HERO_Architect_raise_morale=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Architect_raise_morale, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Architect_raise_morale, Condition(function Trig_HERO_Architect_raise_morale_Conditions))
    call TriggerAddAction(gg_trg_HERO_Architect_raise_morale, function Trig_HERO_Architect_raise_morale_Actions)
endfunction

