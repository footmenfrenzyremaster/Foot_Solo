function InitTrig_HERO_Death_Wards takes nothing returns nothing
    set gg_trg_HERO_Death_Wards=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Death_Wards, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Death_Wards, Condition(function Trig_HERO_Death_Wards_Conditions))
