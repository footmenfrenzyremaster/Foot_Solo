    if ( not ( GetClickedButtonBJ() == udg_Votekick_Button_Ally1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Votekick_Select_Ally_To_Kick_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(udg_Votekick_Start_Player)
    //                                                                                                     
    if ( Trig_Votekick_Select_Ally_To_Kick_Func004C() ) then
        set udg_Votekick_Target_Player=udg_ally1[udg_temp_playernumber]
        call DialogSetMessageBJ(udg_Votekick_Dialog_YesNo, ( "Are you sure you want to votekick " + ( GetPlayerName(udg_Votekick_Target_Player) + "?" ) ))
        call DisplayTimedTextToForce(GetForceOfPlayer(udg_ally2[udg_temp_playernumber]), 20.00, ( "A votekick has started against player: " + ( udg_playername[GetConvertedPlayerId(udg_Votekick_Target_Player)] + ". Type |cffff0000-vk|r to kick them out of the game!" ) ))
    else
        if ( Trig_Votekick_Select_Ally_To_Kick_Func004Func004C() ) then
            set udg_Votekick_Target_Player=udg_ally2[udg_temp_playernumber]
            call DialogSetMessageBJ(udg_Votekick_Dialog_YesNo, ( "Are you sure you want to votekick " + ( GetPlayerName(udg_Votekick_Target_Player) + "?" ) ))
            call DisplayTimedTextToForce(GetForceOfPlayer(udg_ally1[udg_temp_playernumber]), 20.00, ( "A votekick has started against player: " + ( udg_playername[GetConvertedPlayerId(udg_Votekick_Target_Player)] + ". Type |cffff0000-vk|r to kick them out of the game!" ) ))
        else
            if ( Trig_Votekick_Select_Ally_To_Kick_Func004Func004Func001C() ) then
                call TriggerExecute(gg_trg_Votekick_RESET)
            else
            endif
        endif
    endif
endfunction

