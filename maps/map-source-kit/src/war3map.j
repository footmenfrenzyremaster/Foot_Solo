function Trig_HERO_Summon_Brewer_Stats_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummonedUnit()) == 'n049' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Summon_Brewer_Stats_Func035C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 1 ) ) then
        return false
    endif
    return true
endfunction

