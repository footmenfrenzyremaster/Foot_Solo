    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004C takes nothing returns boolean
    if ( not ( udg_Avalanche_SF_Is_Casting[udg_Avalanche_CV] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002A takes nothing returns nothing
    set udg_Avalanche=GetEnumUnit()
    set udg_Avalanche_CV=GetUnitUserData(udg_Avalanche)
    //                                                                                                          
    if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004C() ) then
        // Wind-up animation:
        if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func003C() ) then
            set udg_Avalanche_SF_Duration[udg_Avalanche_CV]=( udg_Avalanche_SF_Duration[udg_Avalanche_CV] + 1 )
            //                                                                                                          
            if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func003Func006C() ) then
                call SetUnitAnimation(udg_Avalanche, "attack")
                call SetUnitTimeScalePercent(udg_Avalanche, 10.00)
            else
                if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func003Func006Func001C() ) then
                    call SetUnitTimeScalePercent(udg_Avalanche, 0.00)
                else
                endif
            endif
        else
            call SetUnitTimeScalePercent(udg_Avalanche, 100.00)
            call GroupRemoveUnitSimple(udg_Avalanche, udg_Avalanche_SF_Caster_Group)
            if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func003Func005C() ) then
                call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Loop)
            else
            endif
        endif
        //                                                                                                          
    else
        // Unleash animation:
        if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005C() ) then
            set udg_Avalanche_SF_Duration[udg_Avalanche_CV]=( udg_Avalanche_SF_Duration[udg_Avalanche_CV] + 1 )
            //                                                                                                          
            if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009C() ) then
                call SetUnitAnimation(udg_Avalanche, "attack")
            else
                //                                                                                                          
                // Cool special effects on his hand for wowing the audience:
                if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func003C() ) then
                    call AddSpecialEffectTargetUnitBJ("origin", udg_Avalanche, "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                else
                endif
                //                                                                                                          
                if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005C() ) then
                    // Silence/Slow/Miss Dummy:
                    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Avalanche), udg_Avalanche_SF_Point[udg_Avalanche_CV], bj_UNIT_FACING)
                    set udg_Avalanche_SF_Dummy=GetLastCreatedUnit()
                    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_Avalanche_SF_Dummy)
                    call UnitAddAbilityBJ('ASES', udg_Avalanche_SF_Dummy)
                    call SetUnitAbilityLevelSwapped('ASES', udg_Avalanche_SF_Dummy, GetUnitAbilityLevelSwapped('ASEF', udg_Avalanche))
                    //                                                                                                          
                    // Get damage dealt based on ability level:
                    set udg_Avalanche_SF_Damage[0]=udg_Avalanche_SF_Damage[GetUnitAbilityLevelSwapped('ASEF', udg_Avalanche)]
                    //                                                                                                          
                    set udg_Avalanche_SF_Enemy_Group=GetUnitsInRangeOfLocAll(325.00, udg_Avalanche_SF_Point[udg_Avalanche_CV])
                    call ForGroupBJ(udg_Avalanche_SF_Enemy_Group, function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func014A)
                    //                                                                                                          
                    call AddSpecialEffectLocBJ(udg_Avalanche_SF_Point[udg_Avalanche_CV], "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    //                                                                                                          
                    call AddSpecialEffectLocBJ(udg_Avalanche_SF_Point[udg_Avalanche_CV], "Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl")
                    set udg_DDE_Duration=2.00
                    call TriggerExecute(gg_trg_DDE_Destroy_Last_Created_Effect)
                    //                                                                                                          
                    call DestroyGroup(udg_Avalanche_SF_Enemy_Group)
                    call RemoveLocation(udg_Avalanche_SF_Point[udg_Avalanche_CV])
                else
                    // Linger for another 0.40 seconds to allow the animation to complete fully:
                    if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func002C() ) then
                        call BlzPauseUnitEx(udg_Avalanche, false)
                        //                                                                                                          
                        call GroupRemoveUnitSimple(udg_Avalanche, udg_Avalanche_SF_Caster_Group)
                        if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func002Func004C() ) then
                            call DisableTrigger(GetTriggeringTrigger())
                        else
                        endif
                    else
                    endif
                endif
            endif
        else
            call SetUnitTimeScalePercent(udg_Avalanche, 100.00)
            call RemoveLocation(udg_Avalanche_SF_Point[udg_Avalanche_CV])
            call BlzPauseUnitEx(udg_Avalanche, false)
            //                                                                                                          
            call GroupRemoveUnitSimple(udg_Avalanche, udg_Avalanche_SF_Caster_Group)
            if ( Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func006C() ) then
                call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Loop)
            else
            endif
        endif
    endif
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Avalanche_SF_Caster_Group, function Trig_Avalanche_Seismic_Fury_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_Avalanche_Seismic_Fury_Loop takes nothing returns nothing
    set gg_trg_Avalanche_Seismic_Fury_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Avalanche_Seismic_Fury_Loop, 0.02)
    call TriggerAddAction(gg_trg_Avalanche_Seismic_Fury_Loop, function Trig_Avalanche_Seismic_Fury_Loop_Actions)
endfunction

//===========================================================================
// Trigger: Avalanche Seismic Fury Floating Text
//===========================================================================
function Trig_Avalanche_Seismic_Fury_Floating_Text_Conditions takes nothing returns boolean
    if ( not ( udg_Avalanche_SF_Stacks[udg_Avalanche_CV] > 0 ) ) then
        return false
    endif
    if ( not ( udg_Avalanche_SF_Stacks[udg_Avalanche_CV] < 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Floating_Text_Actions takes nothing returns nothing
    set udg_Floating_Text_PG=GetForceOfPlayer(GetOwningPlayer(udg_Avalanche))
    //                                                                                                                    
    call CreateTextTagUnitBJ(( I2S(udg_Avalanche_SF_Stacks[udg_Avalanche_CV]) + "x" ), udg_Avalanche, 0, 10, 100.00, 0.00, 0.00, 0)
    //                                                                                                                    
    call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
    call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 32.00, GetRandomReal(50.00, 130.00))
    call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 3.00)
    call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 2.50)
    call ShowTextTagForceBJ(false, GetLastCreatedTextTag(), GetPlayersAll())
    call ShowTextTagForceBJ(true, GetLastCreatedTextTag(), udg_Floating_Text_PG)
    //                                                                                                                    
    call DestroyForce(udg_Floating_Text_PG)
endfunction

//===========================================================================
function InitTrig_Avalanche_Seismic_Fury_Floating_Text takes nothing returns nothing
    set gg_trg_Avalanche_Seismic_Fury_Floating_Text=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Floating_Text)
    call TriggerAddCondition(gg_trg_Avalanche_Seismic_Fury_Floating_Text, Condition(function Trig_Avalanche_Seismic_Fury_Floating_Text_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Seismic_Fury_Floating_Text, function Trig_Avalanche_Seismic_Fury_Floating_Text_Actions)
endfunction

//===========================================================================
// Trigger: Helios Collision Configuration
//===========================================================================
function Trig_Helios_Collision_Configuration_Actions takes nothing returns nothing
    // --------
    // Condition Configuration
    // Unit is a ground unit
    set udg_HC_ConditionConfig[0]=true
    // Unit is a structure
    set udg_HC_ConditionConfig[1]=false
    // Unit is magic immune
    set udg_HC_ConditionConfig[2]=false
    // Unit belongs to an enemy player
    set udg_HC_ConditionConfig[3]=true
    // Unit is alive
    set udg_HC_ConditionConfig[4]=true
    // Determines the area that will be effected by Magnetism
    set udg_HC_ExplosionAOE=500.00
    set udg_HC_AoeBase=400.00
    set udg_HC_AoePerLevel=75.00
    // Determines the strength of the magnetism
    set udg_HC_MagnetismStrengthBase=575.00
    set udg_HC_MagnetismStrengthPerLevel=75.00
    set udg_HC_MagnetismDistanceMultiplyer=1.00
    set udg_HC_MagnetismCap=20.00
    // Determines the damage done by the blast
    set udg_HC_ExplosionDamageBase=300.00
    set udg_HC_ExplosionDamagePerLevel=150.00
    // Determines the strength of the blast
    set udg_HC_BlastDistanceBase=5.00
    set udg_HC_BlastDistanceMultiplyer=0.01
    set udg_HC_HeightMultiplyer=0.20
    set udg_HC_BlastSpeed=16.00
    set udg_HC_BlastCap=550.00
    // Determines the speed of the Sun travelling
    set udg_HC_SunSpeed=9.50
    // Determines the amount of Orbs surround the Sun
    set udg_HC_OrbCountBase=3
    set udg_HC_OrbCountPerLevel=0
    // Determines the amount of Wind that surrounds the Sun
    set udg_HC_WindCountBase=5
    set udg_HC_WindCountPerLevel=2
    // Determines how fast the Orbs Spin around
    set udg_HC_FireOrbSpinSpeed=9.00
    // Determines how fast the Wind Spins around
    set udg_HC_WindSpinSpeed=7.00
    // Determines how far the orbs are from the sun
    set udg_HC_OrbDistance=150.00
    // Determines how far the wind is from the sun
    set udg_HC_WindDistance=150.00
    // Determines how long the dummies will remain after their usefulness has ended
    set udg_HC_DummyExpirationTimers=2.00
    // Determines the scaling of the Sun and its SFX
    set udg_HC_EffectScalingOrbs=90.00
    set udg_HC_EffectScalingWind=90.00
    set udg_HC_EffectScalingSun=80.00
    set udg_HC_EffectScalingBlast=120.00
    // Determines the Height given to the sun and its effects
    set udg_HC_EffectZOrbs=100.00
    set udg_HC_EffectZSun=0.00
    set udg_HC_EffectZWind=0.00
    set udg_HC_EffectZBlast=0.00
    // Determines the unit model used as the Sun
    set udg_HC_SunSFX="war3mapImported\\SuperLightningBall.mdx"
    // Determines the model used for the revolving fire orbs
    set udg_HC_FireOrbSFX="Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl"
    // Determines the unit model used for the burning of the targets
    set udg_HC_BurnSFX="war3mapImported\\Void Rain Missile.mdx"
    // Determines the unit model used as the rotatingwind
    set udg_HC_WindSFX="Abilities\\Spells\\Other\\Tornado\\Tornado_Target.mdl"
    // Determines the SFX used upon explosion
    set udg_HC_ExplosionSFX="war3mapImported\\EMPBomb.mdx"
    // Determines the spell used to act as the activation spell
    set udg_HC_Spell='A0OA'
    // Determines the Dummy used to attach all the effects to
    set udg_HC_DummyType='u015'
endfunction

//===========================================================================
function InitTrig_Helios_Collision_Configuration takes nothing returns nothing
    set gg_trg_Helios_Collision_Configuration=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_Helios_Collision_Configuration, 0.00)
    call TriggerAddAction(gg_trg_Helios_Collision_Configuration, function Trig_Helios_Collision_Configuration_Actions)
endfunction

//===========================================================================
// Trigger: Helios Collision Activation
//===========================================================================
function Trig_Helios_Collision_Activation_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GG' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Activation_Func034C takes nothing returns boolean
    if ( not ( udg_HC_MaxIndex == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Activation_Actions takes nothing returns nothing
    set udg_HC_Caster=GetTriggerUnit()
    set udg_HC_TempPoint=GetUnitLoc(udg_HC_Caster)
    set udg_HC_TempPoint2=GetSpellTargetLoc()
    set udg_HC_Angle=AngleBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2)
    call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint, bj_UNIT_FACING)
    set udg_HC_TempUnit=GetLastCreatedUnit()
    call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit, udg_HC_SunSFX)
    call SetUnitScalePercent(udg_HC_TempUnit, udg_HC_EffectScalingSun, 0.00, 0.00)
    call SetUnitFlyHeightBJ(udg_HC_TempUnit, udg_HC_EffectZSun, 0.00)
    set udg_HC_MaxIndex=( udg_HC_MaxIndex + 1 )
    set udg_HC_OriginalCaster[udg_HC_MaxIndex]=udg_HC_Caster
    set udg_HC_OwningPlayer[udg_HC_MaxIndex]=GetOwningPlayer(udg_HC_Caster)
    set udg_HC_TempInteger=GetUnitAbilityLevelSwapped(udg_HC_Spell, udg_HC_Caster)
    set udg_HC_TempReal=I2R(udg_HC_TempInteger)
    set udg_HC_SpecialEffect[udg_HC_MaxIndex]=GetLastCreatedEffectBJ()
    set udg_HC_Core[udg_HC_MaxIndex]=udg_HC_TempUnit
    set udg_HC_Aoe[udg_HC_MaxIndex]=( udg_HC_AoeBase + ( udg_HC_AoePerLevel * udg_HC_TempReal ) )
    set udg_HC_ExplosionDamage[udg_HC_MaxIndex]=( udg_HC_ExplosionDamageBase + ( udg_HC_ExplosionDamagePerLevel * udg_HC_TempReal ) )
    set udg_HC_MagnetismStrength[udg_HC_MaxIndex]=( udg_HC_MagnetismStrengthBase + ( udg_HC_MagnetismStrengthPerLevel * udg_HC_TempReal ) )
    set udg_HC_Distance[udg_HC_MaxIndex]=DistanceBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2)
    set udg_HC_Core[udg_HC_MaxIndex]=udg_HC_TempUnit
    set udg_HC_CurrentAngle[udg_HC_MaxIndex]=udg_HC_Angle
    set udg_HC_CurrentSunDistance[udg_HC_MaxIndex]=0.00
    set udg_HC_UnitIndex[udg_HC_MaxIndex]=udg_HC_TempUnit
    set udg_HC_StageID[udg_HC_MaxIndex]=1
    set udg_HC_Angle=0.00
    //  
    set udg_HC_BlastDistance[udg_HC_MaxIndex]=0.00
    set udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]=0.00
    set udg_HC_MaxHeight[udg_HC_MaxIndex]=0.00
    set udg_HC_CurrentHeight[udg_HC_MaxIndex]=0.00
    //  
    call RemoveLocation(udg_HC_TempPoint2)
    if ( Trig_Helios_Collision_Activation_Func034C() ) then
        call EnableTrigger(gg_trg_Helios_Collision_Loop)
    else
    endif
    set udg_HC_TempInteger2=( udg_HC_OrbCountBase + ( udg_HC_OrbCountPerLevel * udg_HC_TempInteger ) )
    // Fire Orb Creation
    set udg_HC_Index=1
    loop
        exitwhen udg_HC_Index > udg_HC_TempInteger2
        set udg_HC_Angle=( udg_HC_Angle + ( 360.00 / I2R(udg_HC_TempInteger2) ) )
        set udg_HC_TempPoint2=PolarProjectionBJ(udg_HC_TempPoint, udg_HC_OrbDistance, udg_HC_Angle)
        call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint2, bj_UNIT_FACING)
        set udg_HC_TempUnit2=GetLastCreatedUnit()
        call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit2, udg_HC_FireOrbSFX)
        call SetUnitScalePercent(udg_HC_TempUnit2, udg_HC_EffectScalingOrbs, 0.00, 0.00)
        call SetUnitFlyHeightBJ(udg_HC_TempUnit2, udg_HC_EffectScalingOrbs, 0.00)
        call RemoveLocation(udg_HC_TempPoint2)
        set udg_HC_MaxIndex=( udg_HC_MaxIndex + 1 )
        set udg_HC_SpecialEffect[udg_HC_MaxIndex]=GetLastCreatedEffectBJ()
        set udg_HC_CurrentAngle[udg_HC_MaxIndex]=udg_HC_Angle
        set udg_HC_StageID[udg_HC_MaxIndex]=2
        set udg_HC_Core[udg_HC_MaxIndex]=udg_HC_TempUnit
        set udg_HC_UnitIndex[udg_HC_MaxIndex]=udg_HC_TempUnit2
        //  
        set udg_HC_Aoe[udg_HC_MaxIndex]=0.00
        set udg_HC_OriginalCaster[udg_HC_MaxIndex]=udg_HC_Caster
        set udg_HC_OwningPlayer[udg_HC_MaxIndex]=GetOwningPlayer(udg_HC_Caster)
        set udg_HC_MaxHeight[udg_HC_MaxIndex]=0.00
        set udg_HC_BlastDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_CurrentHeight[udg_HC_MaxIndex]=0.00
        set udg_HC_CurrentSunDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_ExplosionDamage[udg_HC_MaxIndex]=0.00
        set udg_HC_MagnetismStrength[udg_HC_MaxIndex]=0.00
        set udg_HC_Index=udg_HC_Index + 1
    endloop
    set udg_HC_TempInteger2=( udg_HC_WindCountBase + ( udg_HC_WindCountPerLevel * udg_HC_TempInteger ) )
    // Wind Effect Creation
    set udg_HC_Index=1
    loop
        exitwhen udg_HC_Index > udg_HC_TempInteger2
        set udg_HC_Angle=( udg_HC_Angle + ( 360.00 / I2R(udg_HC_TempInteger2) ) )
        set udg_HC_TempPoint2=PolarProjectionBJ(udg_HC_TempPoint, udg_HC_OrbDistance, udg_HC_Angle)
        call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint2, bj_UNIT_FACING)
        set udg_HC_TempUnit2=GetLastCreatedUnit()
        call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit2, udg_HC_WindSFX)
        call SetUnitScalePercent(udg_HC_TempUnit2, udg_HC_EffectScalingOrbs, 0.00, 0.00)
        call SetUnitFlyHeightBJ(udg_HC_TempUnit2, udg_HC_EffectZWind, 0.00)
        call RemoveLocation(udg_HC_TempPoint2)
        set udg_HC_MaxIndex=( udg_HC_MaxIndex + 1 )
        set udg_HC_SpecialEffect[udg_HC_MaxIndex]=GetLastCreatedEffectBJ()
        set udg_HC_CurrentAngle[udg_HC_MaxIndex]=udg_HC_Angle
        set udg_HC_StageID[udg_HC_MaxIndex]=3
        set udg_HC_Core[udg_HC_MaxIndex]=udg_HC_TempUnit
        set udg_HC_UnitIndex[udg_HC_MaxIndex]=udg_HC_TempUnit2
        //  
        set udg_HC_Aoe[udg_HC_MaxIndex]=0.00
        set udg_HC_OriginalCaster[udg_HC_MaxIndex]=udg_HC_Caster
        set udg_HC_OwningPlayer[udg_HC_MaxIndex]=GetOwningPlayer(udg_HC_Caster)
        set udg_HC_BlastDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_CurrentHeight[udg_HC_MaxIndex]=0.00
        set udg_HC_CurrentSunDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_ExplosionDamage[udg_HC_MaxIndex]=0.00
        set udg_HC_MagnetismStrength[udg_HC_MaxIndex]=0.00
        set udg_HC_Index=udg_HC_Index + 1
    endloop
    call RemoveLocation(udg_HC_TempPoint)
endfunction

//===========================================================================
function InitTrig_Helios_Collision_Activation takes nothing returns nothing
    set gg_trg_Helios_Collision_Activation=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Helios_Collision_Activation, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Helios_Collision_Activation, Condition(function Trig_Helios_Collision_Activation_Conditions))
    call TriggerAddAction(gg_trg_Helios_Collision_Activation, function Trig_Helios_Collision_Activation_Actions)
endfunction

//===========================================================================
// Trigger: Helios Collision Loop
//===========================================================================
function Trig_Helios_Collision_Loop_Func001Func002Func003Func010Func020C takes nothing returns boolean
    if ( not ( udg_HC_MaxIndex == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func003Func010C takes nothing returns boolean
    if ( not ( udg_HC_CurrentHeight[udg_HC_Index] < 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func003C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002Func006C takes nothing returns boolean
    if ( not ( udg_HC_CurrentMagnetism > udg_HC_MagnetismCap ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_GROUND) == udg_HC_ConditionConfig[0] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_STRUCTURE) == udg_HC_ConditionConfig[1] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_MAGIC_IMMUNE) == udg_HC_ConditionConfig[2] ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_HC_TempUnit, udg_HC_OwningPlayer[udg_HC_Index]) == udg_HC_ConditionConfig[3] ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HC_TempUnit) == udg_HC_ConditionConfig[4] ) ) then
        return false
    endif
    if ( not ( IsUnitPausedBJ(udg_HC_TempUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func009A takes nothing returns nothing
    set udg_HC_TempUnit=GetEnumUnit()
    if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002C() ) then
        set udg_HC_TempPoint2=GetUnitLoc(udg_HC_TempUnit)
        set udg_HC_TempX=GetUnitX(udg_HC_TempUnit)
        set udg_HC_TempY=GetUnitY(udg_HC_TempUnit)
        set udg_HC_Angle=Atan2(GetUnitY(udg_HC_UnitIndex[udg_HC_Index]) - GetUnitY(udg_HC_TempUnit), GetUnitX(udg_HC_UnitIndex[udg_HC_Index]) - GetUnitX(udg_HC_TempUnit))
        set udg_HC_CurrentMagnetism=( udg_HC_MagnetismStrength[udg_HC_Index] / ( DistanceBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2) * udg_HC_MagnetismDistanceMultiplyer ) )
        if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002Func006C() ) then
            set udg_HC_CurrentMagnetism=udg_HC_MagnetismCap
        else
        endif
        call SetUnitX(udg_HC_TempUnit, udg_HC_TempX + udg_HC_CurrentMagnetism * Cos(udg_HC_Angle))
        call SetUnitY(udg_HC_TempUnit, udg_HC_TempY + udg_HC_CurrentMagnetism * Sin(udg_HC_Angle))
        call RemoveLocation(udg_HC_TempPoint2)
    else
    endif
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002Func009C takes nothing returns boolean
    if ( not ( udg_HC_BlastDistance[udg_HC_MaxIndex] > udg_HC_BlastCap ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_GROUND) == udg_HC_ConditionConfig[0] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_STRUCTURE) == udg_HC_ConditionConfig[1] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_MAGIC_IMMUNE) == udg_HC_ConditionConfig[2] ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_HC_TempUnit, udg_HC_OwningPlayer[udg_HC_Index]) == udg_HC_ConditionConfig[3] ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HC_TempUnit) == udg_HC_ConditionConfig[4] ) ) then
        return false
    endif
    if ( not ( IsUnitPausedBJ(udg_HC_TempUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003A takes nothing returns nothing
    set udg_HC_TempUnit=GetEnumUnit()
    if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002C() ) then
        set udg_HC_TempPoint2=GetUnitLoc(udg_HC_TempUnit)
        call UnitDamageTargetBJ(udg_HC_OriginalCaster[udg_HC_Index], udg_HC_TempUnit, udg_HC_ExplosionDamage[udg_HC_Index], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
        set udg_HC_MaxIndex=( udg_HC_MaxIndex + 1 )
        call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit, udg_HC_BurnSFX)
        set udg_HC_SpecialEffect[udg_HC_MaxIndex]=GetLastCreatedEffectBJ()
        set udg_HC_CurrentAngle[udg_HC_MaxIndex]=AngleBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2)
        set udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_BlastDistance[udg_HC_MaxIndex]=( udg_HC_BlastDistanceBase / ( DistanceBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2) * udg_HC_BlastDistanceMultiplyer ) )
        if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002Func009C() ) then
            set udg_HC_BlastDistance[udg_HC_MaxIndex]=udg_HC_BlastCap
        else
        endif
        set udg_HC_MaxHeight[udg_HC_MaxIndex]=( udg_HC_BlastDistance[udg_HC_MaxIndex] * udg_HC_HeightMultiplyer )
        set udg_HC_CurrentHeight[udg_HC_MaxIndex]=GetUnitFlyHeight(udg_HC_TempUnit)
        set udg_HC_StageID[udg_HC_MaxIndex]=4
        set udg_HC_UnitIndex[udg_HC_MaxIndex]=udg_HC_TempUnit
        //  
        set udg_HC_Aoe[udg_HC_MaxIndex]=0.00
        set udg_HC_OriginalCaster[udg_HC_MaxIndex]=udg_HC_TempUnit
        set udg_HC_OwningPlayer[udg_HC_MaxIndex]=GetOwningPlayer(udg_HC_TempUnit)
        set udg_HC_CurrentSunDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_Core[udg_HC_MaxIndex]=udg_HC_TempUnit
        set udg_HC_ExplosionDamage[udg_HC_MaxIndex]=0.00
        set udg_HC_MagnetismStrength[udg_HC_MaxIndex]=0.00
        call UnitAddAbilityBJ('Arav', udg_HC_TempUnit)
        call UnitRemoveAbilityBJ('Arav', udg_HC_TempUnit)
        call PauseUnitBJ(true, udg_HC_TempUnit)
        call RemoveLocation(udg_HC_TempPoint2)
    else
    endif
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func006Func001C takes nothing returns boolean
    if ( not ( udg_HC_Core[udg_HC_SecondaryIndex] == udg_HC_UnitIndex[udg_HC_Index] ) ) then
        return false
    endif
    if ( not ( udg_HC_UnitIndex[udg_HC_SecondaryIndex] != udg_HC_UnitIndex[udg_HC_Index] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func034C takes nothing returns boolean
    if ( not ( udg_HC_MaxIndex == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013C takes nothing returns boolean
    if ( not ( udg_HC_CurrentSunDistance[udg_HC_Index] >= udg_HC_Distance[udg_HC_Index] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func006C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func008C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HC_UnitIndex[udg_HC_Index]) == udg_HC_DummyType ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Actions takes nothing returns nothing
    set udg_HC_Index=1
    loop
        exitwhen udg_HC_Index > udg_HC_MaxIndex
        set udg_HC_Angle=0.00
        if ( Trig_Helios_Collision_Loop_Func001Func002C() ) then
            // Control over Sun
            if ( Trig_Helios_Collision_Loop_Func001Func002Func004C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_SunSpeed * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_SunSpeed * Sin(udg_HC_Angle))
                // Magnetism Control
                set udg_HC_TempPoint=GetUnitLoc(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_TempGroup=GetUnitsInRangeOfLocAll(udg_HC_Aoe[udg_HC_Index], udg_HC_TempPoint)
                call ForGroupBJ(udg_HC_TempGroup, function Trig_Helios_Collision_Loop_Func001Func002Func004Func009A)
                call DestroyGroup(udg_HC_TempGroup)
                set udg_HC_CurrentSunDistance[udg_HC_Index]=( udg_HC_CurrentSunDistance[udg_HC_Index] + udg_HC_SunSpeed )
                // Explosion Control
                if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013C() ) then
                    set udg_HC_TempGroup=GetUnitsInRangeOfLocAll(udg_HC_ExplosionAOE, udg_HC_TempPoint)
                    // Effected Units
                    call ForGroupBJ(udg_HC_TempGroup, function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003A)
                    call DestroyGroup(udg_HC_TempGroup)
                    // Cleanup
                    set udg_HC_SecondaryIndex=1
                    loop
                        exitwhen udg_HC_SecondaryIndex > udg_HC_MaxIndex
                        if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func006Func001C() ) then
                            set udg_HC_TempUnit=udg_HC_UnitIndex[udg_HC_SecondaryIndex]
                            set udg_HC_TempPoint2=GetUnitLoc(udg_HC_TempUnit)
                            call DestroyEffectBJ(udg_HC_SpecialEffect[udg_HC_SecondaryIndex])
                            call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint2, bj_UNIT_FACING)
                            set udg_HC_TempUnit2=GetLastCreatedUnit()
                            call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit2, udg_HC_ExplosionSFX)
                            call SetUnitScalePercent(udg_HC_TempUnit2, udg_HC_EffectScalingBlast, 0.00, 0.00)
                            call SetUnitFlyHeightBJ(udg_HC_TempUnit2, udg_HC_EffectZBlast, 0.00)
                            call DestroyEffectBJ(GetLastCreatedEffectBJ())
                            call UnitApplyTimedLifeBJ(udg_HC_DummyExpirationTimers, 'BTLF', udg_HC_TempUnit2)
                            set udg_HC_StageID[udg_HC_SecondaryIndex]=udg_HC_StageID[udg_HC_MaxIndex]
                            set udg_HC_Aoe[udg_HC_SecondaryIndex]=udg_HC_Aoe[udg_HC_MaxIndex]
                            set udg_HC_OriginalCaster[udg_HC_SecondaryIndex]=udg_HC_OriginalCaster[udg_HC_MaxIndex]
                            set udg_HC_BlastDistance[udg_HC_SecondaryIndex]=udg_HC_BlastDistance[udg_HC_MaxIndex]
                            set udg_HC_CurrentAngle[udg_HC_SecondaryIndex]=udg_HC_CurrentAngle[udg_HC_MaxIndex]
                            set udg_HC_CurrentBlastDistance[udg_HC_SecondaryIndex]=udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]
                            set udg_HC_OwningPlayer[udg_HC_SecondaryIndex]=udg_HC_OwningPlayer[udg_HC_MaxIndex]
                            set udg_HC_MaxHeight[udg_HC_SecondaryIndex]=udg_HC_MaxHeight[udg_HC_MaxIndex]
                            set udg_HC_SpecialEffect[udg_HC_SecondaryIndex]=udg_HC_SpecialEffect[udg_HC_MaxIndex]
                            set udg_HC_CurrentHeight[udg_HC_SecondaryIndex]=udg_HC_CurrentHeight[udg_HC_MaxIndex]
                            set udg_HC_CurrentSunDistance[udg_HC_SecondaryIndex]=udg_HC_CurrentSunDistance[udg_HC_MaxIndex]
                            set udg_HC_ExplosionDamage[udg_HC_SecondaryIndex]=udg_HC_ExplosionDamage[udg_HC_MaxIndex]
                            set udg_HC_Core[udg_HC_SecondaryIndex]=udg_HC_Core[udg_HC_MaxIndex]
                            set udg_HC_UnitIndex[udg_HC_SecondaryIndex]=udg_HC_UnitIndex[udg_HC_MaxIndex]
                            set udg_HC_MagnetismStrength[udg_HC_SecondaryIndex]=udg_HC_MagnetismStrength[udg_HC_MaxIndex]
                            set udg_HC_MaxIndex=( udg_HC_MaxIndex - 1 )
                            set udg_HC_SecondaryIndex=( udg_HC_SecondaryIndex - 1 )
                            call RemoveUnit(udg_HC_TempUnit)
                            call RemoveLocation(udg_HC_TempPoint2)
                        else
                        endif
                        set udg_HC_SecondaryIndex=udg_HC_SecondaryIndex + 1
                    endloop
                    call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint, bj_UNIT_FACING)
                    set udg_HC_TempUnit=GetLastCreatedUnit()
                    call DestroyEffectBJ(udg_HC_SpecialEffect[udg_HC_Index])
                    call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit, udg_HC_ExplosionSFX)
                    call SetUnitScalePercent(udg_HC_TempUnit, udg_HC_EffectScalingBlast, 0.00, 0.00)
                    call SetUnitFlyHeightBJ(udg_HC_TempUnit, udg_HC_EffectZBlast, 0.00)
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    call UnitApplyTimedLifeBJ(udg_HC_DummyExpirationTimers, 'BTLF', udg_HC_TempUnit)
                    set udg_HC_TempUnit=udg_HC_UnitIndex[udg_HC_Index]
                    set udg_HC_StageID[udg_HC_Index]=udg_HC_StageID[udg_HC_MaxIndex]
                    set udg_HC_Aoe[udg_HC_Index]=udg_HC_Aoe[udg_HC_MaxIndex]
                    set udg_HC_OriginalCaster[udg_HC_Index]=udg_HC_OriginalCaster[udg_HC_MaxIndex]
                    set udg_HC_BlastDistance[udg_HC_Index]=udg_HC_BlastDistance[udg_HC_MaxIndex]
                    set udg_HC_CurrentAngle[udg_HC_Index]=udg_HC_CurrentAngle[udg_HC_MaxIndex]
                    set udg_HC_OwningPlayer[udg_HC_Index]=udg_HC_OwningPlayer[udg_HC_MaxIndex]
                    set udg_HC_MaxHeight[udg_HC_Index]=udg_HC_MaxHeight[udg_HC_MaxIndex]
                    set udg_HC_CurrentBlastDistance[udg_HC_Index]=udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]
                    set udg_HC_CurrentHeight[udg_HC_Index]=udg_HC_CurrentHeight[udg_HC_MaxIndex]
                    set udg_HC_SpecialEffect[udg_HC_Index]=udg_HC_SpecialEffect[udg_HC_MaxIndex]
                    set udg_HC_CurrentSunDistance[udg_HC_Index]=udg_HC_CurrentSunDistance[udg_HC_MaxIndex]
                    set udg_HC_Core[udg_HC_Index]=udg_HC_Core[udg_HC_MaxIndex]
                    set udg_HC_UnitIndex[udg_HC_Index]=udg_HC_UnitIndex[udg_HC_MaxIndex]
                    set udg_HC_ExplosionDamage[udg_HC_Index]=udg_HC_ExplosionDamage[udg_HC_MaxIndex]
                    set udg_HC_MagnetismStrength[udg_HC_Index]=udg_HC_MagnetismStrength[udg_HC_MaxIndex]
                    set udg_HC_MaxIndex=( udg_HC_MaxIndex - 1 )
                    set udg_HC_Index=( udg_HC_Index - 1 )
                    call RemoveUnit(udg_HC_TempUnit)
                    if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func034C() ) then
                        call DisableTrigger(GetTriggeringTrigger())
                    else
                    endif
                else
                endif
                call RemoveLocation(udg_HC_TempPoint)
            else
            endif
            // Fire balls Spin Control
            if ( Trig_Helios_Collision_Loop_Func001Func002Func006C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_Core[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_Core[udg_HC_Index])
                set udg_HC_CurrentAngle[udg_HC_Index]=( udg_HC_CurrentAngle[udg_HC_Index] + udg_HC_FireOrbSpinSpeed )
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_OrbDistance * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_OrbDistance * Sin(udg_HC_Angle))
                set udg_HC_TempPoint=GetUnitLoc(udg_HC_Core[udg_HC_Index])
                call SetUnitFacingToFaceLocTimed(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempPoint, 0)
                call RemoveLocation(udg_HC_TempPoint)
            else
            endif
            // Wind Spin Control
            if ( Trig_Helios_Collision_Loop_Func001Func002Func008C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_Core[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_Core[udg_HC_Index])
                set udg_HC_CurrentAngle[udg_HC_Index]=( udg_HC_CurrentAngle[udg_HC_Index] + udg_HC_WindSpinSpeed )
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_WindDistance * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_WindDistance * Sin(udg_HC_Angle))
            else
            endif
        else
            //  Control of Knockbacked units
            if ( Trig_Helios_Collision_Loop_Func001Func002Func003C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_BlastSpeed * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_BlastSpeed * Sin(udg_HC_Angle))
                set udg_HC_CurrentBlastDistance[udg_HC_Index]=( udg_HC_CurrentBlastDistance[udg_HC_Index] + udg_HC_BlastSpeed )
                set udg_HC_CurrentHeight[udg_HC_Index]=( ( ( 4.00 * udg_HC_MaxHeight[udg_HC_Index] ) / udg_HC_BlastDistance[udg_HC_Index] ) * ( ( udg_HC_CurrentBlastDistance[udg_HC_Index] / udg_HC_BlastDistance[udg_HC_Index] ) * ( udg_HC_BlastDistance[udg_HC_Index] - udg_HC_CurrentBlastDistance[udg_HC_Index] ) ) )
                call SetUnitFlyHeightBJ(udg_HC_UnitIndex[udg_HC_Index], udg_HC_CurrentHeight[udg_HC_Index], 0.00)
                // Unit Release
                if ( Trig_Helios_Collision_Loop_Func001Func002Func003Func010C() ) then
                    call DestroyEffectBJ(udg_HC_SpecialEffect[udg_HC_Index])
                    call PauseUnitBJ(false, udg_HC_UnitIndex[udg_HC_Index])
                    set udg_HC_StageID[udg_HC_Index]=udg_HC_StageID[udg_HC_MaxIndex]
                    set udg_HC_Aoe[udg_HC_Index]=udg_HC_Aoe[udg_HC_MaxIndex]
                    set udg_HC_OriginalCaster[udg_HC_Index]=udg_HC_OriginalCaster[udg_HC_MaxIndex]
                    set udg_HC_OwningPlayer[udg_HC_Index]=udg_HC_OwningPlayer[udg_HC_MaxIndex]
                    set udg_HC_BlastDistance[udg_HC_Index]=udg_HC_BlastDistance[udg_HC_MaxIndex]
                    set udg_HC_CurrentAngle[udg_HC_Index]=udg_HC_CurrentAngle[udg_HC_MaxIndex]
                    set udg_HC_CurrentBlastDistance[udg_HC_Index]=udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]
                    set udg_HC_SpecialEffect[udg_HC_Index]=udg_HC_SpecialEffect[udg_HC_MaxIndex]
                    set udg_HC_CurrentHeight[udg_HC_Index]=udg_HC_CurrentHeight[udg_HC_MaxIndex]
                    set udg_HC_MaxHeight[udg_HC_Index]=udg_HC_MaxHeight[udg_HC_MaxIndex]
                    set udg_HC_CurrentSunDistance[udg_HC_Index]=udg_HC_CurrentSunDistance[udg_HC_MaxIndex]
                    set udg_HC_Core[udg_HC_Index]=udg_HC_Core[udg_HC_MaxIndex]
                    set udg_HC_UnitIndex[udg_HC_Index]=udg_HC_UnitIndex[udg_HC_MaxIndex]
                    set udg_HC_ExplosionDamage[udg_HC_Index]=udg_HC_ExplosionDamage[udg_HC_MaxIndex]
                    set udg_HC_MagnetismStrength[udg_HC_Index]=udg_HC_MagnetismStrength[udg_HC_MaxIndex]
                    set udg_HC_MaxIndex=( udg_HC_MaxIndex - 1 )
                    set udg_HC_Index=( udg_HC_Index - 1 )
                    if ( Trig_Helios_Collision_Loop_Func001Func002Func003Func010Func020C() ) then
                        call DisableTrigger(GetTriggeringTrigger())
                    else
                    endif
                else
                endif
            else
            endif
        endif
        set udg_HC_Index=udg_HC_Index + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Helios_Collision_Loop takes nothing returns nothing
    set gg_trg_Helios_Collision_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Helios_Collision_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Helios_Collision_Loop, 0.03)
    call TriggerAddAction(gg_trg_Helios_Collision_Loop, function Trig_Helios_Collision_Loop_Actions)
endfunction

//===========================================================================
// Trigger: Helios Collision Dummy Removal
//===========================================================================
function Trig_Helios_Collision_Dummy_Removal_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HC_TempUnit) == udg_HC_DummyType ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Dummy_Removal_Actions takes nothing returns nothing
    set udg_HC_TempUnit=GetTriggerUnit()
    if ( Trig_Helios_Collision_Dummy_Removal_Func002C() ) then
        call RemoveUnit(udg_HC_TempUnit)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Helios_Collision_Dummy_Removal takes nothing returns nothing
    set gg_trg_Helios_Collision_Dummy_Removal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Helios_Collision_Dummy_Removal, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(gg_trg_Helios_Collision_Dummy_Removal, function Trig_Helios_Collision_Dummy_Removal_Actions)
endfunction

//===========================================================================
// Trigger: Guardian Force Field Learn
//===========================================================================
function Trig_Guardian_Force_Field_Learn_Conditions takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'AFOR' ) ) then
        return false
    endif
    if ( not ( GetLearnedSkillLevel() == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Learn_Actions takes nothing returns nothing
    if udg_Guardian_FF_Hash == null then
    call InitHashtableBJ()
    set udg_Guardian_FF_Hash=GetLastCreatedHashtableBJ()
    endif
    set udg_Guardian_FF_Detonate='AFFD'
    call UnitAddAbilityBJ(udg_Guardian_FF_Detonate, GetTriggerUnit())
    call UnitMakeAbilityPermanent(GetTriggerUnit(), true, udg_Guardian_FF_Detonate)
    call BlzUnitDisableAbility(GetTriggerUnit(), udg_Guardian_FF_Detonate, true, false)
endfunction

//===========================================================================
function InitTrig_Guardian_Force_Field_Learn takes nothing returns nothing
    set gg_trg_Guardian_Force_Field_Learn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Guardian_Force_Field_Learn, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_Guardian_Force_Field_Learn, Condition(function Trig_Guardian_Force_Field_Learn_Conditions))
    call TriggerAddAction(gg_trg_Guardian_Force_Field_Learn, function Trig_Guardian_Force_Field_Learn_Actions)
endfunction

//===========================================================================
// Trigger: Guardian Force Field Detonate
//===========================================================================
function Trig_Guardian_Force_Field_Detonate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AFFD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Detonate_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Guardian == udg_Guardian_FF_Caster[udg_Guardian_FF_Loop] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Detonate_Actions takes nothing returns nothing
    set udg_Guardian=GetTriggerUnit()
    set udg_Guardian_FF_Loop=1
    loop
        exitwhen udg_Guardian_FF_Loop > udg_Guardian_FF_Index
        if ( Trig_Guardian_Force_Field_Detonate_Func002Func001C() ) then
            set udg_Guardian_FF_Duration[udg_Guardian_FF_Loop]=0.00
        else
        endif
        set udg_Guardian_FF_Loop=udg_Guardian_FF_Loop + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Guardian_Force_Field_Detonate takes nothing returns nothing
    set gg_trg_Guardian_Force_Field_Detonate=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Guardian_Force_Field_Detonate, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Guardian_Force_Field_Detonate, Condition(function Trig_Guardian_Force_Field_Detonate_Conditions))
    call TriggerAddAction(gg_trg_Guardian_Force_Field_Detonate, function Trig_Guardian_Force_Field_Detonate_Actions)
endfunction

//===========================================================================
// Trigger: Guardian Force Field Cast
//===========================================================================
function Trig_Guardian_Force_Field_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AFOR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Cast_Func005C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Duration_Per_Lvl[1] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Cast_Func028C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] > 6 ) ) then
        return false
    endif
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] <= 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Cast_Func031C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian)] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Cast_Func033C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Index == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Cast_Actions takes nothing returns nothing
    set udg_Guardian=GetTriggerUnit()
    set udg_Guardian_FF_Index=( udg_Guardian_FF_Index + 1 )
    //                                                                                                                    
    // DEFINE THE DURATION PER [LEVEL]:
    if ( Trig_Guardian_Force_Field_Cast_Func005C() ) then
        set udg_Guardian_FF_Duration_Per_Lvl[1]=3.00
        set udg_Guardian_FF_Duration_Per_Lvl[2]=3.00
        set udg_Guardian_FF_Duration_Per_Lvl[3]=3.50
        set udg_Guardian_FF_Duration_Per_Lvl[4]=4.00
        set udg_Guardian_FF_Duration_Per_Lvl[5]=5.00
        set udg_Guardian_FF_Duration_Per_Lvl[6]=5.00
    else
    endif
    //                                                                                                                    
    set udg_Guardian_Point[0]=GetUnitLoc(udg_Guardian)
    set udg_Guardian_FF_Point[udg_Guardian_FF_Index]=GetSpellTargetLoc()
    set udg_Guardian_FF_Angle[udg_Guardian_FF_Index]=AngleBetweenPoints(udg_Guardian_Point[0], udg_Guardian_FF_Point[udg_Guardian_FF_Index])
    set udg_Guardian_FF_Duration[udg_Guardian_FF_Index]=udg_Guardian_FF_Duration_Per_Lvl[GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Guardian)]
    set udg_Guardian_FF_Level[udg_Guardian_FF_Index]=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Guardian)
    set udg_Guardian_FF_Caster[udg_Guardian_FF_Index]=udg_Guardian
    //                                                                                                                    
    // PATHING BLOCKER:
    call CPP_Add_Pathing(udg_Guardian_FF_Point[udg_Guardian_FF_Index] , 64 , PATHING_TYPE_ANY)
    //                                                                                                                    
    // Some visuals for expressing the death animation:
    call AddSpecialEffectLocBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Index], "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                                    
    // Create force field effects and destroy them a short duration later:
    call AddSpecialEffectLocBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Index], "SC2ForceField_ByEpsilon.mdx")
    call SaveEffectHandleBJ(GetLastCreatedEffectBJ(), 0, udg_Guardian_FF_Index, udg_Guardian_FF_Hash)
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.60)
    call BlzSetSpecialEffectTimeScale(GetLastCreatedEffectBJ(), 3.00)
    //                                                                                                                    
    // Level 1/2 create 1 Wall. Later levels increase number of Walls (1/1/3/3/5/5):
    if ( Trig_Guardian_Force_Field_Cast_Func028C() ) then
        //                                                                                                                    
        set udg_Guardian_Integer[0]=1
        loop
            exitwhen udg_Guardian_Integer[0] > 6
            // PATHING BLOCKER:
            call CPP_Add_Pathing(udg_Guardian_Point[udg_Guardian_Integer[0]] , 64 , PATHING_TYPE_ANY)
            //                                                                                                                    
            // Some visuals for expressing the death animation:
            call AddSpecialEffectLocBJ(udg_Guardian_Point[udg_Guardian_Integer[0]], "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            call AddSpecialEffectLocBJ(udg_Guardian_Point[udg_Guardian_Integer[0]], "SC2ForceField_ByEpsilon.mdx")
            call SaveEffectHandleBJ(GetLastCreatedEffectBJ(), udg_Guardian_Integer[0], udg_Guardian_FF_Index, udg_Guardian_FF_Hash)
            call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.80)
            call BlzSetSpecialEffectTimeScale(GetLastCreatedEffectBJ(), 3.00)
            //                                                                                                                    
            call RemoveLocation(udg_Guardian_Point[udg_Guardian_Integer[0]])
            set udg_Guardian_Integer[0]=udg_Guardian_Integer[0] + 1
        endloop
    else
    endif
    //                                                                                                                    
    set udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian)]=( udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian)] + 1 )
    if ( Trig_Guardian_Force_Field_Cast_Func031C() ) then
        call BlzUnitDisableAbility(udg_Guardian, 'AFFD', false, false)
    else
    endif
    //                                                                                                                    
    if ( Trig_Guardian_Force_Field_Cast_Func033C() ) then
        call EnableTrigger(gg_trg_Guardian_Force_Field_Loop)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Guardian_Force_Field_Cast takes nothing returns nothing
    set gg_trg_Guardian_Force_Field_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Guardian_Force_Field_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Guardian_Force_Field_Cast, Condition(function Trig_Guardian_Force_Field_Cast_Conditions))
    call TriggerAddAction(gg_trg_Guardian_Force_Field_Cast, function Trig_Guardian_Force_Field_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Guardian Force Field Loop
//===========================================================================
function Trig_Guardian_Force_Field_Loop_Func001Func003Func003C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Func001Func003Func013Func001C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] > 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Func001Func003Func013C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] > 2 ) ) then
        return false
    endif
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] <= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Func001Func003Func030C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Index == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Func001Func003C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Duration[udg_Guardian_FF_Loop] <= 0.01 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Actions takes nothing returns nothing
    set udg_Guardian_FF_Loop=1
    loop
        exitwhen udg_Guardian_FF_Loop > udg_Guardian_FF_Index
        set udg_Guardian_FF_Duration[udg_Guardian_FF_Loop]=( udg_Guardian_FF_Duration[udg_Guardian_FF_Loop] - 0.02 )
        //                                                                                                                    
        if ( Trig_Guardian_Force_Field_Loop_Func001Func003C() ) then
            // Disable Detonate:
            set udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])]=( udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])] - 1 )
            if ( Trig_Guardian_Force_Field_Loop_Func001Func003Func003C() ) then
                call BlzUnitDisableAbility(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop], 'AFFD', true, false)
            else
            endif
            //                                                                                                                    
            // Some visuals for expressing the death animation:
            call AddSpecialEffectLocBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            // PATHING BLOCKER:
            call CPP_Remove_Pathing(udg_Guardian_FF_Point[udg_Guardian_FF_Loop] , 64 , PATHING_TYPE_ANY)
            //                                                                                                                    
            // Level 3/4 = 3 Walls:
            if ( Trig_Guardian_Force_Field_Loop_Func001Func003Func013C() ) then
                set udg_Guardian_Point[0]=PolarProjectionBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], 128.00, ( udg_Guardian_FF_Angle[udg_Guardian_FF_Loop] + 90.00 ))
                set udg_Guardian_Point[1]=PolarProjectionBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], 128.00, ( udg_Guardian_FF_Angle[udg_Guardian_FF_Loop] - 90.00 ))
                //                                                                                                                    
                // Damage/Stun:
                call TriggerExecute(gg_trg_Guardian_Force_Field_Damage)
                //                                                                                                                    
                set udg_Guardian_Integer[0]=0
                loop
                    exitwhen udg_Guardian_Integer[0] > 1
                    // PATHING BLOCKER:
                    call CPP_Remove_Pathing(udg_Guardian_Point[udg_Guardian_Integer[0]] , 64 , PATHING_TYPE_ANY)
                    //                                                                                                                    
                    // Some visuals for expressing the death animation:
                    call AddSpecialEffectLocBJ(udg_Guardian_Point[udg_Guardian_Integer[0]], "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
                    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.75)
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    //                                                                                                                    
                    call RemoveLocation(udg_Guardian_Point[udg_Guardian_Integer[0]])
                    set udg_Guardian_Integer[0]=udg_Guardian_Integer[0] + 1
                endloop
            else
                if ( Trig_Guardian_Force_Field_Loop_Func001Func003Func013Func001C() ) then
                    // Level 5/6 = 5 Walls:
                    set udg_Guardian_Point[0]=PolarProjectionBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], 128.00, ( udg_Guardian_FF_Angle[udg_Guardian_FF_Loop] + 90.00 ))
                    set udg_Guardian_Point[1]=PolarProjectionBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], 128.00, ( udg_Guardian_FF_Angle[udg_Guardian_FF_Loop] - 90.00 ))
                    set udg_Guardian_Point[2]=PolarProjectionBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], 256.00, ( udg_Guardian_FF_Angle[udg_Guardian_FF_Loop] + 90.00 ))
                    set udg_Guardian_Point[3]=PolarProjectionBJ(udg_Guardian_FF_Point[udg_Guardian_FF_Loop], 256.00, ( udg_Guardian_FF_Angle[udg_Guardian_FF_Loop] - 90.00 ))
                    //                                                                                                                    
                    // Damage/Stun:
                    call TriggerExecute(gg_trg_Guardian_Force_Field_Damage)
                    //                                                                                                                    
                    set udg_Guardian_Integer[0]=0
                    loop
                        exitwhen udg_Guardian_Integer[0] > 3
                        // PATHING BLOCKER:
                        call CPP_Remove_Pathing(udg_Guardian_Point[udg_Guardian_Integer[0]] , 64 , PATHING_TYPE_ANY)
                        //                                                                                                                    
                        // Some visuals for expressing the death animation:
                        call AddSpecialEffectLocBJ(udg_Guardian_Point[udg_Guardian_Integer[0]], "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
                        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.75)
                        call DestroyEffectBJ(GetLastCreatedEffectBJ())
                        //                                                                                                                    
                        call RemoveLocation(udg_Guardian_Point[udg_Guardian_Integer[0]])
                        set udg_Guardian_Integer[0]=udg_Guardian_Integer[0] + 1
                    endloop
                else
                    // 1 Wall (Level 1/2):
                    // Damage/Stun:
                    call TriggerExecute(gg_trg_Guardian_Force_Field_Damage)
                endif
            endif
            //                                                                                                                    
            // Transfer data:
            call RemoveLocation(udg_Guardian_FF_Point[udg_Guardian_FF_Loop])
            set udg_Guardian_FF_Point[udg_Guardian_FF_Loop]=udg_Guardian_FF_Point[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Duration[udg_Guardian_FF_Loop]=udg_Guardian_FF_Duration[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Angle[udg_Guardian_FF_Loop]=udg_Guardian_FF_Angle[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Level[udg_Guardian_FF_Loop]=udg_Guardian_FF_Level[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Caster[udg_Guardian_FF_Loop]=udg_Guardian_FF_Caster[udg_Guardian_FF_Index]
            //                                                                                                                    
            // HASHTABLE:
            set udg_Guardian_Integer[0]=0
            loop
                exitwhen udg_Guardian_Integer[0] > 4
                set udg_DDE_Effect=LoadEffectHandleBJ(udg_Guardian_Integer[0], udg_Guardian_FF_Loop, udg_Guardian_FF_Hash)
                set udg_DDE_Duration=0.00
                set udg_DDE_Hide_Death_Animation=true
                call TriggerExecute(gg_trg_DDE_Destroy_Effect)
                //                                                                                                                    
                set udg_DDE_Effect=LoadEffectHandleBJ(udg_Guardian_Integer[0], udg_Guardian_FF_Index, udg_Guardian_FF_Hash)
                if udg_DDE_Effect != null then
                call SaveEffectHandleBJ(udg_DDE_Effect, udg_Guardian_Integer[0], udg_Guardian_FF_Loop, udg_Guardian_FF_Hash)
                endif
                set udg_Guardian_Integer[0]=udg_Guardian_Integer[0] + 1
            endloop
            //                                                                                                                    
            // Remove this instance from the loop:
            set udg_Guardian_FF_Index=( udg_Guardian_FF_Index - 1 )
            set udg_Guardian_FF_Loop=( udg_Guardian_FF_Loop - 1 )
            //                                                                                                                    
            if ( Trig_Guardian_Force_Field_Loop_Func001Func003Func030C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        else
        endif
        set udg_Guardian_FF_Loop=udg_Guardian_FF_Loop + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Guardian_Force_Field_Loop takes nothing returns nothing
    set gg_trg_Guardian_Force_Field_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Guardian_Force_Field_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Guardian_Force_Field_Loop, 0.02)
    call TriggerAddAction(gg_trg_Guardian_Force_Field_Loop, function Trig_Guardian_Force_Field_Loop_Actions)
endfunction

//===========================================================================
// Trigger: Guardian Force Field Damage
//===========================================================================
function Trig_Guardian_Force_Field_Damage_Func013Func008C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] <= 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Damage_Func013Func011Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Guardian_Unit[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_Guardian_Unit[0], GetOwningPlayer(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Guardian_Unit[0], UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Guardian_Unit[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Guardian_Unit[0]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Damage_Func013Func011Func002A takes nothing returns nothing
    set udg_Guardian_Unit[0]=GetEnumUnit()
    if ( Trig_Guardian_Force_Field_Damage_Func013Func011Func002Func002C() ) then
        call GroupAddUnitSimple(udg_Guardian_Unit[0], udg_Guardian_Group[1])
    else
    endif
endfunction

function Trig_Guardian_Force_Field_Damage_Func013Func014A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop], GetEnumUnit(), udg_Guardian_Real[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
endfunction

function Trig_Guardian_Force_Field_Damage_Func013Func018Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Guardian_Unit[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_Guardian_Unit[0], GetOwningPlayer(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Guardian_Unit[0], UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Guardian_Unit[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Guardian_Unit[0]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Damage_Func013Func018A takes nothing returns nothing
    set udg_Guardian_Unit[0]=GetEnumUnit()
    if ( Trig_Guardian_Force_Field_Damage_Func013Func018Func002C() ) then
        call UnitDamageTargetBJ(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop], udg_Guardian_Unit[0], udg_Guardian_Real[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
    else
    endif
endfunction

function Trig_Guardian_Force_Field_Damage_Func013C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] <= 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Damage_Actions takes nothing returns nothing
    // Get damage dealt based on ability level:
    set udg_Guardian_Real[0]=( 0.00 * I2R(udg_Guardian_FF_Level[udg_Guardian_FF_Loop]) )
    //                                                                                                                    
    // Create the dummy:
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop]), udg_Guardian_FF_Point[udg_Guardian_FF_Loop], bj_UNIT_FACING)
    set udg_Guardian_Unit[1]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.25, 'BTLF', udg_Guardian_Unit[1])
    call UnitAddAbilityBJ('AFFS', udg_Guardian_Unit[1])
    call SetUnitAbilityLevelSwapped('AFFS', udg_Guardian_Unit[1], udg_Guardian_FF_Level[udg_Guardian_FF_Loop])
    call IssueImmediateOrderBJ(udg_Guardian_Unit[1], "stomp")
    //                                                                                                                    
    // Manage stun and damage around each force field:
    if ( Trig_Guardian_Force_Field_Damage_Func013C() ) then
        // Levels 1 and 2
        //                                                                                                                    
        // Deal damage:
        set udg_Guardian_Group[0]=GetUnitsInRangeOfLocAll(175.00, udg_Guardian_FF_Point[udg_Guardian_FF_Loop])
        call ForGroupBJ(udg_Guardian_Group[0], function Trig_Guardian_Force_Field_Damage_Func013Func018A)
        call DestroyGroup(udg_Guardian_Group[0])
    else
        // Level 3+
        set udg_Guardian_Group[1]=CreateGroup()
        //                                                                                                                    
        // Determine number of Walls based on level (1/1/3/3/5/5):
        if ( Trig_Guardian_Force_Field_Damage_Func013Func008C() ) then
            set udg_Guardian_Integer[10]=1
        else
            set udg_Guardian_Integer[10]=1
        endif
        //                                                                                                                    
        // Stun and gather targets for damage:
        set udg_Guardian_Integer[0]=0
        loop
            exitwhen udg_Guardian_Integer[0] > udg_Guardian_Integer[10]
            set udg_Guardian_Group[0]=GetUnitsInRangeOfLocAll(175.00, udg_Guardian_Point[udg_Guardian_Integer[0]])
            call ForGroupBJ(udg_Guardian_Group[0], function Trig_Guardian_Force_Field_Damage_Func013Func011Func002A)
            call DestroyGroup(udg_Guardian_Group[0])
            //                                                                                                                    
            call SetUnitPositionLoc(udg_Guardian_Unit[1], udg_Guardian_Point[udg_Guardian_Integer[0]])
            call IssueImmediateOrderBJ(udg_Guardian_Unit[1], "stomp")
            set udg_Guardian_Integer[0]=udg_Guardian_Integer[0] + 1
        endloop
        //                                                                                                                    
        // Deal damage:
        call ForGroupBJ(udg_Guardian_Group[1], function Trig_Guardian_Force_Field_Damage_Func013Func014A)
        //                                                                                                                    
        call DestroyGroup(udg_Guardian_Group[1])
    endif
endfunction

//===========================================================================
function InitTrig_Guardian_Force_Field_Damage takes nothing returns nothing
    set gg_trg_Guardian_Force_Field_Damage=CreateTrigger()
    call TriggerAddAction(gg_trg_Guardian_Force_Field_Damage, function Trig_Guardian_Force_Field_Damage_Actions)
endfunction

//===========================================================================
// Trigger: Guardian Energy Chamber Ally Cast
//===========================================================================
function Trig_Guardian_Energy_Chamber_Ally_Cast_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'BENC') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002Func002Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Guardian_Point[4], udg_Guardian_Point[5]) <= 800.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Guardian_Unit[5], GetOwningPlayer(udg_Guardian_Unit[4])) == true ) ) then
        return false
    endif
    if ( not ( udg_Guardian_Unit[5] != udg_Guardian_Unit[4] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002A takes nothing returns nothing
    set udg_Guardian_Unit[5]=GetEnumUnit()
    if ( Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002Func002C() ) then
        set udg_Guardian_Point[5]=GetUnitLoc(udg_Guardian_Unit[5])
        if ( Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002Func002Func002C() ) then
            set udg_Guardian_Real[4]=( 0.10 + ( 0.05 * I2R(GetUnitAbilityLevelSwapped('AENC', udg_Guardian_Unit[5])) ) )
            //                                                                                                                    
            call SetUnitManaBJ(udg_Guardian_Unit[5], ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Guardian_Unit[5]) + ( I2R(udg_Guardian_Integer[5]) * udg_Guardian_Real[4] ) ))
            //                                                                                                                    
            // Missile Properties:
            set udg_MissileSource=udg_Guardian_Unit[4]
            set udg_MissileStart=GetUnitLoc(udg_Guardian_Unit[4])
            set udg_MissileTarget=udg_Guardian_Unit[5]
            set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
            set udg_MissileModel="Abilities\\Spells\\Human\\ManaFlare\\ManaFlareTarget.mdl"
            set udg_MissileScale=1.50
            set udg_MissileCollision=25.00
            set udg_MissileStartZ=90.00
            set udg_MissileFinishZ=90.00
            set udg_MissileSpeed=1200.00
            set udg_MissileData=udg_Guardian_Integer[1]
            // Arc should be between 0.00 and 80.00:
            set udg_MissileArc=30.00
            // Launch Missile:
            call TriggerExecute(gg_trg_MissileCreate)
        else
        endif
        call RemoveLocation(udg_Guardian_Point[5])
    else
    endif
endfunction

function Trig_Guardian_Energy_Chamber_Ally_Cast_Func006C takes nothing returns boolean
    if ( not ( udg_Guardian_Integer[5] >= 50 ) ) then
        return false
    endif
    if ( not ( BlzGetUnitAbilityCooldown(udg_Guardian_Unit[4], udg_Guardian_EC_Ability, udg_Guardian_Integer[4]) >= 4.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Energy_Chamber_Ally_Cast_Actions takes nothing returns nothing
    set udg_Guardian_Unit[4]=GetTriggerUnit()
    set udg_Guardian_EC_Ability=GetSpellAbilityId()
    set udg_Guardian_Integer[4]=( GetUnitAbilityLevelSwapped(udg_Guardian_EC_Ability, udg_Guardian_Unit[4]) - 1 )
    set udg_Guardian_Integer[5]=BlzGetUnitAbilityManaCost(udg_Guardian_Unit[4], udg_Guardian_EC_Ability, udg_Guardian_Integer[4])
    //                                                                                                                    
    if ( Trig_Guardian_Energy_Chamber_Ally_Cast_Func006C() ) then
        set udg_Guardian_Point[4]=GetUnitLoc(udg_Guardian_Unit[4])
        call ForGroupBJ(udg_Guardian_EC_Group, function Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002A)
        call RemoveLocation(udg_Guardian_Point[4])
    else
    endif
endfunction

//===========================================================================
function InitTrig_Guardian_Energy_Chamber_Ally_Cast takes nothing returns nothing
