        return false
    endif
    return true
endfunction

function Trig_set_unit_scale_Func026A takes nothing returns nothing
    set udg_temp_unit=GetEnumUnit()
endfunction

function Trig_set_unit_scale_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_player=ConvertedPlayer(udg_temp_playernumber)
    set udg_temp_int=S2I(SubStringBJ(GetEventPlayerChatString(), 7, 10))
    set udg_temp_real=( I2R(udg_temp_int) / 100.00 )
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "temp int: " + I2S(udg_temp_int) ))
    call ForGroupBJ(GetUnitsSelectedAll(udg_temp_player), function Trig_set_unit_scale_Func026A)
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Selected unit: |r" + GetUnitName(udg_temp_unit) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Current scale factor: |r" + R2S(BlzGetUnitRealField(udg_temp_unit, UNIT_RF_SCALING_VALUE)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00NEW scale factor: |r" + R2S(udg_temp_real) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit attack type: |r" + I2S(BlzGetUnitWeaponIntegerField(GetTriggerUnit(), UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0)) ))
    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_SCALING_VALUE, udg_temp_real)
    call SetUnitScalePercent(udg_temp_unit, ( udg_temp_real * 100.00 ), ( udg_temp_real * 100.00 ), ( udg_temp_real * 100.00 ))
endfunction

