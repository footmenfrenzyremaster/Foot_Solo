function Trig_END_Actions takes nothing returns nothing
    if ( Trig_END_Func001C() ) then
        // TEAM 1 WINS
        if ( Trig_END_Func001Func007C() ) then
            set udg_X=1
            loop
                exitwhen udg_X > 3
                call SetPlayerStateBJ(ConvertedPlayer(udg_X), PLAYER_STATE_GAME_RESULT, 0)
                set udg_X=udg_X + 1
            endloop
            call DisplayTextToForce(udg_all_players, ( GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) + " has made the final strike, Team 1 wins!" ))
            call DisplayTextToForce(udg_all_players, "TRIGSTR_7565")
            call PlaySoundBJ(gg_snd_HumanX1)
            call MMD_FlagPlayer(Player(0) , MMD_FLAG_WINNER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(1) , MMD_FLAG_WINNER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(2) , MMD_FLAG_WINNER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(3) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(4) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(5) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(6) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(7) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(8) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(9) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(10) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(11) , MMD_FLAG_LOSER)
            call TriggerSleepAction(17.25)
            call s__File_close(s__File_write(s__File_open("wc3mt.txt"),"wc3mt-GameEnd"))
            call ForForce(udg_team[1], function Trig_END_Func001Func007Func039A)
            call ForForce(udg_team[2], function Trig_END_Func001Func007Func040A)
            call ForForce(udg_team[3], function Trig_END_Func001Func007Func041A)
            call ForForce(udg_team[4], function Trig_END_Func001Func007Func042A)
            call ForForce(udg_team[5], function Trig_END_Func001Func007Func043A)
        else
        endif
        // TEAM 2 WINS
        if ( Trig_END_Func001Func009C() ) then
            set udg_X=4
            loop
                exitwhen udg_X > 6
