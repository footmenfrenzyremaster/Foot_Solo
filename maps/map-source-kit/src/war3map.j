    if ( not ( udg_HCr_Distance[udg_HCr_CV] <= 125.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func013C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] < udg_HCr_Setup_Min_Distance ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func046C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Actions takes nothing returns nothing
    set udg_HCr_Caster=GetTriggerUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    set udg_HCr_Point[1]=GetSpellTargetLoc()
    set udg_HCr_Distance[udg_HCr_CV]=DistanceBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Level[udg_HCr_CV]=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_HCr_Caster)
    if ( Trig_Pounce_Cast_Func008C() ) then
        set udg_HCr_Setup_Damage[1]=75.00
    else
    endif
    if ( Trig_Pounce_Cast_Func009C() ) then
        set udg_HCr_Setup_Damage[1]=100.00
    else
    endif
    if ( Trig_Pounce_Cast_Func010C() ) then
        set udg_HCr_Setup_Damage[1]=175.00
    else
    endif
    //                                                                                                                    
    // Enforce a minimum distance:
    if ( Trig_Pounce_Cast_Func013C() ) then
        // This is a fix for if you target yourself with the ability:
        if ( Trig_Pounce_Cast_Func013Func002C() ) then
            call RemoveLocation(udg_HCr_Point[1])
            set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Setup_Min_Distance, GetUnitFacing(udg_HCr_Caster))
        else
        endif
        set udg_HCr_Distance[udg_HCr_CV]=udg_HCr_Setup_Min_Distance
    else
    endif
    //                                                                                                                    
    //                                                                                                                    
    // ==============================================================
    // DEFINE the duration and max height (if it's confusing just change the very first number in each):
    set udg_HCr_Duration[udg_HCr_CV]=( 0.30 + ( udg_HCr_Distance[udg_HCr_CV] / 1200.00 ) )
    set udg_HCr_Height[udg_HCr_CV]=( 250.00 + ( udg_HCr_Distance[udg_HCr_CV] / 8.00 ) )
    // ==============================================================
    //                                                                                                                    
    //                                                                                                                    
    // Calculate angle, speed and height adjustment math:
    set udg_HCr_Angle[udg_HCr_CV]=AngleBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Speed[0]=( udg_HCr_Distance[udg_HCr_CV] / udg_HCr_Duration[udg_HCr_CV] )
    set udg_HCr_Speed[udg_HCr_CV]=( udg_HCr_Speed[0] * 0.02 )
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.00
    set udg_HCr_Height_Rate[udg_HCr_CV]=( 2.00 * udg_HCr_Height[udg_HCr_CV] )
    set udg_HCr_Height_Factor[udg_HCr_CV]=( 1.00 / udg_HCr_Duration[udg_HCr_CV] )
    //                                                                                                                    
    // For some reason Collision no longer turns off/on (1.35/1.36 bug):
    call SetUnitPathing(udg_HCr_Caster, false)
    //                                                                                                                    
    // This allows a non-Flying unit to have it's Flying Height adjusted:
    call UnitAddAbilityBJ('Arav', udg_HCr_Caster)
    call UnitRemoveAbilityBJ('Arav', udg_HCr_Caster)
    //                                                                                                                    
    call GroupAddUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
    set udg_HCr_Caster_Count=( udg_HCr_Caster_Count + 1 )
    call SetUnitInvulnerable(udg_HCr_Caster, true)
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Turn on the Loop trigger which moves the caster:
    if ( Trig_Pounce_Cast_Func046C() ) then
        call EnableTrigger(gg_trg_Pounce_Loop)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Pounce_Cast takes nothing returns nothing
    set gg_trg_Pounce_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Pounce_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Pounce_Cast, Condition(function Trig_Pounce_Cast_Conditions))
    call TriggerAddAction(gg_trg_Pounce_Cast, function Trig_Pounce_Cast_Actions)
