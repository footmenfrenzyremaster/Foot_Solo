        return false
    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Effect_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Shattering_Strike_Effect_Func001Func001C() ) then
            set udg_Wrath_Effect[udg_X]=false
            call AddSpecialEffectLocBJ(udg_wrath_point[udg_X], "war3mapImported\\FrostBoltRainV.mdx")
            call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.50)
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

//===========================================================================
function InitTrig_HERO_Shattering_Strike_Effect takes nothing returns nothing
    set gg_trg_HERO_Shattering_Strike_Effect=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[1])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[2])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Effect, udg_timer_wrath_effect[3])
