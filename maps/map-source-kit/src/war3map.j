        call QueueUnitAnimationBJ(udg_HCr_Caster, "stand")
        call AddSpecialEffectTargetUnitBJ("weapon", udg_HCr_Caster, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    //                                                                                                                    
    // Time_Elapsed should increase by the Periodic Interval amount (0.02 by default):
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=( udg_HCr_Elapsed_Time[udg_HCr_CV] + 0.02 )
    //                                                                                                                    
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    //                                                                                                                    
    // Get the destination:
    set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Speed[udg_HCr_CV], udg_HCr_Angle[udg_HCr_CV])
    //                                                                                                                    
    call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[1])
    call SetUnitX(udg_HCr_Caster, GetLocationX(udg_HCr_Point[1]))
    call SetUnitY(udg_HCr_Caster, GetLocationY(udg_HCr_Point[1]))
    //                                                                                                                    
