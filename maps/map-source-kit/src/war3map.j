//===========================================================================
// Trigger: HERO Queen Spiderling Swarm
//
// CHECK #2 - OK - remove unit!
//===========================================================================
function Trig_HERO_Queen_Spiderling_Swarm_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Queen_Spiderling_Swarm_Func006002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true )
endfunction

function Trig_HERO_Queen_Spiderling_Swarm_Func016Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Queen_Spiderling_Swarm_Func016A takes nothing returns nothing
    if ( Trig_HERO_Queen_Spiderling_Swarm_Func016Func001C() ) then
        call IssueTargetOrderBJ(udg_dummy, "web", GetEnumUnit())
    else
    endif
endfunction

function Trig_HERO_Queen_Spiderling_Swarm_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE=( 200.00 + ( 25.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) )
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_Queen_Spiderling_Swarm_Func006002003))
    call PlaySoundOnUnitBJ(gg_snd_PossessionMissileLaunch1, 100, udg_temp_unit)
    call CreateNUnitsAtLoc(1, 'dmmy', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.50, 'BTLF', udg_dummy)
    call UnitAddAbilityBJ('A0MQ', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0MQ', udg_dummy, udg_abilitylevel)
    call IssueImmediateOrderBJ(udg_dummy, "summonquillbeast")
    call UnitAddAbilityBJ('A0NI', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0NI', udg_dummy, udg_abilitylevel)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Queen_Spiderling_Swarm_Func016A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

//===========================================================================
function InitTrig_HERO_Queen_Spiderling_Swarm takes nothing returns nothing
    set gg_trg_HERO_Queen_Spiderling_Swarm=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Queen_Spiderling_Swarm, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Queen_Spiderling_Swarm, Condition(function Trig_HERO_Queen_Spiderling_Swarm_Conditions))
    call TriggerAddAction(gg_trg_HERO_Queen_Spiderling_Swarm, function Trig_HERO_Queen_Spiderling_Swarm_Actions)
endfunction

