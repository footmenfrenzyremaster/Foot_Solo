        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Golovu_Shot_Start_Cast_Actions takes nothing returns nothing
    set udg_SovietSniper=GetTriggerUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    // Define damage scaling per level (once):
    if ( Trig_SovietSniper_Golovu_Shot_Start_Cast_Func005C() ) then
        set udg_SovietSniper_GS_Damage_Per_Lvl[1]=450.00
        set udg_SovietSniper_GS_Damage_Per_Lvl[2]=600.00
        set udg_SovietSniper_GS_Damage_Per_Lvl[3]=900.00
    else
    endif
    //                                                                                                          
    set udg_SovietSniper_GS_Duration[udg_SovietSniper_CV]=0
    set udg_SovietSniper_GS_Is_Casting[udg_SovietSniper_CV]=false
    set udg_SovietSniper_GS_Point[udg_SovietSniper_CV]=GetSpellTargetLoc()
    //                                                                                                          
    call GroupAddUnitSimple(udg_SovietSniper, udg_SovietSniper_GS_Caster_Group)
    call EnableTrigger(gg_trg_SovietSniper_Golovu_Shot_Loop)
    //                                                                                                          
    call BlzPauseUnitEx(udg_SovietSniper, true)
endfunction

