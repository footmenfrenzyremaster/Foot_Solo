    return true
endfunction

function Trig_HERO_Archangel_Smite_Func017Func002A takes nothing returns nothing
    if ( Trig_HERO_Archangel_Smite_Func017Func002Func001C() ) then
        call GroupAddUnitSimple(GetEnumUnit(), udg_smite_heal_unitgroup[udg_temp_playernumber])
    else
        call DoNothing()
    endif
endfunction

function Trig_HERO_Archangel_Smite_Func018A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0EF', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0EF', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "heal", GetEnumUnit())
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_smite_heal_unitgroup[udg_temp_playernumber])
endfunction

function Trig_HERO_Archangel_Smite_Actions takes nothing returns nothing
    // SET BASE VARIABLE
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_degree=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    set udg_temp_AoE_array[1]=135.00
    set udg_temp_AoE_array[2]=145.00
    set udg_temp_AoE_array[3]=160.00
    set udg_temp_AoE_array[4]=175.00
    set udg_temp_AoE_array[5]=180.00
    set udg_temp_AoE_array[6]=180.00
    set udg_temp_real=125.00
    // start action
    set udg_X_array[udg_temp_playernumber]=1
    loop
        exitwhen udg_X_array[udg_temp_playernumber] > 7
        set udg_temp_point=PolarProjectionBJ(udg_temp_point_caster, ( udg_temp_real * I2R(udg_X_array[udg_temp_playernumber]) ), udg_temp_degree)
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(udg_temp_AoE_array[udg_abilitylevel], udg_temp_point, Condition(function Trig_HERO_Archangel_Smite_Func017Func002001003)), function Trig_HERO_Archangel_Smite_Func017Func002A)
        set udg_X_array[udg_temp_playernumber]=udg_X_array[udg_temp_playernumber] + 1
    endloop
    call ForGroupBJ(udg_smite_heal_unitgroup[udg_temp_playernumber], function Trig_HERO_Archangel_Smite_Func018A)
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_HERO_Archangel_Smite takes nothing returns nothing
    set gg_trg_HERO_Archangel_Smite=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Archangel_Smite, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Archangel_Smite, Condition(function Trig_HERO_Archangel_Smite_Conditions))
    call TriggerAddAction(gg_trg_HERO_Archangel_Smite, function Trig_HERO_Archangel_Smite_Actions)
endfunction

