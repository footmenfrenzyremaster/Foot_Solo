function Trig_Turn_on_Triggers_when_items_sold_Actions takes nothing returns nothing
    if ( Trig_Turn_on_Triggers_when_items_sold_Func001C() ) then
        call EnableTrigger(gg_trg_ITEM_Scroll_of_Invisibility)
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func002C() ) then
        call EnableTrigger(gg_trg_ITEM_Scroll_of_AntiMagic)
