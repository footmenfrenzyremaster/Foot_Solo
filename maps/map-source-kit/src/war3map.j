    if ( not ( udg_version_test == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_debug_show_ability_name_Actions takes nothing returns nothing
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    call DisplayTextToForce(udg_temp_playergroup, ( ( "Triggering Unit: " + GetUnitName(GetTriggerUnit()) ) + ( " | Ability: " + GetAbilityName(GetSpellAbilityId()) ) ))
    call DisplayTextToForce(udg_temp_playergroup, ( "Ability Level:" + I2S(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetSpellAbilityUnit())) ))
    call DisplayTextToForce(udg_temp_playergroup, OrderId2StringBJ(GetUnitCurrentOrder(GetTriggerUnit())))
    call DestroyForce(udg_temp_playergroup)
    if ( Trig_debug_show_ability_name_Func006C() ) then
        call BlzStartUnitAbilityCooldown(GetTriggerUnit(), GetSpellAbilityId(), 1.00)
    else
        call DoNothing()
    endif
endfunction

