//===========================================================================
function Trig_Avalanche_Seismic_Fury_Learn_Conditions takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'ASEF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Learn_Func001C takes nothing returns boolean
    if ( not ( udg_Avalanche_SF_Learned[GetUnitUserData(GetTriggerUnit())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Learn_Actions takes nothing returns nothing
    if ( Trig_Avalanche_Seismic_Fury_Learn_Func001C() ) then
        set udg_Avalanche_SF_Learned[GetUnitUserData(GetTriggerUnit())]=true
        call BlzUnitDisableAbility(GetTriggerUnit(), 'ASEF', true, false)
        //                                                                                                          
        // Define how many stacks are needed to enable the ability:
        set udg_Avalanche_SF_Stacks_Needed=0
        //                                                                                                          
        // Define how much damage Seismic Fury deals per level:
        set udg_Avalanche_SF_Damage[1]=350.00
        set udg_Avalanche_SF_Damage[2]=550.00
        set udg_Avalanche_SF_Damage[3]=750.00
    else
    endif
endfunction

//===========================================================================
function InitTrig_Avalanche_Seismic_Fury_Learn takes nothing returns nothing
    set gg_trg_Avalanche_Seismic_Fury_Learn=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Learn)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Avalanche_Seismic_Fury_Learn, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_Avalanche_Seismic_Fury_Learn, Condition(function Trig_Avalanche_Seismic_Fury_Learn_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Seismic_Fury_Learn, function Trig_Avalanche_Seismic_Fury_Learn_Actions)
endfunction

//===========================================================================
// Trigger: Avalanche Seismic Fury Enable
//===========================================================================
function Trig_Avalanche_Seismic_Fury_Enable_Actions takes nothing returns nothing
    // Enable the ability (it should be disabled by default):
    call BlzUnitDisableAbility(udg_Avalanche, 'ASEF', false, false)
    //                                                                                                          
    // Visual indicator of ability being ready:
    call UnitAddAbilityBJ('ASEA', udg_Avalanche)
    //                                                                                                          
    // Cool special effect for eye candy:
    call AddSpecialEffectTargetUnitBJ("origin", udg_Avalanche, "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_Avalanche_Seismic_Fury_Enable takes nothing returns nothing
    set gg_trg_Avalanche_Seismic_Fury_Enable=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Seismic_Fury_Enable)
    call TriggerAddAction(gg_trg_Avalanche_Seismic_Fury_Enable, function Trig_Avalanche_Seismic_Fury_Enable_Actions)
endfunction

