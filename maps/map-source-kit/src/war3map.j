//===========================================================================
// Trigger: Akama Shadow Clone Destroy Clone
//===========================================================================
function Trig_Akama_Shadow_Clone_Destroy_Clone_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Akama_SC_Clone[udg_Akama_CV]) != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Destroy_Clone_Func013C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Akama_SC_Hero_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Shadow_Clone_Destroy_Clone_Actions takes nothing returns nothing
    // Make sure Akama and Akama_CV have been set before running this trigger!
    //                                                                                                          
    set udg_Akama_Point[0]=GetUnitLoc(udg_Akama_SC_Clone[udg_Akama_CV])
    //                                                                                                          
    call AddSpecialEffectLocBJ(udg_Akama_Point[0], "warpimpact.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.00)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                          
    call RemoveLocation(udg_Akama_Point[0])
    //                                                                                                          
    call GroupRemoveUnitSimple(udg_Akama, udg_Akama_SC_Hero_Group)
    if ( Trig_Akama_Shadow_Clone_Destroy_Clone_Func013C() ) then
        call DisableTrigger(gg_trg_Akama_Shadow_Clone_Loop)
    else
    endif
    //                                                                                                          
    call RemoveUnit(udg_Akama_SC_Clone[udg_Akama_CV])
endfunction

//===========================================================================
function InitTrig_Akama_Shadow_Clone_Destroy_Clone takes nothing returns nothing
    set gg_trg_Akama_Shadow_Clone_Destroy_Clone=CreateTrigger()
    call TriggerAddCondition(gg_trg_Akama_Shadow_Clone_Destroy_Clone, Condition(function Trig_Akama_Shadow_Clone_Destroy_Clone_Conditions))
    call TriggerAddAction(gg_trg_Akama_Shadow_Clone_Destroy_Clone, function Trig_Akama_Shadow_Clone_Destroy_Clone_Actions)
endfunction

//===========================================================================
// Trigger: Akama Learn Blink
//===========================================================================
function Trig_Akama_Learn_Blink_Conditions takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'ASHS' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E00Z' ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('ABLI', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Learn_Blink_Actions takes nothing returns nothing
    set udg_Akama=GetTriggerUnit()
    call UnitAddAbilityBJ('ABLI', udg_Akama)
    call BlzUnitDisableAbility(udg_Akama, 'ABLI', true, false)
    call EnableTrigger(gg_trg_Akama_Blink_Start)
    call EnableTrigger(gg_trg_Akama_Blink_Return)
endfunction

//===========================================================================
function InitTrig_Akama_Learn_Blink takes nothing returns nothing
    set gg_trg_Akama_Learn_Blink=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Learn_Blink, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_Akama_Learn_Blink, Condition(function Trig_Akama_Learn_Blink_Conditions))
    call TriggerAddAction(gg_trg_Akama_Learn_Blink, function Trig_Akama_Learn_Blink_Actions)
endfunction

//===========================================================================
// Trigger: Akama Blink Start
//===========================================================================
function Trig_Akama_Blink_Start_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E00Z' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'ASHS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Blink_Start_Func020C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Blink_Start_Actions takes nothing returns nothing
    set udg_Akama=GetTriggerUnit()
    set udg_Akama_CV=GetUnitUserData(udg_Akama)
    //                                                                                                          
    set udg_Akama_Blink_Point[udg_Akama_CV]=GetUnitLoc(udg_Akama)
    //                                                                                                          
    call AddSpecialEffectLocBJ(udg_Akama_Blink_Point[udg_Akama_CV], "Abilities\\Spells\\Undead\\Possession\\PossessionTarget.mdl")
    set udg_Akama_Blink_Sfx[udg_Akama_CV]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.25)
    //                                                                                                          
    // Enable it:
    call BlzUnitDisableAbility(udg_Akama, 'ABLI', false, false)
    //                                                                                                          
    call PolledWait(5.00)
    //                                                                                                          
    set udg_Akama_CV=GetUnitUserData(GetTriggerUnit())
    //                                                                                                          
    if udg_Akama_Blink_Sfx[udg_Akama_CV] != null then
    //                                                                                                          
    if ( Trig_Akama_Blink_Start_Func020C() ) then
        // Disable it:
        call BlzUnitDisableAbility(GetTriggerUnit(), 'ABLI', true, false)
    else
    endif
    //                                                                                                          
    call DestroyEffectBJ(udg_Akama_Blink_Sfx[udg_Akama_CV])
    set udg_Akama_Blink_Sfx[udg_Akama_CV]=null
    endif
endfunction

//===========================================================================
function InitTrig_Akama_Blink_Start takes nothing returns nothing
    set gg_trg_Akama_Blink_Start=CreateTrigger()
    call DisableTrigger(gg_trg_Akama_Blink_Start)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Blink_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Akama_Blink_Start, Condition(function Trig_Akama_Blink_Start_Conditions))
    call TriggerAddAction(gg_trg_Akama_Blink_Start, function Trig_Akama_Blink_Start_Actions)
endfunction

//===========================================================================
// Trigger: Akama Blink Return
//===========================================================================
function Trig_Akama_Blink_Return_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ABLI' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Blink_Return_Actions takes nothing returns nothing
    set udg_Akama=GetTriggerUnit()
    set udg_Akama_CV=GetUnitUserData(udg_Akama)
    //                                                                                                          
    set udg_Akama_Blink_Point[0]=GetUnitLoc(udg_Akama)
    call AddSpecialEffectLocBJ(udg_Akama_Blink_Point[0], "WarpStrikeUp.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_Akama_Blink_Point[0])
    //                                                                                                          
    call SetUnitPositionLoc(udg_Akama, udg_Akama_Blink_Point[udg_Akama_CV])
    call IssueImmediateOrderBJ(udg_Akama, "stop")
    call AddSpecialEffectLocBJ(udg_Akama_Blink_Point[udg_Akama_CV], "WarpStrike.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_Akama_Blink_Point[udg_Akama_CV])
    //                                                                                                          
    // Disable it:
    call DestroyEffectBJ(udg_Akama_Blink_Sfx[udg_Akama_CV])
    set udg_Akama_Blink_Sfx[udg_Akama_CV]=null
    call BlzUnitDisableAbility(udg_Akama, 'ABLI', true, false)
endfunction

//===========================================================================
function InitTrig_Akama_Blink_Return takes nothing returns nothing
    set gg_trg_Akama_Blink_Return=CreateTrigger()
    call DisableTrigger(gg_trg_Akama_Blink_Return)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Blink_Return, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Akama_Blink_Return, Condition(function Trig_Akama_Blink_Return_Conditions))
    call TriggerAddAction(gg_trg_Akama_Blink_Return, function Trig_Akama_Blink_Return_Actions)
endfunction

//===========================================================================
// Trigger: Avalanche Toss Setup
//===========================================================================
function Trig_Avalanche_Toss_Setup_Actions takes nothing returns nothing
    // Define the interval for Toss (shorter = more precise and smoother animation but less efficient):
    set udg_Avalanche_TS_Interval=0.02
    call TriggerRegisterTimerEventPeriodic(gg_trg_Avalanche_Toss_Loop, udg_Avalanche_TS_Interval)
    //                                                                                                                    
    // Define the amount of damage Toss deals to nearby enemy units [Put the level in the brackets]:
    set udg_Avalanche_TS_Damage[1]=90.00
    set udg_Avalanche_TS_Damage[2]=140.00
    set udg_Avalanche_TS_Damage[3]=200.00
    set udg_Avalanche_TS_Damage[4]=250.00
    set udg_Avalanche_TS_Damage[5]=330.00
    set udg_Avalanche_TS_Damage[6]=500.00
endfunction

//===========================================================================
function InitTrig_Avalanche_Toss_Setup takes nothing returns nothing
    set gg_trg_Avalanche_Toss_Setup=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_Avalanche_Toss_Setup, 0.00)
    call TriggerAddAction(gg_trg_Avalanche_Toss_Setup, function Trig_Avalanche_Toss_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Avalanche Toss Begin Cast
//===========================================================================
function Trig_Avalanche_Toss_Begin_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ATSS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Func006Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Avalanche_TS_Picked_Unit) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_Avalanche_TS_Picked_Unit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Avalanche_TS_Picked_Unit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_ANCIENT) == false ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0IL', udg_Avalanche_TS_Picked_Unit) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('ATCL', udg_Avalanche_TS_Picked_Unit) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Func006A takes nothing returns nothing
    set udg_Avalanche_TS_Picked_Unit=GetEnumUnit()
    if ( Trig_Avalanche_Toss_Begin_Cast_Func006Func002C() ) then
    else
        call GroupRemoveUnitSimple(udg_Avalanche_TS_Picked_Unit, udg_Avalanche_TS_Nearby_Group)
    endif
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Avalanche_TS_Nearby_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Actions takes nothing returns nothing
    set udg_Avalanche_TS_Source[0]=GetTriggerUnit()
    set udg_Avalanche_TS_Point[0]=GetUnitLoc(udg_Avalanche_TS_Source[0])
    //                                                                                                                    
    // Filter out unwanted units:
    set udg_Avalanche_TS_Nearby_Group=GetUnitsInRangeOfLocAll(350.00, udg_Avalanche_TS_Point[0])
    call ForGroupBJ(udg_Avalanche_TS_Nearby_Group, function Trig_Avalanche_Toss_Begin_Cast_Func006A)
    //                                                                                                                    
    call RemoveLocation(udg_Avalanche_TS_Point[0])
    //                                                                                                                    
    // If no unit was found then abort:
    if ( Trig_Avalanche_Toss_Begin_Cast_Func011C() ) then
        call IssueImmediateOrderBJ(GetTriggerUnit(), "stop")
    else
    endif
    //                                                                                                                    
    call DestroyGroup(udg_Avalanche_TS_Nearby_Group)
endfunction

//===========================================================================
function InitTrig_Avalanche_Toss_Begin_Cast takes nothing returns nothing
    set gg_trg_Avalanche_Toss_Begin_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Avalanche_Toss_Begin_Cast, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Avalanche_Toss_Begin_Cast, Condition(function Trig_Avalanche_Toss_Begin_Cast_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Toss_Begin_Cast, function Trig_Avalanche_Toss_Begin_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Avalanche Toss Start Cast
//===========================================================================
function Trig_Avalanche_Toss_Start_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ATSS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func010Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Avalanche_TS_Picked_Unit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Avalanche_TS_Picked_Unit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_ANCIENT) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0IL', udg_Avalanche_TS_Picked_Unit) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('ATCL', udg_Avalanche_TS_Picked_Unit) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func010A takes nothing returns nothing
    set udg_Avalanche_TS_Picked_Unit=GetEnumUnit()
    if ( Trig_Avalanche_Toss_Start_Cast_Func010Func002C() ) then
    else
        call GroupRemoveUnitSimple(udg_Avalanche_TS_Picked_Unit, udg_Avalanche_TS_Nearby_Group)
    endif
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func015Func006C takes nothing returns boolean
    if ( not ( udg_Avalanche_TS_Distance_Check[1] < udg_Avalanche_TS_Distance_Check[0] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func015A takes nothing returns nothing
    set udg_Avalanche_TS_Picked_Unit=GetEnumUnit()
    set udg_Avalanche_TS_Point[1]=GetUnitLoc(udg_Avalanche_TS_Picked_Unit)
    set udg_Avalanche_TS_Distance_Check[1]=DistanceBetweenPoints(udg_Avalanche_TS_Point[0], udg_Avalanche_TS_Point[1])
    call RemoveLocation(udg_Avalanche_TS_Point[1])
    //                                                                                                                    
    if ( Trig_Avalanche_Toss_Start_Cast_Func015Func006C() ) then
        set udg_Avalanche_TS_Distance_Check[0]=udg_Avalanche_TS_Distance_Check[1]
        set udg_Avalanche_TS_Closest_Unit=udg_Avalanche_TS_Picked_Unit
    else
    endif
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func021C takes nothing returns boolean
    if ( not ( udg_Avalanche_TS_Closest_Unit == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func046Func006C takes nothing returns boolean
    if ( not ( udg_Avalanche_TS_Target_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Start_Cast_Func046C takes nothing returns boolean
    if ( not ( IsUnitInGroup(udg_Avalanche_TS_Closest_Unit, udg_Avalanche_TS_Target_Group) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Start_Cast_Actions takes nothing returns nothing
    set udg_Avalanche_TS_Source[0]=GetTriggerUnit()
    set udg_Avalanche_TS_Point[0]=GetUnitLoc(udg_Avalanche_TS_Source[0])
    //                                                                                                                    
    // Display the total number of Seismic Fury stacks:
    set udg_Avalanche=GetTriggerUnit()
    call ConditionalTriggerExecute(gg_trg_Avalanche_Seismic_Fury_Floating_Text)
    //                                                                                                                    
    // Filter out unwanted units:
    set udg_Avalanche_TS_Nearby_Group=GetUnitsInRangeOfLocAll(350.00, udg_Avalanche_TS_Point[0])
    call ForGroupBJ(udg_Avalanche_TS_Nearby_Group, function Trig_Avalanche_Toss_Start_Cast_Func010A)
    //                                                                                                                    
    // Get the closest unit:
    set udg_Avalanche_TS_Distance_Check[0]=999999.00
    set udg_Avalanche_TS_Closest_Unit=null
    call ForGroupBJ(udg_Avalanche_TS_Nearby_Group, function Trig_Avalanche_Toss_Start_Cast_Func015A)
    //                                                                                                                    
    call RemoveLocation(udg_Avalanche_TS_Point[0])
    call DestroyGroup(udg_Avalanche_TS_Nearby_Group)
    //                                                                                                                    
    // If no unit was found then abort:
    if ( Trig_Avalanche_Toss_Start_Cast_Func021C() ) then
        return
    else
    endif
    //                                                                                                                    
    // Attach data to the unit being tossed:
    set udg_Avalanche_TS_CV=GetUnitUserData(udg_Avalanche_TS_Closest_Unit)
    //                                                                                                                    
    // ===============================
    // DEFINE THE HEIGHT AND DURATION (note that Height isn't precise so set it higher than intended):
    set udg_Avalanche_TS_Height[udg_Avalanche_TS_CV]=375.00
    set udg_Avalanche_TS_Duration[udg_Avalanche_TS_CV]=0.65
    // ===============================
    //                                                                                                                    
    set udg_Avalanche_TS_Source[udg_Avalanche_TS_CV]=udg_Avalanche_TS_Source[0]
    set udg_Avalanche_TS_Target[udg_Avalanche_TS_CV]=GetSpellTargetUnit()
    set udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV]=0.00
    set udg_Avalanche_TS_Height_Rate[udg_Avalanche_TS_CV]=( 2.00 * udg_Avalanche_TS_Height[udg_Avalanche_TS_CV] )
    set udg_Avalanche_TS_Height_Factor[udg_Avalanche_TS_CV]=( 1.00 / udg_Avalanche_TS_Duration[udg_Avalanche_TS_CV] )
    //                                                                                                                    
    // For some reason Collision no longer turns off/on (1.35/1.36 bug):
    // Turn Collision Off (placeholder)
    //                                                                                                                    
    // The Storm Crow Form ability allows a non-Flying unit to have it's Flying Height adjusted:
    call UnitAddAbilityBJ('Arav', udg_Avalanche_TS_Closest_Unit)
    call UnitRemoveAbilityBJ('Arav', udg_Avalanche_TS_Closest_Unit)
    //                                                                                                                    
    // Turn on the Loop trigger which moves the Tossed units:
    if ( Trig_Avalanche_Toss_Start_Cast_Func046C() ) then
        // This is a triggered Stun (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_Avalanche_TS_Closest_Unit, true)
        //                                                                                                                    
        call GroupAddUnitSimple(udg_Avalanche_TS_Closest_Unit, udg_Avalanche_TS_Target_Group)
        set udg_Avalanche_TS_Target_Count=( udg_Avalanche_TS_Target_Count + 1 )
        if ( Trig_Avalanche_Toss_Start_Cast_Func046Func006C() ) then
            call EnableTrigger(gg_trg_Avalanche_Toss_Loop)
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Avalanche_Toss_Start_Cast takes nothing returns nothing
    set gg_trg_Avalanche_Toss_Start_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Avalanche_Toss_Start_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Avalanche_Toss_Start_Cast, Condition(function Trig_Avalanche_Toss_Start_Cast_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Toss_Start_Cast, function Trig_Avalanche_Toss_Start_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Avalanche Toss Loop
//===========================================================================
function Trig_Avalanche_Toss_Loop_Func002Func009C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Avalanche_TS_Target[udg_Avalanche_TS_CV]) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func016C takes nothing returns boolean
    if ( not ( udg_Avalanche_TS_Remaining_Time >= 0.02 ) ) then
        return false
    endif
    if ( not ( udg_Avalanche_TS_Distance_Check[0] >= 25.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func001C takes nothing returns boolean
    if ( ( udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV] >= udg_Avalanche_TS_Duration[udg_Avalanche_TS_CV] ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_Avalanche_TS_Closest_Unit) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func005C takes nothing returns boolean
    if ( not ( udg_Avalanche_TS_Target_Count == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022Func002Func008Func004C takes nothing returns boolean
    if ( not ( udg_Avalanche_SF_Stacks[udg_Avalanche_CV] == udg_Avalanche_SF_Stacks_Needed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022Func002Func008C takes nothing returns boolean
    if ( not ( udg_Avalanche_SF_Learned[udg_Avalanche_CV] == true ) ) then
        return false
    endif
    if ( not ( udg_Avalanche_SF_Stacks[udg_Avalanche_CV] < udg_Avalanche_SF_Stacks_Needed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Avalanche_TS_Target[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_Avalanche_TS_Target[0], GetOwningPlayer(udg_Avalanche_TS_Source[0])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Target[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_Avalanche_TS_Target[0]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Target[0], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Avalanche_TS_Target[0]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022A takes nothing returns nothing
    set udg_Avalanche_TS_Target[0]=GetEnumUnit()
    if ( Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022Func002C() ) then
        call UnitDamageTargetBJ(udg_Avalanche_TS_Source[udg_Avalanche_TS_CV], udg_Avalanche_TS_Target[0], udg_Avalanche_TS_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_Avalanche_TS_Source[0], "cripple", udg_Avalanche_TS_Target[0])
        call SetUnitInvulnerable(udg_Avalanche_TS_Picked_Unit, false)
        //                                                                                                          
        // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
        // SEISMIC FURY (ULTIMATE):
        set udg_Avalanche_CV=GetUnitUserData(udg_Avalanche_TS_Source[udg_Avalanche_TS_CV])
        if ( Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022Func002Func008C() ) then
            set udg_Avalanche_SF_Stacks[udg_Avalanche_CV]=( udg_Avalanche_SF_Stacks[udg_Avalanche_CV] + 1 )
            call SetUnitVertexColorBJ(udg_Avalanche_TS_Source[udg_Avalanche_TS_CV], 100, ( 100.00 - ( I2R(udg_Avalanche_SF_Stacks[udg_Avalanche_CV]) * 0.50 ) ), ( 100.00 - ( I2R(udg_Avalanche_SF_Stacks[udg_Avalanche_CV]) * 0.50 ) ), 0)
            //                                                                                                          
            if ( Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022Func002Func008Func004C() ) then
                set udg_Avalanche=udg_Avalanche_TS_Source[udg_Avalanche_TS_CV]
                call TriggerExecute(gg_trg_Avalanche_Seismic_Fury_Enable)
            else
            endif
        else
        endif
        // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    else
    endif
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Avalanche_TS_Picked_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002Func026C takes nothing returns boolean
    if ( not Trig_Avalanche_Toss_Loop_Func002Func026Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Loop_Func002A takes nothing returns nothing
    set udg_Avalanche_TS_Picked_Unit=GetEnumUnit()
    set udg_Avalanche_TS_CV=GetUnitUserData(udg_Avalanche_TS_Picked_Unit)
    //                                                                                                                    
    // Time_Elapsed should increase by the Periodic Interval amount (0.02 by default):
    set udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV]=( udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV] + udg_Avalanche_TS_Interval )
    //                                                                                                                    
    // Get the position of the tossed unit and it's target (If target is gone then move in place):
    set udg_Avalanche_TS_Point[0]=GetUnitLoc(udg_Avalanche_TS_Picked_Unit)
    if ( Trig_Avalanche_Toss_Loop_Func002Func009C() ) then
        set udg_Avalanche_TS_Point[1]=GetUnitLoc(udg_Avalanche_TS_Picked_Unit)
    else
        set udg_Avalanche_TS_Point[1]=GetUnitLoc(udg_Avalanche_TS_Target[udg_Avalanche_TS_CV])
    endif
    //                                                                                                                    
    // Calculate remaining time and distance:
    set udg_Avalanche_TS_Remaining_Time=( udg_Avalanche_TS_Duration[udg_Avalanche_TS_CV] - udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV] )
    set udg_Avalanche_TS_Distance_Check[0]=DistanceBetweenPoints(udg_Avalanche_TS_Point[0], udg_Avalanche_TS_Point[1])
    //                                                                                                                    
    // Only move the tossed unit if the calculations are safe:
    if ( Trig_Avalanche_Toss_Loop_Func002Func016C() ) then
        // Calculate the offset that the unit should be moved:
        call SetUnitInvulnerable(udg_Avalanche_TS_Picked_Unit, true)
        set udg_Avalanche_TS_Speed=( ( udg_Avalanche_TS_Distance_Check[0] / udg_Avalanche_TS_Remaining_Time ) * udg_Avalanche_TS_Interval )
        //                                                                                                                    
        // Get the destination:
        set udg_Avalanche_TS_Point[2]=PolarProjectionBJ(udg_Avalanche_TS_Point[0], udg_Avalanche_TS_Speed, AngleBetweenPoints(udg_Avalanche_TS_Point[0], udg_Avalanche_TS_Point[1]))
        //                                                                                                                    
        call SetUnitPositionLoc(udg_Avalanche_TS_Picked_Unit, udg_Avalanche_TS_Point[2])
        call SetUnitX(udg_Avalanche_TS_Picked_Unit, GetLocationX(udg_Avalanche_TS_Point[2]))
        call SetUnitY(udg_Avalanche_TS_Picked_Unit, GetLocationY(udg_Avalanche_TS_Point[2]))
        //                                                                                                                    
        call RemoveLocation(udg_Avalanche_TS_Point[2])
    else
    endif
    //                                                                                                                    
    call RemoveLocation(udg_Avalanche_TS_Point[0])
    call RemoveLocation(udg_Avalanche_TS_Point[1])
    //                                                                                                                    
    // Adjust flying height of the unit:
    set udg_Avalanche_TS_Height[0]=( ( udg_Avalanche_TS_Height_Rate[udg_Avalanche_TS_CV] * udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV] ) - ( udg_Avalanche_TS_Height_Factor[udg_Avalanche_TS_CV] * ( udg_Avalanche_TS_Height_Rate[udg_Avalanche_TS_CV] * ( udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV] * udg_Avalanche_TS_Current_Time[udg_Avalanche_TS_CV] ) ) ) )
    call SetUnitFlyHeightBJ(udg_Avalanche_TS_Picked_Unit, ( GetUnitDefaultFlyHeight(udg_Avalanche_TS_Picked_Unit) + udg_Avalanche_TS_Height[0] ), 0.00)
    //                                                                                                                    
    // Check if the duration is finished or if the tossed unit died:
    if ( Trig_Avalanche_Toss_Loop_Func002Func026C() ) then
        call GroupRemoveUnitSimple(udg_Avalanche_TS_Picked_Unit, udg_Avalanche_TS_Target_Group)
        call SetUnitInvulnerable(udg_Avalanche_TS_Picked_Unit, false)
        set udg_Avalanche_TS_Target_Count=( udg_Avalanche_TS_Target_Count - 1 )
        if ( Trig_Avalanche_Toss_Loop_Func002Func026Func005C() ) then
            call DisableTrigger(gg_trg_Avalanche_Toss_Loop)
        else
        endif
        //                                                                                                                    
        // For some reason Collision no longer turns off/on (1.35/1.36 bug):
        // Turn Collision On (placeholder)
        //                                                                                                                    
        // This removes a triggered Stun from the unit (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_Avalanche_TS_Picked_Unit, false)
        //                                                                                                                    
        call SetUnitFlyHeightBJ(udg_Avalanche_TS_Picked_Unit, GetUnitDefaultFlyHeight(udg_Avalanche_TS_Picked_Unit), 0.00)
        //                                                                                                                    
        // Damage and slow if the tossed unit is still alive:
        if ( Trig_Avalanche_Toss_Loop_Func002Func026Func016C() ) then
            set udg_Avalanche_TS_Point[0]=GetUnitLoc(udg_Avalanche_TS_Picked_Unit)
            call SetUnitPositionLoc(udg_Avalanche_TS_Picked_Unit, udg_Avalanche_TS_Point[0])
            //                                                                                                                    
            // Create the Dummy that slows nearby enemy units:
            call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Avalanche_TS_Source[udg_Avalanche_TS_CV]), udg_Avalanche_TS_Point[0], bj_UNIT_FACING)
            set udg_Avalanche_TS_Source[0]=GetLastCreatedUnit()
            call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_Avalanche_TS_Source[0])
            call UnitAddAbilityBJ('ATOS', udg_Avalanche_TS_Source[0])
            call SetUnitAbilityLevelSwapped('ATOS', udg_Avalanche_TS_Source[0], GetUnitAbilityLevelSwapped('ATSS', udg_Avalanche_TS_Source[udg_Avalanche_TS_CV]))
            //                                                                                                                    
            // Get the damage dealt based on ability level:
            set udg_Avalanche_TS_Damage[0]=udg_Avalanche_TS_Damage[GetUnitAbilityLevelSwapped('ATSS', udg_Avalanche_TS_Source[udg_Avalanche_TS_CV])]
            //                                                                                                                    
            // Create some special effects to make it look cool:
            call AddSpecialEffectLocBJ(udg_Avalanche_TS_Point[0], "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            set udg_Avalanche_TS_Nearby_Group=GetUnitsInRangeOfLocAll(300.00, udg_Avalanche_TS_Point[0])
            call RemoveLocation(udg_Avalanche_TS_Point[0])
            //                                                                                                                    
            // Damage and slow nearby enemy units:
            call ForGroupBJ(udg_Avalanche_TS_Nearby_Group, function Trig_Avalanche_Toss_Loop_Func002Func026Func016Func022A)
            //                                                                                                                    
            call DestroyGroup(udg_Avalanche_TS_Nearby_Group)
        else
        endif
    else
    endif
    //                                                                                                                    
endfunction

function Trig_Avalanche_Toss_Loop_Actions takes nothing returns nothing
    // The Event is added from Toss Setup!
    call ForGroupBJ(udg_Avalanche_TS_Target_Group, function Trig_Avalanche_Toss_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_Avalanche_Toss_Loop takes nothing returns nothing
    set gg_trg_Avalanche_Toss_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Toss_Loop)
    call TriggerAddAction(gg_trg_Avalanche_Toss_Loop, function Trig_Avalanche_Toss_Loop_Actions)
endfunction

