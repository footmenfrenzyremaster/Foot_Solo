endfunction

//===========================================================================
// Trigger: TheNook Hellseek Loop
//===========================================================================
function Trig_TheNook_Hellseek_Loop_Func002Func003Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_TheNook_HK_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func011C takes nothing returns boolean
    if ( not ( udg_TheNook_HK_Duration[udg_TheNook_CV] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func023Func001C takes nothing returns boolean
    if ( not ( udg_TheNook_HK_Duration[udg_TheNook_CV] == 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func023C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_TheNook_Points[1], udg_TheNook_Points[2]) <= 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func023Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_TheNook_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_TheNook_Target, GetOwningPlayer(udg_TheNook)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_TheNook_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_TheNook_Target) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_TheNook_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_TheNook_Target) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func023A takes nothing returns nothing
    set udg_TheNook_Target=GetEnumUnit()
    if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func023Func002C() ) then
        call UnitDamageTargetBJ(udg_TheNook, udg_TheNook_Target, udg_TheNook_Real[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
    else
    endif
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func027C takes nothing returns boolean
    if ( not ( udg_TheNook_Integer[0] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func033C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_TheNook_HK_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003Func030C takes nothing returns boolean
    if ( not ( udg_TheNook_Integer[0] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_TheNook) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Hellseek_Loop_Func002A takes nothing returns nothing
    set udg_TheNook=GetEnumUnit()
    //                                                                                                                    
    if ( Trig_TheNook_Hellseek_Loop_Func002Func003C() ) then
        set udg_TheNook_CV=GetUnitUserData(udg_TheNook)
        //                                                                                                                    
        set udg_TheNook_HK_Duration[udg_TheNook_CV]=( udg_TheNook_HK_Duration[udg_TheNook_CV] + 1 )
        //                                                                                                                    
        // Stun the hero and play the "superman" animation:
        if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func011C() ) then
            call BlzPauseUnitEx(udg_TheNook, true)
            call SetUnitAnimationByIndex(udg_TheNook, 100)
        else
        endif
        //                                                                                                                    
        set udg_TheNook_Points[0]=GetUnitLoc(udg_TheNook)
        set udg_TheNook_Points[1]=GetUnitLoc(udg_TheNook_HK_Target[udg_TheNook_CV])
        set udg_TheNook_Points[2]=PolarProjectionBJ(udg_TheNook_Points[0], 38.00, AngleBetweenPoints(udg_TheNook_Points[0], udg_TheNook_Points[1]))
        //                                                                                                                    
        call SetUnitPositionLoc(udg_TheNook, udg_TheNook_Points[2])
        call SetUnitX(udg_TheNook, GetLocationX(udg_TheNook_Points[2]))
        call SetUnitY(udg_TheNook, GetLocationY(udg_TheNook_Points[2]))
        //                                                                                                                    
        // Check for impact or expiration:
        set udg_TheNook_Integer[0]=0
        if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func023C() ) then
            set udg_TheNook_Integer[0]=1
        else
            if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func023Func001C() ) then
                set udg_TheNook_Integer[0]=2
            else
            endif
        endif
        //                                                                                                                    
        // Memory leaks:
        call RemoveLocation(udg_TheNook_Points[0])
        call RemoveLocation(udg_TheNook_Points[1])
        //                                                                                                                    
        // The spell is finished:
        if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func030C() ) then
            call SetUnitPositionLoc(udg_TheNook, udg_TheNook_Points[2])
            //                                                                                                                    
            // Get ability level for scaling stats:
            set udg_TheNook_Integer[1]=GetUnitAbilityLevelSwapped('AHES', udg_TheNook)
            //                                                                                                                    
            // Cool visual effect:
            call AddSpecialEffectLocBJ(udg_TheNook_Points[2], "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            // Create the dummy:
            call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_TheNook), udg_TheNook_Points[2], bj_UNIT_FACING)
            set udg_TheNook_Dummy=GetLastCreatedUnit()
            call UnitApplyTimedLifeBJ(0.25, 'BTLF', udg_TheNook_Dummy)
            call UnitAddAbilityBJ('AHKS', udg_TheNook_Dummy)
            call SetUnitAbilityLevelSwapped('AHKS', udg_TheNook_Dummy, udg_TheNook_Integer[1])
            call IssueImmediateOrderBJ(udg_TheNook_Dummy, "thunderclap")
            //                                                                                                                    
            // AoE damage and slow:
            set udg_TheNook_Real[0]=( 45.00 + ( 35.00 * I2R(udg_TheNook_Integer[1]) ) )
            set udg_TheNook_Temp_Group=GetUnitsInRangeOfLocAll(340.00, udg_TheNook_Points[2])
            call RemoveLocation(udg_TheNook_Points[2])
            call ForGroupBJ(udg_TheNook_Temp_Group, function Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func023A)
            call DestroyGroup(udg_TheNook_Temp_Group)
            //                                                                                                                    
            // Impact:
            if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func027C() ) then
                call UnitAddAbilityBJ('AHSS', udg_TheNook_Dummy)
                call SetUnitAbilityLevelSwapped('AHSS', udg_TheNook_Dummy, udg_TheNook_Integer[1])
                call IssueTargetOrderBJ(udg_TheNook_Dummy, "thunderbolt", udg_TheNook_HK_Target[udg_TheNook_CV])
            else
            endif
            //                                                                                                                    
            // Try to turn off:
            call RemoveLocation(udg_TheNook_HK_Point[udg_TheNook_CV])
            call BlzPauseUnitEx(udg_TheNook, false)
            call GroupRemoveUnitSimple(udg_TheNook, udg_TheNook_HK_Group)
            if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func030Func033C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        else
            call RemoveLocation(udg_TheNook_Points[2])
        endif
    else
        // TheNook died in flight - Try to turn off:
        // Note: Dead units have all of their BlzPauseUnitEx() counters removed!
        call RemoveLocation(udg_TheNook_HK_Point[udg_TheNook_CV])
        call GroupRemoveUnitSimple(udg_TheNook, udg_TheNook_HK_Group)
        if ( Trig_TheNook_Hellseek_Loop_Func002Func003Func005C() ) then
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    endif
    //                                                                                                                    
endfunction

function Trig_TheNook_Hellseek_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_TheNook_HK_Group, function Trig_TheNook_Hellseek_Loop_Func002A)
endfunction

//===========================================================================
function InitTrig_TheNook_Hellseek_Loop takes nothing returns nothing
    set gg_trg_TheNook_Hellseek_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_TheNook_Hellseek_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_TheNook_Hellseek_Loop, 0.02)
    call TriggerAddAction(gg_trg_TheNook_Hellseek_Loop, function Trig_TheNook_Hellseek_Loop_Actions)
endfunction

//===========================================================================
// Trigger: TheNook Reap Cast
//===========================================================================
function Trig_TheNook_Reap_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AREA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Reap_Cast_Func006C takes nothing returns boolean
    if ( not ( udg_TheNook_R_Damage_Per_Lvl[1] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Reap_Cast_Func026Func002Func004C takes nothing returns boolean
    if ( not ( IsUnitType(udg_TheNook_Target, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_TheNook_Target, 'BHSS') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Reap_Cast_Func026Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_TheNook_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_TheNook_Target, GetOwningPlayer(udg_TheNook)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_TheNook_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_TheNook_Target) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_TheNook_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_TheNook_Target) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TheNook_Reap_Cast_Func026A takes nothing returns nothing
    set udg_TheNook_Target=GetEnumUnit()
    if ( Trig_TheNook_Reap_Cast_Func026Func002C() ) then
        // Deals bonus damage to heroes affected by Hellseek's slow:
        call AddSpecialEffectTargetUnitBJ("chest", udg_TheNook_Target, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        if ( Trig_TheNook_Reap_Cast_Func026Func002Func004C() ) then
            call UnitDamageTargetBJ(udg_TheNook, udg_TheNook_Target, udg_TheNook_Real[1], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        else
            call UnitDamageTargetBJ(udg_TheNook, udg_TheNook_Target, udg_TheNook_Real[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        endif
    else
    endif
endfunction

function Trig_TheNook_Reap_Cast_Actions takes nothing returns nothing
    set udg_TheNook=GetTriggerUnit()
    //                                                                                                                    
    set udg_TheNook_Points[0]=GetUnitLoc(udg_TheNook)
    //                                                                                                                    
    // DEFINE THE DAMAGE DEALT PER [LEVEL]:
    if ( Trig_TheNook_Reap_Cast_Func006C() ) then
        set udg_TheNook_R_Damage_Per_Lvl[1]=80.00
        set udg_TheNook_R_Damage_Per_Lvl[2]=110.00
        set udg_TheNook_R_Damage_Per_Lvl[3]=180.00
        set udg_TheNook_R_Damage_Per_Lvl[4]=245.00
        set udg_TheNook_R_Damage_Per_Lvl[5]=285.00
        set udg_TheNook_R_Damage_Per_Lvl[6]=460.00
    else
    endif
    //                                                                                                                    
    // Get ability level for scaling stats:
    set udg_TheNook_Integer[0]=GetUnitAbilityLevelSwapped('AREA', udg_TheNook)
    //                                                                                                                    
    // Create the dummy:
    //                                                                                                                    
    // AoE damage:
    set udg_TheNook_Real[0]=udg_TheNook_R_Damage_Per_Lvl[udg_TheNook_Integer[0]]
    set udg_TheNook_Real[1]=( udg_TheNook_Real[0] * ( 1.00 + ( I2R(udg_TheNook_Integer[0]) * 0.05 ) ) )
    //                                                                                                                    
    set udg_TheNook_Temp_Group=GetUnitsInRangeOfLocAll(340.00, udg_TheNook_Points[0])
    call RemoveLocation(udg_TheNook_Points[0])
    //                                                                                                                    
    call ForGroupBJ(udg_TheNook_Temp_Group, function Trig_TheNook_Reap_Cast_Func026A)
    //                                                                                                                    
    call DestroyGroup(udg_TheNook_Temp_Group)
endfunction

//===========================================================================
function InitTrig_TheNook_Reap_Cast takes nothing returns nothing
    set gg_trg_TheNook_Reap_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TheNook_Reap_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_TheNook_Reap_Cast, Condition(function Trig_TheNook_Reap_Cast_Conditions))
    call TriggerAddAction(gg_trg_TheNook_Reap_Cast, function Trig_TheNook_Reap_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Thunder Axe
//===========================================================================
function Trig_Thunder_Axe_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0L0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thunder_Axe_Func002C takes nothing returns boolean
    if ( not ( udg_NS_Damage_Copy[1] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thunder_Axe_Actions takes nothing returns nothing
    // DEFINE HAMMER DAMAGE PER LEVEL:
    if ( Trig_Thunder_Axe_Func002C() ) then
        set udg_NS_Damage_Copy[1]=70.00
        set udg_NS_Damage_Copy[2]=110.00
        set udg_NS_Damage_Copy[3]=135.00
        set udg_NS_Damage_Copy[4]=215.00
        set udg_NS_Damage_Copy[5]=270.00
        set udg_NS_Damage_Copy[6]=370.00
    else
    endif
    //                                                                                                     
    set udg_NS_Point_Copy[0]=GetUnitLoc(GetTriggerUnit())
    set udg_NS_Point_Copy[1]=GetSpellTargetLoc()
    set udg_NS_Angle_Copy=AngleBetweenPoints(udg_NS_Point_Copy[0], udg_NS_Point_Copy[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=GetUnitLoc(udg_MissileSource)
    set udg_MissileFinish=PolarProjectionBJ(udg_NS_Point_Copy[0], 1100.00, udg_NS_Angle_Copy)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="war3mapImported\\Axe Missile-Small.mdx"
    set udg_MissileScale=2.00
    set udg_MissileCollision=75.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=1100.00
    set udg_MissileVision=300.00
    set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Axe_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_NS_Point_Copy[0])
    call RemoveLocation(udg_NS_Point_Copy[1])
endfunction

//===========================================================================
function InitTrig_Thunder_Axe takes nothing returns nothing
    set gg_trg_Thunder_Axe=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Thunder_Axe, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Thunder_Axe, Condition(function Trig_Thunder_Axe_Conditions))
    call TriggerAddAction(gg_trg_Thunder_Axe, function Trig_Thunder_Axe_Actions)
endfunction

//===========================================================================
// Trigger: Axe OnHit
//===========================================================================
function Trig_Axe_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitVisible(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_MissileHitUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Axe_OnHit_Func012Func004C takes nothing returns boolean
    if ( not ( udg_MissileTravelled > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Axe_OnHit_Func012C takes nothing returns boolean
    if ( not ( udg_MissileData > 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Axe_OnHit_Func013C takes nothing returns boolean
    if ( not ( udg_MissileTravelled > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Axe_OnHit_Func017Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_NS_Target_Copy, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_NS_Target_Copy) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_NS_Target_Copy, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_NS_Target_Copy, UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_NS_Target_Copy, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_NS_Target_Copy) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Axe_OnHit_Func017A takes nothing returns nothing
    set udg_NS_Target_Copy=GetEnumUnit()
    if ( Trig_Axe_OnHit_Func017Func002C() ) then
        call UnitDamageTargetBJ(udg_MissileSource, udg_NS_Target_Copy, udg_NS_Damage_Copy[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_NS_Dummy_Copy, "thunderbolt", udg_NS_Target_Copy)
    else
    endif
endfunction

function Trig_Axe_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    //                                                                                                     
    call AddSpecialEffectLocBJ(udg_MissilePosition, "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    call CreateNUnitsAtLoc(1, 'dmmy', udg_MissileOwner, udg_MissilePosition, bj_UNIT_FACING)
    set udg_NS_Dummy_Copy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0UF', udg_NS_Dummy_Copy)
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_NS_Dummy_Copy)
    call SetUnitAbilityLevelSwapped('A0UF', udg_NS_Dummy_Copy, GetUnitAbilityLevelSwapped('A0L0', udg_MissileSource))
    //                                                                                                     
    if ( Trig_Axe_OnHit_Func012C() ) then
        // MissileData when empowered by Ulti is equal to Hammer Level + 6 (so at least 7)
        set udg_NS_Damage_Copy[0]=udg_NS_Damage_Copy[( udg_MissileData - 6 )]
        if ( Trig_Axe_OnHit_Func012Func004C() ) then
            set udg_NS_Damage_Copy[0]=( udg_NS_Damage_Copy[0] * ( 1 + ( udg_MissileTravelled / 1100.00 ) ) )
        else
        endif
        set udg_NS_Damage_Copy[0]=( udg_NS_Damage_Copy[0] + ( udg_HU_Damage_Per_Lvl[GetUnitAbilityLevelSwapped('AHAM', udg_MissileSource)] + 0.00 ) )
    else
        set udg_NS_Damage_Copy[0]=udg_NS_Damage_Copy[udg_MissileData]
    endif
    if ( Trig_Axe_OnHit_Func013C() ) then
        set udg_NS_Damage_Copy[0]=( udg_NS_Damage_Copy[0] * ( 1 + ( udg_MissileTravelled / 1100.00 ) ) )
    else
    endif
    // Check if the ulti has empowered this hammer:
    //                                                                                                     
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(180.00, udg_MissilePosition), function Trig_Axe_OnHit_Func017A)
endfunction

