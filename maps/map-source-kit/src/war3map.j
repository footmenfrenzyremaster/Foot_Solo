function Trig_autopool_command_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    if ( Trig_autopool_command_Func004C() ) then
        call DialogClearBJ(udg_dlg_pool[udg_temp_playernumber])
        call DialogSetMessageBJ(udg_dlg_pool[udg_temp_playernumber], "TRIGSTR_1682")
        if ( Trig_autopool_command_Func004Func005C() ) then
            call DialogAddButtonBJ(udg_dlg_pool[udg_temp_playernumber], GetPlayerName(udg_ally1[udg_temp_playernumber]))
