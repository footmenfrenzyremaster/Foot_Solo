    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    if ( Trig_HERO_Metamorphosis_CD_Func006C() ) then
        set udg_temp_real=BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_temp_unit, GetSpellAbilityId()), ABILITY_RLF_COOLDOWN, udg_abilitylevel)
