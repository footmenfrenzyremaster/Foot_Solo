function Trig_set_unit_info_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_player=ConvertedPlayer(udg_temp_playernumber)
    call ForGroupBJ(GetUnitsSelectedAll(udg_temp_player), function Trig_set_unit_info_Func004A)
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Selected unit: |r" + GetUnitName(udg_temp_unit) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit level: |r" + I2S(GetUnitLevel(udg_temp_unit)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Current scale factor: |r" + R2S(BlzGetUnitRealField(udg_temp_unit, UNIT_RF_SCALING_VALUE)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit attack type: |r" + I2S(BlzGetUnitWeaponIntegerField(udg_temp_unit, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit attack CD: |r" + R2S(BlzGetUnitWeaponRealField(udg_temp_unit, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit bounty base: |r" + I2S(BlzGetUnitIntegerField(udg_temp_unit, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit movement speed: |r" + R2S(GetUnitDefaultMoveSpeed(udg_temp_unit)) ))
    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffffff00Unit custom value: |r" + I2S(GetUnitUserData(udg_temp_unit)) ))
endfunction

