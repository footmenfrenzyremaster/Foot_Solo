function Trig_player_destroyed_Actions takes nothing returns nothing
    // Uncle: Remove Pub Defender:
    set udg_Pub_Defenders_Remove=true
    call ForForce(GetPlayersAllies(GetOwningPlayer(GetTriggerUnit())), function Trig_player_destroyed_Func003A)
    if ( Trig_player_destroyed_Func004C() ) then
        call RemoveUnit(udg_Pub_Defenders[( GetPlayerTeam(GetOwningPlayer(GetTriggerUnit())) + 1 )])
    else
    endif
    //                                                                                                     
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))
    set udg_temp_playernumber_ally_1=GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])
    set udg_temp_playernumber_ally_2=GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])
    call DisplayTimedTextToForce(udg_all_players, 3.00, ( GetPlayerName(ConvertedPlayer(udg_temp_playernumber)) + ( " has" + ( " been destroyed by " + GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) ) ) ))
    //                                                                                                     
    // KOTH - Check if they owned the hill and reset it if necessary:
    if ( Trig_player_destroyed_Func013C() ) then
        set udg_KOTH_Should_Reset_Hill=true
        //                                                                                                     
        call ForForce(udg_team[udg_temp_playernumber], function Trig_player_destroyed_Func013Func003A)
        //                                                                                                     
        if ( Trig_player_destroyed_Func013Func005C() ) then
            call TriggerExecute(gg_trg_KOTH_Set_Neutral_Hill)
            call TriggerExecute(gg_trg_KOTH_Reset_Hill)
        else
        endif
    else
    endif
    //                                                                                                     
    if ( Trig_player_destroyed_Func015C() ) then
        set udg_player_active[udg_temp_playernumber]=false
        call ForceRemovePlayerSimple(GetTriggerPlayer(), udg_Active_PlayGroup)
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call EnableTrigger(gg_trg_Visibility)
        call ConditionalTriggerExecute(gg_trg_Visibility)
        call ConditionalTriggerExecute(gg_trg_END)
        //                                                                                                     
        // Uncle: Some units shouldn't get killed:
        set udg_unitgroup_kill=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_temp_playernumber), Condition(function Trig_player_destroyed_Func015Func010002002))
        call ForGroupBJ(udg_unitgroup_kill, function Trig_player_destroyed_Func015Func011002)
        call DestroyGroup(udg_unitgroup_kill)
    else
        call DoNothing()
    endif
    if ( Trig_player_destroyed_Func016C() ) then
        set udg_player_active[udg_temp_playernumber]=false
        set udg_player_active[udg_temp_playernumber_ally_1]=false
        set udg_player_active[udg_temp_playernumber_ally_2]=false
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call ConditionalTriggerExecute(gg_trg_Kill_units_of_inactive_player)
        call EnableTrigger(gg_trg_Visibility)
        call ConditionalTriggerExecute(gg_trg_Visibility)
        call ConditionalTriggerExecute(gg_trg_END)
    else
        set udg_leaving_gold[udg_temp_playernumber]=GetPlayerState(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD)
        call SetPlayerStateBJ(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD, 0)
        if ( Trig_player_destroyed_Func016Func003C() ) then
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_1)), ( "You receive " + ( I2S(( udg_leaving_gold[udg_temp_playernumber] / 2 )) + " Gold." ) ))
            call AdjustPlayerStateBJ(( udg_leaving_gold[udg_temp_playernumber] / 2 ), ConvertedPlayer(udg_temp_playernumber_ally_1), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_2)), ( "You receive " + ( I2S(( udg_leaving_gold[udg_temp_playernumber] / 2 )) + " Gold." ) ))
            call AdjustPlayerStateBJ(( udg_leaving_gold[udg_temp_playernumber] / 2 ), ConvertedPlayer(udg_temp_playernumber_ally_2), PLAYER_STATE_RESOURCE_GOLD)
        else
            call DoNothing()
        endif
        if ( Trig_player_destroyed_Func016Func004C() ) then
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_1)), ( "You receive " + ( I2S(udg_leaving_gold[udg_temp_playernumber]) + " Gold." ) ))
            call AdjustPlayerStateBJ(udg_leaving_gold[udg_temp_playernumber], ConvertedPlayer(udg_temp_playernumber_ally_1), PLAYER_STATE_RESOURCE_GOLD)
        else
            call DoNothing()
        endif
        if ( Trig_player_destroyed_Func016Func005C() ) then
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber_ally_2)), ( "You receive " + ( I2S(udg_leaving_gold[udg_temp_playernumber]) + " Gold." ) ))
            call AdjustPlayerStateBJ(udg_leaving_gold[udg_temp_playernumber], ConvertedPlayer(udg_temp_playernumber_ally_2), PLAYER_STATE_RESOURCE_GOLD)
        else
            call DoNothing()
        endif
    endif
    call EnableTrigger(gg_trg_check_if_team_active)
endfunction

