function Trig_HERO_Architect_raise_morale_Func019C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Architect_raise_morale_Actions takes nothing returns nothing
    // set variables
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    // CR8 flag
    call CreateNUnitsAtLoc(1, 'o00U', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy_flag[udg_temp_playernumber]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(60.00, 'Bhwd', udg_dummy_flag[udg_temp_playernumber])
    call SetUnitAbilityLevelSwapped('A0AJ', udg_dummy_flag[udg_temp_playernumber], udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('AOr2', udg_dummy_flag[udg_temp_playernumber], udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('ACac', udg_dummy_flag[udg_temp_playernumber], udg_abilitylevel)
    call SetUnitAbilityLevelSwapped('A0AK', udg_dummy_flag[udg_temp_playernumber], udg_abilitylevel)
    if ( Trig_HERO_Architect_raise_morale_Func017C() ) then
        call BlzSetUnitMaxHP(udg_dummy_flag[udg_temp_playernumber], 750)
        call BlzSetUnitRealFieldBJ(udg_dummy_flag[udg_temp_playernumber], UNIT_RF_HP, 750.00)
        call BlzSetUnitArmor(udg_dummy_flag[udg_temp_playernumber], 5.00)
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Architect_raise_morale_Func018C() ) then
        call BlzSetUnitMaxHP(udg_dummy_flag[udg_temp_playernumber], 1000)
        call BlzSetUnitRealFieldBJ(udg_dummy_flag[udg_temp_playernumber], UNIT_RF_HP, 1000.00)
        call BlzSetUnitArmor(udg_dummy_flag[udg_temp_playernumber], 10.00)
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Architect_raise_morale_Func019C() ) then
        call BlzSetUnitMaxHP(udg_dummy_flag[udg_temp_playernumber], 1500)
        call BlzSetUnitRealFieldBJ(udg_dummy_flag[udg_temp_playernumber], UNIT_RF_HP, 1500.00)
        call BlzSetUnitArmor(udg_dummy_flag[udg_temp_playernumber], 15.00)
    else
        call DoNothing()
    endif
    call RemoveLocation(udg_temp_point)
endfunction

