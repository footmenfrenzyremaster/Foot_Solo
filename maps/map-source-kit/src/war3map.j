        call DisplayTextToForce(GetPlayersAll(), ( "|cffff0000[DEBUG]|r - " + ( "Enemy Unit: " + GetUnitName(GetEnumUnit()) ) ))
    else
        call DoNothing()
    endif
endfunction

function Trig_ITEM_Wall_taunt_Actions takes nothing returns nothing
    if ( Trig_ITEM_Wall_taunt_Func001C() ) then
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_10771")
    else
        call DoNothing()
    endif
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_AoE=550.00
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_ITEM_Wall_taunt_Func006002003))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_ITEM_Wall_taunt_Func007A)
    call AddSpecialEffectLocBJ(udg_temp_point, "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call PlaySoundOnUnitBJ(gg_snd_Taunt, 100, udg_temp_unit)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

