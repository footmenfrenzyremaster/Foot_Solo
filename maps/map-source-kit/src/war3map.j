//
// fixed
//===========================================================================
function Trig_draw_pressed_Conditions takes nothing returns boolean
    if ( not ( false == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func005Func003C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_btn_draw_yes[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func005Func004C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_btn_draw_no[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func005C takes nothing returns boolean
    if ( not ( udg_player_active[udg_temp_playernumber] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func010Func001Func003C takes nothing returns boolean
    if ( not ( udg_draw[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func010Func001C takes nothing returns boolean
    if ( not ( udg_player_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func011Func002Func027A takes nothing returns nothing
    call CustomDefeatBJ(GetEnumPlayer(), "TRIGSTR_10486")
endfunction

function Trig_draw_pressed_Func011Func002C takes nothing returns boolean
    if ( not ( udg_temp_int2 == udg_temp_int ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Func011C takes nothing returns boolean
    if ( not ( udg_temp_int2 < udg_temp_int ) ) then
        return false
    endif
    return true
endfunction

function Trig_draw_pressed_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_leave_or_votekick[udg_temp_playernumber]=true
    call DialogDisplayBJ(false, udg_dlg_draw[udg_temp_playernumber], GetTriggerPlayer())
    if ( Trig_draw_pressed_Func005C() ) then
        if ( Trig_draw_pressed_Func005Func003C() ) then
            set udg_draw[udg_temp_playernumber]=true
        else
        endif
        if ( Trig_draw_pressed_Func005Func004C() ) then
            set udg_draw[udg_temp_playernumber]=false
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
    call DestroyForce(udg_temp_playergroup)
    // check if all players draw / ded
    set udg_temp_int=0
    set udg_temp_int2=0
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_draw_pressed_Func010Func001C() ) then
            set udg_temp_int=( udg_temp_int + 1 )
            if ( Trig_draw_pressed_Func010Func001Func003C() ) then
                set udg_temp_int2=( udg_temp_int2 + 1 )
            else
                call DoNothing()
            endif
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
    if ( Trig_draw_pressed_Func011C() ) then
        call DisplayTextToForce(udg_all_players, ( ( ( I2S(udg_temp_int2) + " ouf of " ) + I2S(udg_temp_int) ) + " active players have voted to draw the game." ))
    else
        if ( Trig_draw_pressed_Func011Func002C() ) then
            call DisplayTextToForce(udg_all_players, "TRIGSTR_10479")
            call MMD_FlagPlayer(Player(0) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(1) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(2) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(3) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(4) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(5) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(6) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(7) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(8) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(9) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(10) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call MMD_FlagPlayer(Player(11) , MMD_FLAG_LOSER)
            call TriggerSleepAction(0.25)
            call ForForce(udg_all_players, function Trig_draw_pressed_Func011Func002Func027A)
        else
            call DoNothing()
        endif
    endif
endfunction

