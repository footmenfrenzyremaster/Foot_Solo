//===========================================================================
// Trigger: Hammer Ulti Cast
//===========================================================================
function Trig_Hammer_Ulti_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AHAM' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Cast_Actions takes nothing returns nothing
    // ==================================================
    // DEFINE THE BONUS DAMAGE PER LEVEL:
    set udg_HU_Damage_Per_Lvl[1]=450.00
    set udg_HU_Damage_Per_Lvl[2]=750.00
    set udg_HU_Damage_Per_Lvl[3]=1200.00
    // ==================================================
    //                                                                                                     
    set udg_HU_Hero=GetTriggerUnit()
    set udg_HU_CV=GetUnitUserData(udg_HU_Hero)
    //                                                                                                     
    // Set the Duration in seconds:
    set udg_HU_Duration[udg_HU_CV]=25
    //                                                                                                     
    // RESET CD:
    call BlzStartUnitAbilityCooldown(udg_HU_Hero, 'ANSP', 0.10)
    call BlzStartUnitAbilityCooldown(udg_HU_Hero, 'A0QF', 0.10)
    //                                                                                                     
    call UnitAddAbilityBJ('AHUL', udg_HU_Hero)
    call GroupAddUnitSimple(udg_HU_Hero, udg_HU_Group)
    set udg_HU_Duration[udg_HU_CV]=( udg_HU_Duration[udg_HU_CV] * 4 )
    call EnableTrigger(gg_trg_Hammer_Ulti_Loop)
endfunction

//===========================================================================
function InitTrig_Hammer_Ulti_Cast takes nothing returns nothing
    set gg_trg_Hammer_Ulti_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Hammer_Ulti_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Hammer_Ulti_Cast, Condition(function Trig_Hammer_Ulti_Cast_Conditions))
    call TriggerAddAction(gg_trg_Hammer_Ulti_Cast, function Trig_Hammer_Ulti_Cast_Actions)
endfunction

//===========================================================================
// Trigger: Hammer Ulti Loop
//===========================================================================
function Trig_Hammer_Ulti_Loop_Func001Func003Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_HU_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001Func003Func008Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_HU_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001Func003Func008C takes nothing returns boolean
    if ( not ( udg_HU_Duration[udg_HU_CV] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HU_Hero, 'B01J') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001A takes nothing returns nothing
    set udg_HU_Hero=GetEnumUnit()
    //                                                                                                     
    if ( Trig_Hammer_Ulti_Loop_Func001Func003C() ) then
        set udg_HU_CV=GetUnitUserData(udg_HU_Hero)
        //                                                                                                     
        set udg_HU_Duration[udg_HU_CV]=( udg_HU_Duration[udg_HU_CV] - 1 )
        //                                                                                                     
        if ( Trig_Hammer_Ulti_Loop_Func001Func003Func008C() ) then
            call UnitRemoveAbilityBJ('AHUL', udg_HU_Hero)
            call UnitRemoveBuffBJ('B01J', udg_HU_Hero)
            //                                                                                                     
            call GroupRemoveUnitSimple(udg_HU_Hero, udg_HU_Group)
            if ( Trig_Hammer_Ulti_Loop_Func001Func003Func008Func005C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        else
        endif
    else
        // Hero is dead / lost the buff:
        call GroupRemoveUnitSimple(udg_HU_Hero, udg_HU_Group)
        if ( Trig_Hammer_Ulti_Loop_Func001Func003Func003C() ) then
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    endif
endfunction

function Trig_Hammer_Ulti_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_HU_Group, function Trig_Hammer_Ulti_Loop_Func001A)
endfunction

//===========================================================================
function InitTrig_Hammer_Ulti_Loop takes nothing returns nothing
    set gg_trg_Hammer_Ulti_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Hammer_Ulti_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Hammer_Ulti_Loop, 0.25)
    call TriggerAddAction(gg_trg_Hammer_Ulti_Loop, function Trig_Hammer_Ulti_Loop_Actions)
endfunction

//===========================================================================
// Trigger: Dash Wooj
//===========================================================================
function Trig_Dash_Wooj_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0JO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dash_Wooj_Func027C takes nothing returns boolean
    if ( not ( udg_Avalanche_TR_Index == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dash_Wooj_Actions takes nothing returns nothing
    // Create a new instance of Trample:
    set udg_Avalanche_TR_Index=( udg_Avalanche_TR_Index + 1 )
    //                                                                                                                    
    // ================================================
    // Define the animation played, speed per interval, and max duration:
    // Note: Each animation has it's own integer index. It starts at 0 and works it's way up.
    set udg_Avalanche_TR_Animation[udg_Avalanche_TR_Index]=10
    set udg_Avalanche_TR_Speed[udg_Avalanche_TR_Index]=26.00
    set udg_Avalanche_TR_Max_Duration[udg_Avalanche_TR_Index]=31
    // ================================================
    //                                                                                                          
    // Store data about Trample which we will reference in the For Loop:
    set udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index]=GetTriggerUnit()
    set udg_Avalanche_TR_Duration[udg_Avalanche_TR_Index]=0
    set udg_Avalanche_TR_Interval[udg_Avalanche_TR_Index]=9999
    //                                                                                                          
    set udg_Avalanche_TR_Point[0]=GetUnitLoc(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index])
    set udg_Avalanche_TR_Point[1]=GetSpellTargetLoc()
    set udg_Avalanche_TR_Angle[udg_Avalanche_TR_Index]=AngleBetweenPoints(udg_Avalanche_TR_Point[0], udg_Avalanche_TR_Point[1])
    //                                                                                                          
    call RemoveLocation(udg_Avalanche_TR_Point[0])
    call RemoveLocation(udg_Avalanche_TR_Point[1])
    //                                                                                                          
    // Start the Trample loop:
    if ( Trig_Dash_Wooj_Func027C() ) then
        call EnableTrigger(gg_trg_Avalanche_Trample_Loop)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Dash_Wooj takes nothing returns nothing
    set gg_trg_Dash_Wooj=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Dash_Wooj, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Dash_Wooj, Condition(function Trig_Dash_Wooj_Conditions))
    call TriggerAddAction(gg_trg_Dash_Wooj, function Trig_Dash_Wooj_Actions)
endfunction

//===========================================================================
// Trigger: Summon Dragons
//===========================================================================
function Trig_Summon_Dragons_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summon_Dragons_Func002C takes nothing returns boolean
    if ( not ( udg_Summon_Dragons_Level == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summon_Dragons_Actions takes nothing returns nothing
    // DEFINE THE DIFFERENT DRAGON VARIABLES:
    if ( Trig_Summon_Dragons_Func002C() ) then
        set udg_Summon_Dragons_Duration[1]=45.00
        set udg_Summon_Dragons_Duration[2]=45.00
        set udg_Summon_Dragons_Duration[3]=45.00
        set udg_Summon_Dragons_Duration[4]=45.00
        set udg_Summon_Dragons_Duration[5]=45.00
        set udg_Summon_Dragons_Duration[6]=45.00
        //                                                                                                                    
        // Dragon #1:
        set udg_Summon_Dragons_Type_1[1]='n059'
        set udg_Summon_Dragons_Type_1[2]='n05A'
        set udg_Summon_Dragons_Type_1[3]='n05B'
        set udg_Summon_Dragons_Type_1[4]='n05C'
        set udg_Summon_Dragons_Type_1[5]='n05E'
        set udg_Summon_Dragons_Type_1[6]='n05D'
        //                                                                                                                    
        // Dragon #2:
        set udg_Summon_Dragons_Type_2[1]='n053'
        set udg_Summon_Dragons_Type_2[2]='n054'
        set udg_Summon_Dragons_Type_2[3]='n055'
        set udg_Summon_Dragons_Type_2[4]='n056'
        set udg_Summon_Dragons_Type_2[5]='n057'
        set udg_Summon_Dragons_Type_2[6]='n058'
    else
    endif
    // ===============================================
    //                                                                                                                    
    set udg_Summon_Dragons_Level=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
    //                                                                                                                    
    set udg_Summon_Dragons_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_Summon_Dragons_Point[1]=PolarProjectionBJ(udg_Summon_Dragons_Point[0], 128.00, ( GetUnitFacing(GetTriggerUnit()) + 90.00 ))
    set udg_Summon_Dragons_Point[2]=PolarProjectionBJ(udg_Summon_Dragons_Point[0], 128.00, ( GetUnitFacing(GetTriggerUnit()) - 90.00 ))
    //                                                                                                                    
    // Dragon #1:
    call CreateNUnitsAtLoc(1, udg_Summon_Dragons_Type_1[udg_Summon_Dragons_Level], GetOwningPlayer(GetTriggerUnit()), udg_Summon_Dragons_Point[1], GetUnitFacing(GetTriggerUnit()))
    call UnitApplyTimedLifeBJ(udg_Summon_Dragons_Duration[udg_Summon_Dragons_Level], 'BTLF', GetLastCreatedUnit())
    call UnitAddTypeBJ(UNIT_TYPE_SUMMONED, GetLastCreatedUnit())
    //                                                                                                                    
    // Dragon #2:
    call CreateNUnitsAtLoc(1, udg_Summon_Dragons_Type_2[udg_Summon_Dragons_Level], GetOwningPlayer(GetTriggerUnit()), udg_Summon_Dragons_Point[2], GetUnitFacing(GetTriggerUnit()))
    call UnitApplyTimedLifeBJ(udg_Summon_Dragons_Duration[udg_Summon_Dragons_Level], 'BTLF', GetLastCreatedUnit())
    call UnitAddTypeBJ(UNIT_TYPE_SUMMONED, GetLastCreatedUnit())
    //                                                                                                                    
    call RemoveLocation(udg_Summon_Dragons_Point[0])
    call RemoveLocation(udg_Summon_Dragons_Point[1])
    call RemoveLocation(udg_Summon_Dragons_Point[2])
endfunction

//===========================================================================
function InitTrig_Summon_Dragons takes nothing returns nothing
    set gg_trg_Summon_Dragons=CreateTrigger()
