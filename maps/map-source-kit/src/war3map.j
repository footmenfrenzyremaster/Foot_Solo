function Trig_KOTH_Update_Text_Func006C takes nothing returns boolean
    if ( not ( udg_KOTH_Player == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Update_Text_Actions takes nothing returns nothing
    // UPDATE TEXT BASED ON LEVEL:
    if ( Trig_KOTH_Update_Text_Func002C() ) then
        set udg_KOTH_Text="Income: 6g"
    else
        if ( Trig_KOTH_Update_Text_Func002Func001C() ) then
            set udg_KOTH_Text="Income: 9g"
        else
            if ( Trig_KOTH_Update_Text_Func002Func001Func001C() ) then
                set udg_KOTH_Text="Income: 12g"
            else
                if ( Trig_KOTH_Update_Text_Func002Func001Func001Func002C() ) then
                    set udg_KOTH_Text="Income: 18g"
                else
                    set udg_KOTH_Text="Income: 18g"
                endif
            endif
        endif
    endif
    //                                                                                                     
    // Update the Owner portion of the hill text:
    if ( Trig_KOTH_Update_Text_Func005C() ) then
        if ( Trig_KOTH_Update_Text_Func005Func001C() ) then
            set udg_KOTH_Text="Income: 6g"
        else
            if ( Trig_KOTH_Update_Text_Func005Func001Func001C() ) then
                set udg_KOTH_Text="Income: 9g"
            else
                if ( Trig_KOTH_Update_Text_Func005Func001Func001Func001C() ) then
                    set udg_KOTH_Text="Income: 12g"
                else
                    if ( Trig_KOTH_Update_Text_Func005Func001Func001Func001Func002C() ) then
                        set udg_KOTH_Text="Income: 30g"
                    else
                        set udg_KOTH_Text="Income: 30g"
                    endif
                endif
            endif
        endif
    else
        call DoNothing()
    endif
    if ( Trig_KOTH_Update_Text_Func006C() ) then
        set udg_KOTH_Text=( ( udg_KOTH_Text + "|n|cff00ff00Owner|r: " ) + "|cff808080Neutral|r" )
    else
        set udg_KOTH_Text=( ( udg_KOTH_Text + "|n|cff00ff00Owner|r: " ) + ( udg_colour[GetConvertedPlayerId(udg_KOTH_Player)] + ( "Team " + I2S(udg_KOTH_Team_Number) ) ) )
    endif
    //                                                                                                     
    //                                                                                                     
    // Apply the changes:
    if udg_KOTH_Floating_Text != null then
    call DestroyTextTagBJ(udg_KOTH_Floating_Text)
    endif
    //                                                                                                     
    set udg_KOTH_Point=OffsetLocation(udg_centermap, - 128.00, - 80.00)
    call CreateTextTagLocBJ(udg_KOTH_Text, udg_KOTH_Point, 0, 8.00, 100, 100, 100, 0)
    set udg_KOTH_Floating_Text=GetLastCreatedTextTag()
    //                                                                                                     
    call RemoveLocation(udg_KOTH_Point)
endfunction

//===========================================================================
function InitTrig_KOTH_Update_Text takes nothing returns nothing
    set gg_trg_KOTH_Update_Text=CreateTrigger()
    call TriggerAddAction(gg_trg_KOTH_Update_Text, function Trig_KOTH_Update_Text_Actions)
endfunction

