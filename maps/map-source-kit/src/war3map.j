function InitTrig_HERO_Throw_Glaive takes nothing returns nothing
    set gg_trg_HERO_Throw_Glaive=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Throw_Glaive, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Throw_Glaive, Condition(function Trig_HERO_Throw_Glaive_Conditions))
    call TriggerAddAction(gg_trg_HERO_Throw_Glaive, function Trig_HERO_Throw_Glaive_Actions)
endfunction

