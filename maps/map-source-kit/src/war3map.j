function InitTrig_stop_TK takes nothing returns nothing
    set gg_trg_stop_TK=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_stop_TK, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_stop_TK, Condition(function Trig_stop_TK_Conditions))
    call TriggerAddAction(gg_trg_stop_TK, function Trig_stop_TK_Actions)
endfunction

