//===========================================================================
// Trigger: Beast Attack
//
// Note:
// You must copy the variable and one action from initalization to your map, else knock back won't work!
// Variable and action are:
// Create hashtable 
// Knockback table
//===========================================================================
function Trig_Beast_Attack_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A006' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_Attack_Func030Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_Beast_Attack_Target, GetOwningPlayer(udg_Beast_Attack_Caster)) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_Attack_Func030C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_Beast_Attack_Target, GetOwningPlayer(udg_Beast_Attack_Caster)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_Attack_Actions takes nothing returns nothing
    // -------------------------------------------------------------------------------------------------
    // Getting the Spell constants
    // -------------------------------------------------------------------------------------------------
    set udg_Beast_Attack_Caster=GetTriggerUnit()
    set udg_Beast_Attack_Target=GetSpellTargetUnit()
    set udg_Beast_Attack_Ability_Level=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Beast_Attack_Caster)
    set udg_Beast_Attack_Ability_Level=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Beast_Attack_Caster)
    set udg_Beast_Attack_Location=GetUnitLoc(udg_Beast_Attack_Caster)
    set udg_Beast_Attack_Location2=GetUnitLoc(udg_Beast_Attack_Target)
    // -------------------------------------------------------------------------------------------------
    // Setting the Spell values
    // -------------------------------------------------------------------------------------------------
    set udg_Beast_Attack_Max_Life=GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Beast_Attack_Caster)
    set udg_Beast_Attack_Total_Damage=( 60.00 + ( 75.00 * I2R(udg_Beast_Attack_Ability_Level) ) )
    // -------------------------------------------------------------------------------------------------
    // Knockback Setings
    // -------------------------------------------------------------------------------------------------
    set udg_KnockbackAngle=AngleBetweenPoints(udg_Beast_Attack_Location, udg_Beast_Attack_Location2)
    set udg_KnockbackSpeed=35.00
    set udg_KnockbackDistance=( 320.00 + ( 50.00 * I2R(udg_Beast_Attack_Ability_Level) ) )
    call SaveRealBJ(udg_KnockbackSpeed, StringHashBJ("speed"), GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockbackTable)
    call SaveRealBJ(udg_KnockbackAngle, StringHashBJ("angle"), GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockbackTable)
    call SaveRealBJ(udg_KnockbackDistance, StringHashBJ("distance"), GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockbackTable)
    call GroupAddUnitSimple(udg_Beast_Attack_Target, udg_KnockbackUnits)
    call EnableTrigger(gg_trg_KnockbackUnits)
    // -------------------------------------------------------------------------------------------------
    // Damaging the target
    // -------------------------------------------------------------------------------------------------
    if ( Trig_Beast_Attack_Func030C() ) then
        call UnitDamageTargetBJ(udg_Beast_Attack_Caster, udg_Beast_Attack_Target, udg_Beast_Attack_Total_Damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    else
        if ( Trig_Beast_Attack_Func030Func001C() ) then
            call SetUnitLifeBJ(udg_Beast_Attack_Target, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Beast_Attack_Target) + ( 200.00 + ( 100.00 * I2R(udg_Beast_Attack_Ability_Level) ) ) ))
            call AddSpecialEffectTargetUnitBJ("origin", udg_Beast_Attack_Target, "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
    endif
    // -------------------------------------------------------------------------------------------------
    // Creating nice special effect
    // -------------------------------------------------------------------------------------------------
    call AddSpecialEffectTargetUnitBJ("hand, left", udg_Beast_Attack_Caster, "units\\human\\phoenix\\phoenix.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call AddSpecialEffectTargetUnitBJ("hand, right", udg_Beast_Attack_Caster, "units\\human\\phoenix\\phoenix.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    // -------------------------------------------------------------------------------------------------
    // Clearing leaks
    // -------------------------------------------------------------------------------------------------
    call RemoveLocation(udg_Beast_Attack_Location)
    call RemoveLocation(udg_Beast_Attack_Location2)
endfunction

//===========================================================================
function InitTrig_Beast_Attack takes nothing returns nothing
    set gg_trg_Beast_Attack=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Beast_Attack, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Beast_Attack, Condition(function Trig_Beast_Attack_Conditions))
    call TriggerAddAction(gg_trg_Beast_Attack, function Trig_Beast_Attack_Actions)
endfunction

//===========================================================================
// Trigger: KnockbackUnits
//===========================================================================
function Trig_KnockbackUnits_Func004Func004Func003003 takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_KnockbackUnits_Func004Func004Func004Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_KnockbackUnits) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockbackUnits_Func004Func004Func004C takes nothing returns boolean
    if ( not ( IsTerrainPathableBJ(udg_Knockback_Loc2, PATHING_TYPE_WALKABILITY) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockbackUnits_Func004Func004Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_KnockbackUnits) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockbackUnits_Func004Func004C takes nothing returns boolean
    if ( not ( udg_KnockbackDistance > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockbackUnits_Func004A takes nothing returns nothing
    set udg_KnockbackSpeed=LoadRealBJ(StringHashBJ("speed"), GetHandleIdBJ(GetEnumUnit()), udg_KnockbackTable)
    set udg_KnockbackAngle=LoadRealBJ(StringHashBJ("angle"), GetHandleIdBJ(GetEnumUnit()), udg_KnockbackTable)
    set udg_KnockbackDistance=LoadRealBJ(StringHashBJ("distance"), GetHandleIdBJ(GetEnumUnit()), udg_KnockbackTable)
    if ( Trig_KnockbackUnits_Func004Func004C() ) then
        set udg_Knockback_Loc1=GetUnitLoc(GetEnumUnit())
        set udg_Knockback_Loc2=PolarProjectionBJ(udg_Knockback_Loc1, udg_KnockbackSpeed, udg_KnockbackAngle)
        call EnumDestructablesInCircleBJ(175.00, udg_Knockback_Loc1, function Trig_KnockbackUnits_Func004Func004Func003003)
        if ( Trig_KnockbackUnits_Func004Func004Func004C() ) then
            call RemoveLocation(udg_Knockback_Loc1)
            call RemoveLocation(udg_Knockback_Loc2)
            call FlushChildHashtableBJ(GetHandleIdBJ(GetEnumUnit()), udg_KnockbackTable)
            call GroupRemoveUnitSimple(GetEnumUnit(), udg_KnockbackUnits)
            if ( Trig_KnockbackUnits_Func004Func004Func004Func006C() ) then
                call SetUnitPathing(udg_Beast_Attack_Target, true)
                call DisableTrigger(gg_trg_KnockbackUnits)
            else
            endif
        else
            call SetUnitPathing(udg_Beast_Attack_Target, false)
            call SetUnitPositionLoc(GetEnumUnit(), udg_Knockback_Loc2)
            call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            call SaveRealBJ(( udg_KnockbackDistance - udg_KnockbackSpeed ), StringHashBJ("distance"), GetHandleIdBJ(GetEnumUnit()), udg_KnockbackTable)
            call SetUnitPathing(udg_Beast_Attack_Target, true)
            call RemoveLocation(udg_Knockback_Loc1)
            call RemoveLocation(udg_Knockback_Loc2)
        endif
    else
        call FlushChildHashtableBJ(GetHandleIdBJ(GetEnumUnit()), udg_KnockbackTable)
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_KnockbackUnits)
        call SetUnitPathing(udg_Beast_Attack_Target, true)
        if ( Trig_KnockbackUnits_Func004Func004Func008C() ) then
            call SetUnitPathing(udg_Beast_Attack_Target, true)
            call DisableTrigger(gg_trg_KnockbackUnits)
        else
        endif
    endif
endfunction

function Trig_KnockbackUnits_Actions takes nothing returns nothing
    // -------------------------------------------------------------------------------------------------
    // Leave this actions as they are/// You can add change special effects but that's it
    // -------------------------------------------------------------------------------------------------
    call ForGroupBJ(udg_KnockbackUnits, function Trig_KnockbackUnits_Func004A)
endfunction

//===========================================================================
function InitTrig_KnockbackUnits takes nothing returns nothing
    set gg_trg_KnockbackUnits=CreateTrigger()
    call DisableTrigger(gg_trg_KnockbackUnits)
    call TriggerRegisterTimerEventPeriodic(gg_trg_KnockbackUnits, 0.03)
    call TriggerAddAction(gg_trg_KnockbackUnits, function Trig_KnockbackUnits_Actions)
endfunction

//===========================================================================
// Trigger: Parasite
//===========================================================================
function Trig_Parasite_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Func010C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_temp_target, udg_temp_player) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Actions takes nothing returns nothing
    // SET BASE VARIABLES
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_target=GetSpellTargetUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    // ACTION TIME
    if ( Trig_Parasite_Func010C() ) then
        // TARGET = ENEMY
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0HL', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0HL', udg_dummy, udg_abilitylevel)
        call IssueTargetOrderBJ(udg_dummy, "parasite", udg_temp_target)
        call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    else
    endif
    // CLEANUP TIME
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

//===========================================================================
function InitTrig_Parasite takes nothing returns nothing
    set gg_trg_Parasite=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Parasite, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Parasite, Condition(function Trig_Parasite_Conditions))
    call TriggerAddAction(gg_trg_Parasite, function Trig_Parasite_Actions)
endfunction

//===========================================================================
// Trigger: Fire Wall notused
//===========================================================================
function Trig_Fire_Wall_notused_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A052' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_Wall_notused_Actions takes nothing returns nothing
    // -------------------------------------------------------------------------------------------------
    // Getting the Spell constants
    // -------------------------------------------------------------------------------------------------
    set udg_Fire_Wall_Caster=GetTriggerUnit()
    set udg_Fire_Wall_Owner=GetOwningPlayer(udg_Fire_Wall_Caster)
    set udg_Fire_Wall_Ability_Level=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Fire_Wall_Caster)
    set udg_Fire_Wall_Location=GetSpellTargetLoc()
    // -------------------------------------------------------------------------------------------------
    // Setting the Spell values
    // -------------------------------------------------------------------------------------------------
    set udg_Fire_Wall_Duration=4.00
    set udg_Fire_Wall_Distance=70.00
    set udg_Fire_Wall_Dummy_Ability='A05A'
    // -------------------------------------------------------------------------------------------------
    // Creating and setting the dummy unit
    // -------------------------------------------------------------------------------------------------
    call CreateNUnitsAtLoc(1, 'h01J', udg_Fire_Wall_Owner, udg_Fire_Wall_Location, bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(udg_Fire_Wall_Duration, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ(udg_Fire_Wall_Dummy_Ability, GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped(udg_Fire_Wall_Dummy_Ability, GetLastCreatedUnit(), udg_Fire_Wall_Ability_Level)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "immolation")
    // -------------------------------------------------------------------------------------------------
    // Creating special effect
    // -------------------------------------------------------------------------------------------------
    call AddSpecialEffectLocBJ(udg_Fire_Wall_Location, "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // -------------------------------------------------------------------------------------------------
        // Setting the location
        // -------------------------------------------------------------------------------------------------
        set udg_Fire_Wall_Loop_Location=PolarProjectionBJ(udg_Fire_Wall_Location, ( udg_Fire_Wall_Distance * I2R(GetForLoopIndexA()) ), ( GetUnitFacing(udg_Fire_Wall_Caster) - 90.00 ))
        // -------------------------------------------------------------------------------------------------
        // Creating and setting the dummy unit
        // -------------------------------------------------------------------------------------------------
        call CreateNUnitsAtLoc(1, 'h01J', udg_Fire_Wall_Owner, udg_Fire_Wall_Loop_Location, bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(udg_Fire_Wall_Duration, 'BTLF', GetLastCreatedUnit())
        call UnitAddAbilityBJ(udg_Fire_Wall_Dummy_Ability, GetLastCreatedUnit())
        call SetUnitAbilityLevelSwapped(udg_Fire_Wall_Dummy_Ability, GetLastCreatedUnit(), udg_Fire_Wall_Ability_Level)
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "immolation")
        // -------------------------------------------------------------------------------------------------
        // Creating special effect
        // -------------------------------------------------------------------------------------------------
        call AddSpecialEffectLocBJ(udg_Fire_Wall_Loop_Location, "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(udg_Fire_Wall_Loop_Location, "Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // -------------------------------------------------------------------------------------------------
        // Setting the location
        // -------------------------------------------------------------------------------------------------
        set udg_Fire_Wall_Loop_Location_2=PolarProjectionBJ(udg_Fire_Wall_Location, ( udg_Fire_Wall_Distance * I2R(GetForLoopIndexA()) ), ( GetUnitFacing(udg_Fire_Wall_Caster) + 90.00 ))
        // -------------------------------------------------------------------------------------------------
        // Creating and setting the dummy unit
        // -------------------------------------------------------------------------------------------------
        call CreateNUnitsAtLoc(1, 'h01J', udg_Fire_Wall_Owner, udg_Fire_Wall_Loop_Location_2, bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(udg_Fire_Wall_Duration, 'BTLF', GetLastCreatedUnit())
        call UnitAddAbilityBJ(udg_Fire_Wall_Dummy_Ability, GetLastCreatedUnit())
        call SetUnitAbilityLevelSwapped(udg_Fire_Wall_Dummy_Ability, GetLastCreatedUnit(), udg_Fire_Wall_Ability_Level)
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "immolation")
        // -------------------------------------------------------------------------------------------------
        // Creating special effect
        // -------------------------------------------------------------------------------------------------
        call AddSpecialEffectLocBJ(udg_Fire_Wall_Loop_Location_2, "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(udg_Fire_Wall_Loop_Location_2, "Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // -------------------------------------------------------------------------------------------------
        // Clearing leaks
        // -------------------------------------------------------------------------------------------------
        call RemoveLocation(udg_Fire_Wall_Loop_Location)
        call RemoveLocation(udg_Fire_Wall_Loop_Location_2)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // -------------------------------------------------------------------------------------------------
    // Clearing leaks
    // -------------------------------------------------------------------------------------------------
    call RemoveLocation(udg_Fire_Wall_Location)
endfunction

//===========================================================================
function InitTrig_Fire_Wall_notused takes nothing returns nothing
    set gg_trg_Fire_Wall_notused=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Fire_Wall_notused, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Fire_Wall_notused, Condition(function Trig_Fire_Wall_notused_Conditions))
    call TriggerAddAction(gg_trg_Fire_Wall_notused, function Trig_Fire_Wall_notused_Actions)
endfunction

