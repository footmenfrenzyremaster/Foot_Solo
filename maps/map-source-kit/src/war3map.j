    set gg_trg_set_hero_bounty_update=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_bounty_update, 1.00)
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_bounty_update, 60.00)
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_bounty_update, 120.00)
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_bounty_update, 180.00)
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_bounty_update, 240.00)
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_bounty_update, 300.00)
