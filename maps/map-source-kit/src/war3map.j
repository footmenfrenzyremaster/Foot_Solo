    set gg_trg_ITEM_packhorse_buy=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_packhorse_buy, EVENT_PLAYER_UNIT_SELL_ITEM)
    call TriggerAddCondition(gg_trg_ITEM_packhorse_buy, Condition(function Trig_ITEM_packhorse_buy_Conditions))
    call TriggerAddAction(gg_trg_ITEM_packhorse_buy, function Trig_ITEM_packhorse_buy_Actions)
endfunction

