//
// CHECK #2 - OK
//===========================================================================
function Trig_GM_info_Func001Func001C takes nothing returns boolean
    if ( not ( udg_guided[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GM_info_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_GM_info_Func001Func001C() ) then
            set udg_temp_playergroup=GetForceOfPlayer(ConvertedPlayer(udg_X))
            call DisplayTimedTextToForce(udg_temp_playergroup, 5.00, "TRIGSTR_1110")
            set udg_temp_point=GetRectCenter(gg_rct_TOURNAMENT_WINNERS)
            call PingMinimapLocForForceEx(udg_all_players, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
            call RemoveLocation(udg_temp_point)
            call EnableTrigger(gg_trg_GM_send_messages)
            call DestroyForce(udg_temp_playergroup)
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

