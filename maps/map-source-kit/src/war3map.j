endfunction

//===========================================================================
// Trigger: eight
//===========================================================================
function Trig_eight_Conditions takes nothing returns boolean
    if ( not ( udg_balanced == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_Func001Func001Func001Func019Func001Func003C takes nothing returns boolean
    if ( ( udg_X_base == 1 ) ) then
        return true
    endif
    if ( ( udg_X_base == 2 ) ) then
        return true
    endif
    if ( ( udg_X_base == 14 ) ) then
        return true
    endif
    return false
endfunction

function Trig_eight_Func001Func001Func001Func019Func001Func005C takes nothing returns boolean
    if ( not ( udg_temp_level == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_Func001Func001Func001Func019Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('Rhan', ConvertedPlayer(udg_X_playernumber)) > 0 ) ) then
        return false
    endif
    if ( not Trig_eight_Func001Func001Func001Func019Func001Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_eight_Func001Func001Func001Func019Func003C takes nothing returns boolean
    if ( ( udg_X_base == 6 ) ) then
        return true
    endif
    if ( ( udg_X_base == 10 ) ) then
        return true
    endif
    if ( ( udg_X_base == 11 ) ) then
        return true
    endif
    if ( ( udg_X_base == 12 ) ) then
        return true
    endif
    if ( ( udg_X_base == 24 ) ) then
        return true
    endif
    if ( ( udg_X_base == 25 ) ) then
        return true
    endif
    return false
endfunction

function Trig_eight_Func001Func001Func001Func019Func005C takes nothing returns boolean
    if ( not ( udg_temp_level == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_Func001Func001Func001Func019C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('Robs', ConvertedPlayer(udg_X_playernumber)) > 0 ) ) then
        return false
    endif
    if ( not Trig_eight_Func001Func001Func001Func019Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_eight_Func001Func001Func001Func020Func003C takes nothing returns boolean
    if ( ( udg_X_base == 3 ) ) then
        return true
    endif
    if ( ( udg_X_base == 4 ) ) then
        return true
    endif
