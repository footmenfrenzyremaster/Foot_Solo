function Trig_Pounce_Cast_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0W4' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0W3' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0W5' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Pounce_Cast_Conditions takes nothing returns boolean
    if ( not Trig_Pounce_Cast_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func008C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0W4' ) ) then
        return false
    endif
    return true
endfunction

