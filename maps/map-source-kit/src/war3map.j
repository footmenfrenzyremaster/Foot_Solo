function Trig_eight_new_Conditions takes nothing returns boolean
    if ( not ( udg_balanced == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_eight_new_Func002Func002Func001Func006Func002Func001Func001C takes nothing returns boolean
    if ( not ( udg_autosend[GetForLoopIndexA()] == true ) ) then
        return false
    endif
    return true
