    set gg_trg_fake_shops_insert=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_fake_shops_insert, 0.20)
    call TriggerAddCondition(gg_trg_fake_shops_insert, Condition(function Trig_fake_shops_insert_Conditions))
    call TriggerAddAction(gg_trg_fake_shops_insert, function Trig_fake_shops_insert_Actions)
