//===========================================================================
// Trigger: autopool time
//
// ok
//===========================================================================
function Trig_autopool_time_Func001Func001C takes nothing returns boolean
    if ( not ( udg_player_active[udg_autopoolto[udg_temp_playernumber]] == true ) ) then
        return false
    endif
    if ( not ( udg_autopoolto[udg_temp_playernumber] >= 1 ) ) then
        return false
    endif
    if ( not ( GetPlayerState(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD) > udg_pool_threshold[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function Trig_autopool_time_Actions takes nothing returns nothing
    set udg_temp_playernumber=1
    loop
        exitwhen udg_temp_playernumber > 12
        if ( Trig_autopool_time_Func001Func001C() ) then
            set udg_goldpool[udg_temp_playernumber]=( GetPlayerState(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD) - udg_pool_threshold[udg_temp_playernumber] )
            call SetPlayerStateBJ(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD, udg_pool_threshold[udg_temp_playernumber])
            call AdjustPlayerStateBJ(udg_goldpool[udg_temp_playernumber], ConvertedPlayer(udg_autopoolto[udg_temp_playernumber]), PLAYER_STATE_RESOURCE_GOLD)
            set udg_temp_playergroup=GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber))
            call DisplayTimedTextToForce(udg_temp_playergroup, 1.00, ( I2S(udg_goldpool[udg_temp_playernumber]) + ( " |cffffcc00Gold|r has been sent to " + GetPlayerName(ConvertedPlayer(udg_autopoolto[udg_temp_playernumber])) ) ))
            call DestroyForce(udg_temp_playergroup)
            set udg_temp_playergroup=GetForceOfPlayer(ConvertedPlayer(udg_autopoolto[udg_temp_playernumber]))
            call DisplayTimedTextToForce(udg_temp_playergroup, 1.00, ( I2S(udg_goldpool[udg_temp_playernumber]) + ( " |cffffcc00Gold|r received from " + GetPlayerName(ConvertedPlayer(udg_temp_playernumber)) ) ))
            call DestroyForce(udg_temp_playergroup)
            set udg_goldpool[udg_temp_playernumber]=0
        else
            call DoNothing()
        endif
        set udg_temp_playernumber=udg_temp_playernumber + 1
    endloop
endfunction

