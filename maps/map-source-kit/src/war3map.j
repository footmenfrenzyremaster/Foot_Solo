function Trig_HERO_Architect_tower_build_Func007001 takes nothing returns boolean
    return ( udg_tower_ID == 20 )
endfunction

function Trig_HERO_Architect_tower_build_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_HERO_Architect_tower_countdown)
    set udg_temp_unit=GetConstructedStructure()
    call UnitApplyTimedLifeBJ(15.00, 'BTLF', udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
    if ( (udg_tower_ID == 20) ) then // INLINED!!
        set udg_tower_ID=0
    else
        call DoNothing()
    endif
    set udg_tower_ID=( udg_tower_ID + 1 )
    call SetUnitUserData(udg_temp_unit, udg_tower_ID)
    call StartTimerBJ(udg_timer_tower[udg_tower_ID], false, 30.00)
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_timer_tower[udg_tower_ID]), 2, 0), udg_temp_point, 0, 9.00, 100, 100, 100, 25.00)
    set udg_tower_timer_text[udg_tower_ID]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_tower_timer_text[udg_tower_ID], 15.00)
endfunction

