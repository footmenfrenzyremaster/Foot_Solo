    return true
endfunction

function Trig_HERO_Dark_Necro_Corrupted_Attack_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped('A0I7', udg_temp_unit)
    // ICON
    call UnitRemoveAbilityBJ('A0I7', udg_temp_unit)
    call UnitAddAbilityBJ('A0I7', udg_temp_unit)
    call SetUnitAbilityLevelSwapped('A0I7', udg_temp_unit, udg_abilitylevel)
    // Actual
    call UnitRemoveAbilityBJ('A0FF', udg_temp_unit)
    call UnitAddAbilityBJ('A0FF', udg_temp_unit)
    call SetUnitAbilityLevelSwapped('A0FF', udg_temp_unit, udg_abilitylevel)
endfunction

