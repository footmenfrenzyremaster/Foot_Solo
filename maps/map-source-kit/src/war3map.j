//===========================================================================
function Trig_Holy_Crash_Setup_Actions takes nothing returns nothing
    // ==============================================================
    // DEFINE the amount of damage it deals to nearby enemy units [Put the level in the brackets]:
    set udg_HCr_Setup_Damage[1]=225.00
    set udg_HCr_Setup_Damage[2]=325.00
    set udg_HCr_Setup_Damage[3]=425.00
    set udg_HCr_Setup_Damage[4]=250.00
    set udg_HCr_Setup_Damage[5]=350.00
    set udg_HCr_Setup_Damage[6]=460.00
    //                                                                                                                    
    // DEFINE the amount of life it restores to nearby allied units [Put the level in the brackets]:
    set udg_HCr_Setup_Heal[1]=100.00
    set udg_HCr_Setup_Heal[2]=200.00
    set udg_HCr_Setup_Heal[3]=300.00
    set udg_HCr_Setup_Heal[4]=125.00
    set udg_HCr_Setup_Heal[5]=175.00
    set udg_HCr_Setup_Heal[6]=230.00
    //                                                                                                                    
    // DEFINE the minimum distance that can be traveled, this should be at least 1:
    set udg_HCr_Setup_Min_Distance=200.00
    // ==============================================================
endfunction

